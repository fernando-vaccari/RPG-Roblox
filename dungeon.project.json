{
  "name": "ProjectMedievalRPG_Dungeon",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "MedievalRPG": {
        "$path": "src/shared"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "MedievalWorldgen": {
        "$path": "src/worldgen"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "MedievalServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "MedievalClient": {
          "$path": "src/client"
        }
      }
    }
  }
}
