="Cities/Asterion/Asterion_19/Foundation",["Offset"]={10,0.9199999999999972,-25.0},["Position"]={1600.999826,64.12,1626.5267910999999},["Yaw"]=-2.5679105464612797,["Location"]="Mercado • exterior, lateral da fachada",["FutureBuilding"]=true},["Asterion_Ambient_Artisan"]={["Id"]="Asterion_Ambient_Artisan",["Anchor"]="Cities/Asterion/Asterion_25/Foundation",["Offset"]={10,0.9199999999999972,-25.0},["Position"]={1820.1661709,64.12,1546.0622380000002},["Yaw"]=2.746147426161197,["Location"]="Oficina • exterior, lateral da fachada",["FutureBuilding"]=false},["Asterion_Ambient_Employee"]={["Id"]="Asterion_Ambient_Employee",["Anchor"]="Cities/Asterion/Asterion_19/Foundation",["Offset"]={-18,0.9199999999999972,-25.0},["Position"]={1624.5172584,64.12,1611.33039702},["Yaw"]=-2.5679105464612797,["Location"]="Mercado • exterior, lateral da fachada",["FutureBuilding"]=false},["Asterion_Ambient_Adventurer"]={["Id"]="Asterion_Ambient_Adventurer",["Anchor"]="Cities/Asterion/Asterion_13/Foundation",["Offset"]={-10,0.9199999999999972,-25.0},["Position"]={1839.341934,64.12,1620.0141405},["Yaw"]=2.6225468834463066,["Location"]="Campo de Treino • exterior, lateral da fachada",["FutureBuilding"]=false},["Asterion_Ambient_Farmer"]={["Id"]="Asterion_Ambient_Farmer",["Anchor"]="Cities/Asterion/Asterion_19/Foundation",["Offset"]={26,0.9199999999999972,-25.0},["Position"]={1587.5612932,64.12,1635.2104448599998},["Yaw"]=-2.5679105464612797,["Location"]="Mercado • exterior, lateral da fachada",["FutureBuilding"]=true},["MalgorthDepths_Administrator"]={["Id"]="MalgorthDepths_Administrator",["Anchor"]="DungeonEntrance/MalgorthGate/Forecourt",["Offset"]={-16,1.12,-16},["Position"]={-16.0,49.12,-2566.0},["Yaw"]=0.0,["Location"]="Pátio existente da entrada MalgorthGate",["FutureBuilding"]=false},["FallenSanctum_Administrator"]={["Id"]="FallenSanctum_Administrator",["Anchor"]="DungeonEntrance/FallenSanctumGate/Forecourt",["Offset"]={-16,1.12,-16},["Position"]={-1366.0,65.12,-2536.0},["Yaw"]=0.0,["Loca