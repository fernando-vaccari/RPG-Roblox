<roblox version="4">
  <Item class="Model" referent="0">
    <Properties>
      <string name="Name">EldravynNPCPackage</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Authoring</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Placement</string>
          <string name="Source"><![CDATA[-- Read-only map queries. Never writes Terrain, moves buildings or guesses interiors.
local P={}
function P.resolve(world,path)
 local node=world;for segment in path:gmatch('[^/]+')do node=node and node:FindFirstChild(segment)end;return node
end
function P.safe(position,ignore,expectedY)
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=ignore;params.IgnoreWater=false;params.RespectCanCollide=true
 local hit=workspace:Raycast(position+Vector3.new(0,12,0),Vector3.new(0,-40,0),params)
 if not hit or hit.Material==Enum.Material.Water or (hit.Normal and hit.Normal.Y<0.85) or math.abs(hit.Position.Y-expectedY)>6 then return nil end
 local feet=hit.Position+Vector3.new(0,0.12,0)
 local box=OverlapParams.new();box.FilterType=Enum.RaycastFilterType.Exclude;local ignored=table.clone(ignore);table.insert(ignored,workspace.Terrain);box.FilterDescendantsInstances=ignored;box.RespectCanCollide=true
 for _,part in workspace:GetPartBoundsInBox(CFrame.new(feet+Vector3.new(0,3.7,0)),Vector3.new(4.8,7,4.8),box)do
  if part.CanCollide then return nil end
 end
 return feet
end
function P.frame(world,entry,npcs,strict)
 local anchor=P.resolve(world,entry.Anchor)
 if not anchor or not anchor:IsA('BasePart') then return nil,'Âncora ausente: '..entry.Anchor end
 local offset=Vector3.new(table.unpack(entry.Offset));local position=anchor.CFrame:PointToWorldSpace(offset)
 if strict then
  local safe=P.safe(position,{npcs},position.Y);if not safe then return nil,'Piso/obstáculo incompatível: '..entry.Id end;position=safe
 end
 local look=anchor.CFrame.LookVector
 return CFrame.lookAt(position,position+Vector3.new(look.X,0,look.Z))
end
return P
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">R15Factory</string>
          <string name="Source"><![CDATA[-- Original native R15 topology, Motor6D joints and decorative clothing. No asset IDs.
local F={}
function F.create(parent,definition,role,frame)
 local m=Instance.new('Model');m.Name=definition.Id;m.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
 m:SetAttribute('EldravynNPCId',definition.Id);m:SetAttribute('NPCRole',definition.Role);m:SetAttribute('City',definition.City)
 m:SetAttribute('AmbientNPC',definition.Ambient==true);m:SetAttribute('NPCVersion',1)
 if definition.Dungeon then m:SetAttribute('DungeonId',definition.Dungeon) end
 local mage=definition.Role=='Magic' or definition.Role=='Races' or definition.Role=='Fusions'
 local guard=definition.Role=='Guard' or definition.Role=='Classes' or definition.Role=='GuildMaster'
 local skin=Color3.fromRGB(190+(definition.Variant or 1)*6,148+(definition.Variant or 1)*5,115+(definition.Variant or 1)*4)
 local cloth=if mage then Color3.fromRGB(70,71,122) elseif guard then Color3.fromRGB(72,95,117) elseif definition.Role=='Blacksmith' then Color3.fromRGB(95,67,49) else Color3.fromRGB(100,102,72)
 local pants=Color3.fromRGB(59,51,49);local metal=Color3.fromRGB(153,161,171)
 local parts,offsets={},{}
 local function part(name,size,offset,color)
  local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=frame*CFrame.new(offset);p.Color=color
  p.Material=Enum.Material.SmoothPlastic;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true
  p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=m
  parts[name]=p;offsets[name]=offset;return p
 end
 local root=part('HumanoidRootPart',Vector3.new(2,2,1),Vector3.new(0,3,0),cloth);root.Transparency=1;root.Anchored=true
 part('LowerTorso',Vector3.new(1.8,0.9,0.9),Vector3.new(0,3,0),cloth)
 part('UpperTorso',Vector3.new(2,1.4,1),Vector3.new(0,4,0),cloth)
 local head=part('Head',Vector3.new(1.4,1.1,1),Vector3.new(0,5.25,0),skin)
 for _,side in {'Left','Right'} do
  local x=if side=='Left' then -1 else 1
  part(side..'UpperArm',Vector3.new(0.65,1.1,0.75),Vector3.new(x*1.35,4,0),cloth)
  part(side..'LowerArm',Vector3.new(0.6,0.9,0.65),Vector3.new(x*1.35,3,0),if definition.Role=='Blacksmith' then skin else cloth)
  part(side..'Hand',Vector3.new(0.6,0.5,0.65),Vector3.new(x*1.35,2.3,0),if guard or definition.Role=='Blacksmith' then pants else skin)
  part(side..'UpperLeg',Vector3.new(0.8,1.2,0.8),Vector3.new(x*0.5,1.95,0),pants)
  part(side..'LowerLeg',Vector3.new(0.7,1,0.7),Vector3.new(x*0.5,0.9,0),pants)
  part(side..'Foot',Vector3.new(0.8,0.5,1.2),Vector3.new(x*0.5,0.25,-0.1),Color3.fromRGB(45,37,33))
 end
 local function joint(name,a,b,pivot)
  local motor=Instance.new('Motor6D');motor.Name=name;motor.Part0=parts[a];motor.Part1=parts[b]
  motor.C0=CFrame.new(pivot-offsets[a]);motor.C1=CFrame.new(pivot-offsets[b]);motor.Parent=parts[a]
  for _,body in {a,b} do local at=Instance.new('Attachment');at.Name=name..'RigAttachment';at.CFrame=CFrame.new(pivot-offsets[body]);at.Parent=parts[body] end
 end
 joint('Root','HumanoidRootPart','LowerTorso',Vector3.new(0,3,0));joint('Waist','LowerTorso','UpperTorso',Vector3.new(0,3.4,0));joint('Neck','UpperTorso','Head',Vector3.new(0,4.7,0))
 for _,side in {'Left','Right'} do local x=if side=='Left' then -1 else 1
  joint(side..'Shoulder','UpperTorso',side..'UpperArm',Vector3.new(x,4.4,0))
  joint(side..'Elbow',side..'UpperArm',side..'LowerArm',Vector3.new(x*1.35,3.45,0))
  joint(side..'Wrist',side..'LowerArm',side..'Hand',Vector3.new(x*1.35,2.55,0))
  joint(side..'Hip','LowerTorso',side..'UpperLeg',Vector3.new(x*0.5,2.55,0))
  joint(side..'Knee',side..'UpperLeg',side..'LowerLeg',Vector3.new(x*0.5,1.35,0))
  joint(side..'Ankle',side..'LowerLeg',side..'Foot',Vector3.new(x*0.5,0.4,0))
 end
 local function adorn(name,size,offset,color,body)
  body=body or 'UpperTorso';local p=part(name,size,offsets[body]+offset,color)
  local weld=Instance.new('WeldConstraint');weld.Part0=parts[body];weld.Part1=p;weld.Parent=p;return p
 end
 for _,x in {-0.3,0.3} do adorn('Eye'..x,Vector3.new(0.13,0.17,0.08),Vector3.new(x,0,-0.54),Color3.fromRGB(28,24,31),'Head') end
 adorn('Hair',Vector3.new(1.5,0.35,1.1),Vector3.new(0,0.5,0.05),pants,'Head')
 adorn('Mouth',Vector3.new(0.3,0.06,0.06),Vector3.new(0,-0.3,-0.54),pants,'Head')
 adorn('Belt',Vector3.new(1.95,0.22,1),Vector3.new(0,-0.1,0),pants,'LowerTorso')
 if mage then
  adorn('Robe',Vector3.new(1.9,1.5,1),Vector3.new(0,-0.5,0),cloth,'LowerTorso')
  adorn('HatBrim',Vector3.new(2,0.2,1.6),Vector3.new(0,0.6,0),cloth,'Head')
  adorn('HatCrown',Vector3.new(1,1.2,0.9),Vector3.new(0,1.1,0),cloth,'Head')
  adorn('DecorativeStaff',Vector3.new(0.22,4.8,0.22),Vector3.new(0.5,0.8,0),Color3.fromRGB(102,75,46),'RightHand')
 elseif guard then
  adorn('Breastplate',Vector3.new(1.85,1.2,0.2),Vector3.new(0,0,-0.6),metal)
  for _,x in {-1,1} do adorn('Pauldron'..x,Vector3.new(0.9,0.35,1),Vector3.new(x*1.2,0.5,0),metal) end
 elseif definition.Role=='Blacksmith' then
  adorn('Apron',Vector3.new(1.6,2,0.15),Vector3.new(0,-0.4,-0.6),Color3.fromRGB(84,51,32))
  adorn('HammerHandle',Vector3.new(0.2,1.3,0.2),Vector3.new(0,-0.3,0),pants,'RightHand')
  adorn('HammerHead',Vector3.new(0.9,0.4,0.4),Vector3.new(0,0.35,0),metal,'RightHand')
 else
  adorn('VestTrim',Vector3.new(0.2,1.3,0.15),Vector3.new(-0.5,0,-0.6),Color3.fromRGB(204,178,106))
  adorn('Satchel',Vector3.new(0.8,0.8,0.5),Vector3.new(0.9,-0.3,0.1),pants,'LowerTorso')
 end
 local hum=Instance.new('Humanoid');hum.RigType=Enum.HumanoidRigType.R15;hum.DisplayName=role.Name..' • '..role.Title;hum.HipHeight=2
 hum.MaxHealth=100;hum.Health=100;hum.BreakJointsOnDeath=false;hum.AutoRotate=false;hum.Parent=m
 local animator=Instance.new('Animator');animator.Parent=hum
 local prompt=Instance.new('ProximityPrompt');prompt.Name='NPCInteraction';prompt.ActionText='Conversar';prompt.ObjectText=role.Name..' • '..role.Title
 prompt.MaxActivationDistance=12;prompt.RequiresLineOfSight=true;prompt.HoldDuration=0;prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.Parent=head
 m.PrimaryPart=root;m.Parent=parent;return m
end
return F
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Client</string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">NPCDialogueClient</string>
          <string name="Source"><![CDATA[-- One responsive interface shared by every role; prices/options arrive from server.
local UI={}
function UI.new(playerGui,action)
 local screen=Instance.new('ScreenGui');screen.Name='EldravynNPCDialogue';screen.ResetOnSpawn=false;screen.DisplayOrder=25;screen.Parent=playerGui
 local panel=Instance.new('Frame');panel.Name='Dialogue';panel.AnchorPoint=Vector2.new(0.5,0.5);panel.Position=UDim2.fromScale(0.5,0.5);panel.Size=UDim2.fromScale(0.92,0.84);panel.BackgroundColor3=Color3.fromRGB(31,27,24);panel.Visible=false;panel.Parent=screen
 local cap=Instance.new('UISizeConstraint');cap.MaxSize=Vector2.new(660,720);cap.Parent=panel
 local border=Instance.new('UIStroke');border.Color=Color3.fromRGB(177,146,83);border.Thickness=2;border.Parent=panel
 local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(0,10);corner.Parent=panel
 local title=Instance.new('TextLabel');title.Name='Title';title.Size=UDim2.new(1,-70,0,58);title.Position=UDim2.fromOffset(16,6);title.BackgroundTransparency=1;title.Font=Enum.Font.Garamond;title.TextColor3=Color3.fromRGB(241,216,165);title.TextSize=23;title.TextWrapped=true;title.TextXAlignment=Enum.TextXAlignment.Left;title.Parent=panel
 local close=Instance.new('TextButton');close.Name='Close';close.Text='×';close.TextSize=30;close.Size=UDim2.fromOffset(48,48);close.Position=UDim2.new(1,-56,0,8);close.BackgroundColor3=Color3.fromRGB(75,43,37);close.TextColor3=Color3.fromRGB(255,242,219);close.Parent=panel
 local scroll=Instance.new('ScrollingFrame');scroll.Name='Content';scroll.Position=UDim2.fromOffset(16,72);scroll.Size=UDim2.new(1,-32,1,-88);scroll.BackgroundTransparency=1;scroll.BorderSizePixel=0;scroll.ScrollBarThickness=6;scroll.CanvasSize=UDim2.fromOffset(0,0);scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y;scroll.Parent=panel
 local layout=Instance.new('UIListLayout');layout.Padding=UDim.new(0,10);layout.SortOrder=Enum.SortOrder.LayoutOrder;layout.Parent=scroll
 local text=Instance.new('TextLabel');text.Name='Body';text.Size=UDim2.new(1,-10,0,0);text.AutomaticSize=Enum.AutomaticSize.Y;text.BackgroundTransparency=1;text.TextColor3=Color3.fromRGB(237,225,203);text.TextSize=18;text.Font=Enum.Font.SourceSans;text.TextWrapped=true;text.TextXAlignment=Enum.TextXAlignment.Left;text.TextYAlignment=Enum.TextYAlignment.Top;text.LayoutOrder=0;text.Parent=scroll
 local toast=Instance.new('TextLabel');toast.Name='Notice';toast.AnchorPoint=Vector2.new(0.5,0);toast.Position=UDim2.fromScale(0.5,0.03);toast.Size=UDim2.new(0.9,0,0,64);toast.BackgroundColor3=Color3.fromRGB(39,34,28);toast.TextColor3=Color3.fromRGB(255,226,166);toast.TextSize=18;toast.Font=Enum.Font.SourceSans;toast.TextWrapped=true;toast.Visible=false;toast.Parent=screen
 local self={Panel=panel,Screen=screen,Token=nil,Options={},Buttons={},Sending=false,NoticeSerial=0}
 function self:choose(index)
  if self.Sending or not self.Token or not self.Options[index] or not self.Options[index].Enabled then return end
  self.Sending=true;action:FireServer({Token=self.Token,Choice=index})
 end
 function self:hide()
  for i,v in self.Options do if v.Label=='Encerrar conversa' or v.Label=='Encerrar' then self:choose(i);break end end
  panel.Visible=false
 end
 close.Activated:Connect(function()self:hide()end)
 function self:receive(payload)
  if payload.Notice and not payload.Token then
   self.NoticeSerial+=1;local serial=self.NoticeSerial;toast.Text=payload.Notice;toast.Visible=true
   task.delay(6,function()if serial==self.NoticeSerial then toast.Visible=false end end)
  end
  if payload.Close then panel.Visible=false;self.Token=nil;return end
  if not payload.Token then return end
  self.Sending=false;self.Token=payload.Token;self.Options=payload.Options or {};panel.Visible=true
  title.Text=payload.Name..' • '..payload.Title;text.Text=(payload.Notice and payload.Notice..'\n\n' or '')..payload.Text
  for _,b in self.Buttons do b:Destroy()end;self.Buttons={};scroll.CanvasPosition=Vector2.new(0,0)
  for index,option in self.Options do
   local button=Instance.new('TextButton');button.Name='Option'..index;button.Size=UDim2.new(1,-10,0,52);button.AutomaticSize=Enum.AutomaticSize.Y
   button.Text=option.Label;button.TextWrapped=true;button.TextSize=18;button.Font=Enum.Font.SourceSansSemibold;button.LayoutOrder=index;button.AutoButtonColor=option.Enabled
   button.BackgroundColor3=if option.Enabled then Color3.fromRGB(83,63,38) else Color3.fromRGB(49,46,42)
   button.TextColor3=if option.Enabled then Color3.fromRGB(255,239,202) else Color3.fromRGB(164,158,145)
   local padding=Instance.new('UIPadding');padding.PaddingTop=UDim.new(0,12);padding.PaddingBottom=UDim.new(0,12);padding.PaddingLeft=UDim.new(0,10);padding.PaddingRight=UDim.new(0,10);padding.Parent=button
   button.Parent=scroll;button.Activated:Connect(function()self:choose(index)end);table.insert(self.Buttons,button)
  end
 end
 return self
end
return UI
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="6">
        <Properties>
          <string name="Name">NPCInteractionClient</string>
          <bool name="Disabled">true</bool>
          <string name="Source"><![CDATA[local Players=game:GetService('Players')
local player=Players.LocalPlayer
local remotes=game.ReplicatedStorage:WaitForChild('EldravynNPC'):WaitForChild('RemoteEvents')
local ui=require(script.Parent.NPCDialogueClient).new(player:WaitForChild('PlayerGui'),remotes:WaitForChild('Action'))
local marker
remotes:WaitForChild('View').OnClientEvent:Connect(function(payload)
 ui:receive(payload)
 if payload.Marker then
  if marker then marker:Destroy()end
  marker=Instance.new('Part');marker.Name='NPCDestination';marker.Size=Vector3.new(0.5,0.5,0.5);marker.Transparency=1;marker.Anchored=true;marker.CanCollide=false;marker.CanTouch=false;marker.CanQuery=false;marker.Position=payload.Marker.Position+Vector3.new(0,10,0);marker.Parent=workspace
  local billboard=Instance.new('BillboardGui');billboard.Size=UDim2.fromOffset(240,64);billboard.AlwaysOnTop=true;billboard.Adornee=marker;billboard.Parent=marker
  local label=Instance.new('TextLabel');label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=0.2;label.BackgroundColor3=Color3.fromRGB(42,34,24);label.TextColor3=Color3.fromRGB(255,226,145);label.Font=Enum.Font.SourceSansBold;label.TextSize=18;label.TextWrapped=true;label.Text='◆ '..payload.Marker.Name;label.Parent=billboard
  local this=marker;task.delay(payload.Marker.Seconds,function()if this then this:Destroy()end;if marker==this then marker=nil end end)
 end
end)
game:GetService('UserInputService').InputBegan:Connect(function(input,processed)if not processed and input.KeyCode==Enum.KeyCode.Escape then ui:hide()end end)
-- Bounded local idle poses; no external Animation IDs or server frame loop.
local joints={};local elapsed=0
local function refresh()
 joints={};local folder=workspace:FindFirstChild('EldravynNPCs');local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
 if not folder or not root then return end
 local nearest={}
 for _,npc in folder:GetDescendants()do if npc:IsA('Model') and npc:GetAttribute('EldravynNPCId') and npc.PrimaryPart then
  local distance=(npc.PrimaryPart.Position-root.Position).Magnitude;if distance<90 then table.insert(nearest,{NPC=npc,Distance=distance})end
 end end
 table.sort(nearest,function(a,b)return a.Distance<b.Distance end)
 for index=1,math.min(#nearest,12)do
  local npc=nearest[index].NPC;local torso=npc:FindFirstChild('UpperTorso');local neck=torso and torso:FindFirstChild('Neck')
  if neck then table.insert(joints,neck)end
 end
end
task.spawn(function()while true do refresh();task.wait(2)end end)
game:GetService('RunService').Heartbeat:Connect(function(dt)
 elapsed+=dt;for index,joint in joints do if joint.Parent then joint.Transform=CFrame.Angles(math.sin(elapsed*1.3+index)*0.025,math.sin(elapsed*0.8+index)*0.07,0)end end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="7">
      <Properties>
        <string name="Name">Installer</string>
        <string name="Source"><![CDATA[-- Run from Command Bar in Edit mode on a saved COPY of the existing Place.
local I={Version=1}
function I.Install()
 assert(not game:GetService('RunService'):IsRunning(),'Pare Play antes de instalar NPCs.')
 local package=script.Parent
 local world=workspace:FindFirstChild('GeneratedWorld')
 assert(world,'GeneratedWorld não encontrado. Nenhum mapa será criado pelo instalador.')
 local rs=game:GetService('ReplicatedStorage');local ss=game:GetService('ServerScriptService')
 local starter=game:GetService('StarterPlayer'):WaitForChild('StarterPlayerScripts')
 assert(rs:FindFirstChild('MedievalRPG'),'Biblioteca original MedievalRPG ausente; instalação interrompida.')
 local old=ss:FindFirstChild('MedievalServer')
 if old then assert(not old:IsA('Script') or old.Disabled,'Runtime RPG já ativo; integração específica necessária.') end
 if old then for _,v in old:GetDescendants()do assert(not v:IsA('Script') or v.Disabled,'Runtime RPG já ativo: exige integração específica para evitar dois escritores de perfil.')end end
 local destinations={{Parent=rs,Name='EldravynNPC',Source=package.Shared},{Parent=ss,Name='EldravynNPC',Source=package.Server},{Parent=starter,Name='EldravynNPCClient',Source=package.Client}}
 local root=workspace:FindFirstChild('EldravynNPCs')
 if root then
  assert(root:GetAttribute('NPCInstallVersion')==I.Version,'Pasta EldravynNPCs pertence a outro conteúdo; nada sobrescrito.')
  for _,d in destinations do assert(d.Parent:FindFirstChild(d.Name) and d.Parent[d.Name]:GetAttribute('NPCInstallVersion')==I.Version,'Instalação incompleta; nenhum conteúdo será substituído automaticamente.')end
  print('[NPC] Versão '..I.Version..' já instalada. Nenhum NPC duplicado.');return {Existing=true}
 end
 for _,d in destinations do assert(not d.Parent:FindFirstChild(d.Name),'Destino já ocupado: '..d.Name..'. Nenhum arquivo será sobrescrito.')end
 local config=require(package.Shared.NPCConfig);local positions=require(package.Shared.PlacementConfig)
 local placement=require(package.Authoring.Placement);local factory=require(package.Authoring.R15Factory)
 local frames,existing={},{}
 local aliases={Guild='GuildMaster',Merchant='General',Mage='Magic',Blacksmith='Blacksmith',Innkeeper='Inn',Guard='Guard'}
 for _,model in workspace:GetDescendants()do
  if model:IsA('Model') and model:FindFirstChildOfClass('Humanoid') then
   local role=model:GetAttribute('NPCRole') or model:GetAttribute('Role')
   role=aliases[role] or role;local city=model:GetAttribute('City') or model:GetAttribute('CityId')
   if not role then for key,entry in config.Roles do if model.Name==entry.Name or model.Name==entry.Title then role=key end end end
   if not city then local ancestor=model.Parent;while ancestor and ancestor~=workspace do
    if ({Valoria=true,Arkheim=true,Eldoria=true,Durakh=true,Asterion=true,MalgorthDepths=true,FallenSanctum=true})[ancestor.Name] then city=ancestor.Name;break end
    ancestor=ancestor.Parent
   end end
   assert(role and city,'NPC existente sem identificação: '..model.Name..'. Defina atributos NPCRole e City antes de instalar, para evitar duplicação.')
   existing[city..':'..role]=model
  end
 end
 -- Check every anchor before creating or enabling anything.
 local strict=world:GetAttribute('TerrainPending')~=true
 local staging=Instance.new('Folder');staging.Name='EldravynNPCs';staging:SetAttribute('NPCInstallVersion',I.Version)
 local skipped={}
 for _,definition in config.Definitions do
  if existing[definition.City..':'..definition.Role] then table.insert(skipped,definition.Id)
  else
   local frame,reason=placement.frame(world,assert(positions.NPCs[definition.Id]),staging,strict)
   if not frame then staging:Destroy();error(reason..'. Ajuste PlacementConfig à sua cópia antes de tentar novamente; mapa preservado.')end
   frames[definition.Id]=frame
  end
 end
 local created={};local previousStage=workspace:GetAttribute('EldravynNPCStage2');local previousPreview=workspace:GetAttribute('StudioSessionPreview')
 local ok,err=pcall(function()
  local cities={}
  for _,definition in config.Definitions do if frames[definition.Id] then
   local city=cities[definition.City]
   if not city then city=Instance.new('Folder');city.Name=definition.City;city.Parent=staging;cities[definition.City]=city end
   factory.create(city,definition,config.Roles[definition.Role],frames[definition.Id])
  end end
  for _,d in destinations do
   local clone=d.Source:Clone();clone.Name=d.Name;clone:SetAttribute('NPCInstallVersion',I.Version);table.insert(created,clone);clone.Parent=d.Parent
  end
  staging.Parent=workspace;table.insert(created,staging)
  workspace:SetAttribute('EldravynNPCStage2',true)
  if previousPreview==nil then workspace:SetAttribute('StudioSessionPreview',true)end
  for _,container in created do for _,node in container:GetDescendants()do if node:IsA('BaseScript') then node.Disabled=false end end end
 end)
 if not ok then
  for _,node in created do node:Destroy()end;staging:Destroy()
  workspace:SetAttribute('EldravynNPCStage2',previousStage);workspace:SetAttribute('StudioSessionPreview',previousPreview);error(err)
 end
 for _,id in skipped do warn('[NPC] Equivalente existente preservado, sem duplicar: '..id..'. Integre o diálogo deste personagem manualmente.')end
 print('[NPC] Instalação concluída sem editar GeneratedWorld/Terrain. Salve outra cópia e teste Play. Prévia Studio pode ser volátil.')
 return {Installed=#config.Definitions-#skipped,Skipped=skipped,TerrainTouched=false}
end
return I
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">AmbientService</string>
          <string name="Source"><![CDATA[-- Small, bounded patrols for ambient residents only. No pathfinding or combat AI.
local Players=game:GetService('Players')
local TweenService=game:GetService('TweenService')
local Placement=require(script.Parent.Placement)
local Ambient={}
local mobile={Resident=true,Traveler=true,Farmer=true,Adventurer=true}
function Ambient.start(npcs,folder)
 local homes={};for _,npc in npcs do
  if npc:GetAttribute('AmbientNPC') and mobile[npc:GetAttribute('NPCRole')] and npc.PrimaryPart then homes[npc]={Frame=npc.PrimaryPart.CFrame,Away=false}end
 end
 task.spawn(function()
  while folder.Parent do
   task.wait(10);local active=0
   for npc,home in homes do
    if active>=4 then break end
    local root=npc.PrimaryPart;local nearby=false
    if not root or (npc:GetAttribute('NPCSpeakingUntil') or 0)>os.clock() then continue end
    for _,player in Players:GetPlayers()do local p=player.Character and player.Character:FindFirstChild('HumanoidRootPart');if p and (p.Position-root.Position).Magnitude<75 then nearby=true;break end end
    if not nearby then continue end
    local target=home.Frame*(if home.Away then CFrame.new() else CFrame.new(2.5,0,0))
    local delta=target.Position-root.Position;local valid=true;local feet
    for step=0,4 do
     local point=root.Position+delta*(step/4)-Vector3.new(0,3,0)
     feet=Placement.safe(point,{folder},point.Y)
     if not feet or math.abs(feet.Y-point.Y)>0.7 then valid=false;break end
    end
    for other in homes do if other~=npc and other.PrimaryPart and (other.PrimaryPart.Position-target.Position).Magnitude<6 then valid=false;break end end
    if valid and feet then
     active+=1;home.Away=not home.Away
     local destination=target+Vector3.new(0,feet.Y+3-target.Position.Y,0)
     TweenService:Create(root,TweenInfo.new(2,Enum.EasingStyle.Linear),{CFrame=destination}):Play()
    end
   end
  end
 end)
end
return Ambient
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="10">
