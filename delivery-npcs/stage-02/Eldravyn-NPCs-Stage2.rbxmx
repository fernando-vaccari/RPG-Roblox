        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Http=game:GetService('HttpService')
local DSS=game:GetService('DataStoreService')
local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.WorldConfig)
local Catalog=require(Shared.Config.ContentConfig)
local Rules=require(Shared.Core.Progression)
local Identity=require(Shared.Core.IdentityRules)
local IdentityConfig=require(Shared.Config.IdentityConfig)
local Adventure=require(Shared.Core.AdventureRules)
local AdventureConfig=require(Shared.Config.AdventureConfig)
local Expeditions=require(Shared.Core.DungeonRules)
local DungeonConfig=require(Shared.Config.DungeonConfig)
local npcStage=workspace:GetAttribute('EldravynNPCStage2')==true
local function clone(t) return Http:JSONDecode(Http:JSONEncode(t)) end
Identity.validate(IdentityConfig)
local function prepare(raw)
    assert(raw==nil or type(raw)=='table','Perfil inválido; defaults não serão gravados')
    local state=Rules.sanitize(raw,Catalog)
    Identity.restore(state,type(raw)=='table' and raw.Identity or nil,IdentityConfig)
    Adventure.restore(state,type(raw)=='table' and raw.Adventure or nil,AdventureConfig)
    Expeditions.restore(state,type(raw)=='table' and raw.Expedition or nil,DungeonConfig)
    -- Preserve the NPC extension even when the legacy Place owns the profile.
    if raw and raw.NPC~=nil then
        assert(type(raw.NPC)=='table' and raw.NPC.Version==1,'Extensão NPC inválida; preservar perfil')
        state.NPC=clone(raw.NPC)
        if table.find(Catalog.Ranks,raw.Rank) then state.Rank=raw.Rank end
        if IdentityConfig.Advanced[raw.Class] then state.Class=raw.Class end
        for _,item in Catalog.Items do if item.Class==raw.Class then state.Class=raw.Class end end
    end
    if npcStage then
        local npc=game.ReplicatedStorage:WaitForChild('EldravynNPC')
        require(npc.Rules).restore(state,raw,require(npc.Registry))
        -- Buying ownership does not equip armor in the NPC-only stage.
        state.Armor=if raw and raw.Armor=='Armor' and state.Inventory.Armor then 'Armor' else ''
    end
    return state
end
local studioPreview=game:GetService('RunService'):IsStudio() and workspace:GetAttribute('StudioSessionPreview')==true
local Data={Sessions={},Persistent=Config.EnableDataStore and not studioPreview}
local store=if Data.Persistent then DSS:GetDataStore('MedievalRPG_v1') else nil
function Data.load(player,reuseToken)
    local previous=Data.Sessions[player]
    if previous and (previous.Saving or previous.Loading) then return false,'Perfil ocupado; aguarde a operação atual.' end
    local slot={Loading=true,PendingDeath=previous and previous.PendingDeath,Token=reuseToken or Http:GenerateGUID(false),State=Rules.new(),Ready=false,Saving=false,Frozen=false}
    Data.Sessions[player]=slot
    if not store then slot.State=prepare(nil);slot.Ready=true;slot.Loading=false; return true,'Modo volátil: raça não sorteada. Persistência é obrigatória para identidade permanente.' end
    local candidate
    local ok,result
    for attempt=1,3 do
        ok,result=pcall(function()
            return store:UpdateAsync('Player_'..player.UserId,function(old)
                assert(old==nil or type(old)=='table' and type(old.Data)=='table','Envelope existente inválido; preservar para recuperação')
                old=old or {}
                assert(old.Session==nil or type(old.Session)=='table' and type(old.Session.Token)=='string' and type(old.Session.Expires)=='number' and old.Session.Expires==old.Session.Expires,'Lock inválido')
                local lock=old.Session
                if lock and lock.Token~=slot.Token and type(lock.Expires)=='number' and lock.Expires>os.time() then return nil end
                local profile=prepare(old.Data)
                if profile.Identity.Race=='' and not npcStage then
                    if not candidate then candidate=math.random(1,100) end
                    Identity.assign(profile,IdentityConfig,candidate)
                end
                Identity.refresh(profile,IdentityConfig,os.time())
                if slot.PendingDeath then Identity.fail(profile,IdentityConfig,slot.PendingDeath) end
                return {Data=profile,Session={Token=slot.Token,Expires=os.time()+180}}
            end)
        end)
        if ok and result and result.Session and result.Session.Token==slot.Token then break end
        if attempt<3 then task.wait(attempt) end
    end
    if not ok or not result or not result.Session or result.Session.Token~=slot.Token then
        slot.Loading=false;slot.Frozen=true
        warn('Perfil indisponível para '..player.UserId..'; nenhuma gravação de defaults será feita.')
        return false,'Dados indisponíveis ou sessão ativa em outro servidor. Entre novamente mais tarde.'
    end
    slot.State=prepare(result.Data);slot.Ready=true;slot.Loading=false;slot.PendingDeath=nil;slot.LeaseUntil=result.Session.Expires
    if player.Parent~=Players then Data.save(player,true);Data.Sessions[player]=nil end
    return true,'Progresso carregado.'
end
function Data.get(player)
    local slot=Data.Sessions[player]
    if slot and store and slot.Ready and slot.LeaseUntil and os.time()>=slot.LeaseUntil then slot.Frozen=true end
    return if slot and slot.Ready and not slot.Frozen and not slot.Released then slot.State else nil
end
function Data.save(player,release)
    local slot=Data.Sessions[player]
    if slot and slot.Released then return true end
    if not slot or not slot.Ready or slot.Saving or slot.Frozen then return false,'Perfil ocupado/indisponível' end
    if not store then return true end
    slot.Saving=true
    if release then slot.Frozen=true end
    slot.State.Identity.CurrentClass=slot.State.Class
    local snapshot=clone(slot.State)
    local ok,result=pcall(function()
        return store:UpdateAsync('Player_'..player.UserId,function(old)
            if type(old)~='table' or not old.Session or old.Session.Token~=slot.Token then return nil end
            if old.Data and old.Data.Identity and old.Data.Identity.Race~=snapshot.Identity.Race then return nil end
            return {Data=snapshot,Session=if release then nil else {Token=slot.Token,Expires=os.time()+180}}
        end)
    end)
    slot.Saving=false
    if not ok or not result then
        -- Congela em caso de erro ou perda de posse; evita recompensas em perfil sem lock.
        slot.Frozen=true;warn('Save falhou; perfil congelado para '..player.UserId)
        return false,'Falha de salvamento. Reconecte para proteger o progresso.'
    end
    if release then slot.Released=true else slot.LeaseUntil=result.Session.Expires;Data.flushDeath(player) end
    return true
end
-- Grant + durable receipt marker committed in the SAME owned profile transaction.
function Data.changeIdentity(player,mutation)
    local slot=Data.Sessions[player]
    if not store or not Data.get(player) or slot.Saving or slot.Released then return false,'Perfil ocupado ou sem persistência.' end
    local snapshot=clone(slot.State)
    snapshot.Identity.CurrentClass=snapshot.Class
    local accepted,message=mutation(snapshot)
    if not accepted then return false,message end
    snapshot.Identity.CurrentClass=snapshot.Class
    slot.Saving=true;slot.Frozen=true
    local ok,result=pcall(function()
        return store:UpdateAsync('Player_'..player.UserId,function(old)
            if not old or not old.Session or old.Session.Token~=slot.Token then return nil end
            if not old.Data or not old.Data.Identity or old.Data.Identity.Race~=snapshot.Identity.Race then return nil end
            return {Data=snapshot,Session={Token=slot.Token,Expires=os.time()+180}}
        end)
    end)
    slot.Saving=false
    if not ok or not result then return false,'Gravação incerta; perfil congelado até recarga. Nenhuma compra será confirmada.' end
    slot.State=prepare(result.Data);slot.Frozen=false;slot.LeaseUntil=result.Session.Expires
    Data.flushDeath(player)
    return true,message
end
-- Reuses the same atomic profile transaction for expedition tickets/rewards.
-- Volatile mode is explicit and never used for paid grants or racial rolls.
function Data.transaction(player,mutation)
    if store then return Data.changeIdentity(player,mutation) end
    local state=Data.get(player);if not state then return false,'Perfil indisponível.' end
    local snapshot=clone(state);local ok,message=mutation(snapshot)
    if ok then Data.Sessions[player].State=prepare(snapshot) end
    return ok,message
end
function Data.receipt(player,receiptId,productId)
    local slot=Data.Sessions[player]
    if not store or not Data.get(player) or slot.Saving or slot.Released then return false end
    if slot.State.Identity.Receipts[receiptId] then return true end
    slot.Saving=true;slot.Frozen=true
    slot.State.Identity.CurrentClass=slot.State.Class
    local snapshot=clone(slot.State)
    local ok,result=pcall(function()
        return store:UpdateAsync('Player_'..player.UserId,function(old)
            if type(old)~='table' or not old.Session or old.Session.Token~=slot.Token then return nil end
            if not old.Data or not old.Data.Identity or old.Data.Identity.Race~=snapshot.Identity.Race then return nil end
            if old.Data.Identity.Receipts[receiptId] then return old end
            local nextState=clone(snapshot)
            if not Identity.grantReceipt(nextState,IdentityConfig,receiptId,productId) then return nil end
            return {Data=nextState,Session={Token=slot.Token,Expires=os.time()+180}}
        end)
    end)
    slot.Saving=false
    if not ok or not result then
        -- Keep frozen on uncertainty; Roblox must retry the receipt, never acknowledge a lost grant.
        warn('Recibo pendente; perfil requer recarga segura: '..player.UserId)
        return false
    end
    slot.State=prepare(result.Data);slot.Frozen=false;slot.LeaseUntil=result.Session.Expires
    Data.flushDeath(player)
    return slot.State.Identity.Receipts[receiptId]==true
end
function Data.noteDeath(player)
    local slot=Data.Sessions[player]
    if not slot or not slot.Ready then return end
    slot.PendingDeath=os.time()
    local changed=Identity.fail(slot.State,IdentityConfig,slot.PendingDeath)
    if not slot.Saving and not slot.Frozen then
        slot.PendingDeath=nil
        if changed then Data.save(player,false) end
    end
end
function Data.flushDeath(player)
    local slot=Data.Sessions[player]
    if not slot or not slot.PendingDeath then return end
    local at=slot.PendingDeath;slot.PendingDeath=nil
    local changed=Identity.fail(slot.State,IdentityConfig,at)
    if changed or slot.State.Identity.Racial.Status=='Failed' then Data.save(player,false) end
end
function Data.remove(player)
    local slot=Data.Sessions[player]
    if not slot then return end
    local limit=os.clock()+8
    while slot.Saving and os.clock()<limit do task.wait(0.1) end
    if slot.Frozen then
        -- Discard uncertain local snapshot; release ONLY our lock, preserving durable receipts/progress.
        if store and not slot.Saving then pcall(function()
            store:UpdateAsync('Player_'..player.UserId,function(old)
                if type(old)=='table' and old.Session and old.Session.Token==slot.Token then return {Data=old.Data} end
                return nil
            end)
        end) end
    else Data.save(player,true) end
    if Data.Sessions[player]==slot then Data.Sessions[player]=nil end
end
function Data.start()
    task.spawn(function()
        while task.wait(45) do
            for player,slot in Data.Sessions do
                if slot.Ready and not slot.Saving and not slot.Frozen then Data.save(player,false) end
            end
        end
    end)
    game:BindToClose(function()
        local pending=0
        for player in Data.Sessions do pending+=1;task.spawn(function() Data.remove(player);pending-=1 end) end
        local deadline=os.clock()+20
        while pending>0 and os.clock()<deadline do task.wait(0.1) end
    end)
end
return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">DialogueService</string>
          <string name="Source"><![CDATA[-- Client sends only a single-use token and an index into server-owned options.
local Players=game:GetService('Players')
local Http=game:GetService('HttpService')
local Shared=game.ReplicatedStorage.EldravynNPC
local C=require(Shared.Registry)
local Data=require(script.Parent.NPCDataService)
local Actions=require(script.Parent.NPCActionService)
local D={Sessions={},Limits={}}
function D.near(player,npc)
 local character=player.Character;local root=character and character:FindFirstChild('HumanoidRootPart')
 local hum=character and character:FindFirstChildOfClass('Humanoid');local head=npc and npc:FindFirstChild('Head')
 if not root or not hum or hum.Health<=0 or not head or not npc:IsDescendantOf(workspace) then return false end
 if (root.Position-head.Position).Magnitude>C.PromptDistance+2 then return false end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={character,workspace:FindFirstChild('EldravynNPCs') or npc};params.IgnoreWater=true
 local hit=workspace:Raycast(root.Position,head.Position-root.Position,params)
 return hit==nil or hit.Instance:IsDescendantOf(npc)
end
function D.send(player,session,page,notice)
 local menu=Actions.menu(player,session.NPC,page)
 session.Page=page;session.Options=menu.Options;session.Token=Http:GenerateGUID(false);session.Expires=os.clock()+C.SessionSeconds;session.NPC:SetAttribute('NPCSpeakingUntil',session.Expires)
 local role=C.Roles[session.NPC:GetAttribute('NPCRole')]
 local choices={};for _,v in menu.Options do table.insert(choices,{Label=v.Label,Enabled=v.Enabled})end
 D.View:FireClient(player,{Token=session.Token,Name=role.Name,Title=role.Title,Text=menu.Text,Notice=notice,Options=choices})
end
function D.close(player)
 D.Sessions[player]=nil;if D.View then D.View:FireClient(player,{Close=true})end
end
function D.open(player,npc)
 local now=os.clock();if now<(D.Limits[player] or 0) then return false end;D.Limits[player]=now+0.3
 local previous=D.Sessions[player];if previous and previous.Busy then return false end
 if Actions.NPCs[npc:GetAttribute('EldravynNPCId')]~=npc or not D.near(player,npc) then return false end
 if not Data.get(player) then
  D.View:FireClient(player,{Close=true,Notice='Perfil indisponível. Aguarde ou reconecte; nenhuma compra foi realizada.'});return false
 end
 local s={NPC=npc,Busy=true};D.Sessions[player]=s
 local ok,err=pcall(function()Data.event(player,'Talk:'..npc:GetAttribute('NPCRole'),'Interaction');D.send(player,s,'Root')end)
 s.Busy=false;if not ok then warn('[NPC] Interação falhou: '..tostring(err));D.close(player)end
 return ok
end
function D.handle(player,payload)
 local now=os.clock();if now<(D.Limits[player] or 0) then return false end;D.Limits[player]=now+0.2
 local s=D.Sessions[player]
 if not s or s.Busy or type(payload)~='table' or type(payload.Token)~='string' or #payload.Token>80 or payload.Token~=s.Token then return false end
 if not require(Shared.Rules).integer(payload.Choice,1,#s.Options) then return false end
 if now>s.Expires or not D.near(player,s.NPC) then D.close(player);return false end
 local option=s.Options[payload.Choice];if not option.Enabled then return false end
 -- Invalidate before any yielding persistence or marketplace calls.
 s.Busy=true;s.Token=nil
 local ok,err=pcall(function()
  local command=option.Command
  if command=='Close' then D.close(player)
  elseif command=='Page' then s.Pending=nil;D.send(player,s,option.Value)
  elseif command=='Mark' then
   local target=Actions.Locations[option.Value]
   if target then D.View:FireClient(player,{Marker={Name=target.Name,Position=target.Position,Seconds=45}})end
   D.send(player,s,s.Page,'Destino marcado por 45 segundos.')
  elseif command=='Confirm' then
   local pending=s.Pending;s.Pending=nil;local state=Data.get(player)
   if not pending or not state or state.Revision~=s.Revision then D.send(player,s,'Root','Os dados mudaram. Consulte os custos e confirme novamente.');return end
   local accepted,message=Actions.execute(player,s.NPC,pending)
   D.send(player,s,'Root',message or (if accepted then 'Operação concluída.' else 'Operação indisponível.'))
  else
   local state=Data.get(player);if not state then D.close(player);return end
   s.Pending=option;s.Revision=state.Revision;s.Options={{Label='Confirmar',Command='Confirm',Enabled=true},{Label='Cancelar / voltar',Command='Page',Value=s.Page,Enabled=true},{Label='Encerrar',Command='Close',Enabled=true}}
   s.Token=Http:GenerateGUID(false);s.Expires=now+C.SessionSeconds
   D.View:FireClient(player,{Token=s.Token,Name=C.Roles[s.NPC:GetAttribute('NPCRole')].Name,Title='Confirmação',Text=option.Label..'\nConfirme esta operação. Custos e requisitos serão verificados novamente pelo servidor.',Options={{Label='Confirmar',Enabled=true},{Label='Cancelar / voltar',Enabled=true},{Label='Encerrar',Enabled=true}}})
  end
 end)
 s.Busy=false
 if not ok then warn('[NPC] Operação interrompida: '..tostring(err));D.close(player)end
 return ok
end
function D.start(view,action)
 D.View=view;action.OnServerEvent:Connect(D.handle)
 Players.PlayerRemoving:Connect(function(p)D.Sessions[p]=nil;D.Limits[p]=nil end)
end
return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">NPCActionService</string>
          <string name="Source"><![CDATA[local Shared=game.ReplicatedStorage.EldravynNPC
local C=require(Shared.Registry)
local R=require(Shared.Rules)
local Data=require(script.Parent.NPCDataService)
local Purchase=require(script.Parent.PurchaseService)
local A={Locations={},NPCs={},DungeonAdapter=nil}
local function sorted(t)local keys={};for key in t do table.insert(keys,key)end;table.sort(keys);return keys end
local function objective(event)
 local kind,id=event:match('^([^:]+):(.+)$')
 if kind=='Talk' then return 'Conversar com '..(C.Roles[id] and C.Roles[id].Title or id)
 elseif kind=='Visit' then return 'Visitar '..id
 elseif kind=='Combat' then return 'Derrotar '..(if id=='Bandit' then 'bandidos' else id)..' (combate futuro)'end
 return 'Objetivo de exploração'
end
local function money(s)return 'Moedas: '..s.Gold..' | Banco: '..s.NPC.Bank end
function A.menu(player,npc,page)
 local s=Data.get(player);if not s then return {Text='Perfil indisponível. Nenhuma operação será realizada.',Options={}} end
 local role=npc:GetAttribute('NPCRole');local words=C.Dialogue[role] or C.Dialogue.Ambient
 local result={Text=words.Greeting..'\n'..money(s),Options={}}
 local function text(v)result.Text=v..'\n'..money(s)end
 local function option(label,command,value,extra,enabled)
  table.insert(result.Options,{Label=label,Command=command,Value=value,Extra=extra,Enabled=enabled~=false})
 end
 local function menu(label,target)option(label,'Page',target)end
 local function doAction(label,command,value,extra,enabled)option(label,command,value,extra,enabled)end
 page=page or 'Root'
 if page=='Lore' then
  local lines=C.Dialogue.AmbientLines[role]
  text(words.Lore..(if lines then '\n'..table.concat(lines,'\n') else ''))
 elseif page=='History' and role=='GuildMaster' then
  local rows={'Rank: '..(if s.Rank=='' then 'não registrado' else s.Rank)}
  for _,h in s.NPC.History do table.insert(rows,h.Text..' • '..os.date('!%d/%m/%Y',h.At)) end;text(table.concat(rows,'\n'))
 elseif page=='Ranks' and role=='GuildMaster' then
  local rows={};for _,rank in C.Ranks do local q=C.RankRequirements[rank];table.insert(rows,rank..': '..q.XP..' XP, '..q.Quests..' contratos • '..q.Benefit)end
  text('Atual: '..s.Rank..' | XP: '..s.XP..' | contratos: '..s.NPC.Completed..'\n'..table.concat(rows,'\n'))
  doAction('Solicitar próxima promoção','Promote')
 elseif page:sub(1,7)=='Quests:' and role=='Reception' then
  local rank=page:sub(8);text('Contratos de rank '..rank)
  for _,id in sorted(C.Quests) do local q=C.Quests[id]
   if q.Rank==rank and not q.Ticket and (not q.SecretRegion or s.NPC.Discovered[q.SecretRegion]) then menu(q.Name,'Quest:'..id)end
  end
 elseif page:sub(1,6)=='Quest:' and (role=='Reception' or role=='Dungeon') then
  local id=page:sub(7);local q=C.Quests[id]
  if not q or q.Ticket and role=='Dungeon' and C.Dungeon.Tickets[q.Ticket].Dungeon~=npc:GetAttribute('DungeonId') then text('Contrato indisponível.')
  elseif q.SecretRegion and not s.NPC.Discovered[q.SecretRegion] then text('Contrato ainda não descoberto.')
  else
   local state=s.NPC.Quests[id];local rows={q.Name,q.Description,'Rank '..q.Rank..' | '..q.Gold..' moedas | '..q.XP..' XP'}
   for i,o in q.Objectives do table.insert(rows,objective(o.Event)..' • '..(state and state.Counts[i] or 0)..'/'..o.Need)end
   if q.Ticket then table.insert(rows,'Recompensa: 1 ticket '..C.Dungeon.Tickets[q.Ticket].Name..'. Repetição após 24h.')end
   if q.FutureCombat then table.insert(rows,'Combate futuro: só eventos de adaptador autorizado no servidor podem avançar.')end
   if state and state.LastClaim then table.insert(rows,'Última entrega: '..os.date('!%d/%m %H:%M UTC',state.LastClaim))end
   text(table.concat(rows,'\n'));doAction('Aceitar contrato','Accept',id)
   if state and state.Status=='Active' then doAction('Abandonar contrato','Abandon',id);doAction('Entregar contrato','Claim',id)end
  end
 elseif page=='Shop' and C.Shops[role] then
  text('Catálogo • '..C.Roles[role].Title..'\nCompras ficam registradas; consumíveis não produzem efeitos nesta etapa.')
  for _,id in C.Shops[role] do local item=C.Items[id]
   menu(item.Name..' • '..item.Price..' moedas • '..item.Rarity,'Item:'..id)
  end
 elseif page:sub(1,5)=='Item:' and C.Shops[role] then
  local id=page:sub(6);local item=C.Items[id]
  if item and table.find(C.Shops[role],id) then
   text(item.Name..' • '..item.Rarity..'\nRank '..item.MinRank..' | propriedade: '..(s.Inventory[id] or 0)..'\n'..(item.Note or 'Registro de propriedade; sem equipar ou atacar.'))
   doAction('Comprar por '..item.Price..' moedas','Buy',id,role)
   doAction('Vender por '..item.Sell..' moedas','Sell',id,role)
  else text('Item indisponível.')end
 elseif page=='Upgrades' and role=='Blacksmith' then
  text('Melhorias registradas, sem alterar dano ou defesa nesta etapa.')
  for _,id in sorted(C.Items) do local cost=R.upgradeCost(s,C,id)
   if cost then doAction(C.Items[id].Name..' +'..cost.Level..' → +'..(cost.Level+1)..' • '..cost.Gold..' moedas + '..cost.Ore..' minérios','Upgrade',id)
   elseif (s.NPC.Upgrades[id] or 0)>=C.Upgrade.Max then doAction(C.Items[id].Name..' +'..s.NPC.Upgrades[id]..' • nível máximo','Upgrade',id,nil,false)end
  end
 elseif page=='Bank' and role=='Bank' then
  text('Depósitos e saques são persistidos na mesma transação.')
  for _,amount in {10,50,100,500} do
   doAction('Depositar '..amount..' moedas','Deposit',amount,nil,s.Gold>=amount)
   doAction('Sacar '..amount..' moedas','Withdraw',amount,nil,s.NPC.Bank>=amount)
  end
  if s.Gold>0 then doAction('Depositar saldo: '..s.Gold,'Deposit',s.Gold)end
  if s.NPC.Bank>0 then doAction('Sacar saldo: '..s.NPC.Bank,'Withdraw',s.NPC.Bank)end
 elseif page=='Classes' and role=='Classes' then
  text('Classe atual: '..(if s.Class=='' then 'não escolhida' else s.Class)..'\nCréditos de troca: '..s.NPC.ClassCredits)
  for _,id in {'Guerreiro','Espadachim','Mago'} do
   doAction(id..': '..C.Classes[id].Text,'Choose',id,nil,s.Class=='' or s.NPC.ClassCredits>0)
  end
  doAction('Comprar crédito de troca • 100 Robux','ClassPurchase',nil,nil,Purchase.available('NPCClassChange'))
  if not Purchase.available('NPCClassChange') then result.Text..='\nCompra desativada: configure o produto oficial de 100 Robux e persistência.'end
  for _,id in sorted(C.Advanced) do local e=C.Advanced[id]
   doAction(e.Base..' → '..id..' • Rank '..e.Rank..' + '..(if e.Secret and not s.NPC.Discovered.Vespera then 'contrato secreto ainda não descoberto' else C.Quests[e.Quest].Name),'Evolve',id,nil,s.Class==e.Base and R.rank(s,C,e.Rank) and R.completed(s,e.Quest))
  end
 elseif page=='Magic' and role=='Magic' then
  text('Escolas de magia • registros de estudo, sem conjuração.')
  for _,id in sorted(C.Spells) do local m=C.Spells[id]
   doAction(m.Name..' ('..m.School..') • '..m.Text..' Rank '..m.Rank..(if m.Quest then ' + '..C.Quests[m.Quest].Name else '')..(if m.Price then ' • '..m.Price..' moedas' else '')..(if s.NPC.Magic[id] then ' • estudo registrado' else ''),'Magic',id,nil,m.RegistrationEnabled and not s.NPC.Magic[id] and R.rank(s,C,m.Rank) and R.completed(s,m.Quest))
  end
 elseif page=='Directions' and role=='Guide' then
  text('Escolha um destino existente. A marcação dura 45 segundos.')
  for _,id in sorted(A.Locations) do menu(A.Locations[id].Name,'Direction:'..id)end
 elseif page:sub(1,10)=='Direction:' and role=='Guide' then
  local id=page:sub(11);if A.Locations[id] then text(A.Locations[id].Name);option('Marcar destino','Mark',id)end
 elseif page:sub(1,7)=='Ticket:' and role=='Dungeon' then
  local key=page:sub(8);local t=C.Dungeon.Tickets[key];local d=t and C.Dungeon.Dungeons[t.Dungeon]
  if not t or t.Dungeon~=npc:GetAttribute('DungeonId') then text('Ticket indisponível.')
  else
   text(t.Name..'\nRank '..t.Rank..' | possui '..(s.NPC.Tickets[key] or 0)..' ticket(s)\n'..d.RewardPreview)
   menu('Missão para obter este ticket','Quest:'..t.Quest)
   doAction('Comprar ticket por '..t.Price..' moedas','TicketBuy',key)
   local enabled=A.DungeonAdapter~=nil and d.EntryEnabled and d.InteriorReady and d.PlaceId>0
   doAction('Solicitar entrada neste andar','Enter',key,nil,enabled)
   if not enabled then result.Text..='\nEntrada indisponível: interior/destino ainda não integrado. Tickets não serão consumidos.'end
  end
 elseif page=='Root' then
  if role=='GuildMaster' then doAction('Registrar aventureiro • rank F','Register',nil,nil,s.Rank=='');menu('Rank, requisitos e benefícios','Ranks');menu('Histórico de progressão','History')
  elseif role=='Reception' then for _,rank in C.Ranks do menu('Missões de rank '..rank,'Quests:'..rank)end
  elseif C.Shops[role] then menu('Comprar e vender','Shop')
  elseif role=='Blacksmith' then menu('Aprimorar equipamento','Upgrades')
  elseif role=='Bank' then menu('Saldo, depósito e saque','Bank')
  elseif role=='Classes' then menu('Escolha, evolução e troca de classe','Classes')
  elseif role=='Magic' then menu('Escolas e registros de estudo','Magic')
  elseif role=='Guide' then menu('Serviços e regiões','Directions')
  elseif role=='Dungeon' then
   local id=npc:GetAttribute('DungeonId');local d=C.Dungeon.Dungeons[id];text(d.Name..' • '..d.Floors..' andares\n'..words.Greeting)
   for floor=1,d.Floors do menu('Andar '..floor..' • ticket e contrato','Ticket:'..id..':'..floor)end
  elseif role=='Inn' then doAction('Hospedagem e ponto de retorno • '..C.InnPrice..' moedas','Inn')
  elseif role=='Healer' then
   local hum=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
   local compatible=hum and hum.Health>0 and hum.Health<hum.MaxHealth
   doAction('Curar • '..C.HealPrice..' moedas','Heal',nil,nil,compatible==true)
   if not compatible then result.Text..='\nCura indisponível: personagem sem ferimentos ou vida incompatível.'end
  elseif role=='Tutorial' then
   local lessons={'Fale comigo para começar.','Visite Maelis na guilda.','Consulte a recepcionista.','Peça uma indicação à guia.','Tutorial concluído; contratos e exploração estão disponíveis.'}
   result.Text..='\n'..lessons[math.clamp(s.NPC.Tutorial.Step+1,1,#lessons)]..'\n'..words.Lore
   doAction('Pular tutorial','Tutorial','Skip');doAction('Revisar tutorial','Tutorial','Review')
  elseif role=='Races' then
   local race=s.Identity.Race;local catalog=require(game.ReplicatedStorage.MedievalRPG.Config.IdentityConfig)
   result.Text..='\nRaça atual: '..(catalog.Races[race] and catalog.Races[race].Name or 'ainda não registrada')..'\nEvolução: '..(if s.Identity.Evolution=='' then 'nenhuma' else s.Identity.Evolution)
   for _,id in catalog.RaceOrder do local r=catalog.Races[id];result.Text..='\n'..r.Name..': '..r.Identity..' → '..r.Evolution end
   result.Text..='\nAlteração de raça e fusão indisponíveis nesta etapa.'
  elseif role=='Skills' then
   result.Text..='\n'..words.Lore..'\nPlanejado: técnicas por classe, domínio por uso e desafios específicos. Níveis/custos aguardam definição; nenhuma técnica pode ser comprada agora.'
  elseif role=='Fusions' then
   result.Text..='\n'..words.Lore..'\nPlanejado: combinações autorizadas de habilidades ou linhagens, missões e materiais específicos. Catálogo, resultados e custos desta integração aguardam definição; nenhuma combinação está ativa.' end
  menu('Conversar sobre a região','Lore')
 else text('Esta opção não pertence ao NPC.')end
 if page~='Root' then menu('Voltar','Root')end
 option('Encerrar conversa','Close')
 return result
end
function A.execute(player,npc,option)
 local cmd,v,extra=option.Command,option.Value,option.Extra
 if cmd=='ClassPurchase' then return Purchase.prompt(player,'NPCClassChange') end
 if cmd=='Enter' then
  local t=C.Dungeon.Tickets[v];local d=t and C.Dungeon.Dungeons[t.Dungeon]
  if not d or not A.DungeonAdapter or not d.EntryEnabled or not d.InteriorReady or d.PlaceId<=0 then return false,'Destino indisponível; nenhum ticket consumido.'end
  local valid,ready=pcall(A.DungeonAdapter.ValidateDestination,d,t.Floor)
  if not valid or not ready then return false,'Destino não validado; nenhum ticket consumido.'end
  local ok,msg=Data.change(player,function(s)return R.admit(s,C,v,os.time())end)
  if not ok then return ok,msg end
  local id=Data.get(player).NPC.Admission.Id
  local started,result=pcall(A.DungeonAdapter.Enter,player,d,t.Floor,id)
  if not started or not result then return Data.change(player,function(s)return R.refundAdmission(s,C,id)end)end
  return true,'Admissão registrada; o adaptador deve confirmar a chegada no servidor.'
 end
 local hum=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
 local ok,message=Data.change(player,function(s)
  local now=os.time()
  if cmd=='Register' then return R.register(s,C,now)
  elseif cmd=='Promote' then return R.promote(s,C,now)
  elseif cmd=='Accept' then return R.accept(s,C,v,now)
  elseif cmd=='Abandon' then return R.abandon(s,C,v)
  elseif cmd=='Claim' then return R.claim(s,C,v,now)
  elseif cmd=='Buy' then return R.buy(s,C,v,extra)
  elseif cmd=='Sell' then return R.sell(s,C,v,extra)
  elseif cmd=='Deposit' or cmd=='Withdraw' then return R.bank(s,C,cmd,v)
  elseif cmd=='Upgrade' then return R.upgrade(s,C,v)
  elseif cmd=='TicketBuy' then return R.ticket(s,C,v)
  elseif cmd=='Choose' then return R.choose(s,C,v,now)
  elseif cmd=='Evolve' then return R.evolve(s,C,v,now)
  elseif cmd=='Magic' then return R.magic(s,C,v)
  elseif cmd=='Tutorial' then return R.tutorial(s,C,v)
  elseif cmd=='Inn' then return R.inn(s,C,npc:GetAttribute('EldravynNPCId'),npc:GetAttribute('City'),now)
  elseif cmd=='Heal' then
   if not hum or hum.Parent~=player.Character or hum.Health<=0 or hum.Health>=hum.MaxHealth or s.Gold<C.HealPrice or s.NPC.PendingHeal then return false,'Vida incompatível, cura desnecessária ou moedas insuficientes.'end
   s.Gold-=C.HealPrice;s.NPC.PendingHeal=C.HealPrice;return true,'Serviço de cura registrado.'
  end
  return false,'Operação inválida.'
 end)
 if ok and cmd=='Heal' then
  local healed=hum and hum.Parent==player.Character and hum.Health>0
  if healed then hum.Health=hum.MaxHealth end
  local settled=Data.change(player,function(s)
   if not s.NPC.PendingHeal then return false end
   if not healed then s.Gold+=s.NPC.PendingHeal end;s.NPC.PendingHeal=nil;return true
  end)
  if not settled then return false,'Confirmação pendente; o serviço será conciliado na próxima conexão.'end
 end
 return ok,message
end
return A
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">NPCDataService</string>
          <string name="Source"><![CDATA[-- Single existing DataStore and session owner; no second economy/profile writer.
local Shared=game.ReplicatedStorage.EldravynNPC
local C=require(Shared.Registry)
local Legacy=require(game.ReplicatedStorage.MedievalRPG.Config.ContentConfig)
-- Register ownership-only catalogue extension in an older Studio copy, without rewriting its scripts.
Legacy.Items.TravelRelic=Legacy.Items.TravelRelic or {Name=C.Items.TravelRelic.Name,Price=250,Kind='Material',Rarity='Rare'}
local Data=require(script.Parent.DataService)
local Rules=require(Shared.Rules)
local Service={Persistent=Data.Persistent}
Service.get=Data.get;Service.load=Data.load;Service.remove=Data.remove;Service.start=Data.start
function Service.change(player,fn)
 return Data.transaction(player,function(s)
  local ok,message=fn(s)
  if ok then s.Revision+=1 end
  return ok,message
 end)
end
function Service.event(player,event,source)
 local current=Data.get(player);if not current then return false end
 -- Avoid a DataStore write when no objective, discovery or tutorial step changes.
 local Http=game:GetService('HttpService');local probe=Http:JSONDecode(Http:JSONEncode(current))
 if not Rules.event(probe,C,event,source) then return false end
 return Service.change(player,function(s)return Rules.event(s,C,event,source),'Progresso registrado.'end)
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">NPCService</string>
          <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Shared=game.ReplicatedStorage:WaitForChild('EldravynNPC')
local C=require(Shared.Registry)
local Data=require(script.Parent.NPCDataService)
local Actions=require(script.Parent.NPCActionService)
local Dialogue=require(script.Parent.DialogueService)
local Purchase=require(script.Parent.PurchaseService)
local Placement=require(script.Parent.Placement)
local Service={Started=false}
local function remote(parent,name)
 local value=parent:FindFirstChild(name)
 if not value then value=Instance.new('RemoteEvent');value.Name=name;value.Parent=parent end
 assert(value:IsA('RemoteEvent'));return value
end
function Service.start()
 if Service.Started then return end
 local world=workspace:FindFirstChild('GeneratedWorld');local folder=workspace:FindFirstChild('EldravynNPCs')
 assert(world and folder,'Instale os NPCs no mapa antes de iniciar.')
 if world:GetAttribute('TerrainPending')==true then warn('[NPC] Terrain pendente. Use PrepareStudio em Edit antes de testar. Nenhum terreno será gerado no runtime.');return end
 Service.Started=true
 local remotes=Shared:FindFirstChild('RemoteEvents') or Instance.new('Folder');remotes.Name='RemoteEvents';remotes.Parent=Shared
 local view,action=remote(remotes,'View'),remote(remotes,'Action');Dialogue.start(view,action)
 for _,npc in folder:GetDescendants()do
  local id=npc:GetAttribute('EldravynNPCId')
  if npc:IsA('Model') and id then
   assert(not Actions.NPCs[id],'NPC duplicado: '..id);Actions.NPCs[id]=npc
   local root=npc:FindFirstChild('HumanoidRootPart');local prompt=npc:FindFirstChild('NPCInteraction',true)
   local entry=require(Shared.PlacementConfig).NPCs[id]
   local frame=entry and Placement.frame(world,entry,folder,true)
   if root and prompt and frame then
    npc:PivotTo(frame*CFrame.new(0,3,0));prompt.Enabled=true
    prompt.Triggered:Connect(function(player)Dialogue.open(player,npc)end)
    if not npc:GetAttribute('AmbientNPC') then Actions.Locations[id]={Name=C.Roles[npc:GetAttribute('NPCRole')].Title..' • '..npc:GetAttribute('City'),Position=frame.Position}end
   else
    if prompt then prompt.Enabled=false end
    warn('[NPC] Posição não validada; interação desativada: '..id)
   end
  end
 end
 local regions={}
 for id,entry in require(Shared.PlacementConfig).Regions do
  local anchor=Placement.resolve(world,entry.Anchor)
  if anchor and anchor:IsA('BasePart') then
   local record={Name=entry.Name,Position=anchor.Position,Radius=entry.Radius}
   regions[id]=record;Actions.Locations[id]=record
  end
 end
 Purchase.registerProduct('NPCClassChange',C.ClassChangeProduct,require(Shared.Rules).classReceipt)
 Purchase.OnGrant=function(p)Dialogue.close(p);view:FireClient(p,{Notice='Crédito oficial registrado. Converse novamente com o mestre de classes.'})end
 Purchase.start();Data.start()
 require(script.Parent.AmbientService).start(Actions.NPCs,folder)
 local function onCharacter(player,character)
  local root=character:WaitForChild('HumanoidRootPart',10);if not root then return end
  local state=Data.get(player);local id=state and state.NPC.ReturnNPC;local npc=id and Actions.NPCs[id]
  if not npc or not npc.PrimaryPart then return end
  -- Return beside the inn only if a fresh floor/clearance query succeeds.
  local position=npc.PrimaryPart.Position+npc.PrimaryPart.CFrame.LookVector*5-Vector3.new(0,3,0)
  local safe=Placement.safe(position,{folder,character},position.Y)
  if safe then root.CFrame=CFrame.new(safe+Vector3.new(0,3,0))end
 end
 local function joined(player)
  local ok,message=Data.load(player)
  if player.Parent~=Players then return end
  if not ok then view:FireClient(player,{Notice=message});return end
  local state=Data.get(player)
  if state and state.NPC.PendingHeal then
   Data.change(player,function(s)s.Gold=math.min(C.MaxGold,s.Gold+s.NPC.PendingHeal);s.NPC.PendingHeal=nil;return true end)
  end
  player.CharacterAdded:Connect(function(character)onCharacter(player,character)end)
  if player.Character then onCharacter(player,player.Character)end
  view:FireClient(player,{Notice=if Data.Persistent then 'Perfil NPC carregado.' else 'Prévia Studio: progresso temporário, sem persistência ou compras Robux.'})
 end
 Players.PlayerAdded:Connect(joined);Players.PlayerRemoving:Connect(Data.remove)
 for _,player in Players:GetPlayers()do task.spawn(joined,player)end
 -- A single low-frequency scheduler. Only meaningful progress writes to the profile.
 task.spawn(function()
  local visits={}
  while Service.Started do
   task.wait(2)
   for _,player in Players:GetPlayers()do
    local character=player.Character;local root=character and character:FindFirstChild('HumanoidRootPart')
    local hum=character and character:FindFirstChildOfClass('Humanoid')
    if root and hum and hum.Health>0 and Data.get(player) then
     local previous=visits[player] or {};local current={}
     for id,region in regions do
      if (root.Position-region.Position).Magnitude<region.Radius then
       current[id]=true;if previous[id] then Data.event(player,'Visit:'..id,'Exploration')end
      end
     end
     visits[player]=current
    end
    local session=Dialogue.Sessions[player]
    if session and not session.Busy and (os.clock()>session.Expires or not Dialogue.near(player,session.NPC)) then Dialogue.close(player)end
   end
   for player in visits do if player.Parent~=Players then visits[player]=nil end end
  end
 end)
 print('[NPC] Etapa 2 iniciada. Combate, conjuração, fusões e interiores de dungeon permanecem fora desta etapa.')
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Placement</string>
          <string name="Source"><![CDATA[-- Read-only map queries. Never writes Terrain, moves buildings or guesses interiors.
local P={}
function P.resolve(world,path)
 local node=world;for segment in path:gmatch('[^/]+')do node=node and node:FindFirstChild(segment)end;return node
end
function P.safe(position,ignore,expectedY)
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=ignore;params.IgnoreWater=false;params.RespectCanCollide=true
 local hit=workspace:Raycast(position+Vector3.new(0,12,0),Vector3.new(0,-40,0),params)
 if not hit or hit.Material==Enum.Material.Water or (hit.Normal and hit.Normal.Y<0.85) or math.abs(hit.Position.Y-expectedY)>6 then return nil end
 local feet=hit.Position+Vector3.new(0,0.12,0)
 local box=OverlapParams.new();box.FilterType=Enum.RaycastFilterType.Exclude;local ignored=table.clone(ignore);table.insert(ignored,workspace.Terrain);box.FilterDescendantsInstances=ignored;box.RespectCanCollide=true
 for _,part in workspace:GetPartBoundsInBox(CFrame.new(feet+Vector3.new(0,3.7,0)),Vector3.new(4.8,7,4.8),box)do
  if part.CanCollide then return nil end
 end
 return feet
end
function P.frame(world,entry,npcs,strict)
 local anchor=P.resolve(world,entry.Anchor)
 if not anchor or not anchor:IsA('BasePart') then return nil,'Âncora ausente: '..entry.Anchor end
 local offset=Vector3.new(table.unpack(entry.Offset));local position=anchor.CFrame:PointToWorldSpace(offset)
 if strict then
  local safe=P.safe(position,{npcs},position.Y);if not safe then return nil,'Piso/obstáculo incompatível: '..entry.Id end;position=safe
 end
 local look=anchor.CFrame.LookVector
 return CFrame.lookAt(position,position+Vector3.new(look.X,0,look.Z))
end
return P
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">PurchaseService</string>
          <string name="Source"><![CDATA[-- Único ProcessReceipt da Experience. Ambos os Places usam o mesmo perfil/ledger.
local Market=game:GetService('MarketplaceService')
local Players=game:GetService('Players')
local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.IdentityConfig)
local Rules=require(Shared.Core.IdentityRules)
local Data=require(script.Parent.DataService)
local Purchase={OnGrant=nil,OnPending=nil}
local extensions={}
function Purchase.registerProduct(key,product,grant)
 assert(not extensions[key] and not Config.Products[key] and type(grant)=='function','Produto duplicado/inválido')
 for _,p in Config.Products do assert(product.Id==0 or p.Id~=product.Id,'ID oficial já usado') end
 for _,e in extensions do assert(product.Id==0 or e.Product.Id~=product.Id,'ID oficial já registrado') end
 extensions[key]={Product=product,Grant=grant}
end
local function product(key)return extensions[key] and extensions[key].Product or Config.Products[key]end
function Purchase.available(key)
 local p=product(key)
 return p~=nil and p.Id>0 and Data.Persistent and (extensions[key]~=nil or key=='RacialRetry' or next(Config.Fusion.Recipes)~=nil)
end
function Purchase.prompt(player,key)
 local profile=Data.get(player);local p=product(key)
 if not profile or not Purchase.available(key) then return false,'Compra desativada: produto real e catálogo devem estar configurados.' end
 if key=='RacialRetry' then
  Rules.refresh(profile,Config,os.time())
  if profile.Identity.Racial.Status~='Failed' or os.time()>=profile.Identity.Racial.ReadyAt or profile.Identity.RetryCredits>0 then return false,'Nova tentativa paga não é necessária.' end
 end
 local receiptCount=0;for _ in profile.Identity.Receipts do receiptCount+=1 end
 if receiptCount>=1024 then return false,'Novas compras pausadas; o histórico precisa de manutenção segura.' end
 local ok,info=pcall(function() return Market:GetProductInfoAsync(p.Id,Enum.InfoType.Product) end)
 if not ok or not info.IsForSale or info.PriceInRobux~=p.Robux then return false,'Produto/preço oficial não corresponde à configuração. Nenhuma compra aberta.' end
 local prompted=pcall(function() Market:PromptProductPurchase(player,p.Id) end)
 return prompted,if prompted then 'Confirme somente na janela oficial Roblox.' else 'Não foi possível abrir a compra.'
end
function Purchase.process(receipt)
 local pending=Enum.ProductPurchaseDecision.NotProcessedYet
 if type(receipt)~='table' or type(receipt.PurchaseId)~='string' or #receipt.PurchaseId<1 or #receipt.PurchaseId>200 then return pending end
 local known=false
 for _,p in Config.Products do if p.Id>0 and p.Id==receipt.ProductId then known=true end end
 local extension
 for _,e in extensions do if e.Product.Id>0 and e.Product.Id==receipt.ProductId then known=true;extension=e end end
 if not known then return pending end
 local player=Players:GetPlayerByUserId(receipt.PlayerId)
 if not player then return pending end
 local granted
 if extension then
    if not Data.Persistent then return pending end
    granted=Data.changeIdentity(player,function(state)
        if state.Identity.Receipts[receipt.PurchaseId] then return true end
        return extension.Grant(state,receipt.PurchaseId)
    end)
 else granted=Data.receipt(player,receipt.PurchaseId,receipt.ProductId) end
 if not granted then
    if Purchase.OnPending then Purchase.OnPending(player) end
    return pending
 end
 if Purchase.OnGrant then Purchase.OnGrant(player) end
 return Enum.ProductPurchaseDecision.PurchaseGranted
end
function Purchase.start()
 Rules.validate(Config)
 Market.ProcessReceipt=Purchase.process
end
return Purchase
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[-- Only trusted server code can invoke this adapter; no RemoteEvent exposes it.
local Data=require(script.Parent.NPCDataService)
local C=require(game.ReplicatedStorage.EldravynNPC.Registry)
local R=require(game.ReplicatedStorage.EldravynNPC.Rules)
local Q={CombatEnabled=false}
function Q.combatEvent(player,event,eventId)
 if not Q.CombatEnabled or type(event)~='string' or event:sub(1,7)~='Combat:' or type(eventId)~='string' or #eventId<1 or #eventId>100 then return false end
 local known=false;for _,q in C.Quests do for _,o in q.Objectives do if o.Event==event then known=true end end end
 if not known then return false end
 return Data.change(player,function(s)
  local ledger=s.NPC.CombatEvents or {};if ledger[eventId] then return false end
  local count=0;for _ in ledger do count+=1 end;if count>=1024 then return false,'Adaptador exige rotação segura do histórico.'end
  if not R.event(s,C,event,'CombatAdapter') then return false end
  ledger[eventId]=true;s.NPC.CombatEvents=ledger;return true,'Evento de combate registrado.'
 end)
end
return Q
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="19">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">DialogueConfig</string>
          <string name="Source"><![CDATA[return {
 GuildMaster={Greeting='A guilda reconhece jornadas honestas. Posso registrar sua entrada ou avaliar uma promoção.',Lore='Nossos registros preservam cada promoção; nenhum rank é vendido.'},
 Reception={Greeting='Os contratos de exploração estão abertos. Aceite um antes de visitar seus objetivos.',Lore='Cada recompensa é entregue uma vez por conclusão. Contratos de tickets podem ser repetidos após 24 horas.'},
 Dungeon={Greeting='Cada andar exige seu próprio ticket. Obtenha-o por contrato ou por moedas.',Lore='As duas dungeons possuem 10 e 20 andares. O acesso permanece fechado enquanto não houver destino e integração confirmados.'},
 Blacksmith={Greeting='Trago as ferramentas; você traz minério e moedas. Confira o custo antes de melhorar uma peça.',Lore='A melhoria fica registrada na propriedade. Não adiciona ataques ou cálculo de dano nesta etapa.'},
 Weapons={Greeting='Escolha uma arma para registrar como sua. O preço está no catálogo.',Lore='As armas são propriedades persistentes; ataques serão integrados posteriormente.'},
 Armor={Greeting='Uma boa couraça começa com um trabalho cuidadoso.',Lore='Raridade e melhorias ficam registradas. O cálculo de defesa pertence a outra etapa.'},
 General={Greeting='Provisões e minério para a jornada. Confira seu saldo antes de comprar.',Lore='Poções ficam armazenadas; não simulamos efeitos de sistemas futuros.'},
 Classes={Greeting='Sua vocação começa com uma escolha. Conheça as três classes iniciais.',Lore='As evoluções exigem rank e contratos. Trocas pagas só concedem crédito após recibo oficial.'},
 Magic={Greeting='Aprender as escolas vem antes de conjurar. Posso registrar estudos autorizados.',Lore='Luz, fogo e outras escolas aguardam suas técnicas. Não há conjuração nesta etapa.'},
 Skills={Greeting='Disciplina precede domínio. As técnicas terão requisitos próprios.',Lore='A evolução de habilidades está planejada; não existe árvore de habilidades ativa nesta etapa.'},
 Races={Greeting='Cada povo guarda uma história. Posso consultar sua linhagem já registrada.',Lore='Humanos, elfos, elfos negros, demônios e anjos possuem identidades próprias. Não sorteio nem altero raças.'},
 Fusions={Greeting='Unir legados exige conhecimento que ainda está sendo estudado.',Lore='Fusões de raças e habilidades estão indisponíveis. Nenhum recurso será cobrado por elas.'},
 Inn={Greeting='A lareira está acesa. Uma hospedagem registra esta cidade como local de descanso.',Lore='Seu ponto de retorno usa um destino existente e seguro, validado no servidor.'},
 Healer={Greeting='Posso tratar feridas quando houver um sistema de vida compatível.',Lore='Sem personagem vivo ou sem necessidade de cura, não há cobrança.'},
 Bank={Greeting='Seu dinheiro pode descansar no cofre. Confira os valores antes de confirmar.',Lore='Depósitos e saques movem moedas no mesmo registro persistente.'},
 Guide={Greeting='O continente é grande. Posso marcar um serviço ou região que realmente existe.',Lore='Siga as estradas para as cidades e procure os marcos das clareiras nas florestas.'},
 Tutorial={Greeting='Bem-vindo a Eldravyn. Vamos conhecer movimento, interação e a guilda.',Lore='PC: WASD e espaço; celular: direcional e salto. Use E ou toque no botão próximo de um NPC. Moedas pagam serviços; ranks abrem contratos.'},
 TravelShop={Greeting='Minha caravana trouxe peças escolhidas para esta temporada.',Lore='O catálogo é configurável e estável; não existem eventos aleatórios de venda nesta etapa.'},
 Ambient={Greeting='Que sua viagem seja tranquila. Esta cidade vive do trabalho de muita gente.',Lore='As muralhas protegem nossos mercados. Procure a guia para encontrar serviços.'},
 AmbientLines={Guard={'Os portões devem permanecer livres.','As torres vigiam as estradas, não os viajantes.'},Resident={'As casas têm nomes; sempre encontramos o caminho de volta.','Ouça os sinos ao entardecer.'},Traveler={'A ponte levou minha caravana até aqui.','As florestas merecem respeito.'},Artisan={'Uma boa peça precisa de paciência.','A madeira das vigas conta a idade desta oficina.'},Employee={'O comerciante atende logo adiante.','Conferimos cada pedido antes da entrega.'},Adventurer={'Todo rank S começou como F.','A recepcionista conhece os contratos de exploração.'},Farmer={'O vento traz notícias antes das caravanas.','A cidade também depende do campo.'}}}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">DungeonTicketConfig</string>
          <string name="Source"><![CDATA[-- Every floor has a distinct ticket and contract. No destination is invented.
local C={Order={'MalgorthDepths','FallenSanctum'},Dungeons={
 MalgorthDepths={Name='Abismo de Malgorth',Floors=10,Rank='F',PlaceId=0,EntryEnabled=false,InteriorReady=false,RewardPreview='Recompensas serão validadas pela futura integração da dungeon.'},
 FallenSanctum={Name='Santuário do Reino Caído',Floors=20,Rank='E',PlaceId=0,EntryEnabled=false,InteriorReady=false,RewardPreview='Recompensas serão validadas pela futura integração da dungeon.'}},Tickets={}}
for _,id in C.Order do
 local d=C.Dungeons[id]
 for floor=1,d.Floors do
  local key=id..':'..floor
  local rank=if floor>15 then 'B' elseif floor>10 then 'C' elseif floor>5 then 'D' else d.Rank
  C.Tickets[key]={Dungeon=id,Floor=floor,Name=d.Name..' • andar '..floor,Price=40+floor*15,Rank=rank,Quest='Ticket:'..key}
 end
end
return C
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">NPCConfig</string>
          <string name="Source"><![CDATA[-- Stage 2 is opt-in. No combat, racial roll or general inventory is started.
local C={Version=1,MaxGold=1000000000,MaxStack=99,PromptDistance=12,SessionSeconds=90,
 ClassChangeProduct={Id=0,Robux=100},InnPrice=15,HealPrice=10,
 Ranks={'F','E','D','C','B','A','S'},
 RankRequirements={F={XP=0,Quests=0,Benefit='Registro e missões iniciais'},E={XP=100,Quests=2,Benefit='Novos contratos e estudos de classe'},D={XP=260,Quests=4,Benefit='Contratos das fronteiras'},C={XP=600,Quests=8,Benefit='Autorizações intermediárias de dungeon'},B={XP=1200,Quests=12,Benefit='Contratos veteranos'},A={XP=2400,Quests=18,Benefit='Contratos de elite'},S={XP=4800,Quests=28,Benefit='Reconhecimento máximo da guilda'}},
 Classes={Guerreiro={Text='Resistência e proteção; técnicas serão integradas depois.'},Espadachim={Text='Disciplina com lâminas; ataques pertencem à etapa de combate.'},Mago={Text='Estudo arcano; conjuração será integrada depois.'},Arqueiro={Legacy=true,Text='Classe anterior preservada; seleção inicial destaca as três classes principais.'}},
 Advanced={Tanque={Base='Guerreiro',Rank='E',Quest='CityTour'},['Valquíria']={Base='Guerreiro',Rank='D',Quest='ForestSurvey'},Samurai={Base='Espadachim',Rank='E',Quest='CityTour'},Assassino={Base='Espadachim',Rank='D',Quest='ShadowDiscovery'},Invocador={Base='Mago',Rank='E',Quest='RuneStudy'},Necromante={Base='Mago',Rank='D',Quest='ShadowDiscovery',Secret=true}},
 Spells={LuzGuia={Name='Luz-guia',School='Luz',Rank='E',Quest='RuneStudy',Price=20,RegistrationEnabled=true,Text='Registro de estudo disponível; conjuração em atualização futura.'},Chama={Name='Chama',School='Fogo',Rank='D',RegistrationEnabled=false,Text='Catálogo futuro; desbloqueio e conjuração indisponíveis.'}},
 Roles={},Definitions={},AmbientRoles={'Guard','Resident','Traveler','Artisan','Employee','Adventurer','Farmer'}}
local roles={
 GuildMaster={'Maelis','Mestre da Guilda','GuildHall'},Reception={'Iria','Recepcionista da Guilda','GuildHall'},
 Blacksmith={'Borin','Ferreiro','Blacksmith'},Weapons={'Aren','Comerciante de Armas','WeaponShop'},Armor={'Helga','Comerciante de Armaduras','Workshop'},General={'Nilo','Comerciante Geral','Market'},
 Classes={'Kael','Mestre de Classes','TrainingHall'},Magic={'Seren','Mestre de Magia','MagicShop'},Skills={'Darian','Mentor de Habilidades','TrainingHall'},Races={'Liora','Especialista em Raças','Temple'},Fusions={'Orin','Especialista em Fusões','Workshop'},
 Inn={'Mira','Estalajadeira','Tavern'},Healer={'Elian','Curandeiro','Temple'},Bank={'Cedric','Banqueiro','Market'},Guide={'Nara','Guia da Cidade','Stable'},Tutorial={'Theo','Guia de Novos Aventureiros','Spawn'},TravelShop={'Veyra','Mercadora Viajante','Market'},
 Dungeon={'Selwyn','Administrador de Dungeon','Dungeon'},
 Guard={'Sentinela','Guarda','Castle'},Resident={'Morador','Morador','SmallHouse'},Traveler={'Viajante','Viajante','Stable'},Artisan={'Artesão','Artesão','Workshop'},Employee={'Assistente','Funcionário de loja','Market'},Adventurer={'Aventureiro','Aventureiro','TrainingHall'},Farmer={'Camponês','Camponês','Barn'}}
for id,r in roles do C.Roles[id]={Name=r[1],Title=r[2],Template=r[3]} end
for _,role in {'GuildMaster','Reception','Blacksmith','Weapons','Armor','General','Classes','Magic','Skills','Races','Fusions','Inn','Healer','Bank','Guide','Tutorial','TravelShop'} do
 table.insert(C.Definitions,{Id='Valoria_'..role,Role=role,City='Valoria'})
end
for _,city in {'Arkheim','Eldoria','Durakh','Asterion'} do
 for _,role in {'Guide','General','Inn'} do table.insert(C.Definitions,{Id=city..'_'..role,Role=role,City=city}) end
end
for _,city in {'Valoria','Arkheim','Eldoria','Durakh','Asterion'} do
 for i,role in C.AmbientRoles do table.insert(C.Definitions,{Id=city..'_Ambient_'..role,Role=role,City=city,Ambient=true,Variant=i}) end
end
for _,id in {'MalgorthDepths','FallenSanctum'} do table.insert(C.Definitions,{Id=id..'_Administrator',Role='Dungeon',City=id,Dungeon=id}) end
return C
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
