      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">EnemyAnimationClient</string>
          <string name="Source"><![CDATA[-- One bounded cosmetic scheduler. Never starts AI or sends combat intentions.
local Run=game:GetService('RunService')
local Players=game:GetService('Players')
local Collection=game:GetService('CollectionService')
local Animation=require(script.Parent.NPCAnimationController)
local Controller={Current=nil}
function Controller.start()
 if Controller.Current then return Controller.Current end
 local self={Entries={},Connections={},Selected={},Scan=0,Stopped=false};Controller.Current=self
 function self:remove(model)
  local e=self.Entries[model];if not e then return end
  e.Animation:destroy();for joint in e.Joints do if joint.Parent then joint.Transform=CFrame.new()end end
  if e.Blob and e.Blob.Parent then e.Blob.Size=e.BlobSize end
  self.Entries[model]=nil;self.Selected[model]=nil
 end
 function self:add(model)
  if self.Entries[model]or not model:IsA('Model')or model:GetAttribute('AvatarArtVersion')~=3 or not model:GetAttribute('AvatarEnemyKind')or not model.PrimaryPart then return end
  local h=model:FindFirstChildOfClass('Humanoid');local visuals=model:FindFirstChild('AvatarEnemyVisuals');if not h or not visuals then return end
  local e={Model=model,Root=model.PrimaryPart,Humanoid=h,Kind=model:GetAttribute('AvatarRigKind'),Animation=Animation.new(model),Joints={},Last=model.PrimaryPart.Position,Accum=0}
  for _,node in model:GetDescendants()do if node:IsA('Motor6D')and node.Name:match('^Avatar_')then e.Joints[node]=node.Name:sub(8)end end
  e.Blob=visuals:FindFirstChild('Avatar_Blob');if e.Blob then e.BlobSize=e.Blob.Size end
  self.Entries[model]=e
 end
 function self:scan()
  for model in self.Entries do if not model:IsDescendantOf(workspace)then self:remove(model)end end
  local player=Players.LocalPlayer;local root=player and player.Character and player.Character:FindFirstChild('HumanoidRootPart');local rows={}
  if root then for model,e in self.Entries do local d=(e.Root.Position-root.Position).Magnitude;if d<100 and e.Humanoid.Health>0 then table.insert(rows,{Model=model,Distance=d})end end end
  table.sort(rows,function(a,b)return a.Distance<b.Distance end)
  local nextSelection={};for i=1,math.min(10,#rows)do nextSelection[rows[i].Model]=true end
  for model in self.Selected do if not nextSelection[model]and self.Entries[model]then self.Entries[model].Animation:stop(true)end end
  self.Selected=nextSelection
 end
 function self:step(dt,now)
  if self.Stopped then return end;self.Scan+=dt;if self.Scan>=1 then self.Scan=0;self:scan()end
  for model in self.Selected do
   local e=self.Entries[model];if not e then continue end;e.Accum+=dt
   if e.Accum<.05 then e.Animation:afterAnimation();continue end
   local elapsed=e.Accum;e.Accum=0;local speed=(e.Root.Position-e.Last).Magnitude/math.max(elapsed,.001);e.Last=e.Root.Position
   if e.Humanoid.Health<=0 then e.Animation:stop(true);continue end
   local state=model:GetAttribute('State');local pose=if state=='WINDUP'then'Inspect'elseif state=='ATTACK'then'Forge'elseif speed>.3 then'Walk'else'Idle'
   if e.Kind=='R15'then e.Animation:update(pose,now,elapsed,0,nil,false)
   elseif e.Kind=='Quadruped'then
    for joint,bone in e.Joints do
     local sign=if bone=='FrontLeft'or bone=='HindRight'then 1 else-1
     local angle=if bone:find('Front')or bone:find('Hind')then math.sin(now*7)*.48*sign*(if speed>.3 then 1 else 0)elseif bone=='BeastHead'then math.sin(now*1.1)*.045 else math.sin(now*1.7)*.10
     joint.Transform=joint.Transform:Lerp(CFrame.Angles(angle,0,0),.3)
    end
   elseif e.Blob and e.Blob.Parent then local pulse=math.sin(now*4)*.055;e.Blob.Size=Vector3.new(e.BlobSize.X*(1-pulse/2),e.BlobSize.Y*(1+pulse),e.BlobSize.Z*(1-pulse/2))end
  end
 end
 function self:destroy()
  if self.Stopped then return end;self.Stopped=true;for _,c in self.Connections do c:Disconnect()end
  local list={};for model in self.Entries do table.insert(list,model)end;for _,model in list do self:remove(model)end;table.clear(self.Selected);Controller.Current=nil
 end
 table.insert(self.Connections,Run.PreAnimation:Connect(function()for model in self.Selected do local e=self.Entries[model];if e then e.Animation:beforeAnimation()end end end))
 table.insert(self.Connections,Run.PreSimulation:Connect(function(dt)self:step(dt,workspace:GetServerTimeNow())end))
 for _,model in Collection:GetTagged('EldravynAvatarEnemy')do self:add(model)end
 table.insert(self.Connections,Collection:GetInstanceAddedSignal('EldravynAvatarEnemy'):Connect(function(model)self:add(model)end))
 table.insert(self.Connections,Collection:GetInstanceRemovedSignal('EldravynAvatarEnemy'):Connect(function(model)self:remove(model)end))
 self:scan();return self
end
return Controller
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">NPCAnimationController</string>
          <string name="Source"><![CDATA[local Shared=game.ReplicatedStorage.EldravynNPCVisualV2
local Config=require(Shared.NPCVisualConfig)
local Motion=require(Shared.NPCMotion)
local Policy=require(Shared.NPCVisualPolicy)
local Animation={}
local function playable(hum)
 if not hum or hum.Health<=0 then return false end
 local state=hum:GetState()
 return state~=Enum.HumanoidStateType.Dead and state~=Enum.HumanoidStateType.Ragdoll and state~=Enum.HumanoidStateType.Seated and state~=Enum.HumanoidStateType.FallingDown
end
function Animation.new(npc)
 local hum=npc:FindFirstChildOfClass('Humanoid');local self={NPC=npc,Humanoid=hum,Animator=hum and hum:FindFirstChildOfClass('Animator'),Joints={},Tracks={},Failed={},Assets={},Connections={},NativeOffsets={},NativeAttention={},State=nil,Current=nil,Owns=false,Released=false,External=false,CheckAt=0}
 for _,node in npc:GetDescendants()do if node:IsA('Motor6D') then self.Joints[node.Name]=node end end
 return setmetatable(self,{__index=Animation})
end
-- Remove our previous additive offsets BEFORE Animator samples the next frame.
-- Tracks may omit Neck/Waist; without this, attention would accumulate on them.
function Animation:beforeAnimation()
 for joint,offset in self.NativeOffsets do
  if joint.Parent and joint.Transform==offset.Applied then joint.Transform=offset.Base end
 end
 table.clear(self.NativeOffsets)
end
function Animation:afterAnimation()
 if not self.Current or not self.Current.IsPlaying or self.Current.Length<=0 or not self.Owns or self.External or not playable(self.Humanoid) then return end
 self:beforeAnimation()
 -- Reapply only these two cached offsets even on frames between budgeted pose
 -- updates, otherwise PreAnimation removal would make native attention flicker.
 for joint,desired in self.NativeAttention do if joint.Parent then
  local base=joint.Transform;local applied=base*desired
  self.NativeOffsets[joint]={Base=base,Applied=applied};joint.Transform=applied
 end end
end
function Animation:stop(reset)
 self:beforeAnimation()
 table.clear(self.NativeAttention)
 if self.Current then self.Current:Stop(Config.FadeSeconds);self.Current=nil end
 if reset and self.Owns then for _,joint in self.Joints do if joint.Parent then joint.Transform=CFrame.new()end end end
 self.Owns=false;self.State=nil
end
function Animation:destroy()
 if self.Released then return end;self:stop(true);self.Released=true
 for _,connection in self.Connections do connection:Disconnect()end
 for _,track in self.Tracks do track:Destroy()end
 for _,asset in self.Assets do asset:Destroy()end
 table.clear(self.Joints);table.clear(self.Tracks);table.clear(self.Assets)
end
function Animation:track(state)
 local def=Config.Animations[state]
 if not def or not Policy.clipId(def.Id) or self.Failed[state] or not self.Animator then return nil end
 if self.Tracks[state] then return self.Tracks[state]end
 local asset=Instance.new('Animation');asset.AnimationId=def.Id;table.insert(self.Assets,asset)
 local ok,track=pcall(function()return self.Animator:LoadAnimation(asset)end)
 if not ok then self.Failed[state]=true;warn('[NPC V2] Animação indisponível; fallback procedural: '..state);return nil end
 track.Priority=Enum.AnimationPriority[def.Priority];track.Looped=def.Looped;self.Tracks[state]=track;return track
end
function Animation:update(state,now,dt,phase,attention,reduced)
 self:beforeAnimation()
 if self.Released or not self.NPC.Parent or not playable(self.Humanoid) then self:stop(true);return end
 if now>=self.CheckAt then
  self.CheckAt=now+1;self.External=false
  local animate=self.NPC:FindFirstChild('Animate')
  if animate and animate:IsA('BaseScript') and not animate.Disabled then self.External=true end
  if self.Animator then for _,track in self.Animator:GetPlayingAnimationTracks()do
   local ours=false;for _,own in self.Tracks do if own==track then ours=true;break end end
   if not ours then self.External=true;break end
  end end
 end
 if self.External then self:stop(false);return end
 if self.State~=state then
  if self.Current then self.Current:Stop(Config.FadeSeconds)end
  self.State=state;self.Current=self:track(state)
  if self.Current then self.Current:Play(Config.FadeSeconds,1,1)end
 end
 local native=self.Current and self.Current.IsPlaying and self.Current.Length>0
 table.clear(self.NativeAttention)
 local pose=if native then {} else Motion.pose(state,now,phase,reduced)
 local alpha=1-math.exp(-10*math.min(dt,.25))
 for name,joint in self.Joints do
  if not joint.Parent then continue end
  local angles=pose[name] or {0,0,0};local desired=CFrame.Angles(angles[1],angles[2],angles[3])
  if name=='Neck' and attention then desired*=CFrame.Angles(attention.Pitch,attention.Yaw,0)
  elseif name=='Waist' and attention then desired*=CFrame.Angles(0,attention.Torso,0)end
  if native then
   if name=='Neck' or name=='Waist' then
    self.NativeAttention[joint]=desired
   end
  else joint.Transform=joint.Transform:Lerp(desired,alpha)end
 end
 self.Owns=true;if native then self:afterAnimation()end
end
return Animation
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Model" referent="6">
      <Properties>
        <string name="Name">CoreV2</string>
        <bool name="NeedsPivotMigration">false</bool>
