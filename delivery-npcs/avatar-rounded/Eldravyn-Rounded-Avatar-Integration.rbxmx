        <Item class="Folder" referent="20">
          <Properties>
            <string name="Name">Replacements</string>
          </Properties>
          <Item class="ModuleScript" referent="21">
            <Properties>
              <string name="Name">AmbientService</string>
              <string name="Source"><![CDATA[-- Small, bounded patrols for ambient residents only. No pathfinding or combat AI.
local Players=game:GetService('Players')
local TweenService=game:GetService('TweenService')
local Placement=require(script.Parent.Placement)
local Ambient={}
local mobile={Resident=true,Traveler=true,Farmer=true,Adventurer=true}
function Ambient.start(npcs,folder)
 if workspace:GetAttribute('EldravynNPCVisualVersion')==2 then return require(script.Parent.NPCBehaviorController).start(npcs,folder)end
 local homes={};for _,npc in npcs do
  if npc:GetAttribute('AmbientNPC') and mobile[npc:GetAttribute('NPCRole')] and npc.PrimaryPart then homes[npc]={Frame=npc.PrimaryPart.CFrame,Away=false}end
 end
 task.spawn(function()
  while folder.Parent do
   task.wait(10);local active=0
   for npc,home in homes do
    if active>=4 then break end
    local root=npc.PrimaryPart;local nearby=false
    if not root or (npc:GetAttribute('NPCSpeakingUntil') or 0)>os.clock() then continue end
    for _,player in Players:GetPlayers()do local p=player.Character and player.Character:FindFirstChild('HumanoidRootPart');if p and (p.Position-root.Position).Magnitude<75 then nearby=true;break end end
    if not nearby then continue end
    local target=home.Frame*(if home.Away then CFrame.new() else CFrame.new(2.5,0,0))
    local delta=target.Position-root.Position;local valid=true;local feet
    for step=0,4 do
     local point=root.Position+delta*(step/4)-Vector3.new(0,3,0)
     feet=Placement.safe(point,{folder},point.Y)
     if not feet or math.abs(feet.Y-point.Y)>0.7 then valid=false;break end
    end
    for other in homes do if other~=npc and other.PrimaryPart and (other.PrimaryPart.Position-target.Position).Magnitude<6 then valid=false;break end end
    if valid and feet then
     active+=1;home.Away=not home.Away
     local destination=target+Vector3.new(0,feet.Y+3-target.Position.Y,0)
     TweenService:Create(root,TweenInfo.new(2,Enum.EasingStyle.Linear),{CFrame=destination}):Play()
    end
   end
  end
 end)
end
return Ambient
]]></string>
            </Properties>
          </Item>
          <Item class="LocalScript" referent="22">
            <Properties>
              <string name="Name">NPCInteractionClient</string>
              <bool name="Disabled">true</bool>
              <string name="Source"><![CDATA[local Players=game:GetService('Players')
local player=Players.LocalPlayer
local remotes=game.ReplicatedStorage:WaitForChild('EldravynNPC'):WaitForChild('RemoteEvents')
local ui=require(script.Parent.NPCDialogueClient).new(player:WaitForChild('PlayerGui'),remotes:WaitForChild('Action'))
local marker
remotes:WaitForChild('View').OnClientEvent:Connect(function(payload)
 ui:receive(payload)
 if payload.Marker then
  if marker then marker:Destroy()end
  marker=Instance.new('Part');marker.Name='NPCDestination';marker.Size=Vector3.new(0.5,0.5,0.5);marker.Transparency=1;marker.Anchored=true;marker.CanCollide=false;marker.CanTouch=false;marker.CanQuery=false;marker.Position=payload.Marker.Position+Vector3.new(0,10,0);marker.Parent=workspace
  local billboard=Instance.new('BillboardGui');billboard.Size=UDim2.fromOffset(240,64);billboard.AlwaysOnTop=true;billboard.Adornee=marker;billboard.Parent=marker
  local label=Instance.new('TextLabel');label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=0.2;label.BackgroundColor3=Color3.fromRGB(42,34,24);label.TextColor3=Color3.fromRGB(255,226,145);label.Font=Enum.Font.SourceSansBold;label.TextSize=18;label.TextWrapped=true;label.Text='◆ '..payload.Marker.Name;label.Parent=billboard
  local this=marker;task.delay(payload.Marker.Seconds,function()if this then this:Destroy()end;if marker==this then marker=nil end end)
 end
end)
game:GetService('UserInputService').InputBegan:Connect(function(input,processed)if not processed and input.KeyCode==Enum.KeyCode.Escape then ui:hide()end end)
-- V2 owns animation motors only; the existing dialogue, shop UI and marker above stay intact.
if workspace:GetAttribute('EldravynNPCVisualVersion')==2 then
 local manager=require(script.Parent.NPCPerformanceManager).start(workspace:WaitForChild('EldravynNPCs'),player,game:GetService('UserInputService').TouchEnabled)
 script.Destroying:Connect(function()manager:destroy()end)
 return
end
-- Bounded local idle poses; no external Animation IDs or server frame loop.
local joints={};local elapsed=0
local function refresh()
 joints={};local folder=workspace:FindFirstChild('EldravynNPCs');local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
 if not folder or not root then return end
 local nearest={}
 for _,npc in folder:GetDescendants()do if npc:IsA('Model') and npc:GetAttribute('EldravynNPCId') and npc.PrimaryPart then
  local distance=(npc.PrimaryPart.Position-root.Position).Magnitude;if distance<90 then table.insert(nearest,{NPC=npc,Distance=distance})end
 end end
 table.sort(nearest,function(a,b)return a.Distance<b.Distance end)
 for index=1,math.min(#nearest,12)do
  local npc=nearest[index].NPC;local torso=npc:FindFirstChild('UpperTorso');local neck=torso and torso:FindFirstChild('Neck')
  if neck then table.insert(joints,neck)end
 end
end
task.spawn(function()while true do refresh();task.wait(2)end end)
game:GetService('RunService').Heartbeat:Connect(function(dt)
 elapsed+=dt;for index,joint in joints do if joint.Parent then joint.Transform=CFrame.Angles(math.sin(elapsed*1.3+index)*0.025,math.sin(elapsed*0.8+index)*0.07,0)end end
end)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">NPCService</string>
              <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Shared=game.ReplicatedStorage:WaitForChild('EldravynNPC')
local C=require(Shared.Registry)
local Data=require(script.Parent.NPCDataService)
local Actions=require(script.Parent.NPCActionService)
local Dialogue=require(script.Parent.DialogueService)
local Purchase=require(script.Parent.PurchaseService)
local Placement=require(script.Parent.Placement)
local Service={Started=false}
local function remote(parent,name)
 local value=parent:FindFirstChild(name)
 if not value then value=Instance.new('RemoteEvent');value.Name=name;value.Parent=parent end
 assert(value:IsA('RemoteEvent'));return value
end
function Service.start()
 if Service.Started then return end
 local world=workspace:FindFirstChild('GeneratedWorld');local folder=workspace:FindFirstChild('EldravynNPCs')
 assert(world and folder,'Instale os NPCs no mapa antes de iniciar.')
 if world:GetAttribute('TerrainPending')==true then warn('[NPC] Terrain pendente. Use PrepareStudio em Edit antes de testar. Nenhum terreno será gerado no runtime.');return end
 Service.Started=true
 local remotes=Shared:FindFirstChild('RemoteEvents') or Instance.new('Folder');remotes.Name='RemoteEvents';remotes.Parent=Shared
 local view,action=remote(remotes,'View'),remote(remotes,'Action');Dialogue.start(view,action)
 for _,npc in folder:GetDescendants()do
  local id=npc:GetAttribute('EldravynNPCId')
  if npc:IsA('Model') and id then
   assert(not Actions.NPCs[id],'NPC duplicado: '..id);Actions.NPCs[id]=npc
   local root=npc:FindFirstChild('HumanoidRootPart');local prompt=npc:FindFirstChild('NPCInteraction',true)
   local entry=require(Shared.PlacementConfig).NPCs[id]
   local visualV2=workspace:GetAttribute('EldravynNPCVisualVersion')==2 and npc:GetAttribute('NPCVisualVersion')==2
   local frame=if visualV2 then require(script.Parent.NPCPositionAdapter).frame(npc,world,entry,folder,Placement) else entry and Placement.frame(world,entry,folder,true)
   if root and prompt and frame then
    if not visualV2 then npc:PivotTo(frame*CFrame.new(0,3,0))end;prompt.Enabled=true
    prompt.Triggered:Connect(function(player)Dialogue.open(player,npc)end)
    if not npc:GetAttribute('AmbientNPC') then Actions.Locations[id]={Name=C.Roles[npc:GetAttribute('NPCRole')].Title..' • '..npc:GetAttribute('City'),Position=frame.Position}end
   else
    if prompt then prompt.Enabled=false end
    warn('[NPC] Posição não validada; interação desativada: '..id)
   end
  end
 end
 local regions={}
 for id,entry in require(Shared.PlacementConfig).Regions do
  local anchor=Placement.resolve(world,entry.Anchor)
  if anchor and anchor:IsA('BasePart') then
   local record={Name=entry.Name,Position=anchor.Position,Radius=entry.Radius}
   regions[id]=record;Actions.Locations[id]=record
  end
 end
 Purchase.registerProduct('NPCClassChange',C.ClassChangeProduct,require(Shared.Rules).classReceipt)
 Purchase.OnGrant=function(p)Dialogue.close(p);view:FireClient(p,{Notice='Crédito oficial registrado. Converse novamente com o mestre de classes.'})end
 Purchase.start();Data.start()
 require(script.Parent.AmbientService).start(Actions.NPCs,folder)
 local function onCharacter(player,character)
  local root=character:WaitForChild('HumanoidRootPart',10);if not root then return end
  local state=Data.get(player);local id=state and state.NPC.ReturnNPC;local npc=id and Actions.NPCs[id]
  if not npc or not npc.PrimaryPart then return end
  -- Return beside the inn only if a fresh floor/clearance query succeeds.
  local position=npc.PrimaryPart.Position+npc.PrimaryPart.CFrame.LookVector*5-Vector3.new(0,3,0)
  local safe=Placement.safe(position,{folder,character},position.Y)
  if safe then root.CFrame=CFrame.new(safe+Vector3.new(0,3,0))end
 end
 local function joined(player)
  local ok,message=Data.load(player)
  if player.Parent~=Players then return end
  if not ok then view:FireClient(player,{Notice=message});return end
  local state=Data.get(player)
  if state and state.NPC.PendingHeal then
   Data.change(player,function(s)s.Gold=math.min(C.MaxGold,s.Gold+s.NPC.PendingHeal);s.NPC.PendingHeal=nil;return true end)
  end
  player.CharacterAdded:Connect(function(character)onCharacter(player,character)end)
  if player.Character then onCharacter(player,player.Character)end
  view:FireClient(player,{Notice=if Data.Persistent then 'Perfil NPC carregado.' else 'Prévia Studio: progresso temporário, sem persistência ou compras Robux.'})
 end
 Players.PlayerAdded:Connect(joined);Players.PlayerRemoving:Connect(Data.remove)
 for _,player in Players:GetPlayers()do task.spawn(joined,player)end
 -- A single low-frequency scheduler. Only meaningful progress writes to the profile.
 task.spawn(function()
  local visits={}
  while Service.Started do
   task.wait(2)
   for _,player in Players:GetPlayers()do
    local character=player.Character;local root=character and character:FindFirstChild('HumanoidRootPart')
    local hum=character and character:FindFirstChildOfClass('Humanoid')
    if root and hum and hum.Health>0 and Data.get(player) then
     local previous=visits[player] or {};local current={}
     for id,region in regions do
      if (root.Position-region.Position).Magnitude<region.Radius then
       current[id]=true;if previous[id] then Data.event(player,'Visit:'..id,'Exploration')end
      end
     end
     visits[player]=current
    end
    local session=Dialogue.Sessions[player]
    if session and not session.Busy and (os.clock()>session.Expires or not Dialogue.near(player,session.NPC)) then Dialogue.close(player)end
   end
   for player in visits do if player.Parent~=Players then visits[player]=nil end end
  end
 end)
 print('[NPC] Etapa 2 iniciada. Combate, conjuração, fusões e interiores de dungeon permanecem fora desta etapa.')
end
return Service
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="24">
          <Properties>
            <string name="Name">Server</string>
          </Properties>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">NPCBehaviorController</string>
              <string name="Source"><![CDATA[-- One authoritative cosmetic-behavior scheduler; never mutates data, quests or services.
local Players=game:GetService('Players')
local Run=game:GetService('RunService')
local Tween=game:GetService('TweenService')
local Shared=game.ReplicatedStorage.EldravynNPCVisualV2
local Config=require(Shared.NPCVisualConfig).Behavior
local Appearance=require(Shared.NPCAppearanceConfig)
local Behavior={Current=nil}
function Behavior.start(npcs,folder)
 if Behavior.Current and not Behavior.Current.Stopped then return Behavior.Current end
 local Placement=require(script.Parent.Placement);local Dialogue=require(script.Parent.DialogueService)
 local self={Entries={},Connections={},Stopped=false,Accum=0};Behavior.Current=self
 local function state(e,name)if e.State~=name then e.State=name;e.NPC:SetAttribute('NPCV2State',name)end end
 function self:cancel(e)
  if e.Tween then e.Tween:Cancel();e.Tween:Destroy();e.Tween=nil end;e.Moving=false
 end
 function self:speaker(e,now)
  local candidates={}
  for player,s in Dialogue.Sessions do
   if player.Parent==Players and s.NPC==e.NPC and (s.Busy or (s.Expires or 0)>now) then table.insert(candidates,player)end
  end
  table.sort(candidates,function(a,b)return a.UserId<b.UserId end)
  for _,player in candidates do if player.UserId==e.Speaker then return player.UserId end end
  return candidates[1] and candidates[1].UserId
 end
 function self:interaction(e,now)
  local speaker=self:speaker(e,now)
  if speaker then self:cancel(e);e.Speaker=speaker;e.NPC:SetAttribute('NPCV2Speaker',speaker);state(e,'Talk');return true end
  if e.Speaker then e.Speaker=nil;e.NPC:SetAttribute('NPCV2Speaker',nil);e.NextMove=now+1;e.ReturnPending=(e.Root.Position-e.Home.Position).Magnitude>.06;state(e,'Idle')end
  return false
 end
 function self:clear(e,target)
  if e.NPC:GetAttribute('NPCV2PatrolFloorValid')==false then return false end
  local origin=e.Root.Position;local delta=target.Position-origin
  if (target.Position-e.Home.Position).Magnitude>Config.PatrolRadius+.05 then return false end
  local samples=math.max(1,math.ceil(delta.Magnitude/.35))
  for i=0,samples do
   local point=origin+delta*(i/samples)-Vector3.new(0,3,0)
   local floor=Placement.safe(point,{folder},point.Y)
   if not floor or math.abs(floor.Y-point.Y)>.65 then return false end
  end
  -- Prevent cosmetic actors crossing one another, even with collision disabled.
  for _,other in self.Entries do
   if other~=e and other.Root.Parent then
    local d=other.Root.Position-origin;local length=delta:Dot(delta)
    local t=if length>0 then math.clamp(d:Dot(delta)/length,0,1) else 0
    if (other.Root.Position-(origin+delta*t)).Magnitude<4.5 then return false end
   end
  end
  return true
 end
 function self:move(e,target,now)
  if not self:clear(e,target) then state(e,'Observe');e.NextMove=now+Config.Pause;return false end
  local distance=(target.Position-e.Root.Position).Magnitude
  if distance<.06 then e.ReturnPending=false;return false end
  local duration=distance/Config.Speed
  e.Tween=Tween:Create(e.Root,TweenInfo.new(duration,Enum.EasingStyle.Linear),{CFrame=target});e.Tween:Play()
  e.Target=target;e.EndAt=now+duration;e.Moving=true;state(e,'Walk');return true
 end
 function self:step(now)
  if self.Stopped then return end
  local people={};for _,player in Players:GetPlayers()do local char=player.Character;local root=char and char:FindFirstChild('HumanoidRootPart');local hum=char and char:FindFirstChildOfClass('Humanoid');if root and hum and hum.Health>0 then table.insert(people,root.Position)end end
  local moving=0;for _,e in self.Entries do if e.Moving then moving+=1 end end
  for _,e in self.Entries do
   if not e.NPC:IsDescendantOf(folder) or e.Humanoid.Health<=0 then self:cancel(e);state(e,'Idle');continue end
   if self:interaction(e,now) then continue end
   local near=false;for _,point in people do if (e.Root.Position-point).Magnitude<=Config.ActiveDistance then near=true;break end end
   if not near then self:cancel(e);state(e,'Idle');continue end
   if e.Moving then
    -- Re-query the remaining path so a new obstacle cancels movement.
    if not self:clear(e,e.Target) then self:cancel(e);e.NextMove=now+Config.Pause;state(e,'Observe')
    elseif now>=e.EndAt then
     self:cancel(e);e.ReturnPending=(e.Root.Position-e.Home.Position).Magnitude>.06;e.NextMove=now+Config.Pause;state(e,'Observe')
    end
   elseif e.Style.Patrol and now>=e.NextMove and moving<Config.MaxMoving then
    local away=(e.Root.Position-e.Home.Position).Magnitude>.06
    local target=if away or e.ReturnPending then e.Home else e.Home*CFrame.new(if e.Direction==1 then 2.5 else -2.5,0,0)
    if self:move(e,target,now) then moving+=1;if not away then e.Direction=-e.Direction end end
   else state(e,if e.Style.Patrol then 'Observe' else 'Work')end
  end
 end
 function self:destroy()
  if self.Stopped then return end;self.Stopped=true
  for _,c in self.Connections do c:Disconnect()end
  for _,e in self.Entries do self:cancel(e);if e.NPC.Parent then e.NPC:SetAttribute('NPCV2State',nil);e.NPC:SetAttribute('NPCV2Speaker',nil)end end
  table.clear(self.Entries);table.clear(self.Connections);if Behavior.Current==self then Behavior.Current=nil end
 end
 local ordered={};for id,npc in npcs do if npc:GetAttribute('NPCVisualVersion')==2 then table.insert(ordered,{Id=id,NPC=npc})end end
 table.sort(ordered,function(a,b)return a.Id<b.Id end)
 for index,row in ordered do
  local npc=row.NPC;local root=npc.PrimaryPart;local hum=npc:FindFirstChildOfClass('Humanoid')
  if root and hum then
   local e={NPC=npc,Root=root,Humanoid=hum,Home=root.CFrame,Style=Appearance.forNPC(row.Id,npc:GetAttribute('NPCRole'),npc:GetAttribute('City')),NextMove=os.clock()+2+(index%5),Direction=1}
   table.insert(self.Entries,e);state(e,'Idle')
   local prompt=npc:FindFirstChild('NPCInteraction',true)
   if prompt then table.insert(self.Connections,prompt.Triggered:Connect(function(player)
    local now=os.clock()
    if not self:interaction(e,now) and player and Dialogue.near(player,npc) then
     -- Listener order is not a contract: the original handler may not yet have
     -- opened its session. Pause only cosmetics after its existing proximity check.
     self:cancel(e);e.NextMove=now+Config.Tick*2;state(e,'Idle')
    end
   end))end
  end
 end
 table.insert(self.Connections,Run.Heartbeat:Connect(function(dt)self.Accum+=dt;if self.Accum>=Config.Tick then self.Accum=0;self:step(os.clock())end end))
 table.insert(self.Connections,folder.Destroying:Connect(function()self:destroy()end))
 return self
end
return Behavior
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">NPCPositionAdapter</string>
              <string name="Source"><![CDATA[-- Preserve the installed position. This adapter never calls PivotTo or changes CFrame.
local Adapter={}
function Adapter.frame(npc,world,entry,folder,placement)
 if npc:GetAttribute('NPCVisualVersion')~=2 then return entry and placement.frame(world,entry,folder,true)end
 local root=npc:FindFirstChild('HumanoidRootPart');if not root then return nil end
 local frame=root.CFrame*CFrame.new(0,-3,0)
 local floor=placement.safe(frame.Position,{folder},frame.Position.Y)
 local valid=floor~=nil and math.abs(floor.Y-frame.Position.Y)<=.8
 npc:SetAttribute('NPCV2PatrolFloorValid',valid)
 if not valid then warn('[NPC V2] Piso incompatível em '..npc.Name..'; posição preservada e patrulha bloqueada. Revise a cópia manualmente.')end
 return frame
end
return Adapter
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="27">
          <Properties>
            <string name="Name">Shared</string>
          </Properties>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">NPCAppearanceConfig</string>
              <string name="Source"><![CDATA[-- Original designs made from native Roblox geometry. No uploaded asset dependency.
local C={Version=2,MaxVisualParts=150,DetailDistance=42}
C.Cities={
 Valoria={Cloth={29,49,69},Accent={194,158,87},Metal={132,143,154}},
 Arkheim={Cloth={94,43,44},Accent={179,135,84},Metal={95,106,116}},
 Eldoria={Cloth={39,88,78},Accent={175,192,160},Metal={149,167,164}},
 Durakh={Cloth={105,74,46},Accent={184,125,72},Metal={111,119,124}},
 Asterion={Cloth={70,58,105},Accent={191,183,215},Metal={153,158,181}},
 MalgorthDepths={Cloth={65,39,48},Accent={171,115,77},Metal={104,112,127}},
 FallenSanctum={Cloth={55,67,87},Accent={173,183,194},Metal={136,151,168}},
}
C.Roles={
 GuildMaster={Style='Commander',Hair='Swept',Cape=true,Armor=true,Book=true,Sword=true,Work='Documents',HairColor={224,215,192}},
 Reception={Style='Scribe',Hair='Braided',Book=true,Work='Documents'},
 Guard={Style='Guard',Hair='Short',Cape=true,Armor=true,Sword=true,Shield=true,Helmet=true,Work='Observe',Patrol=true},
 Classes={Style='Veteran',Hair='Swept',Armor=true,Sword=true,Cape=true,Work='Inspect'},
 Skills={Style='Duelist',Hair='Short',Sword=true,Work='Inspect'},
 Blacksmith={Style='Smith',Hair='Short',Apron=true,Hammer=true,Work='Forge',HairColor={56,45,39}},
 Armor={Style='Armorer',Hair='Braided',Armor=true,Apron=true,Work='Organize'},
 Weapons={Style='Quartermaster',Hair='Swept',Sword=true,Work='Organize'},
 General={Style='Merchant',Hair='Swept',Work='Trade'},
 TravelShop={Style='Nomad',Hair='Braided',Cape=true,Backpack=true,Work='Trade'},
 Magic={Style='Mage',Hair='Long',Cape=true,Robe=true,Staff=true,Book=true,Work='Study'},
 Races={Style='Lorekeeper',Hair='Long',Robe=true,Cape=true,Book=true,Work='Study'},
 Fusions={Style='Artificer',Hair='Swept',Robe=true,Staff=true,Monocle=true,Work='Study'},
 Inn={Style='Host',Hair='Braided',Apron=true,Cup=true,Work='Serve'},
 Healer={Style='Healer',Hair='Long',Robe=true,Work='Study'},
 Bank={Style='Clerk',Hair='Short',Book=true,Monocle=true,Work='Documents'},
 Guide={Style='Scout',Hair='Swept',Cape=true,Work='Orient'},
 Tutorial={Style='Page',Hair='Swept',Work='Orient'},
 Dungeon={Style='Warden',Hair='Long',Armor=true,Cape=true,Work='Inspect'},
 Resident={Style='Citizen',Hair='Swept',Work='Observe',Patrol=true},
 Traveler={Style='Traveler',Hair='Long',Backpack=true,Work='Observe',Patrol=true},
 Artisan={Style='Artisan',Hair='Short',Apron=true,Hammer=true,Work='Forge'},
 Employee={Style='Assistant',Hair='Braided',Apron=true,Work='Organize'},
 Adventurer={Style='Ranger',Hair='Swept',Cape=true,Sword=true,Work='Observe',Patrol=true},
 Farmer={Style='Farmer',Hair='Short',Apron=true,Hat=true,Work='Observe',Patrol=true},
}
local skins={{230,191,160},{198,147,111},{156,107,81},{239,209,184},{174,126,101}}
local hairs={{65,43,32},{132,92,55},{197,170,118},{42,39,47},{176,182,190},{119,54,41}}
local eyes={{67,113,112},{121,91,54},{92,101,137},{108,135,89}}
function C.hash(id)
 local n=17;for i=1,#id do n=(n*31+string.byte(id,i))%104729 end;return n
end
function C.forNPC(id,role,city)
 assert(type(id)=='string' and C.Roles[role] and C.Cities[city],'Visual V2: identidade/papel/cidade desconhecidos')
 local n=C.hash(id);local out=table.clone(C.Roles[role]);local palette=C.Cities[city]
 out.Id=id;out.Role=role;out.City=city;out.Variant=n%3+1
 out.Skin=skins[n%#skins+1];out.HairColor=out.HairColor or hairs[n%#hairs+1];out.Eyes=eyes[n%#eyes+1]
 out.Cloth=palette.Cloth;out.Accent=palette.Accent;out.Metal=palette.Metal
 out.Leather={72+n%12,49+n%8,36+n%6};out.Linen={207,197,170};out.MaxParts=C.MaxVisualParts
 if role=='Healer' then out.Cloth={202,206,185}end
 return out
end
return C
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">NPCMotion</string>
              <string name="Source"><![CDATA[-- Authored procedural pose vocabulary. Radians, no assets, Instances or gameplay state.
local M={}
function M.pose(state,t,phase,reduced)
 local p={};local rad=math.rad
 local function joint(name,x,y,z)p[name]={rad(x or 0),rad(y or 0),rad(z or 0)}end
 local breath=math.sin(t*1.6+phase)
 joint('Waist',.6*breath,0,.45*math.sin(t*.65+phase));joint('Neck',.6*breath,2.5*math.sin(t*.38+phase),0)
 joint('LeftShoulder',1.5*breath,0,-3);joint('RightShoulder',-1.5*breath,0,3)
 joint('LeftElbow',5,0,0);joint('RightElbow',5,0,0)
 if reduced and state~='Walk' and state~='Run' then return p end
 local pulse=math.sin(t*2.6+phase)
 if state=='Walk' or state=='Run' then
  local run=state=='Run';local step=math.sin(t*(if run then 9 else 5.5)+phase);local swing=if run then 36 else 22
  joint('LeftHip',swing*step,0,0);joint('RightHip',-swing*step,0,0)
  joint('LeftKnee',-math.max(0,-step)*(if run then 46 else 28),0,0);joint('RightKnee',-math.max(0,step)*(if run then 46 else 28),0,0)
  joint('LeftAnkle',-8*step,0,0);joint('RightAnkle',8*step,0,0)
  joint('LeftShoulder',-swing*step,0,-4);joint('RightShoulder',swing*step,0,4);joint('Waist',if run then -8 else -2,1.2*step,0)
 elseif state=='Greet' then
  joint('RightShoulder',28,0,84);joint('RightElbow',65,0,0);joint('RightWrist',0,0,14*math.sin(t*10));joint('Neck',-3,0,-4)
 elseif state=='Talk' or state=='Trade' or state=='Orient' then
  joint('RightShoulder',22+5*pulse,0,12);joint('RightElbow',39+9*pulse,0,0);joint('RightWrist',0,12*math.sin(t*1.4),-8)
  joint('LeftElbow',15+7*math.sin(t*1.8+phase),0,0);joint('Neck',2*math.sin(t*2.1),0,0)
 elseif state=='Forge' then
  local lift=(math.sin(t*3+phase)+1)/2
  joint('Waist',-8,0,-3);joint('RightShoulder',35+35*lift,0,8);joint('RightElbow',12+53*lift,0,0)
  joint('RightWrist',12-16*lift,0,0);joint('LeftShoulder',27,0,-5);joint('LeftElbow',24,0,0);joint('Neck',-18,0,0)
 elseif state=='Study' or state=='Documents' then
  joint('LeftShoulder',34,0,-9);joint('LeftElbow',65,0,0);joint('LeftWrist',0,0,-8)
  joint('RightShoulder',23,0,5);joint('RightElbow',45+5*pulse,0,0);joint('RightWrist',0,9*pulse,0);joint('Neck',-16,2*pulse,0)
 elseif state=='Arcane' then
  joint('RightShoulder',38,0,24);joint('RightElbow',28-5*pulse,0,0);joint('LeftShoulder',18,0,-23);joint('LeftElbow',55,0,0)
  joint('LeftWrist',0,18*pulse,0);joint('Neck',-7,0,0)
 elseif state=='Inspect' then
  joint('LeftShoulder',30,0,-6);joint('LeftElbow',43,0,0);joint('RightShoulder',28,0,10);joint('RightElbow',48,0,0);joint('Neck',-13,8*pulse,0)
 elseif state=='Organize' then
  joint('Waist',-5,5*pulse,0);joint('RightShoulder',36+8*pulse,0,9);joint('RightElbow',21+10*pulse,0,0);joint('LeftShoulder',18,0,-5);joint('LeftElbow',35,0,0)
 elseif state=='Serve' then
  joint('RightShoulder',45+5*pulse,0,5);joint('RightElbow',20,0,0);joint('LeftShoulder',10,0,-8);joint('LeftElbow',25,0,0);joint('Neck',-2,3*pulse,0)
 elseif state=='Observe' then joint('Neck',0,10*math.sin(t*.35+phase),0);joint('Waist',0,3*math.sin(t*.35+phase),0)
 end
 return p
end
function M.work(base,t,phase,cycle)
 cycle=cycle or 18;local slot=math.floor((t+phase)%cycle/(cycle/3))
 if base=='Forge' then return ({'Forge','Inspect','Organize'})[slot+1]end
 if base=='Study' then return ({'Study','Study','Arcane'})[slot+1]end
 if base=='Trade' then return ({'Trade','Organize','Trade'})[slot+1]end
 return base
end
return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">NPCVisualConfig</string>
              <string name="Source"><![CDATA[return {
 Version=2,
 Attention={Distance=22,HalfField=80,HeadYaw=44,HeadPitch=20,TorsoYaw=11,Response=7,GreetingCooldown=14},
 Performance={ScanSeconds=0.5,FullDistance=48,ReducedDistance=100,DesktopFull=12,MobileFull=8,Reduced=8,DesktopHz=30,MobileHz=20,ReducedHz=6,Effects=3,Particles=0},
 Behavior={Tick=0.2,ActiveDistance=90,MaxMoving=4,PatrolRadius=3,Speed=1.6,Pause=5,WorkCycle=12},
 -- Empty IDs intentionally use authored procedural poses. Configure ONLY owned/authorized published assets.
 Animations={
  Idle={Id='',Priority='Idle',Looped=true},Walk={Id='',Priority='Movement',Looped=true},Run={Id='',Priority='Movement',Looped=true},
  Greet={Id='',Priority='Action2',Looped=false},Talk={Id='',Priority='Action2',Looped=true},
  Forge={Id='',Priority='Action',Looped=true},Inspect={Id='',Priority='Action',Looped=true},Organize={Id='',Priority='Action',Looped=true},
  Study={Id='',Priority='Action',Looped=true},Arcane={Id='',Priority='Action',Looped=true},Trade={Id='',Priority='Action',Looped=true},
  Documents={Id='',Priority='Action',Looped=true},Serve={Id='',Priority='Action',Looped=true},Orient={Id='',Priority='Action',Looped=true},Observe={Id='',Priority='Idle',Looped=true},
 },
 FadeSeconds=0.22,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">NPCVisualPolicy</string>
              <string name="Source"><![CDATA[local P={}
function P.clipId(id)return type(id)=='string' and id:match('^rbxassetid://[1-9]%d*$')~=nil end
function P.attention(x,y,z,active,c)
 local distance=math.sqrt(x*x+y*y+z*z)
 if distance>c.Distance or distance<.01 then return 0,0,0,false end
 local yaw=math.atan2(-x,-z);local pitch=math.atan2(y,math.sqrt(x*x+z*z))
 if not active and math.abs(yaw)>math.rad(c.HalfField) then return 0,0,0,false end
 return math.clamp(yaw, -math.rad(c.HeadYaw), math.rad(c.HeadYaw)),math.clamp(pitch,-math.rad(c.HeadPitch),math.rad(c.HeadPitch)),math.clamp(yaw*.22,-math.rad(c.TorsoYaw),math.rad(c.TorsoYaw)),true
end
function P.select(candidates,mobile,config)
 table.sort(candidates,function(a,b)if a.Active~=b.Active then return a.Active end;if a.Distance~=b.Distance then return a.Distance<b.Distance end;return a.Id<b.Id end)
 local result={};local full,reduced=0,0;local cap=if mobile then config.MobileFull else config.DesktopFull
 for _,entry in candidates do
  if entry.Distance<=config.FullDistance and full<cap then result[entry.Key]='Full';full+=1
  elseif entry.Distance<=config.ReducedDistance and reduced<config.Reduced then result[entry.Key]='Reduced';reduced+=1 end
 end
 return result
end
return P
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="32">
      <Properties>
        <string name="Name">EnemyRuntime</string>
      </Properties>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Factory</string>
          <string name="Source"><![CDATA[-- Visual factory only: EnemyService retains all AI, health, damage and rewards.
local F={}
local Catalog=require(script.Parent.AvatarCatalog)
local Proxy=require(script.Parent.ProxyRig)
local function frame(v)return CFrame.new(table.unpack(v))end
function F.create(parent,name,position,_color,hostile,kind)
 assert(hostile,'Biblioteca de inimigos não cria NPCs de serviço')
 local key=Catalog.Enemies[kind];local def=key and Catalog.Models[key]
 local template=def and script.Parent.Templates:FindFirstChild(key);assert(template,'Modelo de inimigo não registrado: '..tostring(kind))
 local model=Proxy.create(parent,{Id=name,Role='Guard',City='Enemy',Ambient=false},{Name=name,Title='Inimigo'},CFrame.new(position))
 local root=model.PrimaryPart;local hum=model:FindFirstChildOfClass('Humanoid');local bodies={HumanoidRootPart=root}
 local ok,err=pcall(function()
  for bone in Catalog.R15 do bodies[bone]=assert(model:FindFirstChild(bone),'Proxy R15 incompleto')end
  for _,child in model:GetChildren()do if child:IsA('BasePart') then
   if not bodies[child.Name] then child:Destroy()else child.Transparency=1;child.CanCollide=child.Name=='UpperTorso';child.CanQuery=child.CanCollide end
  end end
  local prompt=model:FindFirstChild('NPCInteraction',true);if prompt then prompt:Destroy()end
  for _,keyName in {'EldravynNPCId','NPCRole','City','AmbientNPC','NPCVersion'}do model:SetAttribute(keyName,nil)end
  local visuals=Instance.new('Folder');visuals.Name='AvatarEnemyVisuals';visuals.Parent=model
  local feet=root.CFrame*CFrame.new(0,-3,0)
  for _,bone in def.Bones do
   local source=assert(template:FindFirstChild(bone));local target=bodies[bone]
   if not target then
    local p=Instance.new('Part');p.Name='AvatarAnchor_'..bone;p.Size=Vector3.new(.1,.1,.1);p.Transparency=1;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true
    local point=Catalog.Quadruped[bone]or{0,.95,0};p.CFrame=feet*frame(point);p.Parent=model;target=p
    local pivot=if bone:find('Front')or bone:find('Hind')then{point[1],1.48,point[3]}elseif bone=='BeastHead'then{0,1.80,-.7}elseif bone=='BeastTail'then{0,1.65,1.0}else point
    local motor=Instance.new('Motor6D');motor.Name='Avatar_'..bone;motor.Part0=root;motor.Part1=p
    local worldPivot=feet*frame(pivot);motor.C0=root.CFrame:ToObjectSpace(worldPivot);motor.C1=p.CFrame:ToObjectSpace(worldPivot);motor.Parent=root
   end
   local mesh=source:Clone();mesh.Name='Avatar_'..bone;mesh.CFrame=feet*source.CFrame;mesh.Anchored=false;mesh.Massless=true;mesh.CanCollide=false;mesh.CanTouch=false;mesh.CanQuery=true;mesh.Parent=visuals
   if def.Kind=='Blob'then mesh.Transparency=.12 end
   local weld=Instance.new('WeldConstraint');weld.Part0=target;weld.Part1=mesh;weld.Parent=mesh
  end
  hum.AutoRotate=true;root.Anchored=false;root.Massless=false
  model:SetAttribute('AvatarEnemyKind',kind);model:SetAttribute('AvatarRigKind',def.Kind);model:SetAttribute('EnemyKind',kind);model:SetAttribute('AvatarArtVersion',3)
  game:GetService('CollectionService'):AddTag(model,'EldravynAvatarEnemy')
  if game:GetService('RunService'):IsRunning()then root:SetNetworkOwner(nil)end
 end)
 if not ok then model:Destroy();error(err)end
 return model,hum,root
end
return F
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">ProxyRig</string>
          <string name="Source"><![CDATA[-- Original native R15 topology, Motor6D joints and decorative clothing. No asset IDs.
local F={}
function F.create(parent,definition,role,frame)
 local m=Instance.new('Model');m.Name=definition.Id;m.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
 m:SetAttribute('EldravynNPCId',definition.Id);m:SetAttribute('NPCRole',definition.Role);m:SetAttribute('City',definition.City)
 m:SetAttribute('AmbientNPC',definition.Ambient==true);m:SetAttribute('NPCVersion',1)
 if definition.Dungeon then m:SetAttribute('DungeonId',definition.Dungeon) end
 local mage=definition.Role=='Magic' or definition.Role=='Races' or definition.Role=='Fusions'
 local guard=definition.Role=='Guard' or definition.Role=='Classes' or definition.Role=='GuildMaster'
 local skin=Color3.fromRGB(190+(definition.Variant or 1)*6,148+(definition.Variant or 1)*5,115+(definition.Variant or 1)*4)
 local cloth=if mage then Color3.fromRGB(70,71,122) elseif guard then Color3.fromRGB(72,95,117) elseif definition.Role=='Blacksmith' then Color3.fromRGB(95,67,49) else Color3.fromRGB(100,102,72)
 local pants=Color3.fromRGB(59,51,49);local metal=Color3.fromRGB(153,161,171)
 local parts,offsets={},{}
 local function part(name,size,offset,color)
  local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=frame*CFrame.new(offset);p.Color=color
  p.Material=Enum.Material.SmoothPlastic;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true
  p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=m
  parts[name]=p;offsets[name]=offset;return p
 end
 local root=part('HumanoidRootPart',Vector3.new(2,2,1),Vector3.new(0,3,0),cloth);root.Transparency=1;root.Anchored=true
 part('LowerTorso',Vector3.new(1.8,0.9,0.9),Vector3.new(0,3,0),cloth)
 part('UpperTorso',Vector3.new(2,1.4,1),Vector3.new(0,4,0),cloth)
 local head=part('Head',Vector3.new(1.4,1.1,1),Vector3.new(0,5.25,0),skin)
 for _,side in {'Left','Right'} do
  local x=if side=='Left' then -1 else 1
  part(side..'UpperArm',Vector3.new(0.65,1.1,0.75),Vector3.new(x*1.35,4,0),cloth)
  part(side..'LowerArm',Vector3.new(0.6,0.9,0.65),Vector3.new(x*1.35,3,0),if definition.Role=='Blacksmith' then skin else cloth)
  part(side..'Hand',Vector3.new(0.6,0.5,0.65),Vector3.new(x*1.35,2.3,0),if guard or definition.Role=='Blacksmith' then pants else skin)
  part(side..'UpperLeg',Vector3.new(0.8,1.2,0.8),Vector3.new(x*0.5,1.95,0),pants)
  part(side..'LowerLeg',Vector3.new(0.7,1,0.7),Vector3.new(x*0.5,0.9,0),pants)
  part(side..'Foot',Vector3.new(0.8,0.5,1.2),Vector3.new(x*0.5,0.25,-0.1),Color3.fromRGB(45,37,33))
 end
 local function joint(name,a,b,pivot)
  local motor=Instance.new('Motor6D');motor.Name=name;motor.Part0=parts[a];motor.Part1=parts[b]
  motor.C0=CFrame.new(pivot-offsets[a]);motor.C1=CFrame.new(pivot-offsets[b]);motor.Parent=parts[a]
  for _,body in {a,b} do local at=Instance.new('Attachment');at.Name=name..'RigAttachment';at.CFrame=CFrame.new(pivot-offsets[body]);at.Parent=parts[body] end
 end
 joint('Root','HumanoidRootPart','LowerTorso',Vector3.new(0,3,0));joint('Waist','LowerTorso','UpperTorso',Vector3.new(0,3.4,0));joint('Neck','UpperTorso','Head',Vector3.new(0,4.7,0))
 for _,side in {'Left','Right'} do local x=if side=='Left' then -1 else 1
  joint(side..'Shoulder','UpperTorso',side..'UpperArm',Vector3.new(x,4.4,0))
  joint(side..'Elbow',side..'UpperArm',side..'LowerArm',Vector3.new(x*1.35,3.45,0))
  joint(side..'Wrist',side..'LowerArm',side..'Hand',Vector3.new(x*1.35,2.55,0))
  joint(side..'Hip','LowerTorso',side..'UpperLeg',Vector3.new(x*0.5,2.55,0))
  joint(side..'Knee',side..'UpperLeg',side..'LowerLeg',Vector3.new(x*0.5,1.35,0))
  joint(side..'Ankle',side..'LowerLeg',side..'Foot',Vector3.new(x*0.5,0.4,0))
 end
 local function adorn(name,size,offset,color,body)
  body=body or 'UpperTorso';local p=part(name,size,offsets[body]+offset,color)
  local weld=Instance.new('WeldConstraint');weld.Part0=parts[body];weld.Part1=p;weld.Parent=p;return p
 end
 for _,x in {-0.3,0.3} do adorn('Eye'..x,Vector3.new(0.13,0.17,0.08),Vector3.new(x,0,-0.54),Color3.fromRGB(28,24,31),'Head') end
 adorn('Hair',Vector3.new(1.5,0.35,1.1),Vector3.new(0,0.5,0.05),pants,'Head')
 adorn('Mouth',Vector3.new(0.3,0.06,0.06),Vector3.new(0,-0.3,-0.54),pants,'Head')
 adorn('Belt',Vector3.new(1.95,0.22,1),Vector3.new(0,-0.1,0),pants,'LowerTorso')
 if mage then
  adorn('Robe',Vector3.new(1.9,1.5,1),Vector3.new(0,-0.5,0),cloth,'LowerTorso')
  adorn('HatBrim',Vector3.new(2,0.2,1.6),Vector3.new(0,0.6,0),cloth,'Head')
  adorn('HatCrown',Vector3.new(1,1.2,0.9),Vector3.new(0,1.1,0),cloth,'Head')
  adorn('DecorativeStaff',Vector3.new(0.22,4.8,0.22),Vector3.new(0.5,0.8,0),Color3.fromRGB(102,75,46),'RightHand')
 elseif guard then
  adorn('Breastplate',Vector3.new(1.85,1.2,0.2),Vector3.new(0,0,-0.6),metal)
  for _,x in {-1,1} do adorn('Pauldron'..x,Vector3.new(0.9,0.35,1),Vector3.new(x*1.2,0.5,0),metal) end
 elseif definition.Role=='Blacksmith' then
  adorn('Apron',Vector3.new(1.6,2,0.15),Vector3.new(0,-0.4,-0.6),Color3.fromRGB(84,51,32))
  adorn('HammerHandle',Vector3.new(0.2,1.3,0.2),Vector3.new(0,-0.3,0),pants,'RightHand')
  adorn('HammerHead',Vector3.new(0.9,0.4,0.4),Vector3.new(0,0.35,0),metal,'RightHand')
 else
  adorn('VestTrim',Vector3.new(0.2,1.3,0.15),Vector3.new(-0.5,0,-0.6),Color3.fromRGB(204,178,106))
  adorn('Satchel',Vector3.new(0.8,0.8,0.5),Vector3.new(0.9,-0.3,0.1),pants,'LowerTorso')
 end
 local hum=Instance.new('Humanoid');hum.RigType=Enum.HumanoidRigType.R15;hum.DisplayName=role.Name..' • '..role.Title;hum.HipHeight=2
 hum.MaxHealth=100;hum.Health=100;hum.BreakJointsOnDeath=false;hum.AutoRotate=false;hum.Parent=m
 local animator=Instance.new('Animator');animator.Parent=hum
 local prompt=Instance.new('ProximityPrompt');prompt.Name='NPCInteraction';prompt.ActionText='Conversar';prompt.ObjectText=role.Name..' • '..role.Title
 prompt.MaxActivationDistance=12;prompt.RequiresLineOfSight=true;prompt.HoldDuration=0;prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.Parent=head
 m.PrimaryPart=root;m.Parent=parent;return m
end
return F
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="35">
      <Properties>
        <string name="Name">EnemyServiceBaseline</string>
        <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Pathfinding=game:GetService('PathfindingService')
local Shared=game.ReplicatedStorage.MedievalRPG
local Rig=require(Shared.RigFactory)
local Catalog=require(Shared.Config.ContentConfig)
local Config=require(Shared.Config.WorldConfig)
local Security=require(script.Parent.AntiExploitService)
local Patterns=require(Shared.Core.ActionMath)
local E={Active={},Spawns={},SpawnSet={},OnKill=nil,Running=false}
local function nearest(pos,radius,scope)
    local best,dist
    for _,p in Players:GetPlayers() do
        local root=Security.alive(p)
        if root and (not E.CanTarget or E.CanTarget(p,scope)) then
            local d=(root.Position-pos).Magnitude
            if d<radius and (not dist or d<dist) then best,dist=p,d end
        end
    end
    return best,dist
end
function E.scan(root)
    local folder=root:FindFirstChild('EnemySpawns')
    if folder then
        for _,marker in folder:GetChildren() do
            if marker:IsA('BasePart') and not E.SpawnSet[marker] then
                E.SpawnSet[marker]=true;table.insert(E.Spawns,{Marker=marker,Next=0,Root=root})
            end
        end
    end
end
local function spawnEnemy(s)
    local kind=s.Marker:GetAttribute('EnemyKind');local def=Catalog.Enemies[kind]
    if not def then return end
    local paint=Color3.fromRGB(table.unpack(def.Color))
    local model,hum,root=Rig.create(s.Root,def.Name,s.Marker.Position,paint,true,kind)
    model:SetAttribute('EnemyKind',kind);model:SetAttribute('HealthMax',def.Health);model:SetAttribute('Health',def.Health)
    local health=def.Health;local heightOffset=3
    if def.Boss then
        local participants=0;for _,p in Players:GetPlayers()do local r=Security.alive(p);if r and (r.Position-s.Marker.Position).Magnitude<100 then participants+=1 end end
        health=math.floor(def.Health*(1+0.35*(math.clamp(participants,1,4)-1)))
        local scale=if kind=='Malgorth' then 2.2 else 1.7
        model:ScaleTo(scale);heightOffset=3*scale
        model:PivotTo(CFrame.new(s.Marker.Position+Vector3.new(0,heightOffset,0)))
        model:SetAttribute('Boss',true);model:SetAttribute('PartyScale',math.clamp(participants,1,4))
    end
    model:SetAttribute('HealthMax',health);model:SetAttribute('Health',health)
    hum.MaxHealth=health;hum.Health=health;hum.WalkSpeed=def.Speed
    local multiplier=s.Marker:GetAttribute('Difficulty') or 1
    health=math.floor(health*multiplier);hum.MaxHealth=health;hum.Health=health
    model:SetAttribute('HealthMax',health);model:SetAttribute('Health',health)
    local e={Model=model,Hum=hum,Root=root,Kind=kind,Def=def,MaxHealth=health,HeightOffset=heightOffset,Spawn=s,Home=s.Marker.Position,LastAttack=0,Contributors={},State='IDLE',PathAt=0,Waypoints=nil,Waypoint=1,PathBusy=false,Target=nil,LastSpecial=os.clock(),SpecialCooldown=5}
    e.Damage=math.floor(def.Damage*math.min(2.5,multiplier))
    s.Enemy=e;E.Active[model]=e
    hum.HealthChanged:Connect(function(h) if model.Parent then model:SetAttribute('Health',h) end end)
    hum.Died:Connect(function()
        e.State='DEAD';model:SetAttribute('State','DEAD')
        if kind=='Malgorth' then s.Root:SetAttribute('BossDefeated',true) end
        if s.Marker:GetAttribute('Once') then s.Marker:SetAttribute('Defeated',true) end
        if E.OnKill then local ok,err=xpcall(function()E.OnKill(e)end,debug.traceback);if not ok then warn(err)end end
        E.Active[model]=nil;s.Enemy=nil;s.Next=os.clock()+(if kind=='Malgorth' or kind=='Knight' then 300 else 25)
        task.delay(4,function() if model.Parent then model:Destroy() end end)
    end)
end
function E.damage(model,player,damage)
    local e=E.Active[model]
    if not e or e.Hum.Health<=0 then return false end
    if E.CanTarget and not E.CanTarget(player,e.Spawn and e.Spawn.Root) then return false end
    if type(damage)~='number' or damage~=damage or damage<=0 or damage>100000 then return false end
    local actual=math.min(damage,e.Hum.Health)
    if e.Spawn and e.Spawn.Marker:GetAttribute('Training') then
        e.Hum.Health=e.Hum.MaxHealth;e.ReactionUntil=os.clock()+0.15;return true
    end
    e.Contributors[player]=(e.Contributors[player] or 0)+actual
    e.Hum:TakeDamage(actual);e.ReactionUntil=os.clock()+0.15;return true
end
local function pathTo(e,target)
    if e.PathBusy or os.clock()-e.PathAt<2 then return end
    e.PathAt=os.clock();e.PathBusy=true
    task.spawn(function()
        local path=Pathfinding:CreatePath({AgentRadius=2,AgentHeight=6,AgentCanJump=true})
        local ok=pcall(function() path:ComputeAsync(e.Root.Position,target) end)
        if e.Model.Parent and ok and path.Status==Enum.PathStatus.Success then
            e.Waypoints=path:GetWaypoints();e.Waypoint=2;e.PathGoal=target
        end
        e.PathBusy=false
    end)
end
function E.resolveSwing(e,now)
    local swing=e.Swing
    if not swing then return end
    if e.Hum.Health<=0 or now<(e.StunnedUntil or 0) or (e.Root.Position-e.Home).Magnitude>95 then e.Swing=nil;return end
    if now<swing.At then return end
    e.Swing=nil
    local r=Security.alive(swing.Player)
    local delta=r and r.Position-e.Root.Position
    if not delta or delta.Magnitude>swing.Range or (delta.Magnitude>0.01 and swing.Direction and delta.Unit:Dot(swing.Direction)<0.1) then return end
    if E.CanTarget and not E.CanTarget(swing.Player,e.Spawn and e.Spawn.Root) then return end
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={e.Model}
    local hit=workspace:Raycast(e.Root.Position,delta,params)
    if E.OnPlayerHit and (not hit or hit.Instance:IsDescendantOf(swing.Player.Character)) then
        E.OnPlayerHit(swing.Player,e.Damage or e.Def.Damage,e.Root.Position,e,true)
    end
end
function E.step()
    local now=os.clock();local count=0
    for _ in E.Active do count+=1 end
    local cap=Config.QualityProfiles[Config.Quality].ActiveEnemies
    for _,s in E.Spawns do
        if s.Marker.Parent and s.Marker:GetAttribute('Enabled')~=false and not s.Marker:GetAttribute('Defeated') and not s.Enemy and now>=s.Next and count<cap and nearest(s.Marker.Position,220,s.Root) then
            if not (s.Marker:GetAttribute('EnemyKind')=='Malgorth' and s.Root:GetAttribute('BossDefeated')) then spawnEnemy(s);count+=1 end
        end
    end
    for model,e in E.Active do
        if e.Spawn and e.Spawn.Marker:GetAttribute('Enabled')==false then
            E.Active[model]=nil;e.Spawn.Enemy=nil;model:Destroy();continue
        end
        if not model.Parent or not e.Root.Parent then E.Active[model]=nil;e.Spawn.Enemy=nil;continue end
        if now<(e.BurnUntil or 0) and now-(e.LastBurn or 0)>0.75 and e.BurnOwner then e.LastBurn=now;E.damage(model,e.BurnOwner,5) end
        if e.Hum.Health<=0 then continue end
        e.Hum.WalkSpeed=if now<(e.SlowUntil or 0) then e.Def.Speed*0.5 else e.Def.Speed
        if now-(e.LastPressure or 0)>2 then e.Posture=math.max(0,(e.Posture or 0)-4) end
        model:SetAttribute('Posture',e.Posture or 0)
        if now<(e.StunnedUntil or 0) then e.Pending=nil;e.Swing=nil;e.Hum:MoveTo(e.Root.Position);model:SetAttribute('State','STAGGER');continue end
        local homeDist=(e.Root.Position-e.Home).Magnitude
        if e.Pending and (homeDist>95 or now<(e.StunnedUntil or 0)) then e.Pending=nil end
        if e.Def.Boss and homeDist<=95 then
            local phase=if e.Hum.Health<(e.MaxHealth or e.Def.Health)*0.5 then 2 else 1;model:SetAttribute('Phase',phase)
            if not e.Pending and not e.Swing and nearest(e.Root.Position,45,e.Spawn and e.Spawn.Root) and now-(e.LastSpecial or now-2)>e.SpecialCooldown then
                e.PatternIndex=(e.PatternIndex or 0)+1
                local pattern=Patterns.boss(e.Kind,phase,e.PatternIndex)
                e.LastSpecial=now;e.SpecialCooldown=pattern.Cooldown
                e.Pending={At=now+pattern.Windup,Origin=e.Root.Position,Pattern=pattern}
                if E.OnWarning then E.OnWarning({Kind='Warning',Position=e.Root.Position,Radius=pattern.Radius,InnerRadius=pattern.InnerRadius,Seconds=pattern.Windup,HeightOffset=e.HeightOffset or 3,Name=pattern.Name,Phase=phase}) end
            end
            if e.Pending then
                e.Hum:MoveTo(e.Root.Position);model:SetAttribute('State','WINDUP')
                if now>=e.Pending.At then
                    local pending=e.Pending;e.Pending=nil
                    for _,p in Players:GetPlayers() do
                        local pr=Security.alive(p)
                        local delta=pr and pr.Position-pending.Origin
                        if delta and (not E.CanTarget or E.CanTarget(p,e.Spawn and e.Spawn.Root)) and Patterns.inArea(Vector2.new(delta.X,delta.Z).Magnitude,delta.Y,pending.Pattern) then
                            local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={model}
                            local hit=workspace:Raycast(pending.Origin,pr.Position-pending.Origin,params)
                            if E.OnPlayerHit and (not hit or hit.Instance:IsDescendantOf(p.Character))then E.OnPlayerHit(p,(e.Damage or e.Def.Damage)*pending.Pattern.Multiplier,pending.Origin,e,false)end
                        end
                    end
                end
                continue
            end
        end
        if e.Swing then
            e.Hum:MoveTo(e.Root.Position);model:SetAttribute('State','WINDUP')
            E.resolveSwing(e,now)
            continue
        end
        local player,dist=nearest(e.Root.Position,90,e.Spawn and e.Spawn.Root)
        local homeDist=(e.Root.Position-e.Home).Magnitude
        local target
        if homeDist>95 or not player then
            e.State=if homeDist>8 then 'RETURN' elseif math.floor(now/4)%2==0 then 'IDLE' else 'PATROL'
            target=e.Home+Vector3.new(math.sin(now*0.12)*5,3,math.cos(now*0.12)*5)
        elseif dist<7+(if e.Kind=='Malgorth' then 3 else 0) then
            e.State='ATTACK';e.Hum:MoveTo(e.Root.Position)
            local pRoot=Security.alive(player)
            local rayParams=RaycastParams.new();rayParams.FilterType=Enum.RaycastFilterType.Exclude;rayParams.FilterDescendantsInstances={model}
            local hit=pRoot and workspace:Raycast(e.Root.Position,pRoot.Position-e.Root.Position,rayParams)
            if pRoot and now-e.LastAttack>1.3 and (not hit or hit.Instance:IsDescendantOf(player.Character)) then
                e.LastAttack=now
                local delta=pRoot.Position-e.Root.Position
                e.Swing={Player=player,At=now+(e.Def.Windup or 0.65),Direction=if delta.Magnitude>0.01 then delta.Unit else nil,Range=7+(if e.Kind=='Malgorth' then 3 else 0)}
                if E.OnWarning then E.OnWarning({Kind='MeleeWarning',Position=e.Root.Position,Seconds=e.Def.Windup or 0.65,Name=e.Def.Name,Target=player.UserId}) end
            end
        else e.State='CHASE';local r=Security.alive(player);target=r and r.Position end
        model:SetAttribute('State',e.State)
        if target and e.State~='IDLE' then
            if e.Waypoints and e.PathGoal and (target-e.PathGoal).Magnitude>18 then e.Waypoints=nil end
            pathTo(e,target)
            local points=e.Waypoints
            local wp=points and points[e.Waypoint]
            if wp then
                if (wp.Position-e.Root.Position).Magnitude<5 then e.Waypoint+=1;wp=points[e.Waypoint] end
                if wp then if wp.Action==Enum.PathWaypointAction.Jump then e.Hum.Jump=true end;e.Hum:MoveTo(wp.Position) end
            end
            -- Sem caminho válido não atravessa paredes tentando mover o CFrame.
        end
        if not nearest(e.Home,300,e.Spawn and e.Spawn.Root) then
            E.Active[model]=nil;e.Spawn.Enemy=nil;e.Spawn.Next=now+3;model:Destroy()
        end
    end
    for _,d in workspace:GetChildren() do
        if d.Name=='GeneratedDungeon' and d:FindFirstChild('Traps') then
            for _,trap in d.Traps:GetChildren() do
                local active=math.floor(now/2)%2==0
                trap.Transparency=if active then 0 else 0.7
                if active then
                    for _,p in Players:GetPlayers() do
                        if Security.near(p,trap,7) and Security.allow(p,'trap',1) then if E.OnPlayerHit then E.OnPlayerHit(p,12,trap.Position) end end
                    end
                end
            end
        end
    end
end
function E.clearScope(scope)
    for model,e in E.Active do
        if e.Spawn and e.Spawn.Root==scope then e.Spawn.Enemy=nil;E.Active[model]=nil;model:Destroy() end
    end
end
function E.start()
    if E.Running then return end;E.Running=true
    local last=0
    game:GetService('RunService').Heartbeat:Connect(function()
        local now=os.clock();if now-last<0.03 then return end;last=now
        for _,e in E.Active do if e.Swing then E.resolveSwing(e,now) end end
    end)
    task.spawn(function() while task.wait(0.25) do local ok,err=xpcall(E.step,debug.traceback);if not ok then warn(err) end end end)
end
return E
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="36">
      <Properties>
        <string name="Name">EnemyServiceTemplate</string>
        <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Pathfinding=game:GetService('PathfindingService')
local Shared=game.ReplicatedStorage.MedievalRPG
local Rig=require(Shared.RigFactory)
local Catalog=require(Shared.Config.ContentConfig)
local Config=require(Shared.Config.WorldConfig)
local Security=require(script.Parent.AntiExploitService)
local Patterns=require(Shared.Core.ActionMath)
local E={Active={},Spawns={},SpawnSet={},OnKill=nil,Running=false}
local function nearest(pos,radius,scope)
    local best,dist
    for _,p in Players:GetPlayers() do
        local root=Security.alive(p)
        if root and (not E.CanTarget or E.CanTarget(p,scope)) then
            local d=(root.Position-pos).Magnitude
            if d<radius and (not dist or d<dist) then best,dist=p,d end
        end
    end
    return best,dist
end
function E.scan(root)
    local folder=root:FindFirstChild('EnemySpawns')
    if folder then
        for _,marker in folder:GetChildren() do
            if marker:IsA('BasePart') and not E.SpawnSet[marker] then
                E.SpawnSet[marker]=true;table.insert(E.Spawns,{Marker=marker,Next=0,Root=root})
            end
        end
    end
end
local function spawnEnemy(s)
    local kind=s.Marker:GetAttribute('EnemyKind');local def=Catalog.Enemies[kind]
    if not def then return end
    local paint=Color3.fromRGB(table.unpack(def.Color))
    local avatar=game:GetService('ServerStorage'):FindFirstChild('EldravynEnemyAvatarLibrary')
    local factory=if avatar and avatar:GetAttribute('Ready')==true then require(avatar.Factory)else Rig
    local model,hum,root=factory.create(s.Root,def.Name,s.Marker.Position,paint,true,kind)
    model:SetAttribute('EnemyKind',kind);model:SetAttribute('HealthMax',def.Health);model:SetAttribute('Health',def.Health)
    local health=def.Health;local heightOffset=3
    if def.Boss then
        local participants=0;for _,p in Players:GetPlayers()do local r=Security.alive(p);if r and (r.Position-s.Marker.Position).Magnitude<100 then participants+=1 end end
        health=math.floor(def.Health*(1+0.35*(math.clamp(participants,1,4)-1)))
        local scale=if kind=='Malgorth' then 2.2 else 1.7
        model:ScaleTo(scale);heightOffset=3*scale
        model:PivotTo(CFrame.new(s.Marker.Position+Vector3.new(0,heightOffset,0)))
        model:SetAttribute('Boss',true);model:SetAttribute('PartyScale',math.clamp(participants,1,4))
    end
    model:SetAttribute('HealthMax',health);model:SetAttribute('Health',health)
    hum.MaxHealth=health;hum.Health=health;hum.WalkSpeed=def.Speed
    local multiplier=s.Marker:GetAttribute('Difficulty') or 1
    health=math.floor(health*multiplier);hum.MaxHealth=health;hum.Health=health
    model:SetAttribute('HealthMax',health);model:SetAttribute('Health',health)
    local e={Model=model,Hum=hum,Root=root,Kind=kind,Def=def,MaxHealth=health,HeightOffset=heightOffset,Spawn=s,Home=s.Marker.Position,LastAttack=0,Contributors={},State='IDLE',PathAt=0,Waypoints=nil,Waypoint=1,PathBusy=false,Target=nil,LastSpecial=os.clock(),SpecialCooldown=5}
    e.Damage=math.floor(def.Damage*math.min(2.5,multiplier))
    s.Enemy=e;E.Active[model]=e
    hum.HealthChanged:Connect(function(h) if model.Parent then model:SetAttribute('Health',h) end end)
    hum.Died:Connect(function()
        e.State='DEAD';model:SetAttribute('State','DEAD')
        if kind=='Malgorth' then s.Root:SetAttribute('BossDefeated',true) end
        if s.Marker:GetAttribute('Once') then s.Marker:SetAttribute('Defeated',true) end
        if E.OnKill then local ok,err=xpcall(function()E.OnKill(e)end,debug.traceback);if not ok then warn(err)end end
        E.Active[model]=nil;s.Enemy=nil;s.Next=os.clock()+(if kind=='Malgorth' or kind=='Knight' then 300 else 25)
        task.delay(4,function() if model.Parent then model:Destroy() end end)
    end)
end
function E.damage(model,player,damage)
    local e=E.Active[model]
    if not e or e.Hum.Health<=0 then return false end
    if E.CanTarget and not E.CanTarget(player,e.Spawn and e.Spawn.Root) then return false end
    if type(damage)~='number' or damage~=damage or damage<=0 or damage>100000 then return false end
    local actual=math.min(damage,e.Hum.Health)
    if e.Spawn and e.Spawn.Marker:GetAttribute('Training') then
        e.Hum.Health=e.Hum.MaxHealth;e.ReactionUntil=os.clock()+0.15;return true
    end
    e.Contributors[player]=(e.Contributors[player] or 0)+actual
    e.Hum:TakeDamage(actual);e.ReactionUntil=os.clock()+0.15;return true
end
local function pathTo(e,target)
    if e.PathBusy or os.clock()-e.PathAt<2 then return end
    e.PathAt=os.clock();e.PathBusy=true
    task.spawn(function()
        local path=Pathfinding:CreatePath({AgentRadius=2,AgentHeight=6,AgentCanJump=true})
        local ok=pcall(function() path:ComputeAsync(e.Root.Position,target) end)
        if e.Model.Parent and ok and path.Status==Enum.PathStatus.Success then
            e.Waypoints=path:GetWaypoints();e.Waypoint=2;e.PathGoal=target
        end
        e.PathBusy=false
    end)
end
function E.resolveSwing(e,now)
    local swing=e.Swing
    if not swing then return end
    if e.Hum.Health<=0 or now<(e.StunnedUntil or 0) or (e.Root.Position-e.Home).Magnitude>95 then e.Swing=nil;return end
    if now<swing.At then return end
    e.Swing=nil
    local r=Security.alive(swing.Player)
    local delta=r and r.Position-e.Root.Position
    if not delta or delta.Magnitude>swing.Range or (delta.Magnitude>0.01 and swing.Direction and delta.Unit:Dot(swing.Direction)<0.1) then return end
    if E.CanTarget and not E.CanTarget(swing.Player,e.Spawn and e.Spawn.Root) then return end
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={e.Model}
    local hit=workspace:Raycast(e.Root.Position,delta,params)
    if E.OnPlayerHit and (not hit or hit.Instance:IsDescendantOf(swing.Player.Character)) then
        E.OnPlayerHit(swing.Player,e.Damage or e.Def.Damage,e.Root.Position,e,true)
    end
end
function E.step()
    local now=os.clock();local count=0
    for _ in E.Active do count+=1 end
    local cap=Config.QualityProfiles[Config.Quality].ActiveEnemies
    for _,s in E.Spawns do
        if s.Marker.Parent and s.Marker:GetAttribute('Enabled')~=false and not s.Marker:GetAttribute('Defeated') and not s.Enemy and now>=s.Next and count<cap and nearest(s.Marker.Position,220,s.Root) then
            if not (s.Marker:GetAttribute('EnemyKind')=='Malgorth' and s.Root:GetAttribute('BossDefeated')) then spawnEnemy(s);count+=1 end
        end
    end
    for model,e in E.Active do
        if e.Spawn and e.Spawn.Marker:GetAttribute('Enabled')==false then
            E.Active[model]=nil;e.Spawn.Enemy=nil;model:Destroy();continue
        end
        if not model.Parent or not e.Root.Parent then E.Active[model]=nil;e.Spawn.Enemy=nil;continue end
        if now<(e.BurnUntil or 0) and now-(e.LastBurn or 0)>0.75 and e.BurnOwner then e.LastBurn=now;E.damage(model,e.BurnOwner,5) end
        if e.Hum.Health<=0 then continue end
        e.Hum.WalkSpeed=if now<(e.SlowUntil or 0) then e.Def.Speed*0.5 else e.Def.Speed
        if now-(e.LastPressure or 0)>2 then e.Posture=math.max(0,(e.Posture or 0)-4) end
        model:SetAttribute('Posture',e.Posture or 0)
        if now<(e.StunnedUntil or 0) then e.Pending=nil;e.Swing=nil;e.Hum:MoveTo(e.Root.Position);model:SetAttribute('State','STAGGER');continue end
        local homeDist=(e.Root.Position-e.Home).Magnitude
        if e.Pending and (homeDist>95 or now<(e.StunnedUntil or 0)) then e.Pending=nil end
        if e.Def.Boss and homeDist<=95 then
            local phase=if e.Hum.Health<(e.MaxHealth or e.Def.Health)*0.5 then 2 else 1;model:SetAttribute('Phase',phase)
            if not e.Pending and not e.Swing and nearest(e.Root.Position,45,e.Spawn and e.Spawn.Root) and now-(e.LastSpecial or now-2)>e.SpecialCooldown then
                e.PatternIndex=(e.PatternIndex or 0)+1
                local pattern=Patterns.boss(e.Kind,phase,e.PatternIndex)
                e.LastSpecial=now;e.SpecialCooldown=pattern.Cooldown
                e.Pending={At=now+pattern.Windup,Origin=e.Root.Position,Pattern=pattern}
                if E.OnWarning then E.OnWarning({Kind='Warning',Position=e.Root.Position,Radius=pattern.Radius,InnerRadius=pattern.InnerRadius,Seconds=pattern.Windup,HeightOffset=e.HeightOffset or 3,Name=pattern.Name,Phase=phase}) end
            end
            if e.Pending then
                e.Hum:MoveTo(e.Root.Position);model:SetAttribute('State','WINDUP')
                if now>=e.Pending.At then
                    local pending=e.Pending;e.Pending=nil
                    for _,p in Players:GetPlayers() do
                        local pr=Security.alive(p)
                        local delta=pr and pr.Position-pending.Origin
                        if delta and (not E.CanTarget or E.CanTarget(p,e.Spawn and e.Spawn.Root)) and Patterns.inArea(Vector2.new(delta.X,delta.Z).Magnitude,delta.Y,pending.Pattern) then
                            local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={model}
                            local hit=workspace:Raycast(pending.Origin,pr.Position-pending.Origin,params)
                            if E.OnPlayerHit and (not hit or hit.Instance:IsDescendantOf(p.Character))then E.OnPlayerHit(p,(e.Damage or e.Def.Damage)*pending.Pattern.Multiplier,pending.Origin,e,false)end
                        end
                    end
                end
                continue
            end
        end
        if e.Swing then
            e.Hum:MoveTo(e.Root.Position);model:SetAttribute('State','WINDUP')
            E.resolveSwing(e,now)
            continue
        end
        local player,dist=nearest(e.Root.Position,90,e.Spawn and e.Spawn.Root)
        local homeDist=(e.Root.Position-e.Home).Magnitude
        local target
        if homeDist>95 or not player then
            e.State=if homeDist>8 then 'RETURN' elseif math.floor(now/4)%2==0 then 'IDLE' else 'PATROL'
            target=e.Home+Vector3.new(math.sin(now*0.12)*5,3,math.cos(now*0.12)*5)
        elseif dist<7+(if e.Kind=='Malgorth' then 3 else 0) then
            e.State='ATTACK';e.Hum:MoveTo(e.Root.Position)
            local pRoot=Security.alive(player)
            local rayParams=RaycastParams.new();rayParams.FilterType=Enum.RaycastFilterType.Exclude;rayParams.FilterDescendantsInstances={model}
            local hit=pRoot and workspace:Raycast(e.Root.Position,pRoot.Position-e.Root.Position,rayParams)
            if pRoot and now-e.LastAttack>1.3 and (not hit or hit.Instance:IsDescendantOf(player.Character)) then
                e.LastAttack=now
                local delta=pRoot.Position-e.Root.Position
                e.Swing={Player=player,At=now+(e.Def.Windup or 0.65),Direction=if delta.Magnitude>0.01 then delta.Unit else nil,Range=7+(if e.Kind=='Malgorth' then 3 else 0)}
                if E.OnWarning then E.OnWarning({Kind='MeleeWarning',Position=e.Root.Position,Seconds=e.Def.Windup or 0.65,Name=e.Def.Name,Target=player.UserId}) end
            end
        else e.State='CHASE';local r=Security.alive(player);target=r and r.Position end
        model:SetAttribute('State',e.State)
        if target and e.State~='IDLE' then
            if e.Waypoints and e.PathGoal and (target-e.PathGoal).Magnitude>18 then e.Waypoints=nil end
            pathTo(e,target)
            local points=e.Waypoints
            local wp=points and points[e.Waypoint]
            if wp then
                if (wp.Position-e.Root.Position).Magnitude<5 then e.Waypoint+=1;wp=points[e.Waypoint] end
                if wp then if wp.Action==Enum.PathWaypointAction.Jump then e.Hum.Jump=true end;e.Hum:MoveTo(wp.Position) end
            end
            -- Sem caminho válido não atravessa paredes tentando mover o CFrame.
        end
        if not nearest(e.Home,300,e.Spawn and e.Spawn.Root) then
            E.Active[model]=nil;e.Spawn.Enemy=nil;e.Spawn.Next=now+3;model:Destroy()
        end
    end
    for _,d in workspace:GetChildren() do
        if d.Name=='GeneratedDungeon' and d:FindFirstChild('Traps') then
            for _,trap in d.Traps:GetChildren() do
                local active=math.floor(now/2)%2==0
                trap.Transparency=if active then 0 else 0.7
                if active then
                    for _,p in Players:GetPlayers() do
                        if Security.near(p,trap,7) and Security.allow(p,'trap',1) then if E.OnPlayerHit then E.OnPlayerHit(p,12,trap.Position) end end
                    end
                end
            end
        end
    end
end
function E.clearScope(scope)
    for model,e in E.Active do
        if e.Spawn and e.Spawn.Root==scope then e.Spawn.Enemy=nil;E.Active[model]=nil;model:Destroy() end
    end
end
function E.start()
    if E.Running then return end;E.Running=true
    local last=0
    game:GetService('RunService').Heartbeat:Connect(function()
        local now=os.clock();if now-last<0.03 then return end;last=now
        for _,e in E.Active do if e.Swing then E.resolveSwing(e,now) end end
    end)
    task.spawn(function() while task.wait(0.25) do local ok,err=xpcall(E.step,debug.traceback);if not ok then warn(err) end end end)
end
return E
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="37">
      <Properties>
        <string name="Name">RegisterImported</string>
        <string name="Source"><![CDATA[-- Studio authoring only; geometry is imported/published by Roblox's 3D Importer.
-- Never loads catalog models, executes imported code, or invents asset IDs.
local Register={}
local Catalog=require(script.Parent.Shared.AvatarCatalog)
local Frame=require(script.Parent.Shared.ImportFrame)
local function editor()local r=game:GetService('RunService');assert(r:IsStudio() and not r:IsRunning(),'Use o editor do Studio, com Play/Run parado.')end
local function vec(v)return {v.X,v.Y,v.Z}end
local function folder(name,parent)local f=Instance.new('Folder');f.Name=name;f.Parent=parent;return f end
local function normalized(part,basis,origin)
 local p=Frame.point(basis,vec(part.Position));local c={part.CFrame:GetComponents()}
 local x=Frame.direction(basis,{c[4],c[7],c[10]});local y=Frame.direction(basis,{c[5],c[8],c[11]});local z=Frame.direction(basis,{c[6],c[9],c[12]})
 return CFrame.new(p[1]-origin[1],p[2]-origin[2],p[3]-origin[3],x[1],y[1],z[1],x[2],y[2],z[2],x[3],y[3],z[3])
end
local function texture(part)
 local sa=part:FindFirstChildOfClass('SurfaceAppearance');local id=if sa then sa.ColorMap else part.TextureID
 assert(Frame.asset(id),'Atlas não publicado/importado em '..part.Name..'. Importe as texturas no Studio junto do FBX.')
 if sa then for _,key in {'NormalMap','MetalnessMap','RoughnessMap'}do local value=sa[key];assert(value=='' or Frame.asset(value),'Mapa PBR inválido: '..part.Name..'/'..key)end end
 return sa
end
function Register.Apply(imported)
 editor();assert(typeof(imported)=='Instance' and imported~=workspace and imported:IsDescendantOf(game),'Selecione o Model de UM arquivo FBX importado, não o Workspace inteiro.')
 local samples,parts,seen,group={},{},{},nil
 local revisionName='ELDRAVYN_ART_'..Catalog.ArtRevision:gsub('%W','_');local revisionFound=false
 for _,node in imported:GetDescendants()do
  assert(not node:IsA('LuaSourceContainer'),'O grupo importado contém scripts; somente o FBX original é aceito.')
  local marker=node.Name:match('^ELDRAVYN_CAL_([OXYZ])$')
  if node.Name==revisionName then assert(node:IsA('BasePart')and not revisionFound,'Marcador de revisão duplicado/inválido');revisionFound=true
  elseif marker then assert(node:IsA('BasePart') and not samples[marker],'Marcador duplicado/inválido');samples[marker]=vec(node.Position)
  elseif node:IsA('MeshPart') then
   local key,bone=node.Name:match('^(.-)__(.+)$');local def=key and Catalog.Models[key]
   assert(def and table.find(def.Bones,bone),'Nome de mesh desconhecido: '..node.Name..'. Preserve os nomes durante a importação.')
   assert(group==nil or group==def.Group,'Mais de um grupo FBX selecionado; registre cada arquivo separadamente.');group=def.Group
   assert(not seen[node.Name],'Mesh duplicado: '..node.Name);seen[node.Name]=true
   assert(Frame.asset(node.MeshId),'Mesh sem ID publicado: '..node.Name);texture(node)
   parts[key]=parts[key]or{};parts[key][bone]=node
  end
 end
 assert(group,'Nenhuma malha de avatar encontrada');assert(revisionFound,'Revisão do FBX incompatível. Importe os arquivos arredondados desta entrega, preservando o marcador de revisão.');local basis=Frame.basis(samples)
 local count=0
 for key,def in Catalog.Models do if def.Group==group then
  assert(parts[key],'Modelo ausente: '..key);for _,bone in def.Bones do assert(parts[key][bone],'Peça ausente: '..key..'/'..bone)end;count+=1
 end end
 local root=script.Parent;local installed=root:FindFirstChild('ImportedTemplates')
 if installed then
  for key in parts do assert(not installed:FindFirstChild(key),'Grupo já registrado: '..group..'. Mantenha a biblioteca existente ou importe uma nova cópia do pacote para atualizar assets.')end
 end
 local prepared=folder('PreparedAvatarTemplates')
 local ok,err=pcall(function()
  for key,nodes in parts do
   local model=folder(key,prepared);local def=Catalog.Models[key];model:SetAttribute('AvatarGroup',group);model:SetAttribute('AvatarRigKind',def.Kind)
   for bone,node in nodes do
    local clone=node:Clone();clone.Name=bone
    -- MeshPart content is retained; only audited appearance children survive.
    for _,child in clone:GetChildren()do if not child:IsA('SurfaceAppearance') then child:Destroy()end end
    clone.Size=node.Size/basis.Scale;clone.CFrame=normalized(node,basis,def.Origin)
    clone.Anchored=false;clone.Massless=true;clone.CanCollide=false;clone.CanQuery=false;clone.CanTouch=false;clone.DoubleSided=true
    clone:SetAttribute('AvatarBone',bone);clone:SetAttribute('AvatarTemplate',key);clone:SetAttribute('VisualDetail',1);clone.Parent=model
   end
  end
 end)
 if not ok then prepared:Destroy();error(err)end
 if not installed then installed=folder('ImportedTemplates',root);installed:SetAttribute('AvatarVersion',3)end
 for _,model in prepared:GetChildren()do model.Parent=installed end;prepared:Destroy()
 print('[Avatar] '..count..' modelos registrados do grupo '..group..'. Nenhum NPC/mapa foi alterado.')
 return {Group=group,Registered=count}
end
function Register.Report()
 local installed=script.Parent:FindFirstChild('ImportedTemplates');local missing={};local ready=0
 for key in Catalog.Models do if installed and installed:FindFirstChild(key) then ready+=1 else table.insert(missing,key)end end
 table.sort(missing);print('[Avatar] '..ready..' modelos registrados; '..#missing..' pendentes de Import 3D.');return {Ready=ready,Missing=missing}
end
function Register.SetPBR(colorMap,metalnessMap,roughnessMap)
 editor();assert(workspace:GetAttribute('EldravynAvatarArtVersion')==nil,'Configure PBR antes de Apply; reverta a camada Avatar para editar os templates.')
 for _,id in {colorMap,metalnessMap,roughnessMap}do assert(Frame.asset(id),'Use o ID real de cada PNG publicado na sua conta.')end
 local templates=script.Parent:FindFirstChild('ImportedTemplates');assert(templates,'Registre os FBX antes dos mapas PBR')
 local count=0
 for _,p in templates:GetDescendants()do if p:IsA('MeshPart')then
  local surface=p:FindFirstChildOfClass('SurfaceAppearance')or Instance.new('SurfaceAppearance');surface.Name='AvatarPBR';surface.ColorMap=colorMap;surface.MetalnessMap=metalnessMap;surface.RoughnessMap=roughnessMap;surface.Parent=p;count+=1
 end end
 return{Meshes=count}
end
return Register
]]></string>
      </Properties>
    </Item>
