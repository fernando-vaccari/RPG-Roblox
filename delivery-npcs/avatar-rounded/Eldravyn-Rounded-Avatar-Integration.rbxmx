NPC_MalgorthDepths_Administrator",["Label"]="MalgorthDepths_Administrator",["Kind"]="R15",["Origin"]={6,0,6},["Group"]="Dungeons",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="MalgorthDepths_Administrator",["Role"]="Dungeon",["City"]="MalgorthDepths"},["NPC_FallenSanctum_Administrator"]={["Key"]="NPC_FallenSanctum_Administrator",["Label"]="FallenSanctum_Administrator",["Kind"]="R15",["Origin"]={13,0,6},["Group"]="Dungeons",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="FallenSanctum_Administrator",["Role"]="Dungeon",["City"]="FallenSanctum"},["ENEMY_Bandit"]={["Key"]="ENEMY_Bandit",["Label"]="Bandido",["Kind"]="R15",["Origin"]={22,0,6},["Group"]="Dungeons",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["EnemyKind"]="Bandit"},["ENEMY_DarkWolf"]={["Key"]="ENEMY_DarkWolf",["Label"]="Lobo Sombrio",["Kind"]="Quadruped",["Origin"]={30,0,6},["Group"]="Dungeons",["Bones"]={"BeastBody","BeastHead","FrontLeft","HindLeft","FrontRight","HindRight","BeastTail"},["EnemyKind"]="DarkWolf"},["ENEMY_Demon"]={["Key"]="ENEMY_Demon",["Label"]="Soldado Demoníaco",["Kind"]="R15",["Origin"]={38,0,6},["Group"]="Dungeons",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["EnemyKind"]="Demon"},["ENEMY_FallenRegent"]={["Key"]="ENEMY_FallenRegent",["Label"]="Regente do Reino Caído",["Kind"]="R15",["Origin"]={6,0,1