        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">AvatarCatalog</string>
          <string name="Source"><![CDATA[-- Generated from original mesh authoring; gameplay catalog remains unchanged.
return {["Version"]=3,["ArtRevision"]="rounded-1",["Models"]={["NPC_Valoria_GuildMaster"]={["Key"]="NPC_Valoria_GuildMaster",["Label"]="Valoria_GuildMaster",["Kind"]="R15",["Origin"]={6,0,6},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_GuildMaster",["Role"]="GuildMaster",["City"]="Valoria"},["NPC_Valoria_Reception"]={["Key"]="NPC_Valoria_Reception",["Label"]="Valoria_Reception",["Kind"]="R15",["Origin"]={13,0,6},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Reception",["Role"]="Reception",["City"]="Valoria"},["NPC_Valoria_Blacksmith"]={["Key"]="NPC_Valoria_Blacksmith",["Label"]="Valoria_Blacksmith",["Kind"]="R15",["Origin"]={20,0,6},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Blacksmith",["Role"]="Blacksmith",["City"]="Valoria"},["NPC_Valoria_Weapons"]={["Key"]="NPC_Valoria_Weapons",["Label"]="Valoria_Weapons",["Kind"]="R15",["Origin"]={27,0,6},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Weapons",["Role"]="Weapons",["City"]="Valoria"},["NPC_Valoria_Armor"]={["Key"]="NPC_Valoria_Armor",["Label"]="Valoria_Armor",["Kind"]="R15",["Origin"]={34,0,6},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Armor",["Role"]="Armor",["City"]="Valoria"},["NPC_Valoria_General"]={["Key"]="NPC_Valoria_General",["Label"]="Valoria_General",["Kind"]="R15",["Origin"]={6,0,14},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_General",["Role"]="General",["City"]="Valoria"},["NPC_Valoria_Classes"]={["Key"]="NPC_Valoria_Classes",["Label"]="Valoria_Classes",["Kind"]="R15",["Origin"]={13,0,14},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Classes",["Role"]="Classes",["City"]="Valoria"},["NPC_Valoria_Magic"]={["Key"]="NPC_Valoria_Magic",["Label"]="Valoria_Magic",["Kind"]="R15",["Origin"]={20,0,14},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Magic",["Role"]="Magic",["City"]="Valoria"},["NPC_Valoria_Skills"]={["Key"]="NPC_Valoria_Skills",["Label"]="Valoria_Skills",["Kind"]="R15",["Origin"]={27,0,14},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Skills",["Role"]="Skills",["City"]="Valoria"},["NPC_Valoria_Races"]={["Key"]="NPC_Valoria_Races",["Label"]="Valoria_Races",["Kind"]="R15",["Origin"]={34,0,14},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Races",["Role"]="Races",["City"]="Valoria"},["NPC_Valoria_Fusions"]={["Key"]="NPC_Valoria_Fusions",["Label"]="Valoria_Fusions",["Kind"]="R15",["Origin"]={6,0,22},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Fusions",["Role"]="Fusions",["City"]="Valoria"},["NPC_Valoria_Inn"]={["Key"]="NPC_Valoria_Inn",["Label"]="Valoria_Inn",["Kind"]="R15",["Origin"]={13,0,22},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Inn",["Role"]="Inn",["City"]="Valoria"},["NPC_Valoria_Healer"]={["Key"]="NPC_Valoria_Healer",["Label"]="Valoria_Healer",["Kind"]="R15",["Origin"]={20,0,22},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Healer",["Role"]="Healer",["City"]="Valoria"},["NPC_Valoria_Bank"]={["Key"]="NPC_Valoria_Bank",["Label"]="Valoria_Bank",["Kind"]="R15",["Origin"]={27,0,22},["Group"]="Valoria",["Bones"]={"UpperTorso","LowerTorso","Head","LeftUpperArm","LeftLowerArm","LeftHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperArm","RightLowerArm","RightHand","RightUpperLeg","RightLowerLeg","RightFoot"},["NPCId"]="Valoria_Bank",["Role"]="Bank",["City"]="Valoria"},["NPC_Valoria_Guide"]={["Key"]="NPC_Valoria_Guide",["Label"]="Valoria_Guide",["Kin