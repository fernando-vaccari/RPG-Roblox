uadruped"]={["BeastBody"]={0,1.5,0},["BeastHead"]={0,1.7,-1.15},["FrontLeft"]={-0.48,0.7,-0.75},["FrontRight"]={0.48,0.7,-0.75},["HindLeft"]={-0.48,0.7,0.85},["HindRight"]={0.48,0.7,0.85},["BeastTail"]={0,1.6,1.4}},["NPCs"]={["Valoria_GuildMaster"]="NPC_Valoria_GuildMaster",["Valoria_Reception"]="NPC_Valoria_Reception",["Valoria_Blacksmith"]="NPC_Valoria_Blacksmith",["Valoria_Weapons"]="NPC_Valoria_Weapons",["Valoria_Armor"]="NPC_Valoria_Armor",["Valoria_General"]="NPC_Valoria_General",["Valoria_Classes"]="NPC_Valoria_Classes",["Valoria_Magic"]="NPC_Valoria_Magic",["Valoria_Skills"]="NPC_Valoria_Skills",["Valoria_Races"]="NPC_Valoria_Races",["Valoria_Fusions"]="NPC_Valoria_Fusions",["Valoria_Inn"]="NPC_Valoria_Inn",["Valoria_Healer"]="NPC_Valoria_Healer",["Valoria_Bank"]="NPC_Valoria_Bank",["Valoria_Guide"]="NPC_Valoria_Guide",["Valoria_Tutorial"]="NPC_Valoria_Tutorial",["Valoria_TravelShop"]="NPC_Valoria_TravelShop",["Arkheim_Guide"]="NPC_Arkheim_Guide",["Arkheim_General"]="NPC_Arkheim_General",["Arkheim_Inn"]="NPC_Arkheim_Inn",["Eldoria_Guide"]="NPC_Eldoria_Guide",["Eldoria_General"]="NPC_Eldoria_General",["Eldoria_Inn"]="NPC_Eldoria_Inn",["Durakh_Guide"]="NPC_Durakh_Guide",["Durakh_General"]="NPC_Durakh_General",["Durakh_Inn"]="NPC_Durakh_Inn",["Asterion_Guide"]="NPC_Asterion_Guide",["Asterion_General"]="NPC_Asterion_General",["Asterion_Inn"]="NPC_Asterion_Inn",["Valoria_Ambient_Guard"]="NPC_Valoria_Ambient_Guard",["Valoria_Ambient_Resident"]="NPC_Valoria_Ambient_Resident",["Valoria_Ambient_Traveler"]="NPC_Valoria_Ambient_Traveler",["Valoria_Ambient_Artisan"]="NPC_Valoria_Ambient_Artisan",["Valoria_Ambient_Employee"]="NPC_Valoria_Ambient_Employee",["Valoria_Ambient_Adventurer"]="NPC_Valoria_Ambient_Adventurer",["Valoria_Ambient_Farmer"]="NPC_Valoria_Ambient_Farmer",["Arkheim_Ambient_Guard"]="NPC_Arkheim_Ambient_Guard",["Arkheim_Ambient_Resident"]="NPC_Arkheim_Ambient_Resident",["Arkheim_Ambient_Traveler"]="NPC_Arkheim_Ambient_Traveler",["Arkheim_Ambient_Artisan"]