        {Id="SylvarinTrail",A={X=1150,Z=-150,H=48},B={X=1100,Z=-1100,H=44},Width=12,Points={{X=1150,Z=-150,H=48},{X=1150,Z=-530,H=48},{X=1260,Z=-700,H=51},{X=1010,Z=-790,H=49},{X=1100,Z=-1100,H=44}}},
