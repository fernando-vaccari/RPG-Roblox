      <Item class="Folder" referent="base_10">
        <Properties>
          <string name="Name">Core</string>
        </Properties>
        <Item class="ModuleScript" referent="base_11">
          <Properties>
            <string name="Name">ActionMath</string>
            <string name="Source">-- Pure budgets used by the runtime, including large-frame protection.
local M={}
function M.travel(speed,remaining,dt)
 assert(type(speed)=='number' and speed&gt;0 and speed&lt;1000)
 assert(type(dt)=='number' and dt==dt)
 return math.min(math.max(0,remaining),speed*math.clamp(dt,0,0.1))
end
function M.boss(kind,phase,index)
 local names=if kind=='Malgorth' then {'Ruptura do Trono','Círculo da Condenação'} elseif kind=='SylvarinBoss' then {'Raízes do Juramento','Vigília do Bosque'} else {'Pulso Sombrio','Eco das Ruínas'}
 return {Name=names[index%2+1],Radius=if phase==2 then 24 else 14,Windup=if phase==2 then 1.4 else 1.2,InnerRadius=if index%2==0 then (if phase==2 then 9.6 else 5.6)else 0,Height=if index%2==0 then 4 else 10,Multiplier=if index%2==0 then 1.2 else 1.4,Cooldown=if phase==2 then 6 else 9}
end
function M.inArea(horizontal,vertical,pattern)
 return horizontal&lt;=pattern.Radius and horizontal&gt;=(pattern.InnerRadius or 0) and math.abs(vertical)&lt;=(pattern.Height or 10)
end
return M
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_12">
          <Properties>
            <string name="Name">AdventureRules</string>
            <string name="Source">local A={}
function A.restore(profile,raw,config)
 raw=if type(raw)=='table' then raw else {}
 profile.Adventure={Version=config.Version,Tutorial={},DefenseClaims={}}
 for _,city in {'Valoria','Arkheim'} do
  local stamp=type(raw.DefenseClaims)=='table' and raw.DefenseClaims[city]
  if type(stamp)=='number' and stamp==stamp and stamp%1==0 and stamp&gt;=0 and stamp&lt;=1e12 then profile.Adventure.DefenseClaims[city]=stamp end
 end
 for _,step in config.Tutorial do
  if type(raw.Tutorial)=='table' and raw.Tutorial[step.Id]==true then profile.Adventure.Tutorial[step.Id]=true end
 end
 -- Existing characters retain their accomplishments; practice objectives remain available.
 if profile.StarterChosen then profile.Adventure.Tutorial.Weapon=true end
 if profile.Rank~='' then profile.Adventure.Tutorial.Guild=true end
 if profile.Quests.FirstSteps and profile.Quests.FirstSteps.Claimed then profile.Adventure.Tutorial.Quest=true end
end
function A.event(profile,config,event)
 if not profile.Adventure then A.restore(profile,nil,config) end
 for _,step in config.Tutorial do
  if step.Id==event and not profile.Adventure.Tutorial[event] then profile.Adventure.Tutorial[event]=true;return true end
 end
 return false
end
function A.current(profile,config)
 for i,step in config.Tutorial do if not profile.Adventure or not profile.Adventure.Tutorial[step.Id] then return step,i end end
 return nil,#config.Tutorial+1
end
return A
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_13">
          <Properties>
            <string name="Name">BenefitPreview</string>
            <string name="Source">-- Approved grants only. Preview is a report and never mutates any wallet/receipt/race.
local Preview={}
function Preview.report(profile,config,key)
 local product=config.Products[key]
 if not product then return nil,'Benefícios deste produto ainda não definidos.' end
 local id=profile.Identity
 if not id then return nil,'Perfil indisponível.' end
 local before=if product.Grant=='Retry' then id.RetryCredits else id.Fusion[product.Grant]
 if type(before)~='number' then return nil,'Tipo de benefício desconhecido.' end
 return {Product=key,PlannedPrice=product.Robux,Grant=product.Grant,Before=before,After=math.min(1000000,before+product.Amount),Preview=true}
end
return Preview
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_14">
          <Properties>
            <string name="Name">CombatRules</string>
            <string name="Source">local R={}
function R.level(xp,c)
 local level=1
 while level&lt;c.MaxLevel and xp&gt;=c.XPBase+(level-1)*c.XPGrowth do xp-=c.XPBase+(level-1)*c.XPGrowth;level+=1 end
 return level,xp,c.XPBase+(level-1)*c.XPGrowth
end
function R.canUse(class,skillClass,c)
 return class==skillClass or c.Classes[class]~=nil and c.Classes[class].Base==skillClass
end
function R.stats(profile,c)
 local level=R.level(profile.XP,c);local base=c.Classes[profile.Class] or {Health=100,Mana=80,Stamina=100,Damage=1,Defense=0,Speed=16}
 local race=c.RaceModifiers and profile.Identity and c.RaceModifiers[profile.Identity.Race] or {Health=0,Mana=0,Stamina=0}
 return {Level=level,Health=base.Health+race.Health+(level-1)*5+(if profile.Armor=='Armor' and (profile.Inventory.Armor or 0)&gt;0 then 40 else 0),Mana=base.Mana+race.Mana+(level-1)*3,Stamina=base.Stamina+race.Stamina+(level-1),Damage=base.Damage*(1+(level-1)*0.025),Defense=base.Defense+math.floor((level-1)/4),Speed=base.Speed}
end
function R.new(stats)
 return {Mana=stats.Mana,Stamina=stats.Stamina,Posture=0,BrokenUntil=0,Cooldowns={},Combo=0,LastPrimary=-100,RecoverUntil=0,DodgeUntil=0,GuardUntil=0,Blocking=false,Sprinting=false}
end
function R.step(s,stats,dt)
 dt=math.clamp(dt,0,0.5)
 s.Mana=math.min(stats.Mana,s.Mana+dt*6)
 s.Stamina=math.clamp(s.Stamina+dt*(if s.Sprinting or s.Blocking then -8 else 16),0,stats.Stamina)
 if s.Stamina==0 then s.Sprinting=false;s.Blocking=false end
end
function R.reserve(s,id,now,mana,stamina,cooldown,recovery)
 if now&lt;s.RecoverUntil or now&lt;(s.Cooldowns[id] or 0) or s.Blocking or s.Mana&lt;mana or s.Stamina&lt;stamina then return false end
 s.Mana-=mana;s.Stamina-=stamina;s.Cooldowns[id]=now+cooldown;s.RecoverUntil=now+(recovery or 0.25);return true
end
function R.primary(s,now,delay)
 if not R.reserve(s,'Primary',now,0,6,delay,delay*0.8) then return nil end
 s.Combo=if now-s.LastPrimary&gt;1.4 then 1 else s.Combo%4+1;s.LastPrimary=now
 return s.Combo,if s.Combo==4 then 1.65 else 1
end
function R.unlock(profile,id,config)
 local skill=config.Skills[id]
 if not skill or not R.canUse(profile.Class,skill.Class,config) or R.level(profile.XP,config)&lt;skill.Level then return false,'Classe/nível insuficiente.' end
 if skill.Level&lt;=1 then return false,'Habilidade inicial já disponível sem compra.' end
 profile.Unlocks=profile.Unlocks or {}
 if profile.Unlocks[id] then return false,'Habilidade já aprendida.' end
 if profile.Gold&lt;skill.Price then return false,'Gold insuficiente.' end
 profile.Gold-=skill.Price;profile.Unlocks[id]=true;return true,'Habilidade aprendida.'
end
return R
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_15">
          <Properties>
            <string name="Name">DefenseRules</string>
            <string name="Source">-- All times come from the server. Holding guard does not renew the parry window.
local D={ParryWindow=0.24,ParryCooldown=0.65,BreakSeconds=1.4,MaxPosture=100}
function D.init(s)
 s.Posture=s.Posture or 0;s.BrokenUntil=s.BrokenUntil or 0
 s.ParryUntil=s.ParryUntil or 0;s.NextParry=s.NextParry or 0;s.LastPressure=s.LastPressure or -100
end
function D.block(s,now,on)
 D.init(s)
 if not on then s.Blocking=false;s.ParryUntil=0;return true end
 if s.Blocking or now&lt;s.RecoverUntil or now&lt;s.BrokenUntil or s.Stamina&lt;10 then return false end
 s.Blocking=true;s.Sprinting=false
 if now&gt;=s.NextParry then s.ParryUntil=now+D.ParryWindow;s.NextParry=now+D.ParryCooldown end
 return true
end
function D.step(s,now,dt)
 D.init(s)
 if now&gt;=s.BrokenUntil and now-s.LastPressure&gt;1 then s.Posture=math.max(0,s.Posture-math.clamp(dt,0,0.5)*(if s.Blocking then 8 else 24)) end
end
function D.resolve(s,now,amount,front,parryable)
 D.init(s)
 if now&lt;s.DodgeUntil then return 0,'Dodge' end
 if s.Blocking and front and now&gt;=s.BrokenUntil then
  if parryable and now&lt;=s.ParryUntil and s.ParryUntil&gt;0 then
   s.ParryUntil=0;s.Posture=math.max(0,s.Posture-30);s.Stamina=math.max(0,s.Stamina-3)
   return 0,'Parry'
  end
  local pressure=math.clamp(amount*1.8,15,60)
  s.Posture=math.min(D.MaxPosture,s.Posture+pressure);s.LastPressure=now
  s.Stamina=math.max(0,s.Stamina-10)
  if s.Posture&gt;=D.MaxPosture or s.Stamina==0 then
   s.Blocking=false;s.Sprinting=false;s.ParryUntil=0;s.BrokenUntil=now+D.BreakSeconds
   s.RecoverUntil=math.max(s.RecoverUntil,s.BrokenUntil)
   return amount,'Break'
  end
  return amount*0.25,'Block'
 end
 return amount,'Hit'
end
function D.pressure(enemy,now,amount)
 enemy.Posture=math.min(100,(enemy.Posture or 0)+amount);enemy.LastPressure=now
 if enemy.Posture&lt;100 then return false end
 enemy.Posture=0;enemy.StunnedUntil=now+(if enemy.Def and enemy.Def.Boss then 1.2 else 2)
 enemy.Pending=nil;enemy.Swing=nil;return true
end
function D.critical(ticket)
 assert(type(ticket)=='number' and ticket%1==0 and ticket&gt;=1 and ticket&lt;=100)
 return if ticket&lt;=8 then 1.35 else 1 -- fixed 8%, independent of race/rarity
end
return D
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_16">
          <Properties>
            <string name="Name">DungeonRules</string>
            <string name="Source">local R={}
local function int(n,lo,hi)return type(n)=='number' and n==n and n%1==0 and n&gt;=lo and n&lt;=hi end
function R.restore(profile,raw,c)
 raw=if type(raw)=='table' then raw else {}
 local out={Best={},Clears={},Ticket=nil}
 for id,d in c.Dungeons do
  local best=type(raw.Best)=='table' and raw.Best[id]
  out.Best[id]=if int(best,0,d.Floors) then best else 0
  out.Clears[id]=out.Best[id]==d.Floors and type(raw.Clears)=='table' and raw.Clears[id]==true
 end
 local t=raw.Ticket
 if type(t)=='table' and c.Dungeons[t.Dungeon] and type(t.Run)=='string' and #t.Run&lt;=80 and #t.Run&gt;0 and int(t.Expires,1,1e12) then
  local members={};local seen={}
  if type(t.Members)=='table' then for _,id in t.Members do
   if int(id,-1e15,1e15) and id~=0 and not seen[id] and #members&lt;c.MaxPlayers then table.insert(members,id);seen[id]=true end
  end end
  if #members&gt;0 then out.Ticket={Dungeon=t.Dungeon,Run=t.Run,Expires=t.Expires,Members=members} end
 end
 profile.Expedition=out;return out
end
function R.floor(c,id,n)
 local d=c.Dungeons[id];assert(d and int(n,1,d.Floors),'Andar inválido')
 local boss=n%5==0
 local layout=if boss then 'Arena' else c.Layouts[(n-1)%#c.Layouts+1]
 local enemies={}
 local roster=if id=='FallenSanctum' then {'Shadow','Demon','DarkWolf','Skeleton'} else {'Skeleton','Demon','DarkWolf','Shadow'}
 for i=1,if boss then 1 else 2+(if n&gt;10 then 2 elseif n&gt;5 then 1 else 0) do
  table.insert(enemies,if boss then (if n==d.Floors then d.FinalBoss else 'Knight') else roster[(n+i-2)%#roster+1])
 end
 return {Index=n,Name=d.Titles[n],Layout=layout,X=d.X,Y=(n-1)*96,Z=d.Z,Enemies=enemies,Boss=boss,Scale=1+(n-1)*0.07+(if id=='FallenSanctum' then 0.45 else 0)}
end
function R.newRun(c,id,members,nonce,now)
 assert(c.Dungeons[id] and #members&gt;=1 and #members&lt;=c.MaxPlayers)
 local allowed={};for _,uid in members do assert(int(uid,-1e15,1e15) and uid~=0 and not allowed[uid]);allowed[uid]=true end
 return {Id=id,Nonce=nonce,Floor=1,Members=allowed,Eliminated={},State='Fighting',Remaining=0,Killed={},Expires=now+c.RunSeconds}
end
function R.beginFloor(run,ids)
 run.Remaining=#ids;run.Killed={};run.Expected={}
 for _,id in ids do assert(not run.Expected[id]);run.Expected[id]=true end
 run.State=if #ids==0 then 'Cleared' else 'Fighting'
end
function R.kill(run,id)
 if run.State~='Fighting' or not run.Expected[id] or run.Killed[id] then return false end
 run.Killed[id]=true;run.Remaining-=1
 if run.Remaining==0 then run.State='Cleared' end
 return true
end
function R.advance(run,c)
 if run.State~='Cleared' then return false end
 if run.Floor==c.Dungeons[run.Id].Floors then run.State='Complete';return true end
 run.Floor+=1;run.State='Preparing';return true
end
function R.eliminate(run,uid)
 if not run.Members[uid] then return false end
 run.Eliminated[uid]=true
 for id in run.Members do if not run.Eliminated[id] then return false end end
 if run.State~='Complete' then run.State='Failed' end;return true
end
function R.reward(profile,c,id,floor)
 local d=c.Dungeons[id]
 if not d or not int(floor,1,d.Floors) then return false end
 local s=profile.Expedition
 if floor&lt;=(s.Best[id] or 0) or floor~=(s.Best[id] or 0)+1 then return false end
 s.Best[id]=floor
 profile.Gold=math.min(1e9,profile.Gold+20+floor*5);profile.XP=math.min(1e9,profile.XP+30+floor*8)
 if floor==d.Floors then s.Clears[id]=true end
 return true
end
return R
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_17">
          <Properties>
            <string name="Name">EnvironmentRules</string>
            <string name="Source">local E={Profiles={LOW={FX=12,Rain=0,Bloom=0.04},MEDIUM={FX=20,Rain=12,Bloom=0.1},HIGH={FX=28,Rain=24,Bloom=0.15}}}
function E.weather(serverSeconds)
 local cycle=math.floor(serverSeconds/300)%4
 return if cycle==1 then 'Mist' elseif cycle==2 then 'Rain' else 'Clear'
end
return E
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_18">
          <Properties>
            <string name="Name">IdentityRules</string>
            <string name="Source">-- Núcleo puro, relógio e sorteio injetados pelo servidor. Nenhuma dependência do engine.
local I={}
local function int(v,min,max) return type(v)=='number' and v==v and v%1==0 and v&gt;=min and v&lt;=max end
function I.validate(c)
 local total=0;local seen={}
 for _,id in c.RaceOrder do local r=c.Races[id];assert(r and not seen[id] and int(r.Weight,1,100));seen[id]=true;total+=r.Weight end
 assert(total==100,'Probabilidades raciais devem somar exatamente 100')
 local products={}
 for _,p in c.Products do assert(int(p.Id,0,1e15) and int(p.Amount,1,100));if p.Id&gt;0 then assert(not products[p.Id],'ID de produto duplicado');products[p.Id]=true end end
 for _,a in c.Advanced do assert(table.find(c.PrimaryClasses,a.Base) and a.Level&gt;=1 and #a.Steps&gt;0) end
 return true
end
function I.pick(c,ticket)
 assert(int(ticket,1,100),'Ticket fora de 1..100');local bound=0
 for _,id in c.RaceOrder do bound+=c.Races[id].Weight;if ticket&lt;=bound then return id end end
 error('Probabilidades inválidas')
end
function I.new()
 return {Version=1,Race='',Evolution='',Classes={},Discoveries={},Challenges={},Racial={Status='Idle',Counts={},ReadyAt=0,Deadline=0},Fusion={Week=0,FreeUsed=0,Basic=0,Premium=0},Fragments=0,RetryCredits=0,Receipts={}}
end
local function stepsDone(steps,counts)
 for i,step in steps do if (counts[tostring(i)] or 0)&lt;step.Count then return false end end;return true
end
local function cleanCounts(steps,raw)
 local counts={}
 if type(raw)=='table' then for i,step in steps do local v=raw[tostring(i)];counts[tostring(i)]=if int(v,0,step.Count) then v else 0 end end
 return counts
end
function I.restore(profile,raw,c)
 local out=I.new();raw=if type(raw)=='table' then raw else {}
 if raw.Race~=nil and raw.Race~='' then assert(c.Races[raw.Race],'Raça persistida inválida; não sortear novamente');out.Race=raw.Race end
 for _,key in {'Fragments','RetryCredits'} do if int(raw[key],0,1000000) then out[key]=raw[key] end end
 for id in c.Secrets do if type(raw.Discoveries)=='table' and raw.Discoveries[id]==true then out.Discoveries[id]=true end end
 if type(raw.Receipts)=='table' then
  for id,v in raw.Receipts do if type(id)=='string' and #id&lt;=200 and v==true then out.Receipts[id]=true end end
 end
 local f=raw.Fusion
 if type(f)=='table' then for key,max in {Week=1000000,FreeUsed=c.Fusion.WeeklyFree,Basic=1000000,Premium=1000000} do if int(f[key],0,max) then out.Fusion[key]=f[key] end end end
 -- Base classes saved by the old system remain unlocked; advanced classes need challenge proof.
 for _,id in {'Guerreiro','Espadachim','Mago','Arqueiro'} do
  if profile.Class==id or type(raw.Classes)=='table' and raw.Classes[id]==true then out.Classes[id]=true end
 end
 for id,def in c.Advanced do
  local v=type(raw.Challenges)=='table' and raw.Challenges[id]
  if type(v)=='table' then
   local counts=cleanCounts(def.Steps,v.Counts)
   local completed=v.Status=='Complete' and stepsDone(def.Steps,counts)
   out.Challenges[id]={Status=if completed then 'Complete' elseif v.Status=='Active' then 'Active' else 'Idle',Counts=counts}
   if completed then out.Classes[id]=true;out.Classes[def.Base]=true end
  end
 end
 local race=c.Races[out.Race];local rq=raw.Racial
 if race and type(rq)=='table' then
  out.Racial.Counts=cleanCounts(race.Steps,rq.Counts)
  if int(rq.ReadyAt,0,1e12) then out.Racial.ReadyAt=rq.ReadyAt end
  if int(rq.Deadline,0,1e12) then out.Racial.Deadline=rq.Deadline end
  if rq.Status=='Complete' and stepsDone(race.Steps,out.Racial.Counts) then out.Racial.Status='Complete'
  elseif rq.Status=='Active' or rq.Status=='Failed' then out.Racial.Status=rq.Status end
  if out.Racial.Status=='Complete' and raw.Evolution==race.Evolution then out.Evolution=race.Evolution end
 end
 profile.Identity=out
 if type(raw.CurrentClass)=='string' and out.Classes[raw.CurrentClass] then profile.Class=raw.CurrentClass end
 out.CurrentClass=profile.Class
 return out
end
function I.assign(profile,c,ticket)
 local s=profile.Identity
 if s.Race~='' then assert(c.Races[s.Race]);return s.Race,false end
 s.Race=I.pick(c,ticket);return s.Race,true
end
function I.week(now) return math.floor((now+3*86400)/604800) end -- Monday 00:00 UTC
function I.refresh(profile,c,now)
 local s=profile.Identity;local week=I.week(now)
 if week&gt;s.Fusion.Week then s.Fusion.Week=week;s.Fusion.FreeUsed=0 end
 if s.Racial.Status=='Active' and now&gt;=s.Racial.Deadline then I.fail(profile,c,s.Racial.Deadline) end
end
function I.fail(profile,c,now)
 local q=profile.Identity.Racial
 if q.Status~='Active' then return false end
 q.Status='Failed';q.ReadyAt=now+c.RetrySeconds;q.Deadline=0;return true
end
function I.startRacial(profile,c,level,now)
 local s=profile.Identity;I.refresh(profile,c,now);local r=c.Races[s.Race]
 if not r or s.Evolution~='' or s.Racial.Status=='Active' or s.Racial.Status=='Complete' then return false,'Missão racial indisponível.' end
 if profile.Rank=='' or level&lt;c.RacialLevel or r.Secret and not s.Discoveries[r.Secret] then return false,'Faltam nível, registro ou descoberta racial.' end
 if now&lt;s.Racial.ReadyAt then
  if s.RetryCredits&lt;1 then return false,'Aguarde 24 horas ou use um crédito de nova tentativa.' end
  s.RetryCredits-=1
 end
 s.Racial={Status='Active',Counts={},ReadyAt=0,Deadline=now+c.RacialDuration};return true,'Missão racial iniciada. Morte ou prazo encerrado causa falha.'
end
function I.startClass(profile,c,id,level)
 local def=c.Advanced[id];local s=profile.Identity
 if not def or not s.Classes[def.Base] or level&lt;def.Level or def.Secret and not s.Discoveries[def.Secret] then return false,'Requisitos de classe/desafio não cumpridos.' end
 if s.Challenges[id] and s.Challenges[id].Status~='Idle' then return false,'Desafio já iniciado/concluído.' end
 s.Challenges[id]={Status='Active',Counts={}};return true,'Desafio de classe iniciado.'
end
local function advance(steps,q,event)
 local changed=false
 if not q or q.Status~='Active' then return false end
 for i,step in steps do
  local key=tostring(i);local before=q.Counts[key] or 0
  if step.Event==event then q.Counts[key]=math.min(step.Count,before+1);changed=changed or q.Counts[key]~=before end
 end
 return changed
end
function I.event(profile,c,event,now)
 I.refresh(profile,c,now);local s=profile.Identity;local changed=false
 local r=c.Races[s.Race];if r then changed=advance(r.Steps,s.Racial,event) end
 for id,def in c.Advanced do changed=advance(def.Steps,s.Challenges[id],event) or changed end
 return changed
end
function I.claimRacial(profile,c,now)
 I.refresh(profile,c,now);local s=profile.Identity;local r=c.Races[s.Race]
 if not r or s.Racial.Status~='Active' or not stepsDone(r.Steps,s.Racial.Counts) then return false,'Complete o desafio racial obrigatório.' end
 if s.Fragments&lt;c.EvolutionFragments then return false,'Faltam fragmentos de dungeon; eles não substituem a missão.' end
 s.Fragments-=c.EvolutionFragments;s.Racial.Status='Complete';s.Racial.Deadline=0;s.Evolution=r.Evolution
 return true,'Evolução racial conquistada.'
end
function I.claimClass(profile,c,id)
 local s=profile.Identity;local def=c.Advanced[id];local q=s.Challenges[id]
 if not def or not q or q.Status~='Active' or not stepsDone(def.Steps,q.Counts) then return false,'Desafio ainda incompleto.' end
 q.Status='Complete';s.Classes[id]=true;return true,'Classe avançada desbloqueada.'
end
function I.selectClass(profile,c,id)
 local s=profile.Identity
 if profile.Class==id then return false,'Classe já está ativa.' end
 if not s.Classes[id] then return false,'Classe bloqueada.' end
 profile.Class=id;s.CurrentClass=id;return true,'Classe selecionada; equipe a arma correspondente.'
end
function I.discover(profile,c,id)
 if not c.Secrets[id] or profile.Identity.Discoveries[id] then return false end
 profile.Identity.Discoveries[id]=true;return true
end
function I.grantReceipt(profile,c,receiptId,productId)
 local s=profile.Identity
 if type(receiptId)~='string' or #receiptId==0 or #receiptId&gt;200 then return false end
 local product
 for _,p in c.Products do if p.Id&gt;0 and p.Id==productId then product=p end end
 if not product then return false end
 if s.Receipts[receiptId] then return true end
 if product.Grant=='Retry' then s.RetryCredits=math.min(1000000,s.RetryCredits+product.Amount)
 else s.Fusion[product.Grant]=math.min(1000000,s.Fusion[product.Grant]+product.Amount) end
 s.Receipts[receiptId]=true;return true
end
function I.buyFusion(profile,c,kind)
 if next(c.Fusion.Recipes)==nil then return false,'Catálogo de fusões aguarda definição; nenhuma moeda foi cobrada.' end
 if kind~='Basic' then return false,'Compra com Gold disponível somente para tentativa básica.' end
 if profile.Gold&lt;c.Fusion.GoldPrice then return false,'Gold insuficiente.' end
 profile.Gold-=c.Fusion.GoldPrice;profile.Identity.Fusion.Basic+=c.Fusion.GoldPack;return true,'Tentativa básica adquirida.'
end
function I.fuse(profile,c,id,now)
 I.refresh(profile,c,now)
 -- Não há algoritmo/resultado autorizado ainda. Não debitar tentativas nem fragmentos.
 return false,'Fusão desativada: combinações e resultados aguardam definição do criador.'
end
return I
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_19">
          <Properties>
            <string name="Name">InteriorPlan</string>
            <string name="Source">local Plan={}
function Plan.build(kind,width,depth,height)
 local out={}
 local function item(name,size,pos,material,collide)
  table.insert(out,{Name=name,Size=size,Position=pos,Material=material,Collide=collide~=false})
 end
 item('Rug',{6,0.12,8},{0,1.6,3},'Fabric',false)
 item('Table',{6,0.6,5},{-width*0.28,4,depth*0.2},'WoodPlanks')
 for _,x in {-2,2}do item('TableLeg',{0.5,2.5,0.5},{-width*0.28+x,2.6,depth*0.2},'Wood')end
 item('Bench',{5,1,2},{-width*0.28,2.4,depth*0.2-4},'WoodPlanks')
 if kind=='Tavern' or string.find(kind,'House') then
  item('BedFrame',{6,1.2,8},{width*0.28,2.2,depth*0.2},'Wood')
  item('Blanket',{5.5,0.5,7},{width*0.28,3.1,depth*0.2},'Fabric',false)
 elseif kind=='Castle' or kind=='Temple' then
  item('Dais',{10,1,6},{0,2,depth*0.33},'Cobblestone')
  item('Throne',{4,6,1},{0,5,depth*0.36},'Wood')
 else item('SupplyShelf',{6,6,2},{width*0.28,4,depth*0.3},'WoodPlanks')end
 for _,z in {-depth*0.25,depth*0.25}do item('CeilingBeam',{width,0.8,0.8},{0,height-1,z},'Wood',false)end
 item('LanternFrame',{1.2,1.8,1.2},{-width/2+2,7,-depth*0.15},'Metal',false)
 item('LanternGlow',{0.8,1.2,0.8},{-width/2+2,7,-depth*0.15},'Neon',false)
 return out
end
return Plan
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_20">
          <Properties>
            <string name="Name">MapVisualRules</string>
            <string name="Source">local Rules={}
local levels={'LOW','MEDIUM','HIGH'}
function Rules.new(touch)
    return {Mode='AUTO',Level=if touch then 2 else 3,EMA=1/60,Slow=0,Fast=0}
end
function Rules.select(state,mode)
    if mode~='AUTO' and not table.find(levels,mode) then return false end
    state.Mode=mode;state.Slow=0;state.Fast=0
    if mode~='AUTO' then state.Level=table.find(levels,mode) end
    return true
end
function Rules.step(state,dt)
    if type(dt)~='number' or dt~=dt or dt&lt;=0 then return levels[state.Level] end
    -- Long pauses do not immediately punish a profile; real frame pacing does.
    dt=math.min(dt,0.25)
    state.EMA+=(dt-state.EMA)*0.05
    if state.Mode=='AUTO' then
        state.Slow=if state.EMA&gt;1/28 then state.Slow+dt else 0
        state.Fast=if state.EMA&lt;1/50 then state.Fast+dt else 0
        if state.Slow&gt;=3 and state.Level&gt;1 then
            state.Level-=1;state.Slow=0;state.Fast=0
        elseif state.Fast&gt;=12 and state.Level&lt;3 then
            state.Level+=1;state.Slow=0;state.Fast=0
        end
    end
    return levels[state.Level]
end
function Rules.distanceVisible(distance,baseDistance,profile,collidable)
    -- Fine decorative objects only. Never hide a collidable building/region.
    return collidable or distance&lt;=baseDistance*profile.DetailScale
end
return Rules
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_21">
          <Properties>
            <string name="Name">Party</string>
            <string name="Source">-- Sem engine: máquina de estados para confirmação de grupos.
local Party = {}
function Party.new(leader)
    return {Leader=leader,Members={leader},Confirmed={},State="Forming"}
end
function Party.join(p,id)
    if p.State~="Forming" or #p.Members&gt;=4 then return false end
    for _,v in p.Members do if v==id then return false end end
    table.insert(p.Members,id); table.clear(p.Confirmed); return true
end
function Party.confirm(p,id)
    if p.State~="Forming" then return false end
    for _,v in p.Members do if v==id then p.Confirmed[id]=true; return true end end
    return false
end
function Party.ready(p,present)
    if p.State~="Forming" or #p.Members&lt;1 or #p.Members&gt;4 then return false end
    for _,id in p.Members do if not p.Confirmed[id] or not present(id) then return false end end
    return true
end
function Party.remove(p,id)
    if p.State~="Forming" then return false end
    for i,v in p.Members do
        if v==id then
            table.remove(p.Members,i); table.clear(p.Confirmed)
            if p.Leader==id then p.Leader=p.Members[1] end
            return true
        end
    end
    return false
end
return Party
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="base_22">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source">-- Regras puras e autoritativas. Apenas o servidor chama estas mutações.
local P = {}
function P.new()
    return {Gold=100,XP=0,Rank="",Class="",Equipment="",Armor="",StarterChosen=false,Unlocks={},Inventory={},Quests={},Claims={},Spawn="Valoria",Revision=0}
end
local function integer(n,lo,hi)
    return type(n)=="number" and n==n and n%1==0 and n&gt;=lo and n&lt;=hi
end
function P.sanitize(raw, catalog)
    local out = P.new()
    if type(raw)~="table" then return out end
    for _,k in {"Gold","XP","Revision"} do
        if integer(raw[k],0,1000000000) then out[k]=raw[k] end
    end
    if raw.Rank=="F" then out.Rank="F" end
    if type(raw.Inventory)=="table" then
        for id,item in catalog.Items do
            local value=raw.Inventory[id]
            if integer(value,1,if item.Kind=="Consumable" or item.Kind=="Material" then 99 else 1) then out.Inventory[id]=value end
        end
    end
    if out.Inventory.Armor and (raw.Armor==nil or raw.Armor=='Armor') then out.Armor='Armor' end
    if catalog.Items[raw.Equipment] and out.Inventory[raw.Equipment] then out.Equipment=raw.Equipment end
    out.StarterChosen=raw.StarterChosen==true
    for id in out.Inventory do if catalog.Items[id].Kind=="Weapon" then out.StarterChosen=true end end
    if type(raw.Quests)=="table" then
        for id,q in catalog.Quests do
            local v=raw.Quests[id]
            if type(v)=="table" then out.Quests[id]={Count=if integer(v.Count,0,q.Required) then v.Count else 0,Claimed=v.Claimed==true} end
        end
    end
    if out.StarterChosen or out.Quests.FirstSteps and out.Quests.FirstSteps.Claimed then
        -- Classe persistida só pode corresponder a um equipamento de classe conhecido.
        for _,item in catalog.Items do if item.Class==raw.Class then out.Class=raw.Class end end
    end
    if out.Class=='' and out.StarterChosen and catalog.Items[out.Equipment] then out.Class=catalog.Items[out.Equipment].Class or '' end
    if raw.Rank~='F' and out.Quests.FirstSteps and out.Quests.FirstSteps.Claimed and table.find(catalog.Ranks,raw.Rank) then out.Rank='F' end
    P.promote(out,catalog)
    if type(raw.Unlocks)=="table" then
        for id,value in raw.Unlocks do if type(id)=="string" and #id&lt;50 and value==true then out.Unlocks[id]=true end end
    end
    if type(raw.Claims)=="table" then
        local n=0
        for id,v in raw.Claims do
            if type(id)=="string" and #id&lt;=100 and v==true and n&lt;512 then out.Claims[id]=true; n+=1 end
        end
    end
    for id in catalog.CityBuildings do if raw.Spawn==id then out.Spawn=id end end
    return out
end
function P.register(s)
    if s.Rank~="" then return false,"Você já está registrado." end
    s.Rank="F"; s.Quests.FirstSteps={Count=0,Claimed=false}
    return true,"Registro concluído: Rank F."
end
function P.buy(s,catalog,id,role)
    local item=catalog.Items[id]
    local allowed=false
    for _,candidate in catalog.Shops[role] or {} do if candidate==id then allowed=true end end
    if not item or not allowed then return false,"Item indisponível nesta loja." end
    if not P.space(s,catalog,id) then return false,'Sem espaço no inventário.' end
    if item.Kind~="Consumable" and item.Kind~="Material" and (s.Inventory[id] or 0)&gt;0 then return false,"Você já possui este item." end
    if (s.Inventory[id] or 0)&gt;=99 then return false,"Inventário cheio." end
    if s.Gold&lt;item.Price then return false,"Gold insuficiente." end
    s.Gold-=item.Price; s.Inventory[id]=(s.Inventory[id] or 0)+1
    return true,"Compra concluída."
end
function P.choose(s,catalog,id)
    local item=catalog.Items[id]
    if not item or item.Kind~="Weapon" then return false,"Equipamento inválido." end
    if s.StarterChosen or s.Equipment~="" then return false,"O equipamento gratuito já foi escolhido." end
    if not P.space(s,catalog,id) then return false,'Sem espaço para a arma inicial.' end
    s.StarterChosen=true;s.Inventory[id]=1; s.Equipment=id;s.Class=item.Class
    return true,"Equipamento recebido. Use a ferramenta para atacar."
end
function P.accept(s,catalog,id)
    if s.Rank=="" or not catalog.Quests[id] or s.Quests[id] then return false,"Missão indisponível." end
    local q=catalog.Quests[id]
    if q.MinRank and (table.find(catalog.Ranks,s.Rank) or 0)&lt;(table.find(catalog.Ranks,q.MinRank) or 99) then return false,'Rank da guilda insuficiente.' end
    for _,pre in q.Prerequisites or {} do if not s.Quests[pre] or not s.Quests[pre].Claimed then return false,"Conclua a missão anterior." end end
    if q.Target=="Supplies" then
        if not s.Inventory.SupplyParcel and not P.space(s,catalog,'SupplyParcel') then return false,'Libere um espaço para os suprimentos.' end
        s.Inventory.SupplyParcel=1
    end
    s.Quests[id]={Count=0,Claimed=false}; return true,"Missão aceita."
end
function P.event(s,catalog,target,amount)
    if not integer(amount,1,10) then return end
    local changed=false
    for id,state in s.Quests do
        local q=catalog.Quests[id]
        if q and not state.Claimed and q.Target==target then local before=state.Count;state.Count=math.min(q.Required,state.Count+amount);changed=changed or state.Count~=before end
    end
    return changed
end
function P.claimQuest(s,catalog,id)
    local q, state=catalog.Quests[id],s.Quests[id]
    if not q or not state or state.Claimed or state.Count&lt;q.Required then return false,"Objetivos pendentes ou recompensa já recebida." end
    if id=="FirstSteps" and (s.Rank~="F" or not catalog.Items[s.Equipment]) then return false,"Registre-se e escolha equipamento." end
    if q.Target=="Supplies" then s.Inventory.SupplyParcel=nil end
    state.Claimed=true; s.Gold=math.min(1000000000,s.Gold+q.Gold); s.XP=math.min(1000000000,s.XP+q.XP)
    if id=="FirstSteps" and s.Class=='' then s.Class=catalog.Items[s.Equipment].Class end
    P.promote(s,catalog)
    return true,"Missão concluída!"
end
function P.chest(s,catalog,id,rarity)
    local reward=catalog.ChestRewards[rarity]
    if not reward or s.Claims[id] then return false,"Baú já coletado ou inválido." end
    local n=0; for _ in s.Claims do n+=1 end
    if n&gt;=512 then return false,"Limite de registros de baú atingido." end
    s.Claims[id]=true; s.Gold=math.min(1000000000,s.Gold+reward)
    return true,"Baú: +"..reward.." Gold."
end
function P.sell(s,catalog,id)
    local item=catalog.Items[id]
    if not item or item.Kind=='Quest' or not item.Price or (s.Inventory[id] or 0)&lt;1 or s.Equipment==id or s.Armor==id then return false,'Item indisponível para venda; desequipe antes.' end
    s.Inventory[id]-=1;if s.Inventory[id]==0 then s.Inventory[id]=nil end;s.Gold=math.min(1000000000,s.Gold+math.floor(item.Price*0.4));return true,'Venda concluída.'
end
function P.space(s,catalog,id)
    local item=catalog.Items[id];if not item then return false end
    if (s.Inventory[id] or 0)&gt;0 then return (item.Kind=='Consumable' or item.Kind=='Material') and s.Inventory[id]&lt;99 end
    local used=0;for _,n in s.Inventory do if n&gt;0 then used+=1 end end
    return used&lt;(catalog.InventorySlots or 20)
end
function P.grantItem(s,catalog,id)
    if not P.space(s,catalog,id) then return false end
    s.Inventory[id]=(s.Inventory[id] or 0)+1;return true
end
function P.promote(s,catalog)
    if s.Rank=='' then return end
    local completed=0;for _,q in s.Quests do if q.Claimed then completed+=1 end end
    for _,rank in catalog.Ranks do
        local requirement=catalog.RankRequirements and catalog.RankRequirements[rank]
        if requirement and s.XP&gt;=requirement.XP and completed&gt;=requirement.Quests then s.Rank=rank end
    end
end
return P
</string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="base_23">
        <Properties>
          <string name="Name">RigFactory</string>
          <string name="Source">-- Alternativa procedural R6 válida, sem downloads ou animações de terceiros.
local Rig={}
function Rig.create(parent,name,position,color,hostile,kind)
    local model=Instance.new('Model'); model.Name=name
    local function limb(id,size,offset,paint,collide)
        local p=Instance.new('Part'); p.Name=id; p.Size=size; p.Position=position+offset
        p.Color=paint; p.Material=Enum.Material.SmoothPlastic; p.CanCollide=collide==true; p.CanTouch=false
        p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=model; return p
    end
    local skin=Color3.fromRGB(214,171,133)
    local root=limb('HumanoidRootPart',Vector3.new(2,2,1),Vector3.new(0,3,0),color,false); root.Transparency=1
    local torso=limb('Torso',Vector3.new(2,2,1),Vector3.new(0,3,0),color,hostile)
    local head=limb('Head',Vector3.new(2,1,1),Vector3.new(0,4.5,0),skin,false)
    local headMesh=Instance.new('SpecialMesh');headMesh.MeshType=Enum.MeshType.Head;headMesh.Scale=Vector3.new(1.15,1.15,1.15);headMesh.Parent=head
    local leftArm=limb('Left Arm',Vector3.new(1,2,1),Vector3.new(-1.5,3,0),color,false)
    local rightArm=limb('Right Arm',Vector3.new(1,2,1),Vector3.new(1.5,3,0),color,false)
    local leftLeg=limb('Left Leg',Vector3.new(1,2,1),Vector3.new(-0.5,1,0),Color3.fromRGB(60,56,51),false)
    local rightLeg=limb('Right Leg',Vector3.new(1,2,1),Vector3.new(0.5,1,0),Color3.fromRGB(60,56,51),false)
    local function joint(id,a,b,c0,c1)
        local motor=Instance.new('Motor6D'); motor.Name=id; motor.Part0=a; motor.Part1=b; motor.C0=c0; motor.C1=c1; motor.Parent=a
    end
    joint('RootJoint',root,torso,CFrame.identity,CFrame.identity)
    joint('Neck',torso,head,CFrame.new(0,1,0),CFrame.new(0,-0.5,0))
    joint('Left Shoulder',torso,leftArm,CFrame.new(-1,0.5,0),CFrame.new(0.5,0.5,0))
    joint('Right Shoulder',torso,rightArm,CFrame.new(1,0.5,0),CFrame.new(-0.5,0.5,0))
    joint('Left Hip',torso,leftLeg,CFrame.new(-0.5,-1,0),CFrame.new(0,1,0))
    joint('Right Hip',torso,rightLeg,CFrame.new(0.5,-1,0),CFrame.new(0,1,0))
    local function adorn(id,size,offset,paint,base)
        base=base or head
        local p=limb(id,size,base.Position-position+offset,paint,false); p.Massless=true
        local weld=Instance.new('WeldConstraint'); weld.Part0=base; weld.Part1=p; weld.Parent=p
        return p
    end
    for _,x in {-0.4,0.4} do adorn('Eye',Vector3.new(0.15,0.18,0.1),Vector3.new(x,0.1,-0.54),Color3.fromRGB(22,26,31)) end
    if kind=='Mage' or kind=='ShopMagic' then
        adorn('WizardHat',Vector3.new(2.4,1.4,2),Vector3.new(0,1,0),color)
        adorn('Robe',Vector3.new(2.2,2.4,1.3),Vector3.new(0,-0.6,0),color,torso)
    elseif kind=='Guard' or hostile then
        adorn('Helmet',Vector3.new(2.1,0.5,1.2),Vector3.new(0,0.5,0),Color3.fromRGB(106,115,128))
        adorn('Breastplate',Vector3.new(2.1,1.7,0.3),Vector3.new(0,0,-0.65),color,torso)
    else
        adorn('Apron',Vector3.new(1.5,1.8,0.2),Vector3.new(0,-0.2,-0.6),Color3.fromRGB(72,49,36),torso)
        adorn('Belt',Vector3.new(2.1,0.25,1.1),Vector3.new(0,-0.6,0),Color3.fromRGB(68,47,29),torso)
    end
    if kind=='Wolf' or kind=='DarkWolf' then
        adorn('Muzzle',Vector3.new(1.2,0.6,1),Vector3.new(0,-0.1,-0.8),color)
        for _,x in {-0.7,0.7} do adorn('Ear',Vector3.new(0.5,0.9,0.5),Vector3.new(x,0.9,0),color) end
    elseif kind=='Malgorth' or kind=='SylvarinBoss' or kind=='NoctharBoss' then
        for _,x in {-0.8,0.8} do adorn('Horn',Vector3.new(0.4,1.8,0.4),Vector3.new(x,1.1,0),Color3.fromRGB(38,24,31)) end
    elseif kind=='Slime' then
        local slime=adorn('SlimeBody',Vector3.new(4,3,4),Vector3.new(0,-0.5,0),color,torso)
        slime.Shape=Enum.PartType.Ball; slime.Transparency=0.2
    end
    local humanoid=Instance.new('Humanoid'); humanoid.DisplayName=name; humanoid.MaxHealth=100; humanoid.Health=100
    humanoid.HipHeight=0; humanoid.BreakJointsOnDeath=false; humanoid.RigType=Enum.HumanoidRigType.R6; humanoid.Parent=model
    root.Anchored=not hostile; model.PrimaryPart=root; model.Parent=parent
    if hostile then root:SetNetworkOwner(nil) end
    model:SetAttribute('ProceduralRig',true)
    return model,humanoid,root
end
return Rig
</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="base_24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="base_25">
      <Properties>
        <string name="Name">MapPreview</string>
        <token name="RunContext">0</token>
        <string name="Source">-- Standalone map inspection bootstrap. No RPG services or world generation.
local RunService=game:GetService('RunService')
local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Environment=require(game:GetService('ServerStorage').MedievalWorldgen.MapEnvironment)
Environment.apply(workspace:GetAttribute('MapEnvironmentPreset') or 'Day')
local root=workspace:FindFirstChild('GeneratedWorld') or workspace:FindFirstChild('GeneratedContinent')
if not root or root:GetAttribute('TerrainPending')==true then
    Players.CharacterAutoLoads=false
    warn('[Eldravyn mapa] Terrain pendente. Pare Play e conclua a preparação pelo guia antes de caminhar.')
end
local controls=Instance.new('Folder');controls.Name='EldravynMapPreview';controls.Parent=RS
local remote=Instance.new('RemoteEvent');remote.Name='Environment';remote.Parent=controls
local limits={}
remote.OnServerEvent:Connect(function(player,preset)
    -- Visual review controls are editor-only and never expose production changes.
    if not RunService:IsStudio() or type(preset)~='string' or #preset&gt;12 then return end
    local now=os.clock();if now&lt;(limits[player] or 0) then return end;limits[player]=now+0.5
    if not ({Dawn=true,Day=true,Sunset=true,Night=true,Rain=true,Fog=true,Storm=true})[preset] then return end
    Environment.apply(preset)
end)
Players.PlayerRemoving:Connect(function(player)limits[player]=nil end)
print('[Eldravyn mapa] Inspeção visual iniciada. Nenhum serviço de gameplay foi carregado.')
</string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="base_26">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="StringValue" referent="base_27">
      <Properties>
        <string name="Name">MedievalPlaceKind</string>
        <string name="Value">Map</string>
      </Properties>
    </Item>
    <Item class="Folder" referent="base_28">
      <Properties>
        <string name="Name">MedievalWorldgen</string>
      </Properties>
      <Item class="ModuleScript" referent="base_29">
        <Properties>
          <string name="Name">ArchitecturalPlan</string>
          <string name="Source">-- Engine-free architectural grammar shared by geometry and structural tests.
local P={}
P.Themes={
 Valoria={Id='Crown',Stone={158,146,124},Plaster={231,217,181},Wood={94,60,40},Roof={146,65,43},Metal={161,137,83},Glass={250,209,128},Height=0},
 Eldoria={Id='Woodland',Stone={126,143,121},Plaster={204,214,172},Wood={77,74,45},Roof={64,111,85},Metal={162,143,82},Glass={220,235,155},Height=2},
 Durakh={Id='Mountain',Stone={116,126,133},Plaster={153,154,140},Wood={81,59,43},Roof={109,79,57},Metal={153,110,69},Glass={255,186,105},Height=2},
 Asterion={Id='Arcane',Stone={175,183,196},Plaster={218,222,228},Wood={78,68,101},Roof={79,87,148},Metal={161,156,193},Glass={143,214,247},Height=4},
 Arkheim={Id='Gothic',Stone={95,105,119},Plaster={142,148,157},Wood={63,56,66},Roof={63,54,80},Metal={109,110,125},Glass={193,160,219},Height=6},
}
local important={GuildHall=true,Tavern=true,Temple=true,Castle=true,MagicSchool=true,Library=true,Forge=true,SmithGuild=true,Blacksmith=true,TrainingHall=true,ArcaneTower=true}
local tower={GuardTower=true,WatchTower=true,ArcaneTower=true}
function P.build(kind,city,index,lot)
 lot=lot or {};index=index or 1
 local theme=P.Themes[city] or P.Themes.Valoria
 local variant=lot.Variant or lot.Variation or index%4
 assert(type(variant)=='number' and variant&gt;=0 and variant%1==0,'Variante arquitetônica inválida')
 variant%=4
 local w,d,h=26+(index%3)*2,28+(index%2)*2,16+(index%3)*2+theme.Height
 if kind=='SmallHouse' then w,d,h=24+variant,27+variant%2,15+variant%2+theme.Height end
 if kind=='LargeHouse' or kind=='GuildHall' or kind=='Tavern' then h+=5 end
 if kind=='Castle' then w,d,h=44,40,34+theme.Height end
 if kind=='ArcaneTower' then w,d,h=24,24,48+theme.Height end
 if kind=='Forge' then w,d,h=38,34,23+theme.Height end
 if kind=='GuardTower' or kind=='WatchTower' then w,d,h=25,26,30+theme.Height end
 local interior=if lot.Interior==nil then important[kind]==true else lot.Interior==true
 local rise=if tower[kind] then 13 elseif theme.Id=='Gothic' or theme.Id=='Arcane' then 11 else 7+variant%2*2
 return {Kind=kind,Theme=theme,Variant=variant,Width=w,Depth=d,Height=h,Rise=rise,
  DoorWidth=8,DoorHeight=10,Interior=interior,Tower=tower[kind]==true,
  District=lot.District or 'Civic',Roof=if tower[kind] then 'Spire' elseif variant==1 then 'CrossGable' elseif variant==3 then 'Dormer' else 'Gable',
  Windows=if theme.Id=='Gothic' then 'Lancet' elseif theme.Id=='Arcane' then 'Crystal' else 'Mullion'}
end
return P
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_30">
        <Properties>
          <string name="Name">BuildingGenerator</string>
          <string name="Source">local G=require(script.Parent.Geometry)
local Plan=require(script.Parent.ArchitecturalPlan)
local Catalog=require(game.ReplicatedStorage.MedievalRPG.Config.ContentConfig)
local Interiors=require(game.ReplicatedStorage.MedievalRPG.Core.InteriorPlan)
local B={}
local function rgb(t)return Color3.fromRGB(table.unpack(t))end
function B.build(parent,lot,city,index)
 local spec=Plan.build(lot.Kind,city,index,lot)
 local kind,theme=lot.Kind,spec.Theme
 local m=G.model(parent,lot.Id)
 m:SetAttribute('Template',kind);m:SetAttribute('ArchitecturalTheme',theme.Id)
 m:SetAttribute('Variant',spec.Variant);m:SetAttribute('District',spec.District);m:SetAttribute('ExplorableInterior',spec.Interior)
 local cf=CFrame.new(lot.X,lot.H,lot.Z)*CFrame.Angles(0,lot.Yaw,0)
 local w,d,h=spec.Width,spec.Depth,spec.Height
 local stone,plaster,wood,roof,metal,glass=rgb(theme.Stone),rgb(theme.Plaster),rgb(theme.Wood),rgb(theme.Roof),rgb(theme.Metal),rgb(theme.Glass)
 local function part(name,size,x,y,z,color,material,detail,rotation,shape)
  local frame=cf*CFrame.new(x,y,z)*(rotation or CFrame.new())
  local p=(if detail then G.detail else G.part)(m,name,size,frame,color or stone,material or Enum.Material.Cobblestone,shape)
  if detail then p.CastShadow=false end
  return p
 end
 local function beam(name,a,b,width,color)
  local p=G.beam(m,cf:PointToWorldSpace(a),cf:PointToWorldSpace(b),width,color or wood,Enum.Material.Wood)
  p.Name=name;p.CanCollide=false;p.CanQuery=false;p.CastShadow=false;return p
 end
 -- Footings descend into the city platform; no floating plinth or Terrain edits.
 part('Foundation',Vector3.new(w+2,2,d+2),0,-0.8,0)
 part('Floor',Vector3.new(w,0.8,d),0,0.4,0,wood,Enum.Material.WoodPlanks)
 part('Back',Vector3.new(w,h,1),0,h/2,d/2,plaster,Enum.Material.Limestone)
 for _,side in {-1,1} do
  part('SideWall',Vector3.new(1,h,d),side*w/2,h/2,0,plaster,if city=='Durakh' or city=='Arkheim' then Enum.Material.Slate else Enum.Material.Limestone)
  part('DoorSide',Vector3.new((w-8)/2,h,1),side*(w+8)/4,h/2,-d/2,plaster,Enum.Material.Limestone)
  part('DoorJamb',Vector3.new(0.65,10,1.6),side*4.35,5,-d/2,stone)
  for _,z in {-d/2,d/2} do
   part('CornerPier',Vector3.new(1.1,h+0.6,1.1),side*w/2,h/2,z,if city=='Durakh' or city=='Arkheim' then stone else wood,if city=='Durakh' or city=='Arkheim' then Enum.Material.Cobblestone else Enum.Material.Wood)
  end
  if side==1 then for _,y in {4,h-1}do
   -- Split front beams preserve the full doorway; back beams span the rear.
   for _,x in {-1,1}do part('TimberRail',Vector3.new((w-9)/2,0.55,0.8),x*(w+9)/4,y,-d/2-0.1,wood,Enum.Material.Wood,true)end
   part('RearRail',Vector3.new(w,0.55,0.8),0,y,d/2+0.1,wood,Enum.Material.Wood,true)
  end end
 end
 part('DoorLintel',Vector3.new(8,h-10,1),0,10+(h-10)/2,-d/2,wood,Enum.Material.Wood)
 part('StoneDoorCrown',Vector3.new(9,0.9,1.8),0,10.2,-d/2,stone,Enum.Material.Cobblestone,true)
 for i=1,3 do part('Step',Vector3.new(8,0.3*i,1.4),0,0.15*i,-d/2-4.1+i*1.2,stone)end
 local function window(x,y,z,sideFace)
  local rotation=if sideFace then CFrame.Angles(0,math.pi/2,0) else CFrame.new()
  local frame=cf*CFrame.new(x,y,z)*rotation
  local function trim(name,size,dx,dy,dz,color,mat)
   local p=G.detail(m,name,size,frame*CFrame.new(dx,dy,dz),color,mat);p.CastShadow=false;return p
  end
  trim('WindowRecess',Vector3.new(4.8,5.8,0.45),0,0,0,wood,Enum.Material.Wood)
  trim('WindowGlass',Vector3.new(3.8,4.8,0.25),0,0,-0.25,glass,Enum.Material.Glass)
  trim('WindowMullion',Vector3.new(0.25,5,0.35),0,0,-0.45,wood,Enum.Material.Wood)
  trim('WindowTransom',Vector3.new(4,0.25,0.35),0,0.4,-0.45,wood,Enum.Material.Wood)
  trim('WindowSill',Vector3.new(5.3,0.45,1),0,-2.9,-0.2,stone,Enum.Material.Cobblestone)
  if spec.Windows=='Lancet' then
   for _,side in {-1,1}do trim('LancetArch',Vector3.new(0.45,3,0.5),side*1.1,2.4,-0.5,stone,Enum.Material.Slate).CFrame=frame*CFrame.new(side*1.1,2.4,-0.5)*CFrame.Angles(0,0,side*0.55)end
  elseif spec.Windows=='Crystal' then
   trim('ArcaneKeystone',Vector3.new(0.8,1.5,0.7),0,3,-0.45,metal,Enum.Material.Metal)
  elseif spec.Variant%2==0 then
   for _,side in {-1,1}do trim('Shutter',Vector3.new(1.2,4.8,0.4),side*3,0,-0.25,roof,Enum.Material.WoodPlanks)end
  end
 end
 for _,side in {-1,1}do
  window(side*w*0.32,8,-d/2-0.5,false)
  if h&gt;24 then window(side*w*0.3,h-7,-d/2-0.5,false)end
  window(side*(w/2+0.45),math.min(10,h-5),d*0.16,true)
 end
 local rise=spec.Rise;local half=w/2+2
 local slope=math.atan2(rise,half);local length=math.sqrt(half*half+rise*rise)
 for _,side in {-1,1}do
  part('PitchedRoof',Vector3.new(length,0.8,d+5),side*half/2,h+rise/2,0,roof,Enum.Material.Slate,false,CFrame.Angles(0,0,-side*slope))
  part('Eave',Vector3.new(0.6,0.8,d+6),side*half,h,0,wood,Enum.Material.Wood,true)
  for _,z in {-d/2,d/2}do beam('GableRafter',Vector3.new(side*half,h,z),Vector3.new(0,h+rise,z),0.65)end
 end
 for _,z in {-d/2,d/2}do
  for _,side in {-1,1}do
   local gable=Instance.new('WedgePart');gable.Name='GableInfill';gable.Size=Vector3.new(0.8,rise,w/2)
   gable.CFrame=cf*CFrame.new(side*w/4,h+rise/2,z)*CFrame.Angles(0,-side*math.pi/2,0)
   gable.Color=plaster;gable.Material=Enum.Material.Limestone;gable.Anchored=true
   gable.CanCollide=false;gable.CanQuery=false;gable.CanTouch=false;gable.CastShadow=false;gable.Parent=m
  end
  beam('KingPost',Vector3.new(0,h,z-0.4),Vector3.new(0,h+rise,z-0.4),0.55)
 end
 part('RidgeCap',Vector3.new(0.8,0.7,d+6),0,h+rise,0,metal,Enum.Material.Metal,true)
 if spec.Roof=='Dormer' or spec.Roof=='CrossGable' then
  local z=-d*0.18
  part('Dormer',Vector3.new(7,4,5),-w*0.24,h+3,z,plaster,Enum.Material.Limestone,true)
  for _,side in {-1,1}do part('DormerRoof',Vector3.new(4.7,0.65,6),-w*0.24+side*1.8,h+6,z,roof,Enum.Material.Slate,true,CFrame.Angles(0,0,-side*0.5))end
  part('DormerGlass',Vector3.new(3.2,2.3,0.4),-w*0.24,h+3,-d*0.18-2.6,glass,Enum.Material.Glass,true)
 end
 if not spec.Tower then
  part('ChimneyStack',Vector3.new(2.8,8,3.2),w*0.3,h+4,d*0.25,stone,Enum.Material.Brick)
  part('ChimneyCap',Vector3.new(3.7,0.7,4.1),w*0.3,h+8.2,d*0.25,metal,Enum.Material.Slate,true)
 end
 if kind=='Tavern' or kind=='LargeHouse' or kind=='GuildHall' then
  part('JettyFloor',Vector3.new(w+1.5,0.65,d+1.5),0,11,0,wood,Enum.Material.Wood,true)
  part('Balcony',Vector3.new(12,0.65,4.5),0,11.4,-d/2-1.8,wood,Enum.Material.WoodPlanks)
  for _,side in {-1,1}do part('BalconySide',Vector3.new(0.6,2.8,4),side*6,13,-d/2-1.7,wood,Enum.Material.Wood,true)end
  part('BalconyRail',Vector3.new(12,0.5,0.5),0,14.2,-d/2-3.8,wood,Enum.Material.Wood,true)
  for x=-5,5,2 do part('Baluster',Vector3.new(0.35,2.5,0.35),x,12.9,-d/2-3.8,wood,Enum.Material.Wood,true)end
 end
 if kind=='Castle' or kind=='Barracks' or spec.Tower then
  local towerH=if kind=='Castle' then h+17 elseif spec.Tower then h+5 else h+8
  for _,side in {-1,1}do
   local x=side*(w/2+3)
   part('Turret',Vector3.new(8,towerH,8),x,towerH/2,d/2-4,stone)
   part('TurretCornice',Vector3.new(9,1,9),x,towerH-2,d/2-4,metal,Enum.Material.Slate,true)
   for i=-1,1 do part('Battlement',Vector3.new(1.6,2.8,2),x+i*3,towerH+1,d/2-8,stone)end
   if theme.Id=='Gothic' or theme.Id=='Arcane' or spec.Tower then
    for _,roofSide in {-1,1}do part('SteepSpire',Vector3.new(7.8,0.8,10),x+roofSide*2.7,towerH+5,d/2-4,roof,Enum.Material.Slate,true,CFrame.Angles(0,0,-roofSide*1))end
    part('Finial',Vector3.new(0.6,6,0.6),x,towerH+12,d/2-4,metal,Enum.Material.Metal,true)
   end
   local banner=part('Banner',Vector3.new(3.2,8,0.2),x,towerH-8,d/2-8.2,roof,Enum.Material.Fabric,true);banner:SetAttribute('Flutter',true)
  end
 end
 if theme.Id=='Woodland' then
  for _,side in {-1,1}do
   beam('BranchBrace',Vector3.new(side*w/2,2,-d/2),Vector3.new(side*(w/2+2),h-3,-d/2),1.1)
   part('WindowPlanter',Vector3.new(5,1.2,2),side*w*0.32,4.2,-d/2-1.1,wood,Enum.Material.WoodPlanks,true)
   part('PlanterLeaves',Vector3.new(5,1.7,2),side*w*0.32,5.3,-d/2-1.1,roof,Enum.Material.Grass,true,nil,Enum.PartType.Ball)
  end
 elseif theme.Id=='Mountain' or theme.Id=='Gothic' then
  for _,side in {-1,1}do
   part('ButtressFoot',Vector3.new(3,3,4),side*(w/2+1),1.5,-d*0.28,stone)
   part('Buttress',Vector3.new(1.8,h*0.65,2),side*(w/2+0.7),h*0.325,-d*0.28,stone,Enum.Material.Slate)
  end
 elseif theme.Id=='Arcane' then
  for _,side in {-1,1}do local crystal=G.crystal(m,cf*CFrame.new(side*(w/2-2),h+rise+1,0),glass,0.7);crystal.CastShadow=false end
 end
 local role=Catalog.Roles[kind] or 'Citizen'
 if Catalog.Shops[role] or role=='Guild' then
  part('Counter',Vector3.new(9,2.8,2.8),-8,1.4,-d/2-5.8,wood,Enum.Material.WoodPlanks)
  part('Awning',Vector3.new(12,0.45,7),-8,8,-d/2-4.3,roof,Enum.Material.Fabric,true,CFrame.Angles(-0.12,0,0))
  for _,x in {-13,-3.8}do part('AwningPost',Vector3.new(0.5,8,0.5),x,4,-d/2-7.5,wood,Enum.Material.Wood)end
 end
 if kind=='Forge' or kind=='Blacksmith' or kind=='SmithGuild' then
  part('Furnace',Vector3.new(8,7,7),w/2-5,3.5,-d/2-5,stone,Enum.Material.Brick)
  part('Embers',Vector3.new(5,2,0.4),w/2-5,3,-d/2-8.7,Color3.fromRGB(234,123,55),Enum.Material.Neon,true)
  part('Anvil',Vector3.new(5,2,2),-w/2+5,3.8,-d/2-5,metal,Enum.Material.Metal)
 elseif kind=='Windmill' then
  for i=0,3 do part('MillSail',Vector3.new(2,15,0.5),0,h+6,-d/2-2,Color3.fromRGB(217,207,171),Enum.Material.Fabric,true,CFrame.Angles(0,0,i*math.pi/2)*CFrame.new(0,7,0))end
 elseif kind=='Library' then
  for i=1,4 do part('Bookshelf',Vector3.new(10,0.8,2),0,i*2,d/2-2,wood,Enum.Material.WoodPlanks);part('Books',Vector3.new(9,1.4,1.4),0,i*2+1,d/2-2,roof,Enum.Material.Fabric,true)end
 elseif kind=='Market' then
  for _,side in {-1,1}do part('MarketCrate',Vector3.new(3,2.5,3),side*8,1.3,-d/2-5,wood,Enum.Material.WoodPlanks)end
 end
 if spec.Interior then
  local furniture=G.model(m,'Interior')
  for _,item in Interiors.build(kind,w,d,h)do
   local tint=if item.Material=='Fabric' then roof elseif item.Material=='Neon' then glass else wood
   local p=G.part(furniture,item.Name,Vector3.new(table.unpack(item.Size)),cf*CFrame.new(table.unpack(item.Position)),tint,Enum.Material[item.Material])
   if not item.Collide then p.CanCollide=false;p.CanQuery=false;p.CastShadow=false end
  end
 end
 local sign=G.sign(m,Catalog.Labels[kind] or kind,cf*CFrame.new(0,12,-d/2-1),math.min(20,w));sign:SetAttribute('IntegrationRole',role)
 if spec.Interior then
  part('LanternBracket',Vector3.new(0.4,0.4,2),4.9,8,-d/2-0.7,metal,Enum.Material.Metal,true)
  part('LanternGlow',Vector3.new(0.9,1.4,0.9),4.9,7,-d/2-1.3,glass,Enum.Material.Neon,true)
 end
 return m,cf:PointToWorldSpace(Vector3.new(0,0,-d/2-8)),role
end
return B
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_31">
        <Properties>
          <string name="Name">CityLandmarkGenerator</string>
          <string name="Source">-- Civic silhouettes, built from native geometry only. No NPC or gameplay logic.
local G=require(script.Parent.Geometry)
local Plan=require(script.Parent.ArchitecturalPlan)
local L={}
local function rgb(c)return Color3.fromRGB(table.unpack(c))end
function L.build(parent,city,_config)
 local theme=Plan.Themes[city.Id] or Plan.Themes.Valoria
 local m=G.model(parent,'Civic_'..theme.Id);m:SetAttribute('ArchitecturalTheme',theme.Id)
 m:SetAttribute('LandmarkId',city.Id..'_Civic');m:SetAttribute('IntegrationOnly',true)
 local cf=CFrame.new(city.X-(if city.Id=='Eldoria' then 32 else 43),city.H,city.Z-(if city.Id=='Eldoria' then 18 else 27))
 local stone,wood,roof,metal,glass=rgb(theme.Stone),rgb(theme.Wood),rgb(theme.Roof),rgb(theme.Metal),rgb(theme.Glass)
 local function p(name,size,x,y,z,color,mat,detail,rotation,shape)
  local part=(if detail then G.detail else G.part)(m,name,size,cf*CFrame.new(x,y,z)*(rotation or CFrame.new()),color or stone,mat or Enum.Material.Cobblestone,shape)
  if detail then part.CastShadow=false end
  return part
 end
 local function beam(name,a,b,width,color)
  local part=G.beam(m,cf:PointToWorldSpace(a),cf:PointToWorldSpace(b),width,color or wood,Enum.Material.Wood)
  part.Name=name;return part
 end
 if city.Id=='Valoria' then
  m:SetAttribute('LandmarkName','Torre das Horas da Aurora')
  p('ClockFoundation',Vector3.new(16,2,16),0,0,0)
  p('ClockBase',Vector3.new(12,18,12),0,10,0)
  p('ClockShaft',Vector3.new(9,26,9),0,30,0,rgb(theme.Plaster),Enum.Material.Limestone)
  for _,side in {-1,1}do
   p('ClockCorner',Vector3.new(1,43,1),side*4.5,22,-4.5,wood,Enum.Material.Wood)
   p('BellPillar',Vector3.new(1.2,9,1.2),side*4.5,47,-4.5,wood,Enum.Material.Wood)
   p('BellPillar',Vector3.new(1.2,9,1.2),side*4.5,47,4.5,wood,Enum.Material.Wood)
   p('ClockRoof',Vector3.new(8.4,0.8,14),side*3.2,55,0,roof,Enum.Material.Slate,true,CFrame.Angles(0,0,-side*0.75))
  end
  p('BelfryFloor',Vector3.new(12,1,12),0,43,0,wood,Enum.Material.WoodPlanks)
  p('Bell',Vector3.new(3,3.4,3),0,47,0,metal,Enum.Material.Metal,true,nil,Enum.PartType.Ball)
  p('ClockFace',Vector3.new(0.4,6,6),0,34,-4.85,rgb(theme.Plaster),Enum.Material.Limestone,true,CFrame.Angles(0,math.pi/2,0),Enum.PartType.Cylinder)
  for i=1,12 do
   local a=i/12*math.pi*2
   p('ClockTick',Vector3.new(0.3,0.65,0.15),math.sin(a)*2.5,34+math.cos(a)*2.5,-5.2,metal,Enum.Material.Metal,true,CFrame.Angles(0,0,-a))
  end
  p('HourHand',Vector3.new(1.8,0.25,0.15),-0.6,34.4,-5.3,wood,Enum.Material.Wood,true,CFrame.Angles(0,0,-0.5))
  p('MinuteHand',Vector3.new(0.22,2.3,0.15),0,35,-5.3,wood,Enum.Material.Wood,true)
  p('ClockFinial',Vector3.new(0.7,6,0.7),0,61,0,metal,Enum.Material.Metal,true)
 elseif city.Id=='Eldoria' then
  m:SetAttribute('LandmarkName','Árvore do Primeiro Pacto')
  p('ElderTrunk',Vector3.new(6,39,6),0,19.5,0,wood,Enum.Material.Wood,false,CFrame.Angles(0,0,0.1))
  for i=1,5 do
   local a=i/5*math.pi*2
   local x,z=math.sin(a)*12,math.cos(a)*12
   beam('Root',Vector3.new(0,9,0),Vector3.new(x,0.5,z),1.7,wood)
   beam('ElderBranch',Vector3.new(0,23,0),Vector3.new(x,35+i,z),1.8,wood)
   p('ElderCrown',Vector3.new(18,14,18),x*0.6,36+i,z*0.6,roof,Enum.Material.Grass,true,nil,Enum.PartType.Ball)
  end
  for _,side in {-1,1}do
   p('RootBridgeDeck',Vector3.new(4,0.7,20),side*10,4,0,wood,Enum.Material.WoodPlanks)
   for _,z in {-9,0,9}do p('RootBridgePost',Vector3.new(0.6,4,0.6),side*12,6,z,wood,Enum.Material.Wood)end
   beam('WovenRail',Vector3.new(side*12,7,-9),Vector3.new(side*12,7,9),0.5,wood)
   for n=1,4 do p('BridgeStep',Vector3.new(4,0.9*n,2),side*10,0.45*n,-19+n*2,stone)end
  end
 elseif city.Id=='Durakh' then
  m:SetAttribute('LandmarkName','Galeria dos Mestres da Pedra')
  for _,x in {-9,9}do
   p('StoneAbutment',Vector3.new(5,9,13),x,4.5,0)
   p('GalleryPier',Vector3.new(3,17,3),x,8.5,5)
  end
  p('GalleryBridge',Vector3.new(23,1.2,11),0,10,0,stone,Enum.Material.Slate)
  for _,z in {-5,5}do
   p('GalleryParapet',Vector3.new(23,2.5,0.8),0,11.8,z)
   for x=-9,9,6 do p('GalleryMerlon',Vector3.new(2,1.2,1.2),x,13.5,z)end
  end
  for n=1,10 do p('GalleryStair',Vector3.new(7,n,1.5),0,n/2,-20+n*1.5,stone,Enum.Material.Slate)end
  p('ForgeChimney',Vector3.new(6,41,6),9,20.5,5,stone,Enum.Material.Brick)
  p('ChimneyCrown',Vector3.new(8,2,8),9,42,5,metal,Enum.Material.Metal)
  for _,x in {-9,9}do p('MineralVein',Vector3.new(1,6,0.3),x,5,-6.7,metal,Enum.Material.Metal,true)end
 elseif city.Id=='Asterion' then
  m:SetAttribute('LandmarkName','Obelisco das Constelações')
  p('RunicDais',Vector3.new(17,2,17),0,0,0,stone,Enum.Material.Marble)
  p('ArcaneShaft',Vector3.new(6,37,6),0,19.5,0,stone,Enum.Material.Marble)
  for _,side in {-1,1}do
   p('ArcaneRib',Vector3.new(0.6,38,0.6),side*3.1,20,-3.1,metal,Enum.Material.Metal,true)
   p('ObeliskCrown',Vector3.new(7.7,0.7,9),side*2.3,43,0,roof,Enum.Material.Slate,true,CFrame.Angles(0,0,-side*0.9))
   G.crystal(m,cf*CFrame.new(side*7,4,0),glass,0.9)
  end
  for i=1,6 do
   p('ConstellationRune',Vector3.new(1,0.5,0.3),if i%2==0 then -0.6 else 0.6,8+i*4,-3.2,glass,Enum.Material.Neon,true,CFrame.Angles(0,0,0.5))
  end
  p('FloatingCrystal',Vector3.new(3,8,3),0,51,0,glass,Enum.Material.Neon,true,CFrame.Angles(0,0,0.35))
 else
  m:SetAttribute('LandmarkName','Campanário do Juramento Partido')
  p('GothicBase',Vector3.new(15,4,15),0,1,0)
  p('GothicTower',Vector3.new(10,33,10),0,19.5,0,stone,Enum.Material.Slate)
  for _,side in {-1,1}do
   p('GothicButtress',Vector3.new(2.5,24,3),side*6,12,-2,stone,Enum.Material.Cobblestone)
   p('BelfryPier',Vector3.new(1.6,10,1.6),side*4,41,-4,stone,Enum.Material.Slate)
   p('GothicRoof',Vector3.new(11,0.8,14),side*3,50,0,roof,Enum.Material.Slate,true,CFrame.Angles(0,0,-side*1))
   p('GothicPinnacle',Vector3.new(1,12,1),side*6,39,-2,metal,Enum.Material.Metal,true)
  end
  p('BrokenBell',Vector3.new(4,3,3),1,4,-5,metal,Enum.Material.Metal,true,CFrame.Angles(0.2,0,0.7),Enum.PartType.Ball)
  p('LancetGlow',Vector3.new(2.5,12,0.3),0,24,-5.2,glass,Enum.Material.Glass,true)
  for _,side in {-1,1}do p('LancetRib',Vector3.new(0.45,4,0.6),side*0.8,31,-5.4,stone,Enum.Material.Slate,true,CFrame.Angles(0,0,side*0.5))end
 end
 return m
end
return L
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_32">
        <Properties>
          <string name="Name">ContentGenerator</string>
          <string name="Source">local G=require(script.Parent.Geometry)
local Buildings=require(script.Parent.BuildingGenerator)
local Shared=game.ReplicatedStorage.MedievalRPG
local Catalog=require(Shared.Config.ContentConfig)
local Rig=require(Shared.RigFactory)
local C={}
local Landmarks=require(script.Parent.LandmarkGenerator)
local Scenery=require(script.Parent.ScenicGenerator)
local function sceneOnly(root)return root:GetAttribute('SceneOnly')==true end
local function color(t) return Color3.fromRGB(t[1],t[2],t[3]) end
function C.npc(parent,id,position,role,city)
    local dialogue=Catalog.Dialogue[role] or Catalog.Dialogue.Citizen
    local paint=if city=='Eldoria' then Color3.fromRGB(94,73,148) elseif city=='Durakh' then Color3.fromRGB(86,81,72) else Color3.fromRGB(91,119,130)
    local model,_,root=Rig.create(parent,dialogue.Name,position,paint,false,role)
    model.Name=id; model:SetAttribute('NpcId',id); model:SetAttribute('Role',role); model:SetAttribute('City',city)
    if role=='Citizen' and Catalog.ResidentStories[city] then
        local hash=0;for i=1,#id do hash+=string.byte(id,i) end
        local name=Catalog.ResidentNames[hash%#Catalog.ResidentNames+1]
        model:SetAttribute('DisplayTitle',name..' • morador de '..city)
        model:SetAttribute('LocalDialogue',Catalog.ResidentStories[city][hash%#Catalog.ResidentStories[city]+1])
        model:FindFirstChildOfClass('Humanoid').DisplayName=name
    end
    G.prompt(root,'Conversar',model:GetAttribute('DisplayTitle') or dialogue.Name)
    return model
end
function C.chest(parent,id,pos,rarity,locked)
    local m=G.model(parent,id); m:SetAttribute('ChestId',id); m:SetAttribute('Rarity',rarity); m:SetAttribute('BossLocked',locked==true)
    G.part(m,'Base',Vector3.new(5,3,3),CFrame.new(pos+Vector3.new(0,1.5,0)),G.Palette.Wood,Enum.Material.WoodPlanks)
    local lid=G.part(m,'Lid',Vector3.new(5.2,1,3.2),CFrame.new(pos+Vector3.new(0,3.5,0)),G.Palette.Gold,Enum.Material.Metal)
    G.prompt(lid,'Abrir',rarity..' • Baú'); return m
end
function C.enemyMarker(parent,id,pos,kind)
    return G.marker(parent,id,pos,{EnemyId=id,EnemyKind=kind})
end
function C.tree(parent,t)
    local cf=CFrame.new(t.X,t.H,t.Z);local scale=t.Scale or 1
    local variant=(t.Variant or 0)%5;local ancient=variant==4
    local dark=t.Forest=='Vespera';local old=t.Forest=='Nocthar'
    local m=G.model(parent,'Tree_'..variant);m:SetAttribute('TreeVariant',variant);m:SetAttribute('ForestId',t.Forest)
    local wood=if variant==1 and not dark then Color3.fromRGB(178,177,149) elseif dark then Color3.fromRGB(65,58,67) else Color3.fromRGB(91,72,48)
    local leaf=if dark then Color3.fromRGB(56,66,77) elseif old then Color3.fromRGB(81,109,76) else Color3.fromRGB(77,137,77)
    local height=if ancient then 29 else 18+variant*2
    local thickness=if ancient then 4.8 else 2.2
    G.part(m,'Trunk',Vector3.new(height,thickness,thickness)*scale,cf*CFrame.new(0,height*0.5*scale,0)*CFrame.Angles(0,variant*0.7,math.pi/2+(if dark then 0.12 else 0.025)),wood,Enum.Material.Wood,Enum.PartType.Cylinder)
    local count=if variant==2 then 5 else 4
    for i=1,count do
        local a=i*2.399+variant*0.7
        local spread=if ancient then 9 elseif variant==2 then 1 else 5
        local crownY=if variant==2 then 11+i*3.4 else height-3+(i%3)*3
        local x,z=math.sin(a)*spread,math.cos(a)*spread
        local size=if variant==2 then Vector3.new(17-i*2.2,6,17-i*2.2) else Vector3.new(12+i%2*4,10,11+i%3*2)
        local crown=G.detail(m,'Canopy',size*scale,cf*CFrame.new(x*scale,crownY*scale,z*scale),leaf,Enum.Material.Grass,Enum.PartType.Ball)
        crown.CastShadow=not dark
        if variant~=2 then
            local branch=G.beam(m,cf:PointToWorldSpace(Vector3.new(0,height*0.55*scale,0)),cf:PointToWorldSpace(Vector3.new(x*scale,(crownY-2)*scale,z*scale)),(if ancient then 1.4 else 0.8)*scale,wood,Enum.Material.Wood)
            branch.CanCollide=false;branch.CanQuery=false
        end
    end
    if ancient or old then
        for i=1,4 do
            local a=i*math.pi/2+variant*0.4
            G.beam(m,cf:PointToWorldSpace(Vector3.new(math.sin(a)*2*scale,4*scale,math.cos(a)*2*scale)),cf:PointToWorldSpace(Vector3.new(math.sin(a)*9*scale,0.6*scale,math.cos(a)*9*scale)),(if ancient then 2.3 else 1.2)*scale,wood,Enum.Material.Wood)
        end
    end
    if variant%2==0 then Scenery.shrub(m,cf*CFrame.new(5*scale,0,2*scale),0.8*scale,dark) end
    return m
end
function C.cities(root,c,plan,checkpoint)
    for _,city in plan.Cities do
        print('[Cidade] '..city.Name)
        local parent=G.model(root.Cities,city.Id)
        parent:SetAttribute('RegionName',city.Name)
        local cf=CFrame.new(city.X,city.H,city.Z)
        G.part(parent,'Plaza',Vector3.new(64,0.5,64),cf,Color3.fromRGB(149,147,128),Enum.Material.Cobblestone)
        require(script.Parent.CityLandmarkGenerator).build(parent,city,c)
        for index,lot in city.Lots do
            local visible=lot
            if sceneOnly(root) and lot.VisualKind then
                visible=table.clone(lot);visible.Kind=lot.VisualKind
            end
            local _,pos,role=Buildings.build(parent,visible,city.Id,index)
            if not sceneOnly(root) then
                local npc=C.npc(root.NPCs,lot.Id..'_NPC',pos,role,city.Id)
                npc:PivotTo(CFrame.lookAt(npc.PrimaryPart.Position,Vector3.new(city.X,npc.PrimaryPart.Position.Y,city.Z)))
            end
            checkpoint()
        end
        local radius
        for _,config in c.Cities do if config.Id==city.Id then radius=config.Radius-6 end end
        -- Muralha com vãos reservados às rotas. Nada fecha uma estrada.
        if city.Id=='Arkheim' or city.Id=='Valoria' or city.Id=='Durakh' then
            for i=1,64 do
                local a=i/64*math.pi*2
                local x,z=city.X+math.sin(a)*radius,city.Z+math.cos(a)*radius
                local free=true
                if require(script.Parent.TerrainMath).roadDistance(c,x,z)&lt;32 then free=false end
                if free then
                    local h=if city.Id=='Arkheim' then 12 else 6
                    local frame=CFrame.new(x,city.H+h/2,z)*CFrame.Angles(0,a,0)
                    G.part(parent,'CityWall',Vector3.new(radius*math.pi/32+1,h,3),frame,G.Palette.Stone,Enum.Material.Cobblestone)
                    if i%2==0 then G.part(parent,'Merlon',Vector3.new(3,2,3),frame*CFrame.new(0,h/2+1,0),G.Palette.Stone,Enum.Material.Cobblestone) end
                end
            end
        end
        for _,offset in {Vector3.new(-24,0,-24),Vector3.new(24,0,24)} do G.torch(parent,cf*CFrame.new(offset+Vector3.new(0,2,0)),true) end
        local board=G.sign(parent,if sceneOnly(root) then 'AVISOS • GUILDA' else 'MISSÕES • GUILDA',cf*CFrame.new(-23,5,0),12)
        if not sceneOnly(root) then board:SetAttribute('QuestBoard',true);G.prompt(board,'Consultar','Quadro de missões') end
        if not sceneOnly(root) then
            local handoff=G.marker(root.InteractiveObjects,city.Id..'_Supplies',Vector3.new(city.X-24,city.H+3,city.Z+12),{Objective='Supplies'})
            if city.Id=='Durakh' then handoff.Transparency=0;G.prompt(handoff,'Entregar','Suprimentos') end
        end
        G.marker(root.CinematicMarkers,city.Id..'_Shot',Vector3.new(city.X,city.H+60,city.Z+120),{
            ShotName=city.Id..'_Plaza',RegionName=city.Name,CameraPosition=Vector3.new(city.X,city.H+60,city.Z+120),LookAtPosition=Vector3.new(city.X,city.H+10,city.Z),Duration=8,Category='City'})
        Landmarks.city(parent,city,c,C)
        if not sceneOnly(root) then Landmarks.defenses(root,c,C,parent,city) end
        if city.Id=='Valoria' then Landmarks.camp(root,c,C,parent) end
        checkpoint()
    end
end
function C.roads(root,plan,checkpoint,config)
    local c=config or require(Shared.Config.WorldConfig)
    local terrain=require(script.Parent.TerrainMath)
    for _,route in plan.Roads do
        local parent=G.model(root.Roads,route.Id)
        parent:SetAttribute('RouteId',route.Id)
        for i,s in route.Segments do
            local a,b=Vector3.new(s.A.X,s.A.H+0.5,s.A.Z),Vector3.new(s.B.X,s.B.H+0.5,s.B.Z)
            local cf=CFrame.lookAt((a+b)/2,b)
            G.part(parent,if s.Bridge then 'BridgeDeck' else 'Road',Vector3.new(route.Width or 18,0.7,(b-a).Magnitude+0.2),cf,
                if s.Bridge then G.Palette.Wood else Color3.fromRGB(149,128,93),if s.Bridge then Enum.Material.WoodPlanks else Enum.Material.Ground)
            if s.Bridge then
                local bridge=G.model(root.Bridges,route.Id..'_'..i)
                for _,side in {-1,1} do
                    G.part(bridge,'Rail',Vector3.new(0.5,0.8,(b-a).Magnitude+0.2),cf*CFrame.new(side*((route.Width or 18)/2),3,0),G.Palette.Wood,Enum.Material.Wood)
                    local p=cf:PointToWorldSpace(Vector3.new(side*((route.Width or 18)/2-1),0,0))
                    local bed=terrain.height(c,p.X,p.Z)
                    local height=math.max(1,p.Y-bed+1)
                    G.part(bridge,'Support',Vector3.new(1.4,height,1.4),CFrame.new(p.X,bed+height/2-0.5,p.Z),G.Palette.Stone,Enum.Material.Cobblestone)
                end
            end
        end
        G.sign(parent,route.Id,CFrame.new(route.A.X+15,route.A.H+5,route.A.Z),14)
        checkpoint()
    end
end
function C.forests(root,c,plan,checkpoint)
    local chestOverrides={};local folders={}
    for _,f in c.Forests do
        folders[f.Id]=G.model(root.Forests,f.Id);folders[f.Id]:SetAttribute('RegionName',f.Name)
        folders[f.Id]:SetAttribute('ForestTheme',if f.Id=='Sylvarin' then 'Emerald' elseif f.Id=='Nocthar' then 'Ancient' else 'Shadow')
    end
    for i,t in plan.Trees do C.tree(folders[t.Forest],t);if i%20==0 then checkpoint() end end
    local terrain=require(script.Parent.TerrainMath)
    for _,land in plan.Landmarks do
        local parent=folders[land.Id];local cf=CFrame.new(land.X,land.H,land.Z)
        chestOverrides[land.Id..'Chest5']=Scenery.forest(parent,land,c,terrain,C)
        if not sceneOnly(root) then
            local altar=G.part(parent,'Altar',Vector3.new(10,3,7),cf*CFrame.new(0,1.5,0),G.Palette.Stone,Enum.Material.Slate)
            altar:SetAttribute('Objective','Ruins');G.prompt(altar,'Investigar','Ruínas antigas')
            local herb=G.crystal(parent,cf*CFrame.new(20,2,12),Color3.fromRGB(107,237,152),0.5)
            herb:SetAttribute('Objective','Herb');G.prompt(herb,'Coletar','Erva rara')
            C.npc(root.NPCs,land.Id..'_Explorer',Vector3.new(land.X-20,land.H,land.Z),'Quest',land.Id)
            C.enemyMarker(root.EnemySpawns,land.Id..'_Boss',Vector3.new(land.X+45,land.H,land.Z),if land.Id=='Sylvarin' then 'SylvarinBoss' elseif land.Id=='Vespera' then 'VesperaBoss' else 'NoctharBoss')
        end
        G.marker(root.CinematicMarkers,land.Id..'_Shot',Vector3.new(land.X,land.H+25,land.Z+65),{
            ShotName=land.Id,RegionName=land.Id,CameraPosition=Vector3.new(land.X,land.H+25,land.Z+65),LookAtPosition=Vector3.new(land.X,land.H+8,land.Z),Duration=7,Category='Forest'})
        checkpoint()
    end
    if not sceneOnly(root) then
        for _,spawn in plan.EnemySpawns do C.enemyMarker(root.EnemySpawns,spawn.Id,Vector3.new(spawn.X,spawn.H,spawn.Z),spawn.Kind) end
        for _,chest in plan.Chests do C.chest(root.TreasureChests,chest.Id,chestOverrides[chest.Id] or Vector3.new(chest.X,chest.H,chest.Z),chest.Rarity) end
    end
end
function C.entrance(root,c,terrain)
    local function gate(id,def,title,dungeonId,shadow)
        local pos=Vector3.new(def.X,terrain.height(c,def.X,def.Z),def.Z);local cf=CFrame.new(pos)
        local m=G.model(root.DungeonEntrance,id);m:SetAttribute('RegionId',id)
        m:SetAttribute('IntegrationKind','DungeonExterior');m:SetAttribute('IntegrationDungeonId',dungeonId)
        local stone=if shadow then Color3.fromRGB(72,69,82) else Color3.fromRGB(126,135,150)
        local glow=if shadow then Color3.fromRGB(169,79,111) else Color3.fromRGB(126,173,207)
        G.part(m,'Forecourt',Vector3.new(76,2,58),cf,stone,Enum.Material.Cobblestone)
        for _,side in {-1,1} do
            local x=side*25
            G.part(m,'TowerPlinth',Vector3.new(19,4,22),cf*CFrame.new(x,2,-2),stone,Enum.Material.Cobblestone)
            G.part(m,'GateTower',Vector3.new(13,43,16),cf*CFrame.new(x,23,-2),stone,Enum.Material.Slate)
            for _,dx in {-6,6} do G.part(m,'Buttress',Vector3.new(3,31,20),cf*CFrame.new(x+dx,16,-1)*CFrame.Angles(0,0,side*0.035),stone,Enum.Material.Rock) end
            for i=1,3 do
                G.part(m,'TowerCornice',Vector3.new(16,1.2,19),cf*CFrame.new(x,12+i*10,-2),Color3.fromRGB(105,111,125),Enum.Material.Cobblestone)
                G.detail(m,'RuneWindow',Vector3.new(3,5,0.3),cf*CFrame.new(x,11+i*8,6.15),glow,Enum.Material.Neon)
            end
            G.part(m,'SpireBase',Vector3.new(17,3,20),cf*CFrame.new(x,46,-2),stone,Enum.Material.Slate)
            G.crystal(m,cf*CFrame.new(x,52,-2),glow,2)
            G.part(m,'ArchHaunch',Vector3.new(16,5,12),cf*CFrame.new(side*13,36,-2)*CFrame.Angles(0,0,side*0.5),stone,Enum.Material.Cobblestone)
            G.part(m,'OuterColumn',Vector3.new(6,20,6),cf*CFrame.new(side*39,10,13),stone,Enum.Material.Cobblestone)
            G.torch(m,cf*CFrame.new(side*36,6,19),true)
            for i=1,4 do G.part(m,'ApproachPost',Vector3.new(2,3,2),cf*CFrame.new(side*34,2,20+i*5),stone,Enum.Material.Cobblestone) end
        end
        G.part(m,'Keystone',Vector3.new(9,7,13),cf*CFrame.new(0,40,-2),stone,Enum.Material.Slate)
        G.part(m,'UpperLintel',Vector3.new(58,4,17),cf*CFrame.new(0,45,-2),stone,Enum.Material.Slate)
        for i=1,4 do G.part(m,'StairTread',Vector3.new(28,i*0.25,4),cf*CFrame.new(0,i*0.125,22-i*4),stone,Enum.Material.Cobblestone) end
        -- The external threshold is open and inert; no false portal or prompt.
        G.sign(m,title,cf*CFrame.new(0,28,7),35)
        G.marker(m,id..'_Threshold',pos+Vector3.new(0,3,0),{IntegrationId=id,IntegrationKind='DungeonThreshold',DungeonId=dungeonId,OpeningWidth=34})
        if not sceneOnly(root) then
            C.npc(root.NPCs,if shadow then 'DungeonGuardian' else 'SanctumGuardian',pos+Vector3.new(0,1,15),'Dungeon',if shadow then 'Malgorth' else 'Vespera'):SetAttribute('DungeonId',dungeonId)
        end
        return pos
    end
    local pos=gate('MalgorthGate',c.DungeonEntrance,'ABISMO DE MALGORTH','MalgorthDepths',true)
    if c.SecondDungeonEntrance then gate('FallenSanctumGate',c.SecondDungeonEntrance,'SANTUÁRIO DO REINO CAÍDO','FallenSanctum',false) end
    G.marker(root.CinematicMarkers,'DungeonShot',pos+Vector3.new(0,48,100),{ShotName='DungeonGate',RegionName='Malgorth',CameraPosition=pos+Vector3.new(0,48,100),LookAtPosition=pos+Vector3.new(0,20,0),Duration=8,Category='Dungeon'})
end
function C.integrationMarkers(root,c,plan,terrain)
    assert(not root:FindFirstChild('IntegrationPoints'),'IntegrationPoints já existe; nada foi substituído')
    local folder=Instance.new('Folder');folder.Name='IntegrationPoints';folder.Parent=root
    for _,city in plan.Cities do
        G.marker(folder,city.Id..'_Services',Vector3.new(city.X,city.H+3,city.Z),{IntegrationId=city.Id,IntegrationKind='CityHub',RegionId=city.Id,Radius=city.Radius})
        for index,lot in city.Lots do
            local role=Catalog.Roles[lot.Kind] or 'Citizen'
            local p=CFrame.new(lot.X,lot.H,lot.Z)*CFrame.Angles(0,lot.Yaw,0)
            G.marker(folder,lot.Id..'_ServiceSlot',p:PointToWorldSpace(Vector3.new(0,3,-27)),{
                IntegrationId=lot.Id,IntegrationKind='ServiceSlot',RegionId=city.Id,DesignRole=role,BuildingKind=lot.Kind,SlotIndex=index})
        end
    end
    for _,forest in c.Forests do
        G.marker(folder,forest.Id..'_Clearing',Vector3.new(forest.X,terrain.height(c,forest.X,forest.Z)+3,forest.Z),{
            IntegrationId=forest.Id..'_Clearing',IntegrationKind='EncounterClearing',RegionId=forest.Id,Radius=28})
    end
    for _,entrance in {{Id='MalgorthDepths',Point=c.DungeonEntrance},{Id='FallenSanctum',Point=c.SecondDungeonEntrance}} do
        if entrance.Point then
            local p=entrance.Point
            G.marker(folder,entrance.Id..'_Approach',Vector3.new(p.X,terrain.height(c,p.X,p.Z)+3,p.Z+30),{
                IntegrationId=entrance.Id,IntegrationKind='DungeonApproach',RegionId=entrance.Id,Radius=28})
        end
    end
    return folder
end
return C
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_33">
        <Properties>
          <string name="Name">DecorationGenerator</string>
          <string name="Source">local G=require(script.Parent.Geometry)
local D={}
function D.generate(parent,c,plan,terrain)
    require(script.Parent.LandmarkGenerator).waterfall(parent,c,terrain)
    require(script.Parent.ScenicGenerator).continent(parent,c,plan,terrain)
    local budget=c.QualityProfiles[c.Quality].DecorationBudget
    local count=0
    for _,road in plan.Roads do
        for i,s in road.Segments do
            if i%7~=0 or s.Bridge then continue end
            local a,b=Vector3.new(s.A.X,0,s.A.Z),Vector3.new(s.B.X,0,s.B.Z)
            local mid=(a+b)/2;local side=Vector3.new(-(b-a).Z,0,(b-a).X).Unit
            for _,sign in {-1,1} do
                if count&gt;=budget then return count end
                local pos=mid+side*sign*28
                local free=true
                for _,city in plan.Cities do
                    for _,lot in city.Lots do
                        if (Vector2.new(lot.X,lot.Z)-Vector2.new(pos.X,pos.Z)).Magnitude&lt;lot.Radius+8 then free=false end
                    end
                end
                if free and terrain.riverDistance(c,pos.X,pos.Z)&gt;65 then
                    local ground=terrain.height(c,pos.X,pos.Z)
                    local scenery=require(script.Parent.ScenicGenerator)
                    if count%3==0 then scenery.shrub(parent,CFrame.new(pos.X,ground,pos.Z),0.8,false)
                    else scenery.boulder(parent,CFrame.new(pos.X,ground+0.6,pos.Z),0.35+count%3*0.1) end
                    count+=1
                end
            end
        end
    end
    return count
end
return D
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_34">
        <Properties>
          <string name="Name">DungeonInteriorGenerator</string>
          <string name="Source">local G=require(script.Parent.Geometry)
local Content=require(script.Parent.ContentGenerator)
local TerrainGenerator=require(script.Parent.TerrainGenerator)
local D={}
function D.GenerateDungeon(options)
    options=options or {}
    assert(not game:GetService('RunService'):IsRunning() or options.StudioTest==true and game:GetService('RunService'):IsStudio(), 'Dungeon do editor só pode ser gerada fora do Play')
    assert(not workspace:FindFirstChild('GeneratedDungeon'),'GeneratedDungeon já existe; nada foi substituído')
    assert(options.StudioTest==true or not workspace:FindFirstChild('GeneratedWorld'),'Use outro Place para a dungeon')
    local origin=options.Origin or Vector3.new(0,20,0)
    local Expeditions=require(script.Parent.ExpeditionGenerator)
    Expeditions.preflight(origin)
    local params=OverlapParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={workspace.Terrain}
    assert(#workspace:GetPartBoundsInBox(CFrame.new(origin+Vector3.new(30,35,330)),Vector3.new(220,100,800),params)==0,'Área da dungeon contém objetos existentes')
    local volume=Region3.new(origin+Vector3.new(-80,-15,-70),origin+Vector3.new(140,85,730)):ExpandToGrid(4)
    TerrainGenerator.assertRegionEmpty(workspace.Terrain,volume,'Área da dungeon contém Terrain existente; use um Place novo')
    local m=G.model(workspace,'GeneratedDungeon'); m:SetAttribute('ProjectId','ProjectMedievalRPG'); m:SetAttribute('BossDefeated',false)
    m:SetAttribute('StudioTest',options.StudioTest==true); m:SetAttribute('Status','Generating')
    m:SetAttribute('Origin',origin)
    for _,name in {'Rooms','EnemySpawns','TreasureChests','Traps','CinematicMarkers','NPCs'} do local f=Instance.new('Folder');f.Name=name;f.Parent=m end
    local ok,err=xpcall(function()
        local titles={'Salão do Juramento','Galeria das Sombras','Ponte do Abismo','Salão das Lâminas','Capela Corrompida','Antecâmara do Cavaleiro','Trono de Malgorth'}
        for i,title in titles do
            local room=G.model(m.Rooms,'Room'..i); room:SetAttribute('RoomName',title)
            local cf=CFrame.new(origin+Vector3.new(0,0,(i-1)*110)); local width=if i==7 then 84 else 52
            if i==3 then
                for _,side in {-1,1}do G.part(room,'AbysmPlatform',Vector3.new(width,3,20),cf*CFrame.new(0,0,side*22),G.Palette.Stone,Enum.Material.Slate)end
                G.part(room,'AbysmBridge',Vector3.new(16,3,24),cf,G.Palette.Stone,Enum.Material.Cobblestone)
                for _,side in {-1,1}do G.part(room,'BridgeRail',Vector3.new(1,3,24),cf*CFrame.new(side*8.5,3,0),G.Palette.Stone,Enum.Material.Slate)end
            else G.part(room,'Floor',Vector3.new(width,3,62),cf,G.Palette.Stone,Enum.Material.Slate)end
            for _,x in {-width/2,width/2} do
                for _,z in {-21,21} do G.part(room,'SideWall',Vector3.new(3,24,20),cf*CFrame.new(x,12,z),G.Palette.Stone,Enum.Material.Slate) end
                if i~=3 or x&lt;0 then G.part(room,'ClosedSide',Vector3.new(3,24,22),cf*CFrame.new(x,12,0),G.Palette.Stone,Enum.Material.Slate)end
                G.part(room,'SideLintel',Vector3.new(3,10,22),cf*CFrame.new(x,20,0),G.Palette.Stone,Enum.Material.Slate)
            end
            for _,z in {-31,31} do
                for _,side in {-1,1} do G.part(room,'DoorWall',Vector3.new((width-16)/2,24,3),cf*CFrame.new(side*(width+16)/4,12,z),G.Palette.Stone,Enum.Material.Cobblestone) end
                G.part(room,'ArchLintel',Vector3.new(16,8,3),cf*CFrame.new(0,20,z),G.Palette.Stone,Enum.Material.Cobblestone)
            end
            G.part(room,'Ceiling',Vector3.new(width,2,62),cf*CFrame.new(0,28,0),Color3.fromRGB(53,45,61),Enum.Material.Slate)
            for _,x in {-width/2+5,width/2-5} do G.torch(room,cf*CFrame.new(x,6,0),true) end
            for _,x in {-width/2+5,width/2-5}do
                G.part(room,'PillarFoot',Vector3.new(5,2,5),cf*CFrame.new(x,2,22),G.Palette.Stone,Enum.Material.Cobblestone)
                G.part(room,'Pillar',Vector3.new(2,20,2),cf*CFrame.new(x,12,22),G.Palette.Stone,Enum.Material.Slate)
            end
            if i==5 then G.part(room,'CorruptedAltar',Vector3.new(12,4,8),cf*CFrame.new(15,3,12),G.Palette.Stone,Enum.Material.CrackedLava)end
            if i==7 then
                G.part(room,'ThroneDais',Vector3.new(20,2,10),cf*CFrame.new(0,2,20),G.Palette.Stone,Enum.Material.Cobblestone)
                G.part(room,'ThroneBack',Vector3.new(8,12,2),cf*CFrame.new(0,9,24),Color3.fromRGB(97,39,53),Enum.Material.Slate)
                for _,side in {-1,1}do G.crystal(room,cf*CFrame.new(side*30,8,20),Color3.fromRGB(185,62,107),1.5)end
            end
            G.sign(room,title,cf*CFrame.new(0,23,-29),30)
            if i&lt;7 then
                local bridge=G.model(m.Rooms,'Corridor'..i)
                G.part(bridge,'Deck',Vector3.new(16,2,50),cf*CFrame.new(0,0,55),G.Palette.Stone,Enum.Material.Cobblestone)
                for _,x in {-9,9} do G.part(bridge,'Rail',Vector3.new(2,3,50),cf*CFrame.new(x,2,55),G.Palette.Stone,Enum.Material.Slate) end
            end
            if i==4 then
                local trap=G.detail(m.Traps,'DemonRune',Vector3.new(12,0.2,12),cf*CFrame.new(0,1.7,0),Color3.fromRGB(208,47,78),Enum.Material.Neon)
                trap:SetAttribute('TrapDamage',12)
            end
            if i&gt;1 then
                local kind=if i==7 then 'Malgorth' elseif i==6 then 'Knight' elseif i==5 then 'Shadow' elseif i%2==0 then 'Demon' else 'Skeleton'
                Content.enemyMarker(m.EnemySpawns,'DungeonEnemy'..i,origin+Vector3.new(0,2,(i-1)*110),kind)
            end
            task.wait()
        end
        -- Sala secreta e ligação lateral explorável.
        local secret=G.model(m.Rooms,'SecretRoom')
        G.part(secret,'SecretFloor',Vector3.new(80,3,24),CFrame.new(origin+Vector3.new(54,0,220)),G.Palette.Stone,Enum.Material.Slate)
        for _,z in {-13,13}do G.part(secret,'SecretRail',Vector3.new(70,5,2),CFrame.new(origin+Vector3.new(59,3,z+220)),G.Palette.Stone,Enum.Material.Slate)end
        G.part(secret,'SecretBack',Vector3.new(2,16,24),CFrame.new(origin+Vector3.new(95,8,220)),G.Palette.Stone,Enum.Material.Slate)
        Content.chest(m.TreasureChests,'MalgorthSecret',origin+Vector3.new(86,2,220),'Epic')
        Content.chest(m.TreasureChests,'MalgorthReward',origin+Vector3.new(18,2,680),'Legendary',true)
        local portal=G.part(m,'ReturnPortal',Vector3.new(10,16,2),CFrame.new(origin+Vector3.new(0,9,690)),Color3.fromRGB(98,127,241),Enum.Material.Neon)
        portal.CanCollide=false; portal:SetAttribute('ReturnPortal',true); G.prompt(portal,'Retornar','Portal de retorno')
        local spawn=Instance.new('SpawnLocation');spawn.Name='DungeonSpawn';spawn.Anchored=true;spawn.Neutral=true
        spawn.Size=Vector3.new(10,1,10);spawn.Position=origin+Vector3.new(0,2,-18);spawn.Parent=m
        m:SetAttribute('SpawnPosition',spawn.Position+Vector3.new(0,4,0))
        Content.npc(m.NPCs,'DepthsReception',origin+Vector3.new(-16,2,-18),'Dungeon','Malgorth'):SetAttribute('DungeonId','MalgorthDepths')
        Content.npc(m.NPCs,'SanctumReception',origin+Vector3.new(16,2,-18),'Dungeon','Vespera'):SetAttribute('DungeonId','FallenSanctum')
        local retreat=G.detail(m,'LobbyReturn',Vector3.new(6,9,2),CFrame.new(origin+Vector3.new(18,6,-25)),Color3.fromRGB(101,158,180),Enum.Material.Neon)
        retreat:SetAttribute('ReturnPortal',true);G.prompt(retreat,'Retornar','Continente')
        G.marker(m.CinematicMarkers,'BossShot',origin+Vector3.new(0,20,610),{ShotName='MalgorthArena',RegionName='Abismo de Malgorth',CameraPosition=origin+Vector3.new(0,20,610),LookAtPosition=origin+Vector3.new(0,8,660),Duration=8,Category='Boss'})
        Expeditions.build(m,origin)
        m:SetAttribute('Status','Complete')
    end,debug.traceback)
    if not ok then m:SetAttribute('Status','Failed');error(err,0) end
    print('[Dungeon] Mapa separado gerado. Teleporte real NÃO TESTADO. Salve o Place.')
    return m
end
return D
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_35">
        <Properties>
          <string name="Name">ExpeditionGenerator</string>
          <string name="Source">local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.DungeonConfig)
local Rules=require(Shared.Core.DungeonRules)
local G=require(script.Parent.Geometry)
local Content=require(script.Parent.ContentGenerator)
local TerrainGenerator=require(script.Parent.TerrainGenerator)
local Generator={}
function Generator.preflight(origin)
 for _,id in Config.Order do
  local d=Config.Dungeons[id]
  local low=origin+Vector3.new(d.X-85,-6,d.Z-85)
  local high=origin+Vector3.new(d.X+85,(d.Floors-1)*96+45,d.Z+85)
  local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={workspace.Terrain}
  assert(#workspace:GetPartBoundsInBox(CFrame.new((low+high)/2),high-low,params)==0,'Área da expedição ocupada; preserve o mapa e use outro Place')
  -- Small per-floor reads avoid an enormous empty vertical voxel allocation.
  for n=1,d.Floors do
   local p=origin+Vector3.new(d.X,(n-1)*96,d.Z)
   TerrainGenerator.assertRegionEmpty(workspace.Terrain,
    Region3.new(p-Vector3.new(85,6,85),p+Vector3.new(85,45,85)):ExpandToGrid(4),
    'Terrain existente na área da expedição')
  end
 end
end
function Generator.build(map,origin)
 local expeditions=G.model(map,'Expeditions')
 for _,id in Config.Order do
  local d=Config.Dungeons[id];local tower=G.model(expeditions,id)
  tower:SetAttribute('DungeonId',id);tower:SetAttribute('FloorCount',d.Floors)
  local tint=Color3.fromRGB(table.unpack(d.Tint))
  for n=1,d.Floors do
   local plan=Rules.floor(Config,id,n);local pos=origin+Vector3.new(plan.X,plan.Y,plan.Z)
   local floor=G.model(tower,'Floor'..n)
   floor:SetAttribute('DungeonId',id);floor:SetAttribute('FloorIndex',n);floor:SetAttribute('Layout',plan.Layout)
   floor:SetAttribute('FloorName',plan.Name);floor:SetAttribute('SpawnPosition',pos+Vector3.new(0,6,-56))
   floor:SetAttribute('Center',pos);floor:SetAttribute('Active',false)
   for _,name in {'EnemySpawns','TreasureChests'} do local f=Instance.new('Folder');f.Name=name;f.Parent=floor end
   local function part(name,size,x,y,z,color,material)
    return G.part(floor,name,size,CFrame.new(pos+Vector3.new(x,y,z)),color or G.Palette.Stone,material or Enum.Material.Slate)
   end
   if plan.Layout=='Bridge' then
    for _,z in {-53,53} do part('Landing',Vector3.new(140,3,40),0,0,z) end
    part('Crossing',Vector3.new(22,3,70),0,0,0)
    for _,x in {-12,12} do part('BridgeRail',Vector3.new(2,4,70),x,3,0) end
   else part('Floor',Vector3.new(140,3,150),0,0,0) end
   for _,x in {-71,71} do part('Wall',Vector3.new(3,34,150),x,17,0) end
   for _,z in {-76,76} do part('Wall',Vector3.new(140,34,3),0,17,z) end
   part('Vault',Vector3.new(144,2,154),0,36,0,Color3.fromRGB(43,42,57))
   for _,x in {-58,58} do
    for _,z in {-48,0,48} do
     part('ColumnBase',Vector3.new(8,3,8),x,3,z)
     part('Column',Vector3.new(4,30,4),x,18,z)
     local banner=G.detail(floor,'Banner',Vector3.new(6,12,0.3),CFrame.new(pos+Vector3.new(x,24,z-3)),tint,Enum.Material.Fabric);banner:SetAttribute('Flutter',true)
    end
    G.torch(floor,CFrame.new(pos+Vector3.new(x,8,0)),true)
   end
   -- Six different traversal silhouettes; a central corridor remains at least 16 studs wide.
   for _,side in {-1,1} do
    if plan.Layout=='Crypt' then
     for row=-1,1 do part('Sarcophagus',Vector3.new(14,4,9),side*39,3,row*24);part('CarvedLid',Vector3.new(15,1,10),side*39,5.5,row*24,tint) end
    elseif plan.Layout=='Library' then
     for row=-1,1 do
      part('Bookshelf',Vector3.new(24,18,3),side*39,10,row*25,G.Palette.Wood,Enum.Material.WoodPlanks)
      for y=5,17,4 do part('Books',Vector3.new(22,2,2),side*39,y,row*25-2,tint,Enum.Material.Fabric) end
     end
    elseif plan.Layout=='Garden' then
     part('Planter',Vector3.new(24,3,50),side*40,2,0)
     for row=-1,1 do Content.tree(floor,{X=pos.X+side*40,H=pos.Y+3,Z=pos.Z+row*18,Scale=0.65,Variant=(n+row)%3,Forest='Vespera'}) end
    elseif plan.Layout=='Forge' then
     part('Furnace',Vector3.new(20,14,22),side*42,8,10,G.Palette.Stone,Enum.Material.Brick)
     G.detail(floor,'Embers',Vector3.new(15,5,0.5),CFrame.new(pos+Vector3.new(side*42,6,-1.5)),Color3.fromRGB(249,124,61),Enum.Material.Neon)
     for row=-1,1 do part('Anvil',Vector3.new(8,3,5),side*32,4,row*28,Color3.fromRGB(71,75,82),Enum.Material.Metal) end
    elseif plan.Layout=='Arena' then
     part('ThroneDais',Vector3.new(18,2,18),side*46,2,38)
     G.crystal(floor,CFrame.new(pos+Vector3.new(side*46,8,38)),tint,1.5)
    end
   end
   for i,kind in plan.Enemies do
    local x=if plan.Layout=='Bridge' or plan.Boss then 0 else (if i%2==0 then -18 else 18)
    local z=if plan.Layout=='Bridge' then 40+(i-1)*7 else -8+(i-1)*14
    local marker=Content.enemyMarker(floor.EnemySpawns,id..'_'..n..'_'..i,pos+Vector3.new(x,2,z),kind)
    marker:SetAttribute('Enabled',false);marker:SetAttribute('Once',true);marker:SetAttribute('Difficulty',plan.Scale)
   end
   local nextPortal=part('NextFloor',Vector3.new(9,12,2),0,7,64,tint,Enum.Material.Neon)
   nextPortal.CanCollide=false;nextPortal:SetAttribute('ExpeditionNext',true);G.prompt(nextPortal,'Avançar',n..'/'..d.Floors..' • elimine os guardiões')
   local leave=part('RetreatPortal',Vector3.new(6,9,2),-29,6,-62,Color3.fromRGB(101,158,180),Enum.Material.Neon)
   leave.CanCollide=false;leave:SetAttribute('ReturnPortal',true);G.prompt(leave,'Retornar','Abandonar expedição')
   local chest=Content.chest(floor.TreasureChests,id..'_Floor_'..n,pos+Vector3.new(28,2,60),if plan.Boss then 'Epic' else 'Uncommon')
   chest:SetAttribute('FloorLocked',true)
   G.sign(floor,string.format('%02d • %s',n,plan.Name),CFrame.new(pos+Vector3.new(0,27,73)),45)
   task.wait()
  end
 end
 return expeditions
end
return Generator
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_36">
        <Properties>
          <string name="Name">Geometry</string>
          <string name="Source">local G={}
G.Palette={Stone=Color3.fromRGB(112,119,124),Wood=Color3.fromRGB(86,53,35),Plaster=Color3.fromRGB(221,202,160),Roof=Color3.fromRGB(133,58,47),Gold=Color3.fromRGB(224,177,74)}
function G.model(parent,name)
    local m=Instance.new('Model'); m.Name=name; m.Parent=parent
    m:SetAttribute('GeneratedBy','ProjectMedievalRPG'); return m
end
function G.part(parent,name,size,cf,color,material,shape)
    local p=Instance.new('Part'); p.Name=name; p.Size=size; p.CFrame=cf
    p.Anchored=true; p.Color=color or G.Palette.Stone; p.Material=material or Enum.Material.Slate
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    if shape then p.Shape=shape end
    p.CanTouch=false; p.Parent=parent; return p
end
function G.detail(parent,name,size,cf,color,material,shape)
    local p=G.part(parent,name,size,cf,color,material,shape)
    p.CanCollide=false; p.CanQuery=false; return p
end
function G.sign(parent,text,cf,width)
    local p=G.detail(parent,'Sign',Vector3.new(width or 12,3,0.4),cf,G.Palette.Wood,Enum.Material.Wood)
    local ui=Instance.new('SurfaceGui'); ui.Face=Enum.NormalId.Front; ui.CanvasSize=Vector2.new(500,130); ui.Parent=p
    local label=Instance.new('TextLabel'); label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1
    label.Text=text; label.TextColor3=G.Palette.Gold; label.TextScaled=true; label.Font=Enum.Font.Garamond; label.Parent=ui
    return p
end
function G.prompt(part,action,object)
    local p=Instance.new('ProximityPrompt'); p.ActionText=action; p.ObjectText=object
    p.KeyboardKeyCode=Enum.KeyCode.E; p.MaxActivationDistance=12; p.RequiresLineOfSight=true; p.HoldDuration=0.2; p.Parent=part; return p
end
function G.marker(parent,id,pos,attrs)
    local p=G.detail(parent,id,Vector3.new(2,2,2),CFrame.new(pos),G.Palette.Gold)
    p.Transparency=1
    for key,value in attrs or {} do p:SetAttribute(key,value) end
    return p
end
function G.crystal(parent,cf,color,scale)
    return G.detail(parent,'Crystal',Vector3.new(2,6,2)*(scale or 1),cf*CFrame.Angles(0,0,0.3),color,Enum.Material.Neon)
end
function G.torch(parent,cf,light)
    G.detail(parent,'TorchWood',Vector3.new(0.6,3,0.6),cf,G.Palette.Wood,Enum.Material.Wood)
    local flame=G.detail(parent,'Flame',Vector3.new(1,1.8,1),cf*CFrame.new(0,2,0),Color3.fromRGB(255,155,58),Enum.Material.Neon,Enum.PartType.Ball)
    if light then local l=Instance.new('PointLight'); l.Range=18; l.Brightness=1; l.Color=flame.Color; l.Shadows=false; l.Parent=flame end
end
function G.beam(parent,a,b,width,color,material)
    local delta=b-a
    return G.part(parent,'Beam',Vector3.new(width,width,delta.Magnitude),CFrame.lookAt((a+b)/2,b),color,material)
end
return G
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_37">
        <Properties>
          <string name="Name">LandmarkGenerator</string>
          <string name="Source">local G=require(script.Parent.Geometry)
local L={}
local function sceneOnly(node)
 while node and node~=workspace do
  if node:GetAttribute('SceneOnly')==true then return true end
  node=node.Parent
 end
 return false
end
function L.city(parent,city,config,Content)
 local cf=CFrame.new(city.X,city.H,city.Z)
 local tint=if city.Id=='Eldoria' then Color3.fromRGB(92,154,108) elseif city.Id=='Asterion' then Color3.fromRGB(135,153,217) else G.Palette.Gold
 -- A furnished civic square with clear north/south and east/west crossing lanes.
 for _,side in {-1,1} do
  for _,z in {-23,23} do
   G.part(parent,'GardenBorder',Vector3.new(14,1.3,7),cf*CFrame.new(side*20,0.8,z),G.Palette.Stone,Enum.Material.Cobblestone)
   G.detail(parent,'FlowerBed',Vector3.new(12,0.8,5),cf*CFrame.new(side*20,1.8,z),Color3.fromRGB(71,123,76),Enum.Material.Grass)
   for i=1,3 do G.detail(parent,'Flower',Vector3.new(1.5,1,1.5),cf*CFrame.new(side*20+i*3-6,2.3,z),tint,Enum.Material.SmoothPlastic,Enum.PartType.Ball) end
  end
  G.part(parent,'PublicBench',Vector3.new(10,0.7,3),cf*CFrame.new(side*20,2,12),G.Palette.Wood,Enum.Material.WoodPlanks)
  for _,x in {-4,4} do G.part(parent,'BenchLeg',Vector3.new(0.7,2,2),cf*CFrame.new(side*20+x,1,12),G.Palette.Wood,Enum.Material.Wood) end
 end
 if city.Id=='Eldoria' then
  for _,x in {-48,48} do Content.tree(parent,{X=city.X+x,H=city.H,Z=city.Z+25,Scale=1.6,Variant=2,Forest='Sylvarin'}) end
 elseif city.Id=='Asterion' then
  for _,x in {-48,48} do
   G.part(parent,'CelestialObelisk',Vector3.new(5,24,5),cf*CFrame.new(x,12,28),G.Palette.Stone,Enum.Material.Marble)
   G.crystal(parent,cf*CFrame.new(x,28,28),tint,1.4)
  end
 elseif city.Id=='Durakh' then
  G.part(parent,'CaravanBed',Vector3.new(12,2,6),cf*CFrame.new(46,3,25),G.Palette.Wood,Enum.Material.WoodPlanks)
  for _,x in {42,50} do for _,z in {21,29} do G.part(parent,'CartWheel',Vector3.new(1,4,4),CFrame.new(city.X+x,city.H+2,city.Z+z),G.Palette.Wood,Enum.Material.Wood,Enum.PartType.Cylinder) end end
 end
 local cityConfig;for _,c in config.Cities do if c.Id==city.Id then cityConfig=c end end
 -- Short porch walks follow each facade; city streets are authored in the plan.
 for _,lot in city.Lots do
  if lot.External then continue end
  local frame=CFrame.new(lot.X,lot.H+0.3,lot.Z)*CFrame.Angles(0,lot.Yaw,0)
  local a=frame:PointToWorldSpace(Vector3.new(0,0,-23))
  local b=if lot.StreetX and lot.StreetZ then Vector3.new(lot.StreetX,lot.H+0.3,lot.StreetZ) else frame:PointToWorldSpace(Vector3.new(0,0,-36))
  if (b-a).Magnitude&gt;0.5 then G.detail(parent,'Footpath',Vector3.new(6,0.2,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),Color3.fromRGB(142,138,122),Enum.Material.Cobblestone) end
 end
 for _,street in city.Streets or {} do
  local a=Vector3.new(street.A.X,city.H+0.28,street.A.Z);local b=Vector3.new(street.B.X,city.H+0.28,street.B.Z)
  G.detail(parent,'DistrictStreet',Vector3.new(street.Width or 12,0.25,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),Color3.fromRGB(139,137,123),Enum.Material.Cobblestone)
 end
 if cityConfig and city.Id=='Arkheim' then G.sign(parent,'O BASTIÃO RESISTE',cf*CFrame.new(0,9,cityConfig.Radius-22),26) end
end
function L.camp(root,c,Content,parent)
 local p=c.Guild;local cf=CFrame.new(p.X,p.Height,p.Z)
 G.part(parent,'GuildCamp',Vector3.new(150,0.5,130),cf,Color3.fromRGB(148,136,112),Enum.Material.Cobblestone)
 G.sign(parent,if sceneOnly(root) then 'GUILDA DOS AVENTUREIROS' else 'GUILDA • TREINO • RANK F',cf*CFrame.new(0,8,-56),30)
 if not sceneOnly(root) then
  local marker=Content.enemyMarker(root.EnemySpawns,'Valoria_Training',Vector3.new(p.X-35,p.Height+1,p.Z),'Training')
  marker:SetAttribute('Training',true)
  G.sign(parent,'ESPERE O AVISO • APARE COM F',cf*CFrame.new(-35,9,13),26)
 else
  G.sign(parent,'PÁTIO DE TREINAMENTO',cf*CFrame.new(-35,7,22),25)
  for _,side in {-1,1} do
   G.part(parent,'PracticePost',Vector3.new(2,6,2),cf*CFrame.new(-35+side*10,3,0),G.Palette.Wood,Enum.Material.Wood)
   G.part(parent,'PracticeArms',Vector3.new(7,0.7,0.7),cf*CFrame.new(-35+side*10,5,0),G.Palette.Wood,Enum.Material.Wood)
  end
 end
 for _,side in {-1,1} do G.torch(parent,cf*CFrame.new(side*65,3,-40),true) end
end
function L.defenses(root,c,Content,parent,city)
 do
  if city.Id~='Valoria' and city.Id~='Arkheim' then return end
  local z=city.Z-(city.Radius+60);local x=city.X+75
  local terrain=require(script.Parent.TerrainMath);local h=terrain.height(c,x,z)
  G.sign(parent,'FRONTEIRA • DEFENDA OS SINOS',CFrame.new(x,h+8,z),30)
  for i=1,5 do
   local px,pz=x+(i-3)*12,z+12
   local marker=Content.enemyMarker(root.EnemySpawns,city.Id..'_Defense_'..i,Vector3.new(px,terrain.height(c,px,pz),pz),'Demon')
   marker:SetAttribute('DefenseCity',city.Id);marker:SetAttribute('Enabled',false);marker:SetAttribute('Once',true)
  end
 end
end
function L.waterfall(root,c,terrain)
 local lake=c.Lake;if not lake then return end
 local p=Vector3.new(lake.X+lake.Radius-20,lake.WaterY,lake.Z)
 local m=G.model(root,'CascadeOfMemories')
 for _,side in {-1,1} do
  local bed=terrain.height(c,p.X+12,p.Z+side*13)
  local height=lake.WaterY+27-bed
  G.part(m,'CascadeRock',Vector3.new(16,height,22),CFrame.new(p.X+12,bed+height/2,p.Z+side*13),G.Palette.Stone,Enum.Material.Rock)
 end
 G.part(m,'UpperBasin',Vector3.new(22,3,20),CFrame.new(p+Vector3.new(12,25,0)),G.Palette.Stone,Enum.Material.Rock)
 local upper=G.detail(m,'UpperWater',Vector3.new(22,0.3,12),CFrame.new(p+Vector3.new(12,26.6,0)),Color3.fromRGB(137,200,210),Enum.Material.Glass);upper.Transparency=0.3
 local sheet=G.detail(m,'Waterfall',Vector3.new(0.7,28,11),CFrame.new(p+Vector3.new(1,13,0)),Color3.fromRGB(137,200,210),Enum.Material.Glass)
 sheet.Transparency=0.35
 for i=1,5 do G.detail(m,'Foam',Vector3.new(7,0.4,3),CFrame.new(p+Vector3.new(-i*3,0.2,i%2*3-2)),Color3.fromRGB(224,242,239),Enum.Material.SmoothPlastic,Enum.PartType.Ball) end
 local shoreX=lake.X-lake.Radius-lake.Bank-12
 if not sceneOnly(root) then
  local objective=G.marker(m,'LakeDiscovery',Vector3.new(shoreX,terrain.height(c,shoreX,lake.Z)+3,lake.Z),{Objective='LakeDiscovery'})
  objective.Transparency=0;G.prompt(objective,'Recordar','Lago das Memórias')
 else
  G.marker(m,'LakeDiscovery',Vector3.new(shoreX,terrain.height(c,shoreX,lake.Z)+3,lake.Z),{IntegrationId='LakeDiscovery',IntegrationKind='Discovery'})
 end
end
return L
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_38">
        <Properties>
          <string name="Name">MapEnvironment</string>
          <string name="Source">-- Environment inspection presets; no time simulation or weather gameplay.
local Environment={}
local presets={
    Dawn={Time=6.4,Brightness=1.7,Exposure=0.02,Density=0.24,Haze=1.3,Color={238,203,168},Decay={134,147,179},Ambient={102,87,119},Outdoor={150,132,142}},
    Day={Time=10.5,Brightness=2.2,Exposure=0.03,Density=0.19,Haze=0.8,Color={202,222,239},Decay={133,155,180},Ambient={88,91,111},Outdoor={143,151,164}},
    Sunset={Time=17.65,Brightness=1.8,Exposure=0.02,Density=0.26,Haze=1.4,Color={246,190,145},Decay={146,116,156},Ambient={109,81,112},Outdoor={162,127,137}},
    Night={Time=0.6,Brightness=1.15,Exposure=-0.03,Density=0.23,Haze=1.1,Color={126,146,183},Decay={64,79,123},Ambient={59,63,90},Outdoor={85,96,126}},
    Rain={Time=13.5,Brightness=1.45,Exposure=-0.04,Density=0.31,Haze=1.8,Color={161,181,192},Decay={108,127,147},Ambient={89,101,119},Outdoor={127,143,155}},
    Fog={Time=7.2,Brightness=1.65,Exposure=0,Density=0.43,Haze=2.7,Color={200,212,205},Decay={149,164,162},Ambient={104,117,123},Outdoor={151,165,164}},
    Storm={Time=15.4,Brightness=1.2,Exposure=-0.08,Density=0.35,Haze=2.2,Color={140,157,177},Decay={78,94,126},Ambient={71,80,105},Outdoor={103,119,143}},
}
local function effect(lighting,class,name)
    local item=lighting:FindFirstChild(name)
    assert(not item or item:IsA(class),'Objeto de iluminação reservado com classe incorreta: '..name)
    if not item then item=Instance.new(class);item.Name=name;item.Parent=lighting end
    return item
end
local function rgb(values)return Color3.fromRGB(table.unpack(values))end
function Environment.apply(name)
    local p=presets[name]
    assert(p,'Preset visual desconhecido')
    local lighting=game:GetService('Lighting')
    lighting.ClockTime=p.Time;lighting.Brightness=p.Brightness;lighting.ExposureCompensation=p.Exposure
    lighting.Ambient=rgb(p.Ambient);lighting.OutdoorAmbient=rgb(p.Outdoor)
    lighting.GlobalShadows=true;lighting.EnvironmentDiffuseScale=0.55;lighting.EnvironmentSpecularScale=0.38
    lighting.ShadowSoftness=0.5
    local atmosphere=effect(lighting,'Atmosphere','EldravynMapAtmosphere')
    atmosphere.Density=p.Density;atmosphere.Haze=p.Haze;atmosphere.Offset=0.12
    atmosphere.Color=rgb(p.Color);atmosphere.Decay=rgb(p.Decay);atmosphere.Glare=0.1
    local bloom=effect(lighting,'BloomEffect','EldravynMapBloom')
    bloom.Intensity=0.075;bloom.Size=18;bloom.Threshold=1.5
    local grade=effect(lighting,'ColorCorrectionEffect','EldravynMapGrade')
    grade.Saturation=0.07;grade.Contrast=0.08;grade.Brightness=0
    local sun=effect(lighting,'SunRaysEffect','EldravynMapSunRays')
    sun.Intensity=if name=='Day' or name=='Dawn' or name=='Sunset' then 0.025 else 0
    sun.Spread=0.65
    local sky=effect(lighting,'Sky','EldravynMapSky')
    sky.CelestialBodiesShown=true;sky.StarCount=1800;sky.SunAngularSize=9;sky.MoonAngularSize=6
    lighting:SetAttribute('MapEnvironmentPreset',name)
    workspace:SetAttribute('MapEnvironmentPreset',name)
    return name
end
return Environment
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_39">
        <Properties>
          <string name="Name">MapSceneGenerator</string>
          <string name="Source">-- Map-only authoring. Existing RPG runtime/services are not started by this path.
local Run=game:GetService('RunService')
local Config=require(game.ReplicatedStorage.MedievalRPG.Config.WorldConfig)
local TerrainMath=require(script.Parent.TerrainMath)
local Terrain=require(script.Parent.TerrainGenerator)
local Plan=require(script.Parent.WorldPlan)
local Content=require(script.Parent.ContentGenerator)
local Catalog=require(game.ReplicatedStorage.MedievalRPG.Config.ContentConfig)
local Scene={}
local folders={'TerrainMarkers','Roads','Bridges','Cities','Forests','DungeonEntrance','Ruins','Decorations','Spawns','InteractiveObjects','TreasureChests','NPCSpawns','EnemySpawns','CinematicMarkers','NPCs'}
local function editor()
    assert(not Run:IsRunning(),'Execute no editor, fora de Play/Run')
end
local function unownedParts(c,root)
    local p=OverlapParams.new();p.FilterType=Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances=if root then {workspace.Terrain,root} else {workspace.Terrain}
    assert(#workspace:GetPartBoundsInBox(CFrame.new(0,(c.MinY+c.MaxY)/2,0),Vector3.new(c.WorldSize,c.MaxY-c.MinY,c.WorldSize),p)==0,
        'A área contém objetos externos ao cenário. Nada foi sobrescrito; use uma cópia nova.')
end
function Scene.generate(config)
    editor();local c=config or Config;TerrainMath.validate(c)
    assert(not workspace:FindFirstChild('GeneratedWorld'),'Um continente já existe; foi preservado')
    unownedParts(c)
    local root=Instance.new('Folder');root.Name='GeneratedWorld'
    root:SetAttribute('ProjectId',c.ProjectId);root:SetAttribute('SchemaVersion',c.SchemaVersion)
    root:SetAttribute('ConfigSignature',TerrainMath.signature(c));root:SetAttribute('Seed',c.Seed)
    root:SetAttribute('SceneOnly',true);root:SetAttribute('TerrainPending',true)
    root:SetAttribute('Status','AuthoringGeometry');root:SetAttribute('ChunksWritten',0);root.Parent=workspace
    local ok,err=xpcall(function()
        Terrain.assertEmpty(workspace.Terrain,c,TerrainMath.chunks(c),function()task.wait()end)
        for _,name in folders do local f=Instance.new('Folder');f.Name=name;f.Parent=root end
        local plan=Plan.build(c,TerrainMath,Catalog)
        Content.roads(root,plan,function()task.wait()end)
        Content.cities(root,c,plan,function()task.wait()end)
        Content.forests(root,c,plan,function()task.wait()end)
        Content.entrance(root,c,TerrainMath)
        require(script.Parent.DecorationGenerator).generate(root.Decorations,c,plan,TerrainMath)
        Content.integrationMarkers(root,c,plan,TerrainMath)
        local city=c.Cities[1]
        local spawn=Instance.new('SpawnLocation');spawn.Name='ValoriaSpawn';spawn.Size=Vector3.new(10,1,10)
        spawn.Position=Vector3.new(city.X,city.Height+1,city.Z);spawn.Anchored=true;spawn.Neutral=true
        spawn.Color=Color3.fromRGB(150,148,131);spawn.Material=Enum.Material.Cobblestone;spawn.Parent=root.Spawns
        root:SetAttribute('PreparedGeometry',true);root:SetAttribute('Status','AwaitingTerrain')
        workspace:SetAttribute('EldravynMapOnly',true)
        require(script.Parent.MapEnvironment).apply('Day')
    end,debug.traceback)
    if not ok then root:SetAttribute('Status','GeometryFailed');root:SetAttribute('Error',tostring(err));error(err,0)end
    Scene.validate(c)
    print('[Eldravyn mapa] Geometria construída. Terrain nativo ainda pendente; execute PrepareStudio() no editor e salve.')
    return root
end
function Scene.completeTerrain(config)
    editor();local c=config or Config
    local root=workspace:FindFirstChild('GeneratedWorld')
    assert(root and root:GetAttribute('ProjectId')==c.ProjectId and root:GetAttribute('SceneOnly')==true,'Cenário próprio ausente')
    assert(root:GetAttribute('ConfigSignature')==TerrainMath.signature(c),'Geografia incompatível; abra o novo Place em outra cópia')
    if root:GetAttribute('Status')=='Complete' and not root:GetAttribute('TerrainPending') then return Scene.validate(c) end
    assert(root:GetAttribute('Status')=='AwaitingTerrain' and root:GetAttribute('ChunksWritten')==0,
        'Cenário incompleto ou Terrain parcial. Reabra a cópia anterior à geração; nada foi apagado.')
    root:SetAttribute('Status','TerrainPreflight')
    local attempted=false
    local function checkpoint()
        assert(root.Parent==workspace and not root:GetAttribute('CancelRequested'),'Geração cancelada; preserve a cópia para diagnóstico')
        task.wait()
    end
    local ok,err=xpcall(function()
        unownedParts(c,root)
        local chunks=TerrainMath.chunks(c)
        Terrain.assertEmpty(workspace.Terrain,c,chunks,function(i,n)
            if i%32==0 or i==n then print('[Preflight mapa] '..i..'/'..n)end
            checkpoint()
        end)
        root:SetAttribute('Status','WritingTerrain')
        for i,chunk in chunks do
            attempted=true;root:SetAttribute('LastAttemptedChunk',i)
            Terrain.writeChunk(workspace.Terrain,c,chunk);root:SetAttribute('ChunksWritten',i)
            if i%16==0 or i==#chunks then print('[Terrain mapa] '..i..'/'..#chunks)end
            checkpoint()
        end
        root:SetAttribute('TerrainPending',false);root:SetAttribute('Status','Complete')
    end,debug.traceback)
    if not ok then
        root:SetAttribute('Status',if attempted then 'FailedPartialTerrain' else 'AwaitingTerrain')
        root:SetAttribute('Error',tostring(err));error(err,0)
    end
    require(script.Parent.MapEnvironment).apply('Day')
    local camera=workspace.CurrentCamera
    if camera then
        local city=c.Cities[1]
        local focus=Vector3.new(city.X,city.Height+24,city.Z)
        camera.CFrame=CFrame.lookAt(focus+Vector3.new(100,100,190),focus)
        camera.Focus=CFrame.new(focus)
    end
    return Scene.validate(c)
end
function Scene.validate(config)
    local c=config or Config;local root=assert(workspace:FindFirstChild('GeneratedWorld'),'Mapa ausente')
    assert(root:GetAttribute('SceneOnly')==true and root:GetAttribute('ProjectId')==c.ProjectId)
    assert(#root.Cities:GetChildren()==5 and #root.Forests:GetChildren()==3,'Regiões incompletas')
    assert(#root.Roads:GetChildren()==#c.Roads and #root.Bridges:GetChildren()&gt;0,'Conexões incompletas')
    assert(root.Spawns:FindFirstChild('ValoriaSpawn'),'Spawn ausente')
    assert(root:FindFirstChild('IntegrationPoints') and #root.IntegrationPoints:GetChildren()&gt;10,'Integrações ausentes')
    local parts=0
    for _,node in root:GetDescendants()do
        assert(not node:IsA('Humanoid') and not node:IsA('ProximityPrompt'),'Gameplay inesperado no cenário')
        assert(not node:GetAttribute('EnemyId') and not node:GetAttribute('NpcId') and not node:GetAttribute('ChestId'),'Marcador de gameplay ativo')
        if node:IsA('BasePart')then assert(node.Anchored,'Peça de cenário solta');parts+=1 end
    end
    return {Parts=parts,SceneOnly=true,TerrainPending=root:GetAttribute('TerrainPending')==true,StudioVisualsValidated=false}
end
return Scene
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_40">
        <Properties>
          <string name="Name">RegenerationService</string>
          <string name="Source">-- Substituições de instâncias próprias, com arquivo recuperável no ServerStorage.
-- Terrain nunca é removido/substituído por este serviço.
local G=require(script.Parent.Geometry)
local Plan=require(script.Parent.WorldPlan)
local Terrain=require(script.Parent.TerrainMath)
local Content=require(script.Parent.ContentGenerator)
local Decor=require(script.Parent.DecorationGenerator)
local Catalog=require(game.ReplicatedStorage.MedievalRPG.Config.ContentConfig)
local Config=require(game.ReplicatedStorage.MedievalRPG.Config.WorldConfig)
local R={Busy=false}
local function root()
    assert(not game:GetService('RunService'):IsRunning(),'Regeneração apenas no editor')
    local w=workspace:FindFirstChild('GeneratedWorld')
    assert(w and w:GetAttribute('ProjectId')==Config.ProjectId and w:GetAttribute('Status')=='Complete','Mundo próprio completo ausente')
    assert(not R.Busy,'Regeneração já em andamento')
    assert(w:GetAttribute('Seed')==Config.Seed,'Mudança de seed exige um Place novo: Terrain atual será preservado')
    assert(w:GetAttribute('ConfigSignature')==Terrain.signature(Config),'Geografia mudou; use um Place novo para preservar o Terrain existente')
    return w
end
local function stage()
    local m=G.model(game.ServerStorage,'MedievalStage_'..game:GetService('HttpService'):GenerateGUID(false))
    for _,name in {'Cities','Forests','NPCs','EnemySpawns','TreasureChests','InteractiveObjects','CinematicMarkers','Decorations'} do local f=Instance.new('Folder');f.Name=name;f.Parent=m end
    return m
end
local function archive()
    local folder=game.ServerStorage:FindFirstChild('MedievalBackups')
    if not folder then folder=Instance.new('Folder');folder.Name='MedievalBackups';folder.Parent=game.ServerStorage end
    local a=G.model(folder,'Backup_'..game:GetService('HttpService'):GenerateGUID(false))
    a:SetAttribute('CreatedAt',os.time());return a
end
local function run(build,commit)
    local w=root();R.Busy=true;local s=stage();local backup
    local ok,result=xpcall(function()
        build(s);backup=archive();commit(w,s,backup)
        s:Destroy();print('Regeneração concluída. Objetos anteriores preservados em '..backup.Name);return backup.Name
    end,debug.traceback)
    R.Busy=false
    if not ok then
        -- O estágio/backup é mantido se o commit falhar; nunca descarta objetos movidos.
        if not backup then s:Destroy() end
        error(result,0)
    end
    return result
end
local function moveChildren(from,to)
    for _,child in from:GetChildren() do child.Parent=to end
end
function R.city(id)
    assert(type(id)=='string' and Catalog.CityBuildings[id],'Cidade inválida')
    local plan=Plan.build(Config,Terrain,Catalog);local subset={Cities={}}
    for _,c in plan.Cities do if c.Id==id then table.insert(subset.Cities,c) end end
    return run(function(s) Content.cities(s,Config,subset,function()end) end,function(w,s,a)
        local old=w.Cities:FindFirstChild(id)
        assert(old and old:GetAttribute('GeneratedBy')==Config.ProjectId,'Cidade não reconhecida')
        old.Parent=a
        for _,npc in w.NPCs:GetChildren() do if npc:GetAttribute('City')==id then npc.Parent=a end end
        for _,name in {'InteractiveObjects','CinematicMarkers','EnemySpawns'} do
            for _,p in w[name]:GetChildren() do if string.sub(p.Name,1,#id+1)==id..'_' then p.Parent=a end end
        end
        for _,name in {'Cities','NPCs','InteractiveObjects','CinematicMarkers','EnemySpawns'} do moveChildren(s[name],w[name]) end
    end)
end
function R.forest(id)
    local valid=false;for _,forest in Config.Forests do if forest.Id==id then valid=true end end
    assert(valid,'Floresta inválida')
    local plan=Plan.build(Config,Terrain,Catalog);local subset={Trees={},Landmarks={},EnemySpawns={},Chests={}}
    for _,t in plan.Trees do if t.Forest==id then table.insert(subset.Trees,t) end end
    for _,key in {'Landmarks','EnemySpawns','Chests'} do
        for _,item in plan[key] do if string.sub(item.Id,1,#id)==id then table.insert(subset[key],item) end end
    end
    local c=table.clone(Config);c.Forests={}
    for _,f in Config.Forests do if f.Id==id then table.insert(c.Forests,f) end end
    return run(function(s) Content.forests(s,c,subset,function()end) end,function(w,s,a)
        local old=w.Forests:FindFirstChild(id);assert(old and old:GetAttribute('GeneratedBy')==Config.ProjectId,'Floresta não reconhecida');old.Parent=a
        for _,npc in w.NPCs:GetChildren() do if npc:GetAttribute('City')==id then npc.Parent=a end end
        for _,name in {'EnemySpawns','TreasureChests','CinematicMarkers'} do
            for _,item in w[name]:GetChildren() do if string.sub(item.Name,1,#id)==id then item.Parent=a end end
        end
        for _,name in {'Forests','NPCs','EnemySpawns','TreasureChests','CinematicMarkers'} do moveChildren(s[name],w[name]) end
    end)
end
function R.decorations()
    return run(function(s) Decor.generate(s.Decorations,Config,Plan.build(Config,Terrain,Catalog),Terrain) end,function(w,s,a)
        w.Decorations.Parent=a;s.Decorations.Parent=w
    end)
end
function R.markers()
    return run(function(s)
        local f=Instance.new('Folder');f.Name='NPCSpawns';f.Parent=s
        for _,npc in workspace.GeneratedWorld.NPCs:GetChildren() do
            if npc.PrimaryPart and npc:GetAttribute('NpcId') then
                G.marker(f,npc:GetAttribute('NpcId'),npc.PrimaryPart.Position,{Role=npc:GetAttribute('Role'),City=npc:GetAttribute('City')})
            end
        end
    end,function(w,s,a) w.NPCSpawns.Parent=a;s.NPCSpawns.Parent=w end)
end
return R
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_41">
        <Properties>
          <string name="Name">ScenicGenerator</string>
          <string name="Source">-- Original environmental kit. Scenery only: no prompts, rewards, actors or combat.
local G=require(script.Parent.Geometry)
local S={}
local moss=Color3.fromRGB(91,116,76)
local function small(parent,name,size,cf,color,material,shape)
    local p=G.detail(parent,name,size,cf,color,material,shape)
    p.CastShadow=false;p:SetAttribute('DetailTier',2);p:SetAttribute('DetailDistance',220)
    return p
end
function S.boulder(parent,cf,scale,tint)
    local m=G.model(parent,'WeatheredBoulder')
    G.part(m,'StoneMass',Vector3.new(9,6,7)*scale,cf*CFrame.Angles(0,0.4,0.17),tint or G.Palette.Stone,Enum.Material.Rock,Enum.PartType.Ball)
    small(m,'Moss',Vector3.new(6,0.45,4)*scale,cf*CFrame.new(0,2.8*scale,0),moss,Enum.Material.Grass,Enum.PartType.Ball)
    return m
end
function S.shrub(parent,cf,scale,dark)
    local tint=if dark then Color3.fromRGB(55,67,73) else Color3.fromRGB(73,123,66)
    for i=1,3 do
        small(parent,'Understory',Vector3.new(4-i*0.4,2+i*0.3,3)*scale,cf*CFrame.new((i-2)*1.8*scale,scale,math.sin(i)*scale),tint,Enum.Material.Grass,Enum.PartType.Ball)
    end
end
function S.ruinedArch(parent,cf,tint)
    local m=G.model(parent,'ForgottenArch')
    for _,side in {-1,1} do
        G.part(m,'PillarFoot',Vector3.new(7,2,7),cf*CFrame.new(side*10,1,0),tint,Enum.Material.Cobblestone)
        G.part(m,'WeatheredColumn',Vector3.new(4,14,4),cf*CFrame.new(side*10,9,0),tint,Enum.Material.Rock)
        G.part(m,'ArchShoulder',Vector3.new(7,3,5),cf*CFrame.new(side*7,17,0)*CFrame.Angles(0,0,side*0.5),tint,Enum.Material.Slate)
    end
    G.part(m,'Keystone',Vector3.new(6,4,5),cf*CFrame.new(0,19,0),tint,Enum.Material.Slate)
    for i=1,4 do S.boulder(m,cf*CFrame.new(15+i*3,1,-i*3),0.4,tint) end
    return m
end
function S.cave(parent,cf,dark)
    local m=G.model(parent,'HiddenCave')
    local stone=if dark then Color3.fromRGB(68,69,84) else Color3.fromRGB(108,117,108)
    G.part(m,'CaveFloor',Vector3.new(30,2,36),cf,stone,Enum.Material.Rock)
    for _,side in {-1,1} do
        G.part(m,'CaveSide',Vector3.new(5,14,32),cf*CFrame.new(side*15,8,3),stone,Enum.Material.Rock)
        for i=1,3 do
            G.detail(m,'EntranceRock',Vector3.new(9-i,9,10),cf*CFrame.new(side*(14-i),4+i*4,-12)*CFrame.Angles(0,i*0.2,side*0.2),stone,Enum.Material.Rock,Enum.PartType.Ball)
        end
    end
    G.part(m,'CaveVault',Vector3.new(34,5,35),cf*CFrame.new(0,17,3),stone,Enum.Material.Rock)
    G.part(m,'CaveBack',Vector3.new(33,15,4),cf*CFrame.new(0,8,20),stone,Enum.Material.Rock)
    for i=1,3 do
        small(m,'Stalactite',Vector3.new(1.5,4+i,1.5),cf*CFrame.new(-10+i*6,12+i*0.5,9),stone,Enum.Material.Rock)
    end
    G.crystal(m,cf*CFrame.new(9,4,9),if dark then Color3.fromRGB(129,101,166) else Color3.fromRGB(104,171,163),0.7)
    for i=1,4 do S.boulder(m,cf*CFrame.new(18+i*2,1,-4+i*4),0.6,stone) end
    m:SetAttribute('IntegrationKind','Cave');m:SetAttribute('WalkableOpeningWidth',20)
    return m
end
function S.forest(parent,land,c,terrain,Content)
    local cf=CFrame.new(land.X,land.H,land.Z)
    local dark=land.Id=='Vespera'
    local tint=if dark then Color3.fromRGB(74,73,91) else Color3.fromRGB(119,130,110)
    local grove=G.model(parent,'HeartGrove')
    grove:SetAttribute('OpenClearingRadius',28)
    -- Deliberately offset the monument; the central clearing remains traversable.
    if land.Id=='Nocthar' then
        Content.tree(grove,{X=land.X-42,H=terrain.height(c,land.X-42,land.Z-25),Z=land.Z-25,Scale=2.25,Variant=4,Forest=land.Id})
        for i=1,5 do
            G.beam(grove,cf:PointToWorldSpace(Vector3.new(-42,1,-25)),cf:PointToWorldSpace(Vector3.new(-42+math.sin(i*1.3)*34,1,-25+math.cos(i*1.3)*34)),3,tint,Enum.Material.Wood)
        end
        S.ruinedArch(grove,cf*CFrame.new(25,0,-36)*CFrame.Angles(0,0.4,0),tint)
    elseif dark then
        for i=1,4 do
            local a=i*1.7
            G.part(grove,'CorruptedMenhir',Vector3.new(3,11+i,4),cf*CFrame.new(math.sin(a)*36,5+i*0.5,math.cos(a)*36)*CFrame.Angles(0,a,0.14),tint,Enum.Material.Slate)
        end
        S.ruinedArch(grove,cf*CFrame.new(-35,0,-32)*CFrame.Angles(0,0.3,0),tint)
    else
        S.ruinedArch(grove,cf*CFrame.new(-36,0,-29)*CFrame.Angles(0,-0.4,0),tint)
        for i=1,5 do S.shrub(grove,cf*CFrame.new(28+i*2,0,-24+i*5),0.75,false) end
    end
    local reservation
    for _,site in c.ScenicReservations or {} do if site.Id==land.Id..'Cave' then reservation=site;break end end
    local caveX,caveZ=if reservation then reservation.X else land.X+8,if reservation then reservation.Z else land.Z+60
    local caveY=terrain.height(c,caveX,caveZ)
    S.cave(parent,CFrame.new(caveX,caveY,caveZ),dark)
    -- Split approach trail skirts scenery and joins the open clearing.
    for _,side in {-1,1} do
        local fromX,fromZ=land.X+side*28,land.Z
        local toX,toZ=caveX+side*4,caveZ-20
        for i=0,7 do
            local aT,bT=i/8,(i+1)/8
            local ax,az=fromX+(toX-fromX)*aT,fromZ+(toZ-fromZ)*aT
            local bx,bz=fromX+(toX-fromX)*bT,fromZ+(toZ-fromZ)*bT
            local a=Vector3.new(ax,terrain.height(c,ax,az)+0.25,az)
            local b=Vector3.new(bx,terrain.height(c,bx,bz)+0.25,bz)
            G.detail(parent,'ForestTrail',Vector3.new(5,0.25,(b-a).Magnitude+0.15),CFrame.lookAt((a+b)/2,b),Color3.fromRGB(119,105,80),Enum.Material.Ground)
        end
    end
    for i=1,9 do
        local a=i*2.399;local r=32+i%3*8
        local x,z=land.X+math.sin(a)*r,land.Z+math.cos(a)*r
        S.boulder(parent,CFrame.new(x,terrain.height(c,x,z)+0.5,z),0.4+i%3*0.1,tint)
    end
    return Vector3.new(caveX,caveY+2,caveZ+10)
end
local function tent(parent,cf,tint)
    local width,depth,height=14,18,8
    for _,side in {-1,1} do
        G.part(parent,'TentCanvas',Vector3.new(11,0.4,depth),cf*CFrame.new(side*3.5,4,0)*CFrame.Angles(0,0,-side*0.8),tint,Enum.Material.Fabric)
        G.beam(parent,cf:PointToWorldSpace(Vector3.new(side*7,0,-9)),cf:PointToWorldSpace(Vector3.new(0,height,-9)),0.4,G.Palette.Wood,Enum.Material.Wood)
    end
    G.beam(parent,cf:PointToWorldSpace(Vector3.new(0,height,-9)),cf:PointToWorldSpace(Vector3.new(0,height,9)),0.4,G.Palette.Wood,Enum.Material.Wood)
end
function S.continent(parent,c,plan,terrain)
    local catalog={
        {Id='MeadowCamp',Kind='Camp',X=440,Z=1250,Name='Acampamento da Estrada Dourada'},
        {Id='MossVillage',Kind='Hamlet',X=1520,Z=-600,Name='Vila do Salgueiro'},
        {Id='BrokenWatch',Kind='Fort',X=-1550,Z=480,Name='Fortaleza do Sino Partido'},
        {Id='RoyalOverlook',Kind='Overlook',X=440,Z=-1450,Name='Mirante das Coroas'},
        {Id='HiddenSanctuary',Kind='Secret',X=-520,Z=-1390,Name='Jardim do Juramento'},
    }
    local folder=G.model(parent,'ScenicRegions')
    for _,site in catalog do
        for _,reservation in c.ScenicReservations or {} do
            if reservation.Id==site.Id then site.X,site.Z=reservation.X,reservation.Z;break end
        end
        local h=terrain.height(c,site.X,site.Z)
        local cf=CFrame.new(site.X,h,site.Z)
        local model=G.model(folder,site.Id)
        model:SetAttribute('RegionId',site.Id);model:SetAttribute('IntegrationKind',site.Kind)
        model:SetAttribute('DisplayName',site.Name)
        if site.Kind=='Camp' then
            for i=1,3 do tent(model,cf*CFrame.new((i-2)*24,0,12+(i%2)*8),Color3.fromRGB(135+i*8,121,86)) end
            for i=1,7 do S.boulder(model,cf*CFrame.new(math.sin(i)*5,0.5,-10+math.cos(i)*5),0.25) end
            G.detail(model,'Ashes',Vector3.new(6,0.2,6),cf*CFrame.new(0,0.2,-10),Color3.fromRGB(55,51,46),Enum.Material.Ground,Enum.PartType.Ball)
            for _,side in {-1,1} do G.part(model,'CampBench',Vector3.new(10,1.2,3),cf*CFrame.new(side*12,1.5,-10),G.Palette.Wood,Enum.Material.Wood) end
        elseif site.Kind=='Hamlet' then
            -- Original small wayside cottages, open fronts and pitched roofs.
            for i=1,3 do
                local x,z=site.X+(i-2)*31,site.Z+(i%2)*28
                local hc=terrain.height(c,x,z);local house=G.model(model,'WaysideCottage'..i);local f=CFrame.new(x,hc,z)
                G.part(house,'Foundation',Vector3.new(22,2,24),f,G.Palette.Stone,Enum.Material.Cobblestone)
                for _,side in {-1,1} do
                    G.part(house,'Side',Vector3.new(1,13,22),f*CFrame.new(side*10,7,0),Color3.fromRGB(183,171,138),Enum.Material.WoodPlanks)
                    G.part(house,'Roof',Vector3.new(13,1,26),f*CFrame.new(side*5.5,16,0)*CFrame.Angles(0,0,-side*0.48),Color3.fromRGB(95,112,89),Enum.Material.Slate)
                    G.part(house,'DoorJamb',Vector3.new(6,13,1),f*CFrame.new(side*7,7,-11),G.Palette.Wood,Enum.Material.Wood)
                end
                G.part(house,'Back',Vector3.new(22,13,1),f*CFrame.new(0,7,11),Color3.fromRGB(183,171,138),Enum.Material.WoodPlanks)
                G.part(house,'Lintel',Vector3.new(8,4,1),f*CFrame.new(0,12,-11),G.Palette.Wood,Enum.Material.Wood)
                G.part(house,'Chimney',Vector3.new(3,9,3),f*CFrame.new(6,17,5),G.Palette.Stone,Enum.Material.Brick)
            end
        elseif site.Kind=='Fort' then
            for _,side in {-1,1} do
                G.part(model,'RuinedTower',Vector3.new(13,24+side*4,13),cf*CFrame.new(side*25,12+side*2,0),Color3.fromRGB(91,99,100),Enum.Material.Cobblestone)
                for i=1,3 do G.part(model,'Merlon',Vector3.new(3,3,3),cf*CFrame.new(side*25+i*4-8,26+side*4,-6),G.Palette.Stone,Enum.Material.Cobblestone) end
                G.part(model,'BrokenWall',Vector3.new(25,11,4),cf*CFrame.new(side*28,5.5,28),G.Palette.Stone,Enum.Material.Cobblestone)
            end
            S.ruinedArch(model,cf,Color3.fromRGB(91,99,100))
        elseif site.Kind=='Overlook' then
            G.part(model,'ViewingTerrace',Vector3.new(42,3,24),cf,G.Palette.Stone,Enum.Material.Cobblestone)
            for _,side in {-1,1} do G.part(model,'Parapet',Vector3.new(2,3,24),cf*CFrame.new(side*20,3,0),G.Palette.Stone,Enum.Material.Cobblestone) end
            G.part(model,'BackParapet',Vector3.new(42,3,2),cf*CFrame.new(0,3,12),G.Palette.Stone,Enum.Material.Cobblestone)
            G.sign(model,site.Name,cf*CFrame.new(0,5,11),24)
        else
            S.ruinedArch(model,cf,Color3.fromRGB(137,145,125))
            for _,side in {-1,1} do S.shrub(model,cf*CFrame.new(side*18,0,8),1.7,false) end
        end
        local marker=G.marker(model,site.Id..'_Integration',Vector3.new(site.X,h+3,site.Z),{IntegrationId=site.Id,IntegrationKind=site.Kind})
        marker:SetAttribute('Radius',50)
    end
    return catalog
end
return S
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_42">
        <Properties>
          <string name="Name">TerrainGenerator</string>
          <string name="Source">local TerrainMath = require(script.Parent.TerrainMath)
local TerrainGenerator = {}

function TerrainGenerator.region(c, chunk)
    return Region3.new(Vector3.new(chunk.X, c.MinY, chunk.Z),
        Vector3.new(chunk.X + chunk.Width, c.MaxY, chunk.Z + chunk.Depth))
end

-- ReadVoxels returns TWO 3D arrays, each with a non-array Size: Vector3 field.
-- Iterate numeric coordinates only; generalized iteration also visits Size.
-- Shared by continent, legacy dungeon and expedition preflights.
function TerrainGenerator.assertRegionEmpty(terrain, region, message)
    local _, occupancy = terrain:ReadVoxels(region, 4)
    local size = occupancy.Size
    assert(typeof(size) == "Vector3"
        and size.X &gt;= 1 and size.Y &gt;= 1 and size.Z &gt;= 1
        and size.X % 1 == 0 and size.Y % 1 == 0 and size.Z % 1 == 0,
        "ReadVoxels retornou dimensões inválidas; geração bloqueada para preservar o Terrain.")
    for x = 1, size.X do
        local plane = occupancy[x]
        for y = 1, size.Y do
            local row = plane[y]
            for z = 1, size.Z do
                -- Any nonzero occupancy (including partial water) is occupied.
                -- Missing/unexpected cells also fail closed, never release writes.
                assert(row[z] == 0, message or "Terrain existente na área reservada. Use um Place novo ou altere o projeto; nada foi sobrescrito.")
            end
        end
    end
end

-- Executado em todos os chunks ANTES da primeira escrita. Não confunde
-- voxels de água com espaço livre e nunca limpa o Terrain global.
function TerrainGenerator.assertEmpty(terrain, c, chunks, checkpoint)
    for index, chunk in chunks do
        TerrainGenerator.assertRegionEmpty(terrain, TerrainGenerator.region(c, chunk))
        checkpoint(index, #chunks)
    end
end

function TerrainGenerator.writeChunk(terrain, c, chunk)
    local nx, ny, nz = chunk.Width/4, (c.MaxY-c.MinY)/4, chunk.Depth/4
    local materials, occupancy = table.create(nx), table.create(nx)
    for ix = 1, nx do
        materials[ix], occupancy[ix] = table.create(ny), table.create(ny)
        for iy = 1, ny do
            materials[ix][iy], occupancy[ix][iy] = table.create(nz), table.create(nz)
        end
        for iz = 1, nz do
            local h, water, surface = TerrainMath.column(c, chunk.X+(ix-0.5)*4, chunk.Z+(iz-0.5)*4)
            for iy = 1, ny do
                local y = c.MinY+(iy-0.5)*4
                local fill = math.clamp((h-y)/4 + 0.5, 0, 1)
                local material = Enum.Material.Rock
                if y &gt;= h-8 and h &lt;= c.BaseHeight+c.MountainHeight*0.65 then
                    material = Enum.Material[surface]
                elseif y &lt; h-8 and y &gt; h-20 then
                    material = Enum.Material.Ground
                end
                if fill == 0 and water and y &lt; water then
                    fill = math.clamp((water-y)/4+0.5,0,1)
                    material = Enum.Material.Water
                elseif water and y &gt;= h-8 then
                    material = Enum.Material.Mud
                end
                materials[ix][iy][iz] = if fill == 0 then Enum.Material.Air else material
                occupancy[ix][iy][iz] = fill
            end
        end
    end
    terrain:WriteVoxels(TerrainGenerator.region(c, chunk), 4, materials, occupancy)
end
return TerrainGenerator
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_43">
        <Properties>
          <string name="Name">TerrainMath</string>
          <string name="Source">-- Núcleo puro. math.noise está disponível tanto em Luau CLI quanto no Studio.
local TerrainMath = {}
-- Control data are immutable during one editor generation. Cache by Roads table,
-- shared by height queries and the visible road planner; no curve is rebuilt per voxel.
local pathCache, gridCache = setmetatable({}, {__mode="k"}), setmetatable({}, {__mode="k"})
local function catmull(a,b,c,d,t)
    if b==c then return b end -- Cardinal city avenues must not bow into building blocks.
    return 0.5*((2*b)+(-a+c)*t+(2*a-5*b+4*c-d)*t*t+(-a+3*b-3*c+d)*t*t*t)
end
function TerrainMath.roadPaths(c)
    if pathCache[c.Roads] then return pathCache[c.Roads] end
    local paths={}
    for index,road in c.Roads do
        local controls=road.Points or {road.A,road.B}
        local points={}
        for i=1,#controls-1 do
            local a,b,p,q=controls[math.max(1,i-1)],controls[i],controls[i+1],controls[math.min(#controls,i+2)]
            local distance=math.sqrt((p.X-b.X)^2+(p.Z-b.Z)^2)
            local steps=math.max(1,math.ceil(distance/12))
            for step=0,steps-1 do
                local t=step/steps
                table.insert(points,{X=catmull(a.X,b.X,p.X,q.X,t),Z=catmull(a.Z,b.Z,p.Z,q.Z,t),H=catmull(a.H,b.H,p.H,q.H,t)})
            end
        end
        table.insert(points,table.clone(controls[#controls]))
        -- A short control leg can inherit a long neighbour's tangent. Bound all
        -- visible/collision spans after sampling, independent of spline speed.
        local sampled={points[1]}
        for i=2,#points do
            local a,b=points[i-1],points[i]
            local length=math.sqrt((b.X-a.X)^2+(b.Z-a.Z)^2)
            local steps=math.max(1,math.ceil(length/14))
            for step=1,steps do
                local t=step/steps
                table.insert(sampled,if step==steps then b else {X=a.X+(b.X-a.X)*t,Z=a.Z+(b.Z-a.Z)*t,H=a.H+(b.H-a.H)*t})
            end
        end
        points=sampled
        table.insert(paths,{Id=road.Id,Points=points,A=road.A,B=road.B,Width=road.Width or 20,Index=index})
    end
    pathCache[c.Roads]=paths
    return paths
end
local function roadGrid(c)
    if gridCache[c.Roads] then return gridCache[c.Roads] end
    local grid={}
    for _,path in TerrainMath.roadPaths(c) do
        for i=1,#path.Points-1 do
            local a,b=path.Points[i],path.Points[i+1]
            local segment={A=a,B=b,Width=path.Width,Index=path.Index}
            -- Include planner clearance as well as terrain blend width.
            for gx=math.floor((math.min(a.X,b.X)-96)/128),math.floor((math.max(a.X,b.X)+96)/128) do
                for gz=math.floor((math.min(a.Z,b.Z)-96)/128),math.floor((math.max(a.Z,b.Z)+96)/128) do
                    local key=gx..":"..gz;grid[key]=grid[key] or {};table.insert(grid[key],segment)
                end
            end
        end
    end
    gridCache[c.Roads]=grid
    return grid
end
local function nearbyRoads(c,x,z)
    return roadGrid(c)[math.floor(x/128)..":"..math.floor(z/128)] or {}
end
function TerrainMath.roadDistance(c,x,z)
    local best=math.huge
    for _,segment in nearbyRoads(c,x,z) do
        local distance=TerrainMath.segment(x,z,segment.A,segment.B)
        best=math.min(best,distance)
    end
    return best
end
local function finite(n)
    return type(n) == "number" and n == n and math.abs(n) &lt; math.huge
end
local function smooth(t)
    t = math.clamp(t, 0, 1)
    return t * t * (3 - 2 * t)
end

function TerrainMath.validate(c)
    assert(c.ProjectId == "ProjectMedievalRPG", "Identidade de projeto inválida")
    for _, key in { "WorldSize", "Seed", "ChunkSize", "MinY", "MaxY", "BaseHeight",
        "Amplitude", "Frequency", "MountainHeight", "CityBlend", "MaxChunks" } do
        assert(finite(c[key]), "Configuração numérica inválida: " .. key)
    end
    assert(c.Resolution == 4, "Resolution deve ser 4")
    assert(c.WorldSize &gt; 0 and c.WorldSize &lt;= 8000 and c.WorldSize % 8 == 0, "WorldSize inválido")
    assert(c.Seed % 1 == 0 and math.abs(c.Seed) &lt;= 1000000, "Seed deve ser inteiro entre -1000000 e 1000000")
    assert(c.ChunkSize &gt;= 32 and c.ChunkSize &lt;= 256 and c.ChunkSize % 4 == 0, "ChunkSize inválido")
    assert(c.MinY % 4 == 0 and c.MaxY % 4 == 0 and c.MinY &lt; c.MaxY, "Limites verticais inválidos")
    assert(c.MaxY - c.MinY &lt;= 512, "Volume vertical excessivo")
    assert(c.Amplitude &gt;= 0 and c.Frequency &gt; 0 and c.MountainHeight &gt;= 0 and c.CityBlend &gt; 0, "Relevo inválido")
    assert(c.BaseHeight - c.Amplitude &gt; c.MinY + 4, "Solo pode ficar abaixo do volume")
    assert(c.BaseHeight + c.Amplitude + c.MountainHeight &lt; c.MaxY - 4, "Relevo pode ultrapassar MaxY")
    assert(c.QualityProfiles[c.Quality], "Qualidade inválida")
    assert(#c.Cities &gt;= 4 and #c.Forests &gt;= 2, "Conteúdo legado deve ser preservado")
    local ids = {}
    for _, regions in { c.Cities, c.Forests } do
        for _, region in regions do
            assert(type(region.Id) == "string" and not ids[region.Id], "ID ausente ou duplicado")
            ids[region.Id] = true
            for _, key in { "X", "Z", "Radius" } do
                assert(finite(region[key]), "Região inválida: " .. key)
            end
            assert(region.Radius &gt; 0, "Raio deve ser positivo")
            assert(math.abs(region.X) + region.Radius + c.CityBlend &lt; c.WorldSize / 2
                and math.abs(region.Z) + region.Radius + c.CityBlend &lt; c.WorldSize / 2, "Região fora do continente")
        end
    end
    for i, city in c.Cities do
        assert(finite(city.Height) and city.Height &gt; c.MinY + 4 and city.Height &lt; c.MaxY - 4, "Altura da cidade inválida")
        for j = i + 1, #c.Cities do
            local other = c.Cities[j]
            local distance = math.sqrt((city.X - other.X)^2 + (city.Z - other.Z)^2)
            assert(distance &gt; city.Radius + other.Radius + 2 * c.CityBlend, "Reservas de cidades se sobrepõem")
        end
    end
    assert(finite(c.DungeonEntrance.X) and finite(c.DungeonEntrance.Z), "Entrada inválida")
    assert(math.abs(c.DungeonEntrance.X) &lt; c.WorldSize/2 and math.abs(c.DungeonEntrance.Z) &lt; c.WorldSize/2, "Entrada fora do mapa")
    assert(math.ceil(c.WorldSize / c.ChunkSize)^2 &lt;= c.MaxChunks, "Orçamento de chunks excedido")
    local profile=c.QualityProfiles[c.Quality]
    for key,limit in {TreesPerForest=1000,DecorationBudget=2000,ActiveEnemies=64} do
        assert(finite(profile[key]) and profile[key]%1==0 and profile[key]&gt;0 and profile[key]&lt;=limit,"Orçamento inválido: "..key)
    end
    assert(type(c.River)=="table" and type(c.Roads)=="table" and #c.Roads&gt;=3,"Rio e rotas são obrigatórios")
    for _,key in {"Z","Meander","Frequency","HalfWidth","BankWidth","WaterY","BedY"} do assert(finite(c.River[key]),"Rio inválido: "..key) end
    local river=c.River
    assert(river.HalfWidth&gt;=8 and river.BankWidth&gt;=24 and river.Meander&gt;=0 and river.Frequency&gt;0,"Margens do rio inválidas")
    assert(river.BedY&gt;c.MinY+4 and river.BedY&lt;river.WaterY and river.WaterY&lt;c.MaxY-4,"Alturas do rio inválidas")
    assert(math.abs(river.Z)+river.Meander+river.HalfWidth+river.BankWidth&lt;c.WorldSize/2,"Rio fora do continente")
    local roadIds={}
    for _,road in c.Roads do
        assert(type(road.Id)=="string" and not roadIds[road.Id],"ID de estrada inválido/duplicado");roadIds[road.Id]=true
        for _,point in {road.A,road.B} do
            assert(type(point)=="table" and finite(point.X) and finite(point.Z) and finite(point.H),"Extremo de estrada inválido")
            assert(math.abs(point.X)&lt;c.WorldSize/2 and math.abs(point.Z)&lt;c.WorldSize/2 and point.H&gt;river.WaterY+8 and point.H&lt;c.MaxY-4,"Estrada fora do volume transitável")
        end
        local points=road.Points or {road.A,road.B}
        assert(#points&gt;=2,"Estrada sem controles")
        assert(points[1].X==road.A.X and points[1].Z==road.A.Z and points[#points].X==road.B.X and points[#points].Z==road.B.Z,"Controles devem preservar os extremos conectados")
        for i,p in points do
            assert(finite(p.X) and finite(p.Z) and finite(p.H) and math.abs(p.X)&lt;c.WorldSize/2 and math.abs(p.Z)&lt;c.WorldSize/2,"Controle fora do mapa")
            if i&gt;1 then
                local q=points[i-1];local length=math.sqrt((p.X-q.X)^2+(p.Z-q.Z)^2)
                assert(length&gt;=32 and math.abs(p.H-q.H)/length&lt;0.15,"Estrada curta/demasiado íngreme")
            end
        end
        assert(road.Width==nil or finite(road.Width) and road.Width&gt;=10 and road.Width&lt;=28,"Largura de estrada inválida")
    end
    for _,range in c.MountainRanges or {} do
        assert(finite(range.Width) and range.Width&gt;=64 and finite(range.Height) and range.Height&gt;0 and range.Height&lt;=c.MountainHeight,"Cadeia de montanhas inválida")
        for _,point in {range.A,range.B} do assert(finite(point.X) and finite(point.Z),"Eixo de montanhas inválido") end
    end
    for _,valley in c.Valleys or {} do assert(finite(valley.Width) and valley.Width&gt;=64 and finite(valley.Depth) and valley.Depth&gt;=0 and valley.Depth&lt;=c.Amplitude,"Vale inválido") end
    for _,site in c.ScenicReservations or {} do
        assert(finite(site.X) and finite(site.Z) and finite(site.Height) and finite(site.Radius) and site.Radius&gt;=24 and site.Height&gt;c.MinY+4 and site.Height&lt;c.MaxY-4,"Reserva cênica inválida")
        assert(site.Blend==nil or finite(site.Blend) and site.Blend&gt;=24,"Transição cênica inválida")
    end
    for _,lake in c.AdditionalLakes or {} do
        assert(finite(lake.Radius) and lake.Radius&gt;=24 and finite(lake.Bank) and lake.Bank&gt;=32 and finite(lake.WaterY) and finite(lake.BedY) and lake.BedY&gt;c.MinY+4 and lake.BedY&lt;lake.WaterY and lake.WaterY&lt;c.MaxY-4,"Lago adicional inválido")
    end
    return true
end

function TerrainMath.baseHeight(c, x, z)
    local seed = c.Seed * 0.0137
    local f = c.Frequency
    local hills = math.noise(x*f, z*f, seed) * 0.72
        + math.noise(x*f*2, z*f*2, seed + 19) * 0.28
    local ridge=0
    for _,range in c.MountainRanges or {} do
        local d=TerrainMath.segment(x,z,range.A,range.B)
        local profile=math.exp(-(d/range.Width)^2)
        local teeth=0.72+0.28*(1-math.abs(math.noise(x*0.004,z*0.004,seed+41)))
        ridge=math.max(ridge,profile*range.Height*teeth)
    end
    if not c.MountainRanges then
        ridge=math.exp(-((x+c.WorldSize*0.39)/(c.WorldSize*0.13))^2)*c.MountainHeight
    end
    local h=c.BaseHeight+hills*c.Amplitude+ridge
    for _,valley in c.Valleys or {} do
        local d=TerrainMath.segment(x,z,valley.A,valley.B)
        h-=valley.Depth*math.exp(-(d/valley.Width)^2)
    end
    for _, city in c.Cities do
        local distance = math.sqrt((x-city.X)^2 + (z-city.Z)^2)
        local blend = smooth((distance-city.Radius)/c.CityBlend)
        h = city.Height + (h-city.Height)*blend
    end
    return h
end

function TerrainMath.signature(c)
    local tokens={tostring(c.SchemaVersion),tostring(c.LayoutRevision)}
    for _,key in {"WorldSize","Seed","MinY","MaxY","BaseHeight","Amplitude","Frequency","MountainHeight","CityBlend"} do table.insert(tokens,tostring(c[key])) end
    if c.River then for _,key in {"Z","Meander","Frequency","HalfWidth","BankWidth","WaterY","BedY"} do table.insert(tokens,tostring(c.River[key])) end end
    if c.Lake then for _,key in {'X','Z','Radius','Bank','WaterY','BedY'} do table.insert(tokens,tostring(c.Lake[key])) end end
    if c.Guild then for _,key in {'X','Z','Height'} do table.insert(tokens,tostring(c.Guild[key])) end end
    for _,city in c.Cities do for _,key in {"Id","X","Z","Radius","Height","Theme"} do table.insert(tokens,tostring(city[key])) end end
    for _,forest in c.Forests do for _,key in {"Id","X","Z","Radius","Theme"} do table.insert(tokens,tostring(forest[key])) end end
    for _,road in c.Roads or {} do
        table.insert(tokens,road.Id)
        table.insert(tokens,tostring(road.Width))
        for _,p in road.Points or {road.A,road.B} do for _,key in {"X","Z","H"} do table.insert(tokens,tostring(p[key])) end end
    end
    for _,group in {c.MountainRanges or {},c.Valleys or {},c.ScenicReservations or {},c.AdditionalLakes or {}} do
        for _,region in group do
            for _,key in {"Id","X","Z","Radius","Height","Width","Depth","Bank","WaterY","BedY","Blend"} do table.insert(tokens,tostring(region[key])) end
            for _,point in {region.A or {},region.B or {}} do table.insert(tokens,tostring(point.X));table.insert(tokens,tostring(point.Z)) end
        end
    end
    return table.concat(tokens,"|")
end

function TerrainMath.segment(x,z,a,b)
    local dx,dz=b.X-a.X,b.Z-a.Z
    local t=math.clamp(((x-a.X)*dx+(z-a.Z)*dz)/(dx*dx+dz*dz),0,1)
    return math.sqrt((x-a.X-t*dx)^2+(z-a.Z-t*dz)^2),t
end
function TerrainMath.riverDistance(c,x,z)
    if not c.River then return math.huge end
    return math.abs(z-(c.River.Z+c.River.Meander*math.sin(x*c.River.Frequency)))
end
function TerrainMath.height(c,x,z)
    local h=TerrainMath.baseHeight(c,x,z)
    local river=TerrainMath.riverDistance(c,x,z)
    local nearest={}
    for _,road in nearbyRoads(c,x,z) do
        local distance,t=TerrainMath.segment(x,z,road.A,road.B)
        local previous=nearest[road.Index]
        if not previous or distance&lt;previous.Distance then nearest[road.Index]={Distance=distance,H=road.A.H+(road.B.H-road.A.H)*t,Width=road.Width} end
    end
    for i=1,#c.Roads do
        local road=nearest[i]
        if road then
            local weight=1-smooth((road.Distance-(road.Width/2+4))/64)
            h=h+(road.H-h)*weight
        end
    end
    -- Cidades permanecem planas; leito só corta fora de suas reservas.
    if c.River then
        local r=c.River
        local blend=smooth((river-r.HalfWidth)/r.BankWidth)
        h=r.BedY+(h-r.BedY)*blend
    end
    for _,city in c.Cities do
        local d=math.sqrt((x-city.X)^2+(z-city.Z)^2)
        local blend=smooth((d-city.Radius)/c.CityBlend)
        h=city.Height+(h-city.Height)*blend
    end
    if c.Guild then
        local g=c.Guild;local d=math.sqrt((x-g.X)^2+(z-g.Z)^2)
        h=g.Height+(h-g.Height)*smooth((d-100)/48)
    end
    for _,site in c.ScenicReservations or {} do
        local d=math.sqrt((x-site.X)^2+(z-site.Z)^2)
        h=site.Height+(h-site.Height)*smooth((d-site.Radius)/(site.Blend or 64))
    end
    for _,l in c.AdditionalLakes or {} do
        local d=math.sqrt((x-l.X)^2+(z-l.Z)^2)
        h=l.BedY+(h-l.BedY)*smooth((d-l.Radius)/l.Bank)
    end
    if c.Lake then
        local l=c.Lake;local d=math.sqrt((x-l.X)^2+(z-l.Z)^2)
        h=l.BedY+(h-l.BedY)*smooth((d-l.Radius)/l.Bank)
    end
    return h
end
function TerrainMath.column(c,x,z)
    local h=TerrainMath.height(c,x,z)
    local water=if c.River and TerrainMath.riverDistance(c,x,z)&lt;c.River.HalfWidth+c.River.BankWidth and h&lt;c.River.WaterY then c.River.WaterY else nil
    if c.Lake then local l=c.Lake;if (x-l.X)^2+(z-l.Z)^2&lt;(l.Radius+l.Bank)^2 and h&lt;l.WaterY then water=l.WaterY end end
    for _,l in c.AdditionalLakes or {} do if (x-l.X)^2+(z-l.Z)^2&lt;(l.Radius+l.Bank)^2 and h&lt;l.WaterY then water=l.WaterY end end
    local bank=c.River and TerrainMath.riverDistance(c,x,z)&lt;c.River.HalfWidth+c.River.BankWidth and h&lt;c.River.WaterY+7
    return h,water,if bank then (if water then 'Mud' else 'Sand')else 'Grass'
end

function TerrainMath.chunks(c)
    local result = {}
    local half = c.WorldSize/2
    for x = -half, half-1, c.ChunkSize do
        for z = -half, half-1, c.ChunkSize do
            table.insert(result, { X=x, Z=z, Width=math.min(c.ChunkSize, half-x), Depth=math.min(c.ChunkSize, half-z) })
        end
    end
    return result
end

function TerrainMath.voxel(c, x, y, z)
    local h,water,surface = TerrainMath.column(c, x, z)
    local occupancy = math.clamp((h-y)/c.Resolution + 0.5, 0, 1)
    local material = "Rock"
    if y &gt;= h-8 then
        material = if h &gt; c.BaseHeight + c.MountainHeight*0.65 then "Rock" else surface
    elseif y &gt; h-20 then
        material = "Ground"
    end
    if occupancy==0 and water and y&lt;water then occupancy=math.clamp((water-y)/4+0.5,0,1);material='Water'
    elseif water and y&gt;=h-8 then material='Mud' end
    if occupancy==0 then material='Air' end
    return material, occupancy
end
return TerrainMath
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="base_44">
        <Properties>
          <string name="Name">ValidationGenerator</string>
          <string name="Source">local Validation={}
function Validation.validate(ws,c)
    local checks={}
    local function check(name,passed)
        local status=if passed then 'PASSOU' else 'FALHOU'
        table.insert(checks,{Name=name,Status=status});print('['..status..'] '..name)
    end
    local root=ws:FindFirstChild('GeneratedWorld')
    check('Pasta e identidade',root~=nil and root:GetAttribute('ProjectId')==c.ProjectId)
    if not root then return checks end
    local marker=root:FindFirstChild('TerrainMarkers');check('Reservas de regiões',marker~=nil and #marker:GetChildren()==#c.Cities+#c.Forests+1)
    local spawns=root:FindFirstChild('Spawns');local spawn=spawns and spawns:FindFirstChild('ValoriaSpawn')
    check('Spawn inicial',spawn~=nil and spawn:IsA('SpawnLocation') and spawn.Anchored and spawn.Enabled)
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={ws.Terrain}
    for _,city in c.Cities do
        local hit=ws:Raycast(Vector3.new(city.X,c.MaxY,city.Z),Vector3.new(0,c.MinY-c.MaxY,0),params)
        check('Solo em '..city.Id,hit~=nil and math.abs(hit.Position.Y-city.Height)&lt;=4)
        local model=root.Cities:FindFirstChild(city.Id)
        local buildings=0
        if model then
            for _,m in model:GetChildren() do if m:GetAttribute('Template') then buildings+=1 end end
        end
        check('Edifícios em '..city.Id,buildings&gt;=13)
    end
    check('Cidades configuradas',#root.Cities:GetChildren()==#c.Cities)
    check('Florestas configuradas',#root.Forests:GetChildren()==#c.Forests)
    check('Estradas',#root.Roads:GetChildren()==#c.Roads)
    check('Pontes sobre o rio',#root.Bridges:GetChildren()&gt;0)
    local interactive=0
    for _,m in root.NPCs:GetChildren() do
        if m:FindFirstChildOfClass('Humanoid') and m:FindFirstChild('HumanoidRootPart') and m.HumanoidRootPart:FindFirstChildOfClass('ProximityPrompt') then interactive+=1 end
    end
    check('NPCs com rig e interação',interactive&gt;=40)
    check('Spawns de inimigos',#root.EnemySpawns:GetChildren()&gt;=12)
    check('Baús configurados',#root.TreasureChests:GetChildren()==#c.Forests*5)
    check('Guardião da dungeon',root.NPCs:FindFirstChild('DungeonGuardian')~=nil)
    check('Marcadores cinematográficos',#root.CinematicMarkers:GetChildren()&gt;=7)
    table.insert(checks,{Name='Gameplay real, DataStore e teleporte',Status='NÃO TESTADO',Reason='Execute matriz de testes no Studio e cliente Roblox.'})
    return checks
end
return Validation
</string>
        </Properties>
