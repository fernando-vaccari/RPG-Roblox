      <Item class="Folder" referent="9">
        <Properties>
          <string name="Name">Core</string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">ActionMath</string>
            <string name="Source"><![CDATA[-- Pure budgets used by the runtime, including large-frame protection.
local M={}
function M.travel(speed,remaining,dt)
 assert(type(speed)=='number' and speed>0 and speed<1000)
 assert(type(dt)=='number' and dt==dt)
 return math.min(math.max(0,remaining),speed*math.clamp(dt,0,0.1))
end
function M.boss(kind,phase,index)
 local names=if kind=='Malgorth' then {'Ruptura do Trono','Círculo da Condenação'} elseif kind=='SylvarinBoss' then {'Raízes do Juramento','Vigília do Bosque'} else {'Pulso Sombrio','Eco das Ruínas'}
 return {Name=names[index%2+1],Radius=if phase==2 then 24 else 14,Windup=if phase==2 then 1.4 else 1.2,InnerRadius=if index%2==0 then (if phase==2 then 9.6 else 5.6)else 0,Height=if index%2==0 then 4 else 10,Multiplier=if index%2==0 then 1.2 else 1.4,Cooldown=if phase==2 then 6 else 9}
end
function M.inArea(horizontal,vertical,pattern)
 return horizontal<=pattern.Radius and horizontal>=(pattern.InnerRadius or 0) and math.abs(vertical)<=(pattern.Height or 10)
end
return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">AdventureRules</string>
            <string name="Source"><![CDATA[local A={}
function A.restore(profile,raw,config)
 raw=if type(raw)=='table' then raw else {}
 profile.Adventure={Version=config.Version,Tutorial={},DefenseClaims={}}
 for _,city in {'Valoria','Arkheim'} do
  local stamp=type(raw.DefenseClaims)=='table' and raw.DefenseClaims[city]
  if type(stamp)=='number' and stamp==stamp and stamp%1==0 and stamp>=0 and stamp<=1e12 then profile.Adventure.DefenseClaims[city]=stamp end
 end
 for _,step in config.Tutorial do
  if type(raw.Tutorial)=='table' and raw.Tutorial[step.Id]==true then profile.Adventure.Tutorial[step.Id]=true end
 end
 -- Existing characters retain their accomplishments; practice objectives remain available.
 if profile.StarterChosen then profile.Adventure.Tutorial.Weapon=true end
 if profile.Rank~='' then profile.Adventure.Tutorial.Guild=true end
 if profile.Quests.FirstSteps and profile.Quests.FirstSteps.Claimed then profile.Adventure.Tutorial.Quest=true end
end
function A.event(profile,config,event)
 if not profile.Adventure then A.restore(profile,nil,config) end
 for _,step in config.Tutorial do
  if step.Id==event and not profile.Adventure.Tutorial[event] then profile.Adventure.Tutorial[event]=true;return true end
 end
 return false
end
function A.current(profile,config)
 for i,step in config.Tutorial do if not profile.Adventure or not profile.Adventure.Tutorial[step.Id] then return step,i end end
 return nil,#config.Tutorial+1
end
return A
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">BenefitPreview</string>
            <string name="Source"><![CDATA[-- Approved grants only. Preview is a report and never mutates any wallet/receipt/race.
local Preview={}
function Preview.report(profile,config,key)
 local product=config.Products[key]
 if not product then return nil,'Benefícios deste produto ainda não definidos.' end
 local id=profile.Identity
 if not id then return nil,'Perfil indisponível.' end
 local before=if product.Grant=='Retry' then id.RetryCredits else id.Fusion[product.Grant]
 if type(before)~='number' then return nil,'Tipo de benefício desconhecido.' end
 return {Product=key,PlannedPrice=product.Robux,Grant=product.Grant,Before=before,After=math.min(1000000,before+product.Amount),Preview=true}
end
return Preview
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">CombatRules</string>
            <string name="Source"><![CDATA[local R={}
function R.level(xp,c)
 local level=1
 while level<c.MaxLevel and xp>=c.XPBase+(level-1)*c.XPGrowth do xp-=c.XPBase+(level-1)*c.XPGrowth;level+=1 end
 return level,xp,c.XPBase+(level-1)*c.XPGrowth
end
function R.canUse(class,skillClass,c)
 return class==skillClass or c.Classes[class]~=nil and c.Classes[class].Base==skillClass
end
function R.stats(profile,c)
 local level=R.level(profile.XP,c);local base=c.Classes[profile.Class] or {Health=100,Mana=80,Stamina=100,Damage=1,Defense=0,Speed=16}
 local race=c.RaceModifiers and profile.Identity and c.RaceModifiers[profile.Identity.Race] or {Health=0,Mana=0,Stamina=0}
 return {Level=level,Health=base.Health+race.Health+(level-1)*5+(if profile.Armor=='Armor' and (profile.Inventory.Armor or 0)>0 then 40 else 0),Mana=base.Mana+race.Mana+(level-1)*3,Stamina=base.Stamina+race.Stamina+(level-1),Damage=base.Damage*(1+(level-1)*0.025),Defense=base.Defense+math.floor((level-1)/4),Speed=base.Speed}
end
function R.new(stats)
 return {Mana=stats.Mana,Stamina=stats.Stamina,Posture=0,BrokenUntil=0,Cooldowns={},Combo=0,LastPrimary=-100,RecoverUntil=0,DodgeUntil=0,GuardUntil=0,Blocking=false,Sprinting=false}
end
function R.step(s,stats,dt)
 dt=math.clamp(dt,0,0.5)
 s.Mana=math.min(stats.Mana,s.Mana+dt*6)
 s.Stamina=math.clamp(s.Stamina+dt*(if s.Sprinting or s.Blocking then -8 else 16),0,stats.Stamina)
 if s.Stamina==0 then s.Sprinting=false;s.Blocking=false end
end
function R.reserve(s,id,now,mana,stamina,cooldown,recovery)
 if now<s.RecoverUntil or now<(s.Cooldowns[id] or 0) or s.Blocking or s.Mana<mana or s.Stamina<stamina then return false end
 s.Mana-=mana;s.Stamina-=stamina;s.Cooldowns[id]=now+cooldown;s.RecoverUntil=now+(recovery or 0.25);return true
end
function R.primary(s,now,delay)
 if not R.reserve(s,'Primary',now,0,6,delay,delay*0.8) then return nil end
 s.Combo=if now-s.LastPrimary>1.4 then 1 else s.Combo%4+1;s.LastPrimary=now
 return s.Combo,if s.Combo==4 then 1.65 else 1
end
function R.unlock(profile,id,config)
 local skill=config.Skills[id]
 if not skill or not R.canUse(profile.Class,skill.Class,config) or R.level(profile.XP,config)<skill.Level then return false,'Classe/nível insuficiente.' end
 if skill.Level<=1 then return false,'Habilidade inicial já disponível sem compra.' end
 profile.Unlocks=profile.Unlocks or {}
 if profile.Unlocks[id] then return false,'Habilidade já aprendida.' end
 if profile.Gold<skill.Price then return false,'Gold insuficiente.' end
 profile.Gold-=skill.Price;profile.Unlocks[id]=true;return true,'Habilidade aprendida.'
end
return R
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">DefenseRules</string>
            <string name="Source"><![CDATA[-- All times come from the server. Holding guard does not renew the parry window.
local D={ParryWindow=0.24,ParryCooldown=0.65,BreakSeconds=1.4,MaxPosture=100}
function D.init(s)
 s.Posture=s.Posture or 0;s.BrokenUntil=s.BrokenUntil or 0
 s.ParryUntil=s.ParryUntil or 0;s.NextParry=s.NextParry or 0;s.LastPressure=s.LastPressure or -100
end
function D.block(s,now,on)
 D.init(s)
 if not on then s.Blocking=false;s.ParryUntil=0;return true end
 if s.Blocking or now<s.RecoverUntil or now<s.BrokenUntil or s.Stamina<10 then return false end
 s.Blocking=true;s.Sprinting=false
 if now>=s.NextParry then s.ParryUntil=now+D.ParryWindow;s.NextParry=now+D.ParryCooldown end
 return true
end
function D.step(s,now,dt)
 D.init(s)
 if now>=s.BrokenUntil and now-s.LastPressure>1 then s.Posture=math.max(0,s.Posture-math.clamp(dt,0,0.5)*(if s.Blocking then 8 else 24)) end
end
function D.resolve(s,now,amount,front,parryable)
 D.init(s)
 if now<s.DodgeUntil then return 0,'Dodge' end
 if s.Blocking and front and now>=s.BrokenUntil then
  if parryable and now<=s.ParryUntil and s.ParryUntil>0 then
   s.ParryUntil=0;s.Posture=math.max(0,s.Posture-30);s.Stamina=math.max(0,s.Stamina-3)
   return 0,'Parry'
  end
  local pressure=math.clamp(amount*1.8,15,60)
  s.Posture=math.min(D.MaxPosture,s.Posture+pressure);s.LastPressure=now
  s.Stamina=math.max(0,s.Stamina-10)
  if s.Posture>=D.MaxPosture or s.Stamina==0 then
   s.Blocking=false;s.Sprinting=false;s.ParryUntil=0;s.BrokenUntil=now+D.BreakSeconds
   s.RecoverUntil=math.max(s.RecoverUntil,s.BrokenUntil)
   return amount,'Break'
  end
  return amount*0.25,'Block'
 end
 return amount,'Hit'
end
function D.pressure(enemy,now,amount)
 enemy.Posture=math.min(100,(enemy.Posture or 0)+amount);enemy.LastPressure=now
 if enemy.Posture<100 then return false end
 enemy.Posture=0;enemy.StunnedUntil=now+(if enemy.Def and enemy.Def.Boss then 1.2 else 2)
 enemy.Pending=nil;enemy.Swing=nil;return true
end
function D.critical(ticket)
 assert(type(ticket)=='number' and ticket%1==0 and ticket>=1 and ticket<=100)
 return if ticket<=8 then 1.35 else 1 -- fixed 8%, independent of race/rarity
end
return D
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">DungeonRules</string>
            <string name="Source"><![CDATA[local R={}
local function int(n,lo,hi)return type(n)=='number' and n==n and n%1==0 and n>=lo and n<=hi end
function R.restore(profile,raw,c)
 raw=if type(raw)=='table' then raw else {}
 local out={Best={},Clears={},Ticket=nil}
 for id,d in c.Dungeons do
  local best=type(raw.Best)=='table' and raw.Best[id]
  out.Best[id]=if int(best,0,d.Floors) then best else 0
  out.Clears[id]=out.Best[id]==d.Floors and type(raw.Clears)=='table' and raw.Clears[id]==true
 end
 local t=raw.Ticket
 if type(t)=='table' and c.Dungeons[t.Dungeon] and type(t.Run)=='string' and #t.Run<=80 and #t.Run>0 and int(t.Expires,1,1e12) then
  local members={};local seen={}
  if type(t.Members)=='table' then for _,id in t.Members do
   if int(id,-1e15,1e15) and id~=0 and not seen[id] and #members<c.MaxPlayers then table.insert(members,id);seen[id]=true end
  end end
  if #members>0 then out.Ticket={Dungeon=t.Dungeon,Run=t.Run,Expires=t.Expires,Members=members} end
 end
 profile.Expedition=out;return out
end
function R.floor(c,id,n)
 local d=c.Dungeons[id];assert(d and int(n,1,d.Floors),'Andar inválido')
 local boss=n%5==0
 local layout=if boss then 'Arena' else c.Layouts[(n-1)%#c.Layouts+1]
 local enemies={}
 local roster=if id=='FallenSanctum' then {'Shadow','Demon','DarkWolf','Skeleton'} else {'Skeleton','Demon','DarkWolf','Shadow'}
 for i=1,if boss then 1 else 2+(if n>10 then 2 elseif n>5 then 1 else 0) do
  table.insert(enemies,if boss then (if n==d.Floors then d.FinalBoss else 'Knight') else roster[(n+i-2)%#roster+1])
 end
 return {Index=n,Name=d.Titles[n],Layout=layout,X=d.X,Y=(n-1)*96,Z=d.Z,Enemies=enemies,Boss=boss,Scale=1+(n-1)*0.07+(if id=='FallenSanctum' then 0.45 else 0)}
end
function R.newRun(c,id,members,nonce,now)
 assert(c.Dungeons[id] and #members>=1 and #members<=c.MaxPlayers)
 local allowed={};for _,uid in members do assert(int(uid,-1e15,1e15) and uid~=0 and not allowed[uid]);allowed[uid]=true end
 return {Id=id,Nonce=nonce,Floor=1,Members=allowed,Eliminated={},State='Fighting',Remaining=0,Killed={},Expires=now+c.RunSeconds}
end
function R.beginFloor(run,ids)
 run.Remaining=#ids;run.Killed={};run.Expected={}
 for _,id in ids do assert(not run.Expected[id]);run.Expected[id]=true end
 run.State=if #ids==0 then 'Cleared' else 'Fighting'
end
function R.kill(run,id)
 if run.State~='Fighting' or not run.Expected[id] or run.Killed[id] then return false end
 run.Killed[id]=true;run.Remaining-=1
 if run.Remaining==0 then run.State='Cleared' end
 return true
end
function R.advance(run,c)
 if run.State~='Cleared' then return false end
 if run.Floor==c.Dungeons[run.Id].Floors then run.State='Complete';return true end
 run.Floor+=1;run.State='Preparing';return true
end
function R.eliminate(run,uid)
 if not run.Members[uid] then return false end
 run.Eliminated[uid]=true
 for id in run.Members do if not run.Eliminated[id] then return false end end
 if run.State~='Complete' then run.State='Failed' end;return true
end
function R.reward(profile,c,id,floor)
 local d=c.Dungeons[id]
 if not d or not int(floor,1,d.Floors) then return false end
 local s=profile.Expedition
 if floor<=(s.Best[id] or 0) or floor~=(s.Best[id] or 0)+1 then return false end
 s.Best[id]=floor
 profile.Gold=math.min(1e9,profile.Gold+20+floor*5);profile.XP=math.min(1e9,profile.XP+30+floor*8)
 if floor==d.Floors then s.Clears[id]=true end
 return true
end
return R
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">EnvironmentRules</string>
            <string name="Source"><![CDATA[local E={Profiles={LOW={FX=12,Rain=0,Bloom=0.04},MEDIUM={FX=20,Rain=12,Bloom=0.1},HIGH={FX=28,Rain=24,Bloom=0.15}}}
function E.weather(serverSeconds)
 local cycle=math.floor(serverSeconds/300)%4
 return if cycle==1 then 'Mist' elseif cycle==2 then 'Rain' else 'Clear'
end
return E
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">IdentityRules</string>
            <string name="Source"><![CDATA[-- Núcleo puro, relógio e sorteio injetados pelo servidor. Nenhuma dependência do engine.
local I={}
local function int(v,min,max) return type(v)=='number' and v==v and v%1==0 and v>=min and v<=max end
function I.validate(c)
 local total=0;local seen={}
 for _,id in c.RaceOrder do local r=c.Races[id];assert(r and not seen[id] and int(r.Weight,1,100));seen[id]=true;total+=r.Weight end
 assert(total==100,'Probabilidades raciais devem somar exatamente 100')
 local products={}
 for _,p in c.Products do assert(int(p.Id,0,1e15) and int(p.Amount,1,100));if p.Id>0 then assert(not products[p.Id],'ID de produto duplicado');products[p.Id]=true end end
 for _,a in c.Advanced do assert(table.find(c.PrimaryClasses,a.Base) and a.Level>=1 and #a.Steps>0) end
 return true
end
function I.pick(c,ticket)
 assert(int(ticket,1,100),'Ticket fora de 1..100');local bound=0
 for _,id in c.RaceOrder do bound+=c.Races[id].Weight;if ticket<=bound then return id end end
 error('Probabilidades inválidas')
end
function I.new()
 return {Version=1,Race='',Evolution='',Classes={},Discoveries={},Challenges={},Racial={Status='Idle',Counts={},ReadyAt=0,Deadline=0},Fusion={Week=0,FreeUsed=0,Basic=0,Premium=0},Fragments=0,RetryCredits=0,Receipts={}}
end
local function stepsDone(steps,counts)
 for i,step in steps do if (counts[tostring(i)] or 0)<step.Count then return false end end;return true
end
local function cleanCounts(steps,raw)
 local counts={}
 if type(raw)=='table' then for i,step in steps do local v=raw[tostring(i)];counts[tostring(i)]=if int(v,0,step.Count) then v else 0 end end
 return counts
end
function I.restore(profile,raw,c)
 local out=I.new();raw=if type(raw)=='table' then raw else {}
 if raw.Race~=nil and raw.Race~='' then assert(c.Races[raw.Race],'Raça persistida inválida; não sortear novamente');out.Race=raw.Race end
 for _,key in {'Fragments','RetryCredits'} do if int(raw[key],0,1000000) then out[key]=raw[key] end end
 for id in c.Secrets do if type(raw.Discoveries)=='table' and raw.Discoveries[id]==true then out.Discoveries[id]=true end end
 if type(raw.Receipts)=='table' then
  for id,v in raw.Receipts do if type(id)=='string' and #id<=200 and v==true then out.Receipts[id]=true end end
 end
 local f=raw.Fusion
 if type(f)=='table' then for key,max in {Week=1000000,FreeUsed=c.Fusion.WeeklyFree,Basic=1000000,Premium=1000000} do if int(f[key],0,max) then out.Fusion[key]=f[key] end end end
 -- Base classes saved by the old system remain unlocked; advanced classes need challenge proof.
 for _,id in {'Guerreiro','Espadachim','Mago','Arqueiro'} do
  if profile.Class==id or type(raw.Classes)=='table' and raw.Classes[id]==true then out.Classes[id]=true end
 end
 for id,def in c.Advanced do
  local v=type(raw.Challenges)=='table' and raw.Challenges[id]
  if type(v)=='table' then
   local counts=cleanCounts(def.Steps,v.Counts)
   local completed=v.Status=='Complete' and stepsDone(def.Steps,counts)
   out.Challenges[id]={Status=if completed then 'Complete' elseif v.Status=='Active' then 'Active' else 'Idle',Counts=counts}
   if completed then out.Classes[id]=true;out.Classes[def.Base]=true end
  end
 end
 local race=c.Races[out.Race];local rq=raw.Racial
 if race and type(rq)=='table' then
  out.Racial.Counts=cleanCounts(race.Steps,rq.Counts)
  if int(rq.ReadyAt,0,1e12) then out.Racial.ReadyAt=rq.ReadyAt end
  if int(rq.Deadline,0,1e12) then out.Racial.Deadline=rq.Deadline end
  if rq.Status=='Complete' and stepsDone(race.Steps,out.Racial.Counts) then out.Racial.Status='Complete'
  elseif rq.Status=='Active' or rq.Status=='Failed' then out.Racial.Status=rq.Status end
  if out.Racial.Status=='Complete' and raw.Evolution==race.Evolution then out.Evolution=race.Evolution end
 end
 profile.Identity=out
 if type(raw.CurrentClass)=='string' and out.Classes[raw.CurrentClass] then profile.Class=raw.CurrentClass end
 out.CurrentClass=profile.Class
 return out
end
function I.assign(profile,c,ticket)
 local s=profile.Identity
 if s.Race~='' then assert(c.Races[s.Race]);return s.Race,false end
 s.Race=I.pick(c,ticket);return s.Race,true
end
function I.week(now) return math.floor((now+3*86400)/604800) end -- Monday 00:00 UTC
function I.refresh(profile,c,now)
 local s=profile.Identity;local week=I.week(now)
 if week>s.Fusion.Week then s.Fusion.Week=week;s.Fusion.FreeUsed=0 end
 if s.Racial.Status=='Active' and now>=s.Racial.Deadline then I.fail(profile,c,s.Racial.Deadline) end
end
function I.fail(profile,c,now)
 local q=profile.Identity.Racial
 if q.Status~='Active' then return false end
 q.Status='Failed';q.ReadyAt=now+c.RetrySeconds;q.Deadline=0;return true
end
function I.startRacial(profile,c,level,now)
 local s=profile.Identity;I.refresh(profile,c,now);local r=c.Races[s.Race]
 if not r or s.Evolution~='' or s.Racial.Status=='Active' or s.Racial.Status=='Complete' then return false,'Missão racial indisponível.' end
 if profile.Rank=='' or level<c.RacialLevel or r.Secret and not s.Discoveries[r.Secret] then return false,'Faltam nível, registro ou descoberta racial.' end
 if now<s.Racial.ReadyAt then
  if s.RetryCredits<1 then return false,'Aguarde 24 horas ou use um crédito de nova tentativa.' end
  s.RetryCredits-=1
 end
 s.Racial={Status='Active',Counts={},ReadyAt=0,Deadline=now+c.RacialDuration};return true,'Missão racial iniciada. Morte ou prazo encerrado causa falha.'
end
function I.startClass(profile,c,id,level)
 local def=c.Advanced[id];local s=profile.Identity
 if not def or not s.Classes[def.Base] or level<def.Level or def.Secret and not s.Discoveries[def.Secret] then return false,'Requisitos de classe/desafio não cumpridos.' end
 if s.Challenges[id] and s.Challenges[id].Status~='Idle' then return false,'Desafio já iniciado/concluído.' end
 s.Challenges[id]={Status='Active',Counts={}};return true,'Desafio de classe iniciado.'
end
local function advance(steps,q,event)
 local changed=false
 if not q or q.Status~='Active' then return false end
 for i,step in steps do
  local key=tostring(i);local before=q.Counts[key] or 0
  if step.Event==event then q.Counts[key]=math.min(step.Count,before+1);changed=changed or q.Counts[key]~=before end
 end
 return changed
end
function I.event(profile,c,event,now)
 I.refresh(profile,c,now);local s=profile.Identity;local changed=false
 local r=c.Races[s.Race];if r then changed=advance(r.Steps,s.Racial,event) end
 for id,def in c.Advanced do changed=advance(def.Steps,s.Challenges[id],event) or changed end
 return changed
end
function I.claimRacial(profile,c,now)
 I.refresh(profile,c,now);local s=profile.Identity;local r=c.Races[s.Race]
 if not r or s.Racial.Status~='Active' or not stepsDone(r.Steps,s.Racial.Counts) then return false,'Complete o desafio racial obrigatório.' end
 if s.Fragments<c.EvolutionFragments then return false,'Faltam fragmentos de dungeon; eles não substituem a missão.' end
 s.Fragments-=c.EvolutionFragments;s.Racial.Status='Complete';s.Racial.Deadline=0;s.Evolution=r.Evolution
 return true,'Evolução racial conquistada.'
end
function I.claimClass(profile,c,id)
 local s=profile.Identity;local def=c.Advanced[id];local q=s.Challenges[id]
 if not def or not q or q.Status~='Active' or not stepsDone(def.Steps,q.Counts) then return false,'Desafio ainda incompleto.' end
 q.Status='Complete';s.Classes[id]=true;return true,'Classe avançada desbloqueada.'
end
function I.selectClass(profile,c,id)
 local s=profile.Identity
 if profile.Class==id then return false,'Classe já está ativa.' end
 if not s.Classes[id] then return false,'Classe bloqueada.' end
 profile.Class=id;s.CurrentClass=id;return true,'Classe selecionada; equipe a arma correspondente.'
end
function I.discover(profile,c,id)
 if not c.Secrets[id] or profile.Identity.Discoveries[id] then return false end
 profile.Identity.Discoveries[id]=true;return true
end
function I.grantReceipt(profile,c,receiptId,productId)
 local s=profile.Identity
 if type(receiptId)~='string' or #receiptId==0 or #receiptId>200 then return false end
 local product
 for _,p in c.Products do if p.Id>0 and p.Id==productId then product=p end end
 if not product then return false end
 if s.Receipts[receiptId] then return true end
 if product.Grant=='Retry' then s.RetryCredits=math.min(1000000,s.RetryCredits+product.Amount)
 else s.Fusion[product.Grant]=math.min(1000000,s.Fusion[product.Grant]+product.Amount) end
 s.Receipts[receiptId]=true;return true
end
function I.buyFusion(profile,c,kind)
 if next(c.Fusion.Recipes)==nil then return false,'Catálogo de fusões aguarda definição; nenhuma moeda foi cobrada.' end
 if kind~='Basic' then return false,'Compra com Gold disponível somente para tentativa básica.' end
 if profile.Gold<c.Fusion.GoldPrice then return false,'Gold insuficiente.' end
 profile.Gold-=c.Fusion.GoldPrice;profile.Identity.Fusion.Basic+=c.Fusion.GoldPack;return true,'Tentativa básica adquirida.'
end
function I.fuse(profile,c,id,now)
 I.refresh(profile,c,now)
 -- Não há algoritmo/resultado autorizado ainda. Não debitar tentativas nem fragmentos.
 return false,'Fusão desativada: combinações e resultados aguardam definição do criador.'
end
return I
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">InteriorPlan</string>
            <string name="Source"><![CDATA[local Plan={}
function Plan.build(kind,width,depth,height)
 local out={}
 local function item(name,size,pos,material,collide)
  table.insert(out,{Name=name,Size=size,Position=pos,Material=material,Collide=collide~=false})
 end
 item('Rug',{6,0.12,8},{0,1.6,3},'Fabric',false)
 item('Table',{6,0.6,5},{-width*0.28,4,depth*0.2},'WoodPlanks')
 for _,x in {-2,2}do item('TableLeg',{0.5,2.5,0.5},{-width*0.28+x,2.6,depth*0.2},'Wood')end
 item('Bench',{5,1,2},{-width*0.28,2.4,depth*0.2-4},'WoodPlanks')
 if kind=='Tavern' or string.find(kind,'House') then
  item('BedFrame',{6,1.2,8},{width*0.28,2.2,depth*0.2},'Wood')
  item('Blanket',{5.5,0.5,7},{width*0.28,3.1,depth*0.2},'Fabric',false)
 elseif kind=='Castle' or kind=='Temple' then
  item('Dais',{10,1,6},{0,2,depth*0.33},'Cobblestone')
  item('Throne',{4,6,1},{0,5,depth*0.36},'Wood')
 else item('SupplyShelf',{6,6,2},{width*0.28,4,depth*0.3},'WoodPlanks')end
 for _,z in {-depth*0.25,depth*0.25}do item('CeilingBeam',{width,0.8,0.8},{0,height-1,z},'Wood',false)end
 item('LanternFrame',{1.2,1.8,1.2},{-width/2+2,7,-depth*0.15},'Metal',false)
 item('LanternGlow',{0.8,1.2,0.8},{-width/2+2,7,-depth*0.15},'Neon',false)
 return out
end
return Plan
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Party</string>
            <string name="Source"><![CDATA[-- Sem engine: máquina de estados para confirmação de grupos.
local Party = {}
function Party.new(leader)
    return {Leader=leader,Members={leader},Confirmed={},State="Forming"}
end
function Party.join(p,id)
    if p.State~="Forming" or #p.Members>=4 then return false end
    for _,v in p.Members do if v==id then return false end end
    table.insert(p.Members,id); table.clear(p.Confirmed); return true
end
function Party.confirm(p,id)
    if p.State~="Forming" then return false end
    for _,v in p.Members do if v==id then p.Confirmed[id]=true; return true end end
    return false
end
function Party.ready(p,present)
    if p.State~="Forming" or #p.Members<1 or #p.Members>4 then return false end
    for _,id in p.Members do if not p.Confirmed[id] or not present(id) then return false end end
    return true
end
function Party.remove(p,id)
    if p.State~="Forming" then return false end
    for i,v in p.Members do
        if v==id then
            table.remove(p.Members,i); table.clear(p.Confirmed)
            if p.Leader==id then p.Leader=p.Members[1] end
            return true
        end
    end
    return false
end
return Party
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[-- Regras puras e autoritativas. Apenas o servidor chama estas mutações.
local P = {}
function P.new()
    return {Gold=100,XP=0,Rank="",Class="",Equipment="",Armor="",StarterChosen=false,Unlocks={},Inventory={},Quests={},Claims={},Spawn="Valoria",Revision=0}
end
local function integer(n,lo,hi)
    return type(n)=="number" and n==n and n%1==0 and n>=lo and n<=hi
end
function P.sanitize(raw, catalog)
    local out = P.new()
    if type(raw)~="table" then return out end
    for _,k in {"Gold","XP","Revision"} do
        if integer(raw[k],0,1000000000) then out[k]=raw[k] end
    end
    if raw.Rank=="F" then out.Rank="F" end
    if type(raw.Inventory)=="table" then
        for id,item in catalog.Items do
            local value=raw.Inventory[id]
            if integer(value,1,if item.Kind=="Consumable" or item.Kind=="Material" then 99 else 1) then out.Inventory[id]=value end
        end
    end
    if out.Inventory.Armor and (raw.Armor==nil or raw.Armor=='Armor') then out.Armor='Armor' end
    if catalog.Items[raw.Equipment] and out.Inventory[raw.Equipment] then out.Equipment=raw.Equipment end
    out.StarterChosen=raw.StarterChosen==true
    for id in out.Inventory do if catalog.Items[id].Kind=="Weapon" then out.StarterChosen=true end end
    if type(raw.Quests)=="table" then
        for id,q in catalog.Quests do
            local v=raw.Quests[id]
            if type(v)=="table" then out.Quests[id]={Count=if integer(v.Count,0,q.Required) then v.Count else 0,Claimed=v.Claimed==true} end
        end
    end
    if out.StarterChosen or out.Quests.FirstSteps and out.Quests.FirstSteps.Claimed then
        -- Classe persistida só pode corresponder a um equipamento de classe conhecido.
        for _,item in catalog.Items do if item.Class==raw.Class then out.Class=raw.Class end end
    end
    if out.Class=='' and out.StarterChosen and catalog.Items[out.Equipment] then out.Class=catalog.Items[out.Equipment].Class or '' end
    if raw.Rank~='F' and out.Quests.FirstSteps and out.Quests.FirstSteps.Claimed and table.find(catalog.Ranks,raw.Rank) then out.Rank='F' end
    P.promote(out,catalog)
    if type(raw.Unlocks)=="table" then
        for id,value in raw.Unlocks do if type(id)=="string" and #id<50 and value==true then out.Unlocks[id]=true end end
    end
    if type(raw.Claims)=="table" then
        local n=0
        for id,v in raw.Claims do
            if type(id)=="string" and #id<=100 and v==true and n<512 then out.Claims[id]=true; n+=1 end
        end
    end
    for id in catalog.CityBuildings do if raw.Spawn==id then out.Spawn=id end end
    return out
end
function P.register(s)
    if s.Rank~="" then return false,"Você já está registrado." end
    s.Rank="F"; s.Quests.FirstSteps={Count=0,Claimed=false}
    return true,"Registro concluído: Rank F."
end
function P.buy(s,catalog,id,role)
    local item=catalog.Items[id]
    local allowed=false
    for _,candidate in catalog.Shops[role] or {} do if candidate==id then allowed=true end end
    if not item or not allowed then return false,"Item indisponível nesta loja." end
    if not P.space(s,catalog,id) then return false,'Sem espaço no inventário.' end
    if item.Kind~="Consumable" and item.Kind~="Material" and (s.Inventory[id] or 0)>0 then return false,"Você já possui este item." end
    if (s.Inventory[id] or 0)>=99 then return false,"Inventário cheio." end
    if s.Gold<item.Price then return false,"Gold insuficiente." end
    s.Gold-=item.Price; s.Inventory[id]=(s.Inventory[id] or 0)+1
    return true,"Compra concluída."
end
function P.choose(s,catalog,id)
    local item=catalog.Items[id]
    if not item or item.Kind~="Weapon" then return false,"Equipamento inválido." end
    if s.StarterChosen or s.Equipment~="" then return false,"O equipamento gratuito já foi escolhido." end
    if not P.space(s,catalog,id) then return false,'Sem espaço para a arma inicial.' end
    s.StarterChosen=true;s.Inventory[id]=1; s.Equipment=id;s.Class=item.Class
    return true,"Equipamento recebido. Use a ferramenta para atacar."
end
function P.accept(s,catalog,id)
    if s.Rank=="" or not catalog.Quests[id] or s.Quests[id] then return false,"Missão indisponível." end
    local q=catalog.Quests[id]
    if q.MinRank and (table.find(catalog.Ranks,s.Rank) or 0)<(table.find(catalog.Ranks,q.MinRank) or 99) then return false,'Rank da guilda insuficiente.' end
    for _,pre in q.Prerequisites or {} do if not s.Quests[pre] or not s.Quests[pre].Claimed then return false,"Conclua a missão anterior." end end
    if q.Target=="Supplies" then
        if not s.Inventory.SupplyParcel and not P.space(s,catalog,'SupplyParcel') then return false,'Libere um espaço para os suprimentos.' end
        s.Inventory.SupplyParcel=1
    end
    s.Quests[id]={Count=0,Claimed=false}; return true,"Missão aceita."
end
function P.event(s,catalog,target,amount)
    if not integer(amount,1,10) then return end
    local changed=false
    for id,state in s.Quests do
        local q=catalog.Quests[id]
        if q and not state.Claimed and q.Target==target then local before=state.Count;state.Count=math.min(q.Required,state.Count+amount);changed=changed or state.Count~=before end
    end
    return changed
end
function P.claimQuest(s,catalog,id)
    local q, state=catalog.Quests[id],s.Quests[id]
    if not q or not state or state.Claimed or state.Count<q.Required then return false,"Objetivos pendentes ou recompensa já recebida." end
    if id=="FirstSteps" and (s.Rank~="F" or not catalog.Items[s.Equipment]) then return false,"Registre-se e escolha equipamento." end
    if q.Target=="Supplies" then s.Inventory.SupplyParcel=nil end
    state.Claimed=true; s.Gold=math.min(1000000000,s.Gold+q.Gold); s.XP=math.min(1000000000,s.XP+q.XP)
    if id=="FirstSteps" and s.Class=='' then s.Class=catalog.Items[s.Equipment].Class end
    P.promote(s,catalog)
    return true,"Missão concluída!"
end
function P.chest(s,catalog,id,rarity)
    local reward=catalog.ChestRewards[rarity]
    if not reward or s.Claims[id] then return false,"Baú já coletado ou inválido." end
    local n=0; for _ in s.Claims do n+=1 end
    if n>=512 then return false,"Limite de registros de baú atingido." end
    s.Claims[id]=true; s.Gold=math.min(1000000000,s.Gold+reward)
    return true,"Baú: +"..reward.." Gold."
end
function P.sell(s,catalog,id)
    local item=catalog.Items[id]
    if not item or item.Kind=='Quest' or not item.Price or (s.Inventory[id] or 0)<1 or s.Equipment==id or s.Armor==id then return false,'Item indisponível para venda; desequipe antes.' end
    s.Inventory[id]-=1;if s.Inventory[id]==0 then s.Inventory[id]=nil end;s.Gold=math.min(1000000000,s.Gold+math.floor(item.Price*0.4));return true,'Venda concluída.'
end
function P.space(s,catalog,id)
    local item=catalog.Items[id];if not item then return false end
    if (s.Inventory[id] or 0)>0 then return (item.Kind=='Consumable' or item.Kind=='Material') and s.Inventory[id]<99 end
    local used=0;for _,n in s.Inventory do if n>0 then used+=1 end end
    return used<(catalog.InventorySlots or 20)
end
function P.grantItem(s,catalog,id)
    if not P.space(s,catalog,id) then return false end
    s.Inventory[id]=(s.Inventory[id] or 0)+1;return true
end
function P.promote(s,catalog)
    if s.Rank=='' then return end
    local completed=0;for _,q in s.Quests do if q.Claimed then completed+=1 end end
    for _,rank in catalog.Ranks do
        local requirement=catalog.RankRequirements and catalog.RankRequirements[rank]
        if requirement and s.XP>=requirement.XP and completed>=requirement.Quests then s.Rank=rank end
    end
end
return P
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">RigFactory</string>
          <string name="Source"><![CDATA[-- Alternativa procedural R6 válida, sem downloads ou animações de terceiros.
local Rig={}
function Rig.create(parent,name,position,color,hostile,kind)
    local model=Instance.new('Model'); model.Name=name
    local function limb(id,size,offset,paint,collide)
        local p=Instance.new('Part'); p.Name=id; p.Size=size; p.Position=position+offset
        p.Color=paint; p.Material=Enum.Material.SmoothPlastic; p.CanCollide=collide==true; p.CanTouch=false
        p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=model; return p
    end
    local skin=Color3.fromRGB(214,171,133)
    local root=limb('HumanoidRootPart',Vector3.new(2,2,1),Vector3.new(0,3,0),color,false); root.Transparency=1
    local torso=limb('Torso',Vector3.new(2,2,1),Vector3.new(0,3,0),color,hostile)
    local head=limb('Head',Vector3.new(2,1,1),Vector3.new(0,4.5,0),skin,false)
    local headMesh=Instance.new('SpecialMesh');headMesh.MeshType=Enum.MeshType.Head;headMesh.Scale=Vector3.new(1.15,1.15,1.15);headMesh.Parent=head
    local leftArm=limb('Left Arm',Vector3.new(1,2,1),Vector3.new(-1.5,3,0),color,false)
    local rightArm=limb('Right Arm',Vector3.new(1,2,1),Vector3.new(1.5,3,0),color,false)
    local leftLeg=limb('Left Leg',Vector3.new(1,2,1),Vector3.new(-0.5,1,0),Color3.fromRGB(60,56,51),false)
    local rightLeg=limb('Right Leg',Vector3.new(1,2,1),Vector3.new(0.5,1,0),Color3.fromRGB(60,56,51),false)
    local function joint(id,a,b,c0,c1)
        local motor=Instance.new('Motor6D'); motor.Name=id; motor.Part0=a; motor.Part1=b; motor.C0=c0; motor.C1=c1; motor.Parent=a
    end
    joint('RootJoint',root,torso,CFrame.identity,CFrame.identity)
    joint('Neck',torso,head,CFrame.new(0,1,0),CFrame.new(0,-0.5,0))
    joint('Left Shoulder',torso,leftArm,CFrame.new(-1,0.5,0),CFrame.new(0.5,0.5,0))
    joint('Right Shoulder',torso,rightArm,CFrame.new(1,0.5,0),CFrame.new(-0.5,0.5,0))
    joint('Left Hip',torso,leftLeg,CFrame.new(-0.5,-1,0),CFrame.new(0,1,0))
    joint('Right Hip',torso,rightLeg,CFrame.new(0.5,-1,0),CFrame.new(0,1,0))
    local function adorn(id,size,offset,paint,base)
        base=base or head
        local p=limb(id,size,base.Position-position+offset,paint,false); p.Massless=true
        local weld=Instance.new('WeldConstraint'); weld.Part0=base; weld.Part1=p; weld.Parent=p
        return p
    end
    for _,x in {-0.4,0.4} do adorn('Eye',Vector3.new(0.15,0.18,0.1),Vector3.new(x,0.1,-0.54),Color3.fromRGB(22,26,31)) end
    if kind=='Mage' or kind=='ShopMagic' then
        adorn('WizardHat',Vector3.new(2.4,1.4,2),Vector3.new(0,1,0),color)
        adorn('Robe',Vector3.new(2.2,2.4,1.3),Vector3.new(0,-0.6,0),color,torso)
    elseif kind=='Guard' or hostile then
        adorn('Helmet',Vector3.new(2.1,0.5,1.2),Vector3.new(0,0.5,0),Color3.fromRGB(106,115,128))
        adorn('Breastplate',Vector3.new(2.1,1.7,0.3),Vector3.new(0,0,-0.65),color,torso)
    else
        adorn('Apron',Vector3.new(1.5,1.8,0.2),Vector3.new(0,-0.2,-0.6),Color3.fromRGB(72,49,36),torso)
        adorn('Belt',Vector3.new(2.1,0.25,1.1),Vector3.new(0,-0.6,0),Color3.fromRGB(68,47,29),torso)
    end
    if kind=='Wolf' or kind=='DarkWolf' then
        adorn('Muzzle',Vector3.new(1.2,0.6,1),Vector3.new(0,-0.1,-0.8),color)
        for _,x in {-0.7,0.7} do adorn('Ear',Vector3.new(0.5,0.9,0.5),Vector3.new(x,0.9,0),color) end
    elseif kind=='Malgorth' or kind=='SylvarinBoss' or kind=='NoctharBoss' then
        for _,x in {-0.8,0.8} do adorn('Horn',Vector3.new(0.4,1.8,0.4),Vector3.new(x,1.1,0),Color3.fromRGB(38,24,31)) end
    elseif kind=='Slime' then
        local slime=adorn('SlimeBody',Vector3.new(4,3,4),Vector3.new(0,-0.5,0),color,torso)
        slime.Shape=Enum.PartType.Ball; slime.Transparency=0.2
    end
    local humanoid=Instance.new('Humanoid'); humanoid.DisplayName=name; humanoid.MaxHealth=100; humanoid.Health=100
    humanoid.HipHeight=0; humanoid.BreakJointsOnDeath=false; humanoid.RigType=Enum.HumanoidRigType.R6; humanoid.Parent=model
    root.Anchored=not hostile; model.PrimaryPart=root; model.Parent=parent
    if hostile then root:SetNetworkOwner(nil) end
    model:SetAttribute('ProceduralRig',true)
    return model,humanoid,root
end
return Rig
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="22">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="23">
      <Properties>
        <string name="Name">MedievalServer</string>
      </Properties>
      <Item class="Script" referent="24">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Runtime: inicializa serviços. NUNCA gera o continente ao entrar um jogador.
local RS=game:GetService('ReplicatedStorage')
local shared=RS:WaitForChild('MedievalRPG')
local remotes=Instance.new('Folder');remotes.Name='Remotes';remotes.Parent=shared
local action=Instance.new('RemoteEvent');action.Name='Action';action.Parent=remotes
local effects=Instance.new('RemoteEvent');effects.Name='Effects';effects.Parent=remotes
require(script.Parent.Services.GameService).start(action,effects)
local config=require(shared.Config.WorldConfig)
local Lighting=game:GetService('Lighting')
Lighting.ClockTime=9.5;Lighting.Brightness=2;Lighting.GlobalShadows=true
Lighting.Ambient=Color3.fromRGB(77,79,100);Lighting.OutdoorAmbient=Color3.fromRGB(126,139,153)
Lighting.EnvironmentDiffuseScale=0.45;Lighting.EnvironmentSpecularScale=0.65;Lighting.ExposureCompensation=0.05
local function ownedEffect(class,name)
    local effect=Lighting:FindFirstChild(name)
    if not effect then effect=Instance.new(class);effect.Name=name;effect.Parent=Lighting end
    return effect
end
local atmosphere=ownedEffect('Atmosphere','MedievalAtmosphere');atmosphere.Density=0.2;atmosphere.Haze=1
local bloom=ownedEffect('BloomEffect','MedievalBloom');bloom.Intensity=0.12;bloom.Size=14;bloom.Threshold=1.4
local grade=ownedEffect('ColorCorrectionEffect','MedievalGrade');grade.Saturation=0.08;grade.Contrast=0.03
-- Um único relógio global; neblina por região é feita localmente pelo client.
task.spawn(function()
    while task.wait(1) do Lighting.ClockTime=(Lighting.ClockTime+24/math.max(60,config.DayLengthSeconds))%24 end
end)
print('[MedievalRPG] Runtime iniciado. Sem geração automática de Terrain.')
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">AntiExploitService</string>
            <string name="Source"><![CDATA[local Security={Buckets={},Sessions={}}
function Security.allow(player,key,interval)
    local buckets=Security.Buckets[player] or {};Security.Buckets[player]=buckets
    local now=os.clock()
    if now<(buckets[key] or 0) then return false end
    buckets[key]=now+interval;return true
end
function Security.alive(player)
    local char=player.Character
    local hum=char and char:FindFirstChildOfClass('Humanoid')
    return char and hum and hum.Health>0 and char:FindFirstChild('HumanoidRootPart')
end
function Security.near(player,part,distance)
    local root=Security.alive(player)
    return root~=nil and part~=nil and part:IsDescendantOf(workspace) and (root.Position-part.Position).Magnitude<=distance
end
function Security.context(player)
    local entry=Security.Sessions[player]
    if not entry or os.clock()>entry.Expires or not Security.near(player,entry.Part,18) then return nil end
    return entry
end
function Security.open(player,part,role,city)
    Security.Sessions[player]={Part=part,Role=role,City=city,Expires=os.clock()+40}
end
function Security.clear(player) Security.Sessions[player]=nil;Security.Buckets[player]=nil end
return Security
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[local Shared=game.ReplicatedStorage.MedievalRPG
local Catalog=require(Shared.Config.ContentConfig)
local Security=require(script.Parent.AntiExploitService)
local Data=require(script.Parent.DataService)
local Enemies=require(script.Parent.EnemyService)
local Config=require(Shared.Config.AbilityConfig)
local Rules=require(Shared.Core.CombatRules)
local Defense=require(Shared.Core.DefenseRules)
local Players=game:GetService('Players')
local Rig=require(Shared.RigFactory)
local Projectiles=require(script.Parent.ProjectileService)
local Combat={FX=nil,States={},Fields={}}
function Combat.clear(player)
 Projectiles.cancel(player)
 for i=#Combat.Fields,1,-1 do if Combat.Fields[i].Owner==player then table.remove(Combat.Fields,i)end end
 local old=Combat.States[player]
 if old and old.Summon then old.Summon.Model:Destroy() end
 Combat.States[player]=nil
end
function Combat.changeClass(player)
 Projectiles.cancel(player)
 for i=#Combat.Fields,1,-1 do if Combat.Fields[i].Owner==player then table.remove(Combat.Fields,i)end end
 local old=Combat.States[player]
 if old then
    if old.Summon then old.Summon.Model:Destroy();old.Summon=nil end
    old.GuardUntil=0;old.RegenUntil=0;old.Blocking=false
    local profile=Data.get(player)
    if profile then local stats=Rules.stats(profile,Config);old.Mana=math.min(old.Mana,stats.Mana);old.Stamina=math.min(old.Stamina,stats.Stamina) end
 end
end
function Combat.get(player)
    local profile=Data.get(player);if not profile then return nil end
    local stats=Rules.stats(profile,Config)
    if not Combat.States[player] then Combat.States[player]=Rules.new(stats) end
    return Combat.States[player],stats,profile
end
function Combat.hurt(player,amount,origin,attacker,parryable)
    local s,stats=Combat.get(player);local root=Security.alive(player)
    if not s or not root or type(amount)~='number' or amount~=amount or amount<=0 then return end
    local now=os.clock()
    local delta=origin and origin-root.Position
    local front=delta~=nil and delta.Magnitude>0.01 and delta.Unit:Dot(root.CFrame.LookVector)>0.15
    local outcome
    amount,outcome=Defense.resolve(s,now,amount,front,parryable==true)
    if outcome=='Parry' and attacker and Enemies.Active[attacker.Model]==attacker then
        Defense.pressure(attacker,now,55);attacker.StunnedUntil=math.max(attacker.StunnedUntil or 0,now+0.5)
        attacker.Swing=nil;attacker.Pending=nil
        if Combat.OnAction then Combat.OnAction(player,'Parry') end
    end
    if Combat.FX and outcome~='Hit' then Combat.FX:FireAllClients({Kind='Defense',Position=root.Position,Outcome=outcome}) end
    if amount==0 then return outcome end
    if now<s.GuardUntil then amount*=0.5 end
    amount=math.max(1,math.floor(amount-stats.Defense))
    s.RecoverUntil=math.max(s.RecoverUntil,now+0.35)
    player.Character:FindFirstChildOfClass('Humanoid'):TakeDamage(amount)
    if Combat.FX then Combat.FX:FireAllClients({Kind='Hit',A=origin or root.Position,B=root.Position,Damage=amount}) end
end
function Combat.control(player,mode)
    local s,stats=Combat.get(player);local root=Security.alive(player)
    if not s or not root then return end
    local now=os.clock()
    if mode=='BlockOff' then Defense.block(s,now,false)
    elseif mode=='BlockOn' then Defense.block(s,now,true)
    elseif mode=='RunOff' then s.Sprinting=false
    elseif mode=='RunOn' and now>=s.RecoverUntil and not s.Blocking and s.Stamina>10 then s.Sprinting=true
    elseif mode=='Dodge' and Rules.reserve(s,'Dodge',now,0,22,1,0.2) then
        s.DodgeUntil=now+0.32;root.AssemblyLinearVelocity=root.CFrame.LookVector*52+Vector3.new(0,root.AssemblyLinearVelocity.Y,0)
        if Combat.OnAction then Combat.OnAction(player,'Dodge') end
        if Combat.FX then Combat.FX:FireClient(player,{Kind='Cooldown',Id='Dodge',Seconds=1});Combat.FX:FireAllClients({Kind='Defense',Position=root.Position,Outcome='Dodge'}) end
    end
end
function Combat.tick(dt)
    local now=os.clock()
    for i=#Combat.Fields,1,-1 do
        local field=Combat.Fields[i]
        if now>=field.Expires or not Security.alive(field.Owner) or field.Owner.Character~=field.Character then table.remove(Combat.Fields,i)
        elseif now>=field.Next then field.Next=now+1;Combat.impact(field.Owner,field.Position,nil,field.Spec)end
    end
    for _,p in Players:GetPlayers() do
        local s,stats,profile=Combat.get(p);local root=Security.alive(p)
        if s and root then
            Rules.step(s,stats,dt)
            Defense.step(s,now,dt)
            local hum=p.Character:FindFirstChildOfClass('Humanoid');hum.MaxHealth=stats.Health
            hum.WalkSpeed=if now<s.BrokenUntil then 4 elseif s.Blocking then 8 elseif s.Sprinting then stats.Speed+10 else stats.Speed
            if os.clock()<(s.RegenUntil or 0) then hum.Health=math.min(hum.MaxHealth,hum.Health+(s.RegenRate or 8)*dt) end
            if s.Summon then
                local summon=s.Summon
                if os.clock()>summon.Expires or not summon.Model.Parent then summon.Model:Destroy();s.Summon=nil
                else
                    summon.Model:PivotTo(CFrame.new(root.Position+Vector3.new(4,0,4)))
                    if os.clock()>=summon.Next then
                        summon.Next=os.clock()+1.5
                        for model,enemy in Enemies.Active do
                            local delta=enemy.Root.Position-root.Position
                            if delta.Magnitude<50 then
                                local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={p.Character,summon.Model}
                                local hit=workspace:Raycast(root.Position,delta,params)
                                if not hit or hit.Instance:IsDescendantOf(model) then
                                    local endPos=enemy.Root.Position
                                    Enemies.damage(model,p,math.floor(12*stats.Damage))
                                    if Combat.FX then Combat.FX:FireAllClients({Kind='Hit',A=summon.Model.PrimaryPart.Position,B=endPos,Magic=true,Damage=12}) end
                                    break
                                end
                            end
                        end
                    end
                end
            end
            local level,progress,need=Rules.level(profile.XP,Config)
            for k,v in {Mana=s.Mana,MaxMana=stats.Mana,Stamina=s.Stamina,MaxStamina=stats.Stamina,Posture=s.Posture,MaxPosture=Defense.MaxPosture,PostureBroken=now<s.BrokenUntil,Level=level,LevelXP=progress,NextXP=need} do p:SetAttribute(k,v) end
        end
    end
end
function Combat.apply(player,model,spec)
 local e=Enemies.Active[model];local root=Security.alive(player)
 if not e or not root or not Data.get(player) then return false end
 local pos=e.Root.Position
 if not Enemies.damage(model,player,spec.Damage) then return false end
 local now=os.clock()
 if not spec.Magic then Defense.pressure(e,now,spec.Pressure or 12) end
 if Combat.OnAction then Combat.OnAction(player,'Attack') end
 if spec.Effect=='Slow' then e.SlowUntil=now+4 end
 if spec.Effect=='Stun' then e.StunnedUntil=math.max(e.StunnedUntil or 0,now+(if e.Def and e.Def.Boss then 0.2 else 0.9)) end
 if spec.Effect=='Burn' then e.BurnUntil=now+4;e.BurnOwner=player end
 if spec.Effect=='Drain' then local h=player.Character:FindFirstChildOfClass('Humanoid');h.Health=math.min(h.MaxHealth,h.Health+math.floor(spec.Damage*0.2))end
 if Combat.FX then Combat.FX:FireAllClients({Kind='Hit',A=spec.Origin,B=pos,Magic=spec.Magic,Damage=spec.Damage,Effect=spec.Effect,Style=spec.Style,Critical=spec.Critical})end
 return true
end
function Combat.impact(player,position,part,spec)
 if spec.Radius>0 and Combat.FX then Combat.FX:FireAllClients({Kind='Burst',Position=position,Radius=spec.Radius,Style=spec.Style})end
 local count=0
 for model,e in Enemies.Active do
  local direct=part and part:IsDescendantOf(model)
  if not direct and (spec.Radius==0 or (e.Root.Position-position).Magnitude>spec.Radius)then continue end
  if not direct then
   local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={player.Character}
   local hit=workspace:Raycast(position,e.Root.Position-position,params)
   if hit and not hit.Instance:IsDescendantOf(model)then continue end
  end
  if Combat.apply(player,model,spec)then count+=1 end
  if count>=8 then break end
 end
end
function Combat.attack(player,target,mode)
    local s,stats,profile=Combat.get(player);local root=Security.alive(player)
    if not s or not root then return end
    local item=Catalog.Items[profile.Equipment]
    if mode~='Racial' and profile.Class~='' and Config.Classes[profile.Class] and Config.Classes[profile.Class].Weapon~=profile.Equipment then return end
    local tool=player.Character:FindFirstChildOfClass('Tool')
    if mode~='Racial' and (not item or (profile.Inventory[profile.Equipment] or 0)<1 or not tool or tool:GetAttribute('ItemId')~=profile.Equipment) then return end
    item=item or {Damage=0,Range=0,Cooldown=1}
    if target~=nil and (typeof(target)~='Vector3' or target.X~=target.X or target.Y~=target.Y or target.Z~=target.Z or target.Magnitude>100000) then return end
    local skillDefinition=Config.Skills[mode]
    local projectileSpeed=skillDefinition and skillDefinition.ProjectileSpeed or (if mode=='Primary' and (profile.Equipment=='Bow' or profile.Equipment=='Staff') then 150 else nil)
    if projectileSpeed and not Projectiles.available(player) then return end
    local style=skillDefinition and skillDefinition.Style or (if profile.Equipment=='Bow' then 'Arrow' elseif profile.Equipment=='Staff' then 'Arcane' else 'Steel')
    if mode=='FlameField' and #Combat.Fields>=8 then return end
    local now=os.clock();local damage,range,radius,effect,combo=item.Damage,item.Range,0,'Hit',0
    if mode=='Racial' then
        local racial=profile.Identity and Config.RacialSkills[profile.Identity.Race]
        if not racial then return end
        if not Rules.reserve(s,'Racial',now,8,0,if profile.Identity.Evolution~='' then 18 else 20,0.25) then return end
        damage,range,radius,effect=racial.Power,0,0,racial.Effect
    elseif mode=='Primary' then
        local multiplier
        combo,multiplier=Rules.primary(s,now,if Rules.canUse(profile.Class,'Espadachim',Config) then 0.35 else item.Cooldown)
        if not combo then return end;damage*=multiplier
    elseif mode=='Heavy' then
        if not Rules.reserve(s,'Heavy',now,0,22,1.5,0.8) then return end
        damage*=2;range=14;radius=8;effect='Stun'
    elseif mode=='Pulse' and profile.Equipment=='Staff' then
        if not Rules.reserve(s,'Pulse',now,8,0,3,0.3) then return end
        damage,range,radius=26,16,16
    else
        local skill=Config.Skills[mode]
        if not skill or not Rules.canUse(profile.Class,skill.Class,Config) or stats.Level<skill.Level then return end
        if profile.Equipment~=Config.Classes[profile.Class].Weapon then return end
        if skill.Effect=='Summon' then
            local count=0;for _,state in Combat.States do if state.Summon then count+=1 end end
            if count>=16 and not s.Summon then return end
        end
        if skill.Level>1 and not profile.Unlocks[mode] then return end
        if not Rules.reserve(s,mode,now,skill.Mana,skill.Stamina,skill.Cooldown,0.45) then return end
        damage,range,radius,effect=skill.Damage,skill.Range,skill.Radius,skill.Effect
    end
    s.Sprinting=false
    local critical=false
    if mode=='Primary' or mode=='Heavy' then local multiplier=Defense.critical(math.random(1,100));damage*=multiplier;critical=multiplier>1 end
    if Combat.OnAction and skillDefinition then Combat.OnAction(player,'Skill') end
    if Combat.FX then
        Combat.FX:FireClient(player,{Kind='Cooldown',Id=mode,Seconds=math.max(0,(s.Cooldowns[mode] or s.Cooldowns.Primary or now)-now),Combo=combo})
        Combat.FX:FireAllClients({Kind='Cast',Position=root.Position,Style=style,Actor=player.UserId,Mode=mode})
    end
    if effect=='Summon' then
        if s.Summon then s.Summon.Model:Destroy() end
        local model=Rig.create(workspace,'Espírito de '..player.DisplayName,root.Position-Vector3.new(0,3,0),Color3.fromRGB(111,137,180),false,'Mage')
        s.Summon={Model=model,Expires=now+12,Next=now};return
    end
    if effect=='RestoreMana' then s.Mana=math.min(stats.Mana,s.Mana+damage);return end
    if effect=='RestoreStamina' then s.Stamina=math.min(stats.Stamina,s.Stamina+damage);return end
    if effect=='Guard' then s.GuardUntil=now+(if mode=='Racial' then 3 else 6);return end
    if effect=='Regen' then s.RegenRate=if mode=='Racial' then 3 else 8;s.RegenUntil=now+8;return end
    if effect=='Heal' then
        for _,p in Players:GetPlayers() do
            local r=Security.alive(p)
            if r and (p==player or radius>0 and (r.Position-root.Position).Magnitude<=radius) then
                local h=p.Character:FindFirstChildOfClass('Humanoid');h.Health=math.min(h.MaxHealth,h.Health+damage)
            end
        end
        return
    end
    local dir=if target and (target-root.Position).Magnitude>0.1 then (target-root.Position).Unit else root.CFrame.LookVector
    if projectileSpeed then
        local character=player.Character;local class=profile.Class
        local spec={Damage=math.floor(damage*stats.Damage),Radius=radius,Effect=effect,Origin=root.Position,Magic=profile.Equipment=='Staff',Style=style,Critical=critical}
        Projectiles.launch(player,root.Position,dir,projectileSpeed,range,style,function()
            local current=Data.get(player);return current~=nil and player.Character==character and current.Class==class and Security.alive(player)~=nil
        end,function(at,part)Combat.impact(player,at,part,spec)end)
        return
    end
    local candidates={}
    for model,e in Enemies.Active do
        local delta=e.Root.Position-root.Position;local distance=delta.Magnitude
        if distance>0.1 and distance<=range and (radius>=range or delta.Unit:Dot(dir)>(if range>20 then 0.85 else 0)) then
            local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={player.Character}
            local hit=workspace:Raycast(root.Position,delta,params)
            if not hit or hit.Instance:IsDescendantOf(model) then table.insert(candidates,{Model=model,E=e,Distance=distance}) end
        end
    end
    table.sort(candidates,function(a,b)return a.Distance<b.Distance end)
    local center=candidates[1] and candidates[1].E.Root.Position
    if mode=='FlameField' then
        local point=center or root.Position+dir*math.min(range,25)
        local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={player.Character}
        local barrier=workspace:Raycast(root.Position,point-root.Position,params)
        if barrier and not center then point=barrier.Position end
        table.insert(Combat.Fields,{Owner=player,Character=player.Character,Position=point,Expires=now+5,Next=now+1,Spec={Radius=radius,Damage=math.max(1,math.floor(damage*stats.Damage*0.3)),Effect='Burn',Origin=point,Magic=true,Style='Fire'}})
        if Combat.FX then Combat.FX:FireAllClients({Kind='Warning',Position=point,Radius=radius,Seconds=5,HeightOffset=1,Name='Campo de Chamas',Friendly=true})end
    end
    if radius>0 and Combat.FX then Combat.FX:FireAllClients({Kind='Burst',Position=center or root.Position,Radius=radius,Style=style})end
    local hits=0
    for _,c in candidates do
        if hits>=8 or (radius==0 and hits>=1) then break end
        if radius>0 and center and (c.E.Root.Position-center).Magnitude>radius then continue end
        if Combat.apply(player,c.Model,{Damage=math.floor(damage*stats.Damage),Effect=effect,Origin=root.Position,Magic=profile.Equipment=='Staff',Style=style,Critical=critical,Pressure=if mode=='Heavy' then 35 else 12}) then hits+=1 end
    end
end
return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Http=game:GetService('HttpService')
local DSS=game:GetService('DataStoreService')
local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.WorldConfig)
local Catalog=require(Shared.Config.ContentConfig)
local Rules=require(Shared.Core.Progression)
local Identity=require(Shared.Core.IdentityRules)
local IdentityConfig=require(Shared.Config.IdentityConfig)
local Adventure=require(Shared.Core.AdventureRules)
local AdventureConfig=require(Shared.Config.AdventureConfig)
local Expeditions=require(Shared.Core.DungeonRules)
local DungeonConfig=require(Shared.Config.DungeonConfig)
Identity.validate(IdentityConfig)
local function prepare(raw)
    assert(raw==nil or type(raw)=='table','Perfil inválido; defaults não serão gravados')
    local state=Rules.sanitize(raw,Catalog)
    Identity.restore(state,type(raw)=='table' and raw.Identity or nil,IdentityConfig)
    Adventure.restore(state,type(raw)=='table' and raw.Adventure or nil,AdventureConfig)
    Expeditions.restore(state,type(raw)=='table' and raw.Expedition or nil,DungeonConfig)
    return state
end
local studioPreview=game:GetService('RunService'):IsStudio() and workspace:GetAttribute('StudioSessionPreview')==true
local Data={Sessions={},Persistent=Config.EnableDataStore and not studioPreview}
local store=if Data.Persistent then DSS:GetDataStore('MedievalRPG_v1') else nil
local function clone(t) return Http:JSONDecode(Http:JSONEncode(t)) end
function Data.load(player,reuseToken)
    local previous=Data.Sessions[player]
    if previous and (previous.Saving or previous.Loading) then return false,'Perfil ocupado; aguarde a operação atual.' end
    local slot={Loading=true,PendingDeath=previous and previous.PendingDeath,Token=reuseToken or Http:GenerateGUID(false),State=Rules.new(),Ready=false,Saving=false,Frozen=false}
    Data.Sessions[player]=slot
    if not store then slot.State=prepare(nil);slot.Ready=true;slot.Loading=false; return true,'Modo volátil: raça não sorteada. Persistência é obrigatória para identidade permanente.' end
    local candidate
    local ok,result
    for attempt=1,3 do
        ok,result=pcall(function()
            return store:UpdateAsync('Player_'..player.UserId,function(old)
                assert(old==nil or type(old)=='table' and type(old.Data)=='table','Envelope existente inválido; preservar para recuperação')
                old=old or {}
                assert(old.Session==nil or type(old.Session)=='table' and type(old.Session.Token)=='string' and type(old.Session.Expires)=='number' and old.Session.Expires==old.Session.Expires,'Lock inválido')
                local lock=old.Session
                if lock and lock.Token~=slot.Token and type(lock.Expires)=='number' and lock.Expires>os.time() then return nil end
                local profile=prepare(old.Data)
                if profile.Identity.Race=='' then
                    if not candidate then candidate=math.random(1,100) end
                    Identity.assign(profile,IdentityConfig,candidate)
                end
                Identity.refresh(profile,IdentityConfig,os.time())
                if slot.PendingDeath then Identity.fail(profile,IdentityConfig,slot.PendingDeath) end
                return {Data=profile,Session={Token=slot.Token,Expires=os.time()+180}}
            end)
        end)
        if ok and result and result.Session and result.Session.Token==slot.Token then break end
        if attempt<3 then task.wait(attempt) end
    end
    if not ok or not result or not result.Session or result.Session.Token~=slot.Token then
        slot.Loading=false;slot.Frozen=true
        warn('Perfil indisponível para '..player.UserId..'; nenhuma gravação de defaults será feita.')
        return false,'Dados indisponíveis ou sessão ativa em outro servidor. Entre novamente mais tarde.'
    end
    slot.State=prepare(result.Data);slot.Ready=true;slot.Loading=false;slot.PendingDeath=nil;slot.LeaseUntil=result.Session.Expires
    if player.Parent~=Players then Data.save(player,true);Data.Sessions[player]=nil end
    return true,'Progresso carregado.'
end
function Data.get(player)
    local slot=Data.Sessions[player]
    if slot and store and slot.Ready and slot.LeaseUntil and os.time()>=slot.LeaseUntil then slot.Frozen=true end
    return if slot and slot.Ready and not slot.Frozen and not slot.Released then slot.State else nil
end
function Data.save(player,release)
    local slot=Data.Sessions[player]
    if slot and slot.Released then return true end
    if not slot or not slot.Ready or slot.Saving or slot.Frozen then return false,'Perfil ocupado/indisponível' end
    if not store then return true end
    slot.Saving=true
    if release then slot.Frozen=true end
    slot.State.Identity.CurrentClass=slot.State.Class
    local snapshot=clone(slot.State)
    local ok,result=pcall(function()
        return store:UpdateAsync('Player_'..player.UserId,function(old)
            if type(old)~='table' or not old.Session or old.Session.Token~=slot.Token then return nil end
            if old.Data and old.Data.Identity and old.Data.Identity.Race~=snapshot.Identity.Race then return nil end
            return {Data=snapshot,Session=if release then nil else {Token=slot.Token,Expires=os.time()+180}}
        end)
    end)
    slot.Saving=false
    if not ok or not result then
        -- Congela em caso de erro ou perda de posse; evita recompensas em perfil sem lock.
        slot.Frozen=true;warn('Save falhou; perfil congelado para '..player.UserId)
        return false,'Falha de salvamento. Reconecte para proteger o progresso.'
    end
    if release then slot.Released=true else slot.LeaseUntil=result.Session.Expires;Data.flushDeath(player) end
    return true
end
-- Grant + durable receipt marker committed in the SAME owned profile transaction.
function Data.changeIdentity(player,mutation)
    local slot=Data.Sessions[player]
    if not store or not Data.get(player) or slot.Saving or slot.Released then return false,'Perfil ocupado ou sem persistência.' end
    local snapshot=clone(slot.State)
    snapshot.Identity.CurrentClass=snapshot.Class
    local accepted,message=mutation(snapshot)
    if not accepted then return false,message end
    snapshot.Identity.CurrentClass=snapshot.Class
    slot.Saving=true;slot.Frozen=true
    local ok,result=pcall(function()
        return store:UpdateAsync('Player_'..player.UserId,function(old)
            if not old or not old.Session or old.Session.Token~=slot.Token then return nil end
            if not old.Data or not old.Data.Identity or old.Data.Identity.Race~=snapshot.Identity.Race then return nil end
            return {Data=snapshot,Session={Token=slot.Token,Expires=os.time()+180}}
        end)
    end)
    slot.Saving=false
    if not ok or not result then return false,'Gravação incerta; perfil congelado até recarga. Nenhuma compra será confirmada.' end
    slot.State=prepare(result.Data);slot.Frozen=false;slot.LeaseUntil=result.Session.Expires
    Data.flushDeath(player)
    return true,message
end
-- Reuses the same atomic profile transaction for expedition tickets/rewards.
-- Volatile mode is explicit and never used for paid grants or racial rolls.
function Data.transaction(player,mutation)
    if store then return Data.changeIdentity(player,mutation) end
    local state=Data.get(player);if not state then return false,'Perfil indisponível.' end
    local snapshot=clone(state);local ok,message=mutation(snapshot)
    if ok then Data.Sessions[player].State=prepare(snapshot) end
    return ok,message
end
function Data.receipt(player,receiptId,productId)
    local slot=Data.Sessions[player]
    if not store or not Data.get(player) or slot.Saving or slot.Released then return false end
    if slot.State.Identity.Receipts[receiptId] then return true end
    slot.Saving=true;slot.Frozen=true
    slot.State.Identity.CurrentClass=slot.State.Class
    local snapshot=clone(slot.State)
    local ok,result=pcall(function()
        return store:UpdateAsync('Player_'..player.UserId,function(old)
            if type(old)~='table' or not old.Session or old.Session.Token~=slot.Token then return nil end
            if not old.Data or not old.Data.Identity or old.Data.Identity.Race~=snapshot.Identity.Race then return nil end
            if old.Data.Identity.Receipts[receiptId] then return old end
            local nextState=clone(snapshot)
            if not Identity.grantReceipt(nextState,IdentityConfig,receiptId,productId) then return nil end
            return {Data=nextState,Session={Token=slot.Token,Expires=os.time()+180}}
        end)
    end)
    slot.Saving=false
    if not ok or not result then
        -- Keep frozen on uncertainty; Roblox must retry the receipt, never acknowledge a lost grant.
        warn('Recibo pendente; perfil requer recarga segura: '..player.UserId)
        return false
    end
    slot.State=prepare(result.Data);slot.Frozen=false;slot.LeaseUntil=result.Session.Expires
    Data.flushDeath(player)
    return slot.State.Identity.Receipts[receiptId]==true
end
function Data.noteDeath(player)
    local slot=Data.Sessions[player]
    if not slot or not slot.Ready then return end
    slot.PendingDeath=os.time()
    local changed=Identity.fail(slot.State,IdentityConfig,slot.PendingDeath)
    if not slot.Saving and not slot.Frozen then
        slot.PendingDeath=nil
        if changed then Data.save(player,false) end
    end
end
function Data.flushDeath(player)
    local slot=Data.Sessions[player]
    if not slot or not slot.PendingDeath then return end
    local at=slot.PendingDeath;slot.PendingDeath=nil
    local changed=Identity.fail(slot.State,IdentityConfig,at)
    if changed or slot.State.Identity.Racial.Status=='Failed' then Data.save(player,false) end
end
function Data.remove(player)
    local slot=Data.Sessions[player]
    if not slot then return end
    local limit=os.clock()+8
    while slot.Saving and os.clock()<limit do task.wait(0.1) end
    if slot.Frozen then
        -- Discard uncertain local snapshot; release ONLY our lock, preserving durable receipts/progress.
        if store and not slot.Saving then pcall(function()
            store:UpdateAsync('Player_'..player.UserId,function(old)
                if type(old)=='table' and old.Session and old.Session.Token==slot.Token then return {Data=old.Data} end
                return nil
            end)
        end) end
    else Data.save(player,true) end
    if Data.Sessions[player]==slot then Data.Sessions[player]=nil end
end
function Data.start()
    task.spawn(function()
        while task.wait(45) do
            for player,slot in Data.Sessions do
                if slot.Ready and not slot.Saving and not slot.Frozen then Data.save(player,false) end
            end
        end
    end)
    game:BindToClose(function()
        local pending=0
        for player in Data.Sessions do pending+=1;task.spawn(function() Data.remove(player);pending-=1 end) end
        local deadline=os.clock()+20
        while pending>0 and os.clock()<deadline do task.wait(0.1) end
    end)
end
return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">DungeonService</string>
            <string name="Source"><![CDATA[local Players=game:GetService('Players')
local RunService=game:GetService('RunService')
local Teleport=game:GetService('TeleportService')
local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.WorldConfig)
local Parties=require(Shared.Core.Party)
local Data=require(script.Parent.DataService)
local Security=require(script.Parent.AntiExploitService)
local Expedition=require(script.Parent.ExpeditionService)
local DungeonConfig=require(Shared.Config.DungeonConfig)
local CombatRules=require(Shared.Core.CombatRules)
local Abilities=require(Shared.Config.AbilityConfig)
local D={Groups={},Membership={},Notice=nil,OnDungeonReady=nil}
local function tell(p,message) if D.Notice then D.Notice(p,message) end end
local function eligible(p)
    local s=Data.get(p)
    local context=Security.context(p)
    return s and s.Rank~='' and Security.alive(p) and context and context.Role=='Dungeon'
end
local function selection(p)
    local ctx=Security.context(p)
    local npc=ctx and ctx.Part:FindFirstAncestorOfClass('Model')
    return npc and npc:GetAttribute('DungeonId') or 'MalgorthDepths'
end
function D.status(player)
    local group=D.Membership[player.UserId]
    local list={}
    if group then
        for _,id in group.Members do
            local p=Players:GetPlayerByUserId(id)
            table.insert(list,{Id=id,Name=if p then p.DisplayName else tostring(id),Confirmed=group.Confirmed[id]==true})
        end
    end
    return {Leader=group and group.Leader,Members=list,State=group and group.State or 'Solo',Code=group and group.Leader,Dungeon=group and group.DungeonId or selection(player)}
end
function D.leave(player,force)
    local group=D.Membership[player.UserId]
    if not group then return end
    if force then group.State='Forming' end
    if group.State~='Forming' then return end
    local oldLeader=group.Leader
    Parties.remove(group,player.UserId);D.Membership[player.UserId]=nil
    D.Groups[oldLeader]=nil
    if #group.Members>0 then D.Groups[group.Leader]=group end
end
local function recover(list)
    for _,p in list do
        local slot=Data.Sessions[p]
        if p.Parent==Players and slot and (slot.Released or slot.Frozen) then task.spawn(function() local ok=Data.load(p,slot.Token);tell(p,if ok then 'Teleporte interrompido; perfil recarregado. Reabra o guardião.' else 'Perfil ainda indisponível; nenhuma recuperação foi confirmada.') end) end
    end
end
function D.transfer(group)
    local list={}
    local id=group.DungeonId or 'MalgorthDepths';local def=DungeonConfig.Dungeons[id]
    if id~='Legacy' and not def then return false,'Dungeon inválida.' end
    if not Parties.ready(group,function(userId)
        local p=Players:GetPlayerByUserId(userId)
        if p and eligible(p) and (id=='Legacy' or selection(p)==id) and (not def or CombatRules.level(Data.get(p).XP,Abilities)>=def.MinLevel) then table.insert(list,p);return true end
        return false
    end) then return false,'Todos devem estar vivos, registrados, próximos e confirmados.' end
    if RunService:IsStudio() then
        if not Config.StudioDungeonTest then return false,'Modo de teste local desativado.' end
        local map=workspace:FindFirstChild('GeneratedDungeon')
        if not map then
            local ok,result=pcall(function()
                return require(game.ServerStorage.MedievalWorldgen.DungeonInteriorGenerator).GenerateDungeon({Origin=Vector3.new(6000,30,0),StudioTest=true})
            end)
            if not ok then warn(result);return false,'Falha ao criar mapa isolado de teste; consulte Output.' end
            map=result
            if D.OnDungeonReady then D.OnDungeonReady(map) end
        end
        if id~='Legacy' then
            local ok,msg=Expedition.begin(id,list,map,game:GetService('HttpService'):GenerateGUID(false))
            if ok then group.State='LocalTest' end
            return ok,msg..' • Teste local, sem TeleportService.'
        end
        group.State='LocalTest'
        for i,p in list do
            p:SetAttribute('InDungeon',true)
            p.Character:PivotTo(CFrame.new(map:GetAttribute('SpawnPosition')+Vector3.new((i-1)*4,0,0)))
            tell(p,'TESTE LOCAL: movimentação no mesmo Place. Nenhum teleporte real foi testado.')
        end
        return true,'Grupo entrou no teste local.'
    end
    if Config.DungeonPlaceId<=0 or Config.ReturnPlaceId<=0 then return false,'Configure DungeonPlaceId e ReturnPlaceId com IDs reais da mesma Experience.' end
    if not Data.Persistent then return false,'Habilite e valide DataStore antes de usar teleporte publicado.' end
    group.State='Teleporting'
    local nonce=game:GetService('HttpService'):GenerateGUID(false)
    for _,p in list do
        if id~='Legacy' then
            local ok=Data.transaction(p,function(s)return Expedition.ticket(s,id,nonce,os.time(),group.Members)end)
            if not ok then group.State='Forming';recover(list);return false,'Não foi possível gravar a reserva; teleporte cancelado.' end
        end
        local saved=Data.save(p,true)
        if not saved then group.State='Forming';recover(list);return false,'Não foi possível salvar todos os perfis; teleporte cancelado.' end
    end
    local options=Instance.new('TeleportOptions');options.ShouldReserveServer=true
    options:SetTeleportData({Party=group.Members,OriginPlaceId=game.PlaceId}) -- Sem itens, Gold ou recompensas no TeleportData.
    local ok,err=pcall(function() Teleport:TeleportAsync(Config.DungeonPlaceId,list,options) end)
    if not ok then warn(err);group.State='Forming';recover(list);return false,'Teleporte falhou. Perfis serão recarregados.' end
    return true,'Teleporte solicitado; aguarde a resposta da plataforma.'
end
function D.action(player,action,code)
    if not eligible(player) then return false,'Registre Rank F e converse com o guardião novamente.' end
    local group=D.Membership[player.UserId]
    if action=='Leave' then D.leave(player);return true,'Grupo atualizado.' end
    if action=='Create' then
        if group then return false,'Saia do grupo atual primeiro.' end
        group=Parties.new(player.UserId);group.DungeonId=selection(player);D.Groups[player.UserId]=group;D.Membership[player.UserId]=group
        return true,'Grupo criado. Código: '..player.UserId
    elseif action=='Join' then
        if group or type(code)~='number' or code%1~=0 then return false,'Código inválido ou você já está em grupo.' end
        local target=D.Groups[code]
        local leader=target and Players:GetPlayerByUserId(target.Leader)
        if not target or not leader or not eligible(leader) or target.DungeonId~=selection(player) then return false,'Grupo indisponível ou de outra dungeon.' end
        if not Parties.join(target,player.UserId) then return false,'Grupo cheio ou iniciado.' end
        D.Membership[player.UserId]=target;return true,'Você entrou no grupo; todos devem confirmar novamente.'
    elseif action=='Confirm' and group then
        Parties.confirm(group,player.UserId);return true,'Presença confirmada. O líder pode iniciar.'
    elseif action=='Start' and group then
        if group.Leader~=player.UserId then return false,'Somente o líder pode iniciar.' end
        return D.transfer(group)
    elseif action=='Solo' or action=='Legacy' then
        if group then return false,'Saia do grupo antes de entrar sozinho.' end
        group=Parties.new(player.UserId);group.DungeonId=if action=='Legacy' then 'Legacy' else selection(player);Parties.confirm(group,player.UserId)
        local ok,message=D.transfer(group)
        if ok then D.Membership[player.UserId]=group;D.Groups[player.UserId]=group end
        return ok,message
    end
    return false,'Ação de grupo inválida.'
end
function D.returnPlayer(player)
    if RunService:IsStudio() then
        local map=workspace:FindFirstChild('GeneratedWorld')
        local spawn=map and map:FindFirstChild('Spawns') and map.Spawns:FindFirstChild('ValoriaSpawn')
        local dungeon=workspace:FindFirstChild('GeneratedDungeon')
        if not spawn and dungeon then spawn=dungeon:FindFirstChild('DungeonSpawn') end
        if not spawn or not player.Character then return false,'Destino local ausente; use Stop para sair.' end
        Expedition.leave(player)
        player.Character:PivotTo(spawn.CFrame+Vector3.new(0,5,0));player:SetAttribute('InDungeon',map==nil)
        local group=D.Membership[player.UserId]
        if group then group.State='Forming';D.leave(player) end
        return true,if map then 'Retorno local concluído; sem TeleportService.' else 'Retorno à recepção de testes; o continente fica no outro Place.'
    end
    if Config.ReturnPlaceId<=0 then return false,'Configure ReturnPlaceId no Place da dungeon.' end
    local slot=Data.Sessions[player]
    if not slot then return false,'Perfil indisponível.' end
    Expedition.leave(player)
    if not Data.save(player,true) then recover({player});return false,'Falha de salvamento; retorno cancelado.' end
    local ok,err=pcall(function() Teleport:TeleportAsync(Config.ReturnPlaceId,{player}) end)
    if not ok then warn(err);recover({player});return false,'Falha de teleporte; perfil será recarregado.' end
    return true,'Retorno solicitado.'
end
function D.start()
    Teleport.TeleportInitFailed:Connect(function(player)
        local slot=Data.Sessions[player]
        if slot and slot.Released then recover({player}) end
        local group=D.Membership[player.UserId]
        if group then group.State='Forming';table.clear(group.Confirmed) end
    end)
end
return D
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">EnemyService</string>
            <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Pathfinding=game:GetService('PathfindingService')
local Shared=game.ReplicatedStorage.MedievalRPG
local Rig=require(Shared.RigFactory)
local Catalog=require(Shared.Config.ContentConfig)
local Config=require(Shared.Config.WorldConfig)
local Security=require(script.Parent.AntiExploitService)
local Patterns=require(Shared.Core.ActionMath)
local E={Active={},Spawns={},SpawnSet={},OnKill=nil,Running=false}
local function nearest(pos,radius,scope)
    local best,dist
    for _,p in Players:GetPlayers() do
        local root=Security.alive(p)
        if root and (not E.CanTarget or E.CanTarget(p,scope)) then
            local d=(root.Position-pos).Magnitude
            if d<radius and (not dist or d<dist) then best,dist=p,d end
        end
    end
    return best,dist
end
function E.scan(root)
    local folder=root:FindFirstChild('EnemySpawns')
    if folder then
        for _,marker in folder:GetChildren() do
            if marker:IsA('BasePart') and not E.SpawnSet[marker] then
                E.SpawnSet[marker]=true;table.insert(E.Spawns,{Marker=marker,Next=0,Root=root})
            end
        end
    end
end
local function spawnEnemy(s)
    local kind=s.Marker:GetAttribute('EnemyKind');local def=Catalog.Enemies[kind]
    if not def then return end
    local paint=Color3.fromRGB(table.unpack(def.Color))
    local model,hum,root=Rig.create(s.Root,def.Name,s.Marker.Position,paint,true,kind)
    model:SetAttribute('EnemyKind',kind);model:SetAttribute('HealthMax',def.Health);model:SetAttribute('Health',def.Health)
    local health=def.Health;local heightOffset=3
    if def.Boss then
        local participants=0;for _,p in Players:GetPlayers()do local r=Security.alive(p);if r and (r.Position-s.Marker.Position).Magnitude<100 then participants+=1 end end
        health=math.floor(def.Health*(1+0.35*(math.clamp(participants,1,4)-1)))
        local scale=if kind=='Malgorth' then 2.2 else 1.7
        model:ScaleTo(scale);heightOffset=3*scale
        model:PivotTo(CFrame.new(s.Marker.Position+Vector3.new(0,heightOffset,0)))
        model:SetAttribute('Boss',true);model:SetAttribute('PartyScale',math.clamp(participants,1,4))
    end
    model:SetAttribute('HealthMax',health);model:SetAttribute('Health',health)
    hum.MaxHealth=health;hum.Health=health;hum.WalkSpeed=def.Speed
    local multiplier=s.Marker:GetAttribute('Difficulty') or 1
    health=math.floor(health*multiplier);hum.MaxHealth=health;hum.Health=health
    model:SetAttribute('HealthMax',health);model:SetAttribute('Health',health)
    local e={Model=model,Hum=hum,Root=root,Kind=kind,Def=def,MaxHealth=health,HeightOffset=heightOffset,Spawn=s,Home=s.Marker.Position,LastAttack=0,Contributors={},State='IDLE',PathAt=0,Waypoints=nil,Waypoint=1,PathBusy=false,Target=nil,LastSpecial=os.clock(),SpecialCooldown=5}
    e.Damage=math.floor(def.Damage*math.min(2.5,multiplier))
    s.Enemy=e;E.Active[model]=e
    hum.HealthChanged:Connect(function(h) if model.Parent then model:SetAttribute('Health',h) end end)
    hum.Died:Connect(function()
        e.State='DEAD';model:SetAttribute('State','DEAD')
        if kind=='Malgorth' then s.Root:SetAttribute('BossDefeated',true) end
        if s.Marker:GetAttribute('Once') then s.Marker:SetAttribute('Defeated',true) end
        if E.OnKill then local ok,err=xpcall(function()E.OnKill(e)end,debug.traceback);if not ok then warn(err)end end
        E.Active[model]=nil;s.Enemy=nil;s.Next=os.clock()+(if kind=='Malgorth' or kind=='Knight' then 300 else 25)
        task.delay(4,function() if model.Parent then model:Destroy() end end)
    end)
end
function E.damage(model,player,damage)
    local e=E.Active[model]
    if not e or e.Hum.Health<=0 then return false end
    if E.CanTarget and not E.CanTarget(player,e.Spawn and e.Spawn.Root) then return false end
    if type(damage)~='number' or damage~=damage or damage<=0 or damage>100000 then return false end
    local actual=math.min(damage,e.Hum.Health)
    if e.Spawn and e.Spawn.Marker:GetAttribute('Training') then
        e.Hum.Health=e.Hum.MaxHealth;e.ReactionUntil=os.clock()+0.15;return true
    end
    e.Contributors[player]=(e.Contributors[player] or 0)+actual
    e.Hum:TakeDamage(actual);e.ReactionUntil=os.clock()+0.15;return true
end
local function pathTo(e,target)
    if e.PathBusy or os.clock()-e.PathAt<2 then return end
    e.PathAt=os.clock();e.PathBusy=true
    task.spawn(function()
        local path=Pathfinding:CreatePath({AgentRadius=2,AgentHeight=6,AgentCanJump=true})
        local ok=pcall(function() path:ComputeAsync(e.Root.Position,target) end)
        if e.Model.Parent and ok and path.Status==Enum.PathStatus.Success then
            e.Waypoints=path:GetWaypoints();e.Waypoint=2;e.PathGoal=target
        end
        e.PathBusy=false
    end)
end
function E.resolveSwing(e,now)
    local swing=e.Swing
    if not swing then return end
    if e.Hum.Health<=0 or now<(e.StunnedUntil or 0) or (e.Root.Position-e.Home).Magnitude>95 then e.Swing=nil;return end
    if now<swing.At then return end
    e.Swing=nil
    local r=Security.alive(swing.Player)
    local delta=r and r.Position-e.Root.Position
    if not delta or delta.Magnitude>swing.Range or (delta.Magnitude>0.01 and swing.Direction and delta.Unit:Dot(swing.Direction)<0.1) then return end
    if E.CanTarget and not E.CanTarget(swing.Player,e.Spawn and e.Spawn.Root) then return end
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={e.Model}
    local hit=workspace:Raycast(e.Root.Position,delta,params)
    if E.OnPlayerHit and (not hit or hit.Instance:IsDescendantOf(swing.Player.Character)) then
        E.OnPlayerHit(swing.Player,e.Damage or e.Def.Damage,e.Root.Position,e,true)
    end
end
function E.step()
    local now=os.clock();local count=0
    for _ in E.Active do count+=1 end
    local cap=Config.QualityProfiles[Config.Quality].ActiveEnemies
    for _,s in E.Spawns do
        if s.Marker.Parent and s.Marker:GetAttribute('Enabled')~=false and not s.Marker:GetAttribute('Defeated') and not s.Enemy and now>=s.Next and count<cap and nearest(s.Marker.Position,220,s.Root) then
            if not (s.Marker:GetAttribute('EnemyKind')=='Malgorth' and s.Root:GetAttribute('BossDefeated')) then spawnEnemy(s);count+=1 end
        end
    end
    for model,e in E.Active do
        if e.Spawn and e.Spawn.Marker:GetAttribute('Enabled')==false then
            E.Active[model]=nil;e.Spawn.Enemy=nil;model:Destroy();continue
        end
        if not model.Parent or not e.Root.Parent then E.Active[model]=nil;e.Spawn.Enemy=nil;continue end
        if now<(e.BurnUntil or 0) and now-(e.LastBurn or 0)>0.75 and e.BurnOwner then e.LastBurn=now;E.damage(model,e.BurnOwner,5) end
        if e.Hum.Health<=0 then continue end
        e.Hum.WalkSpeed=if now<(e.SlowUntil or 0) then e.Def.Speed*0.5 else e.Def.Speed
        if now-(e.LastPressure or 0)>2 then e.Posture=math.max(0,(e.Posture or 0)-4) end
        model:SetAttribute('Posture',e.Posture or 0)
        if now<(e.StunnedUntil or 0) then e.Pending=nil;e.Swing=nil;e.Hum:MoveTo(e.Root.Position);model:SetAttribute('State','STAGGER');continue end
        local homeDist=(e.Root.Position-e.Home).Magnitude
        if e.Pending and (homeDist>95 or now<(e.StunnedUntil or 0)) then e.Pending=nil end
        if e.Def.Boss and homeDist<=95 then
            local phase=if e.Hum.Health<(e.MaxHealth or e.Def.Health)*0.5 then 2 else 1;model:SetAttribute('Phase',phase)
            if not e.Pending and not e.Swing and nearest(e.Root.Position,45,e.Spawn and e.Spawn.Root) and now-(e.LastSpecial or now-2)>e.SpecialCooldown then
                e.PatternIndex=(e.PatternIndex or 0)+1
                local pattern=Patterns.boss(e.Kind,phase,e.PatternIndex)
                e.LastSpecial=now;e.SpecialCooldown=pattern.Cooldown
                e.Pending={At=now+pattern.Windup,Origin=e.Root.Position,Pattern=pattern}
                if E.OnWarning then E.OnWarning({Kind='Warning',Position=e.Root.Position,Radius=pattern.Radius,InnerRadius=pattern.InnerRadius,Seconds=pattern.Windup,HeightOffset=e.HeightOffset or 3,Name=pattern.Name,Phase=phase}) end
            end
            if e.Pending then
                e.Hum:MoveTo(e.Root.Position);model:SetAttribute('State','WINDUP')
                if now>=e.Pending.At then
                    local pending=e.Pending;e.Pending=nil
                    for _,p in Players:GetPlayers() do
                        local pr=Security.alive(p)
                        local delta=pr and pr.Position-pending.Origin
                        if delta and (not E.CanTarget or E.CanTarget(p,e.Spawn and e.Spawn.Root)) and Patterns.inArea(Vector2.new(delta.X,delta.Z).Magnitude,delta.Y,pending.Pattern) then
                            local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={model}
                            local hit=workspace:Raycast(pending.Origin,pr.Position-pending.Origin,params)
                            if E.OnPlayerHit and (not hit or hit.Instance:IsDescendantOf(p.Character))then E.OnPlayerHit(p,(e.Damage or e.Def.Damage)*pending.Pattern.Multiplier,pending.Origin,e,false)end
                        end
                    end
                end
                continue
            end
        end
        if e.Swing then
            e.Hum:MoveTo(e.Root.Position);model:SetAttribute('State','WINDUP')
            E.resolveSwing(e,now)
            continue
        end
        local player,dist=nearest(e.Root.Position,90,e.Spawn and e.Spawn.Root)
        local homeDist=(e.Root.Position-e.Home).Magnitude
        local target
        if homeDist>95 or not player then
            e.State=if homeDist>8 then 'RETURN' elseif math.floor(now/4)%2==0 then 'IDLE' else 'PATROL'
            target=e.Home+Vector3.new(math.sin(now*0.12)*5,3,math.cos(now*0.12)*5)
        elseif dist<7+(if e.Kind=='Malgorth' then 3 else 0) then
            e.State='ATTACK';e.Hum:MoveTo(e.Root.Position)
            local pRoot=Security.alive(player)
            local rayParams=RaycastParams.new();rayParams.FilterType=Enum.RaycastFilterType.Exclude;rayParams.FilterDescendantsInstances={model}
            local hit=pRoot and workspace:Raycast(e.Root.Position,pRoot.Position-e.Root.Position,rayParams)
            if pRoot and now-e.LastAttack>1.3 and (not hit or hit.Instance:IsDescendantOf(player.Character)) then
                e.LastAttack=now
                local delta=pRoot.Position-e.Root.Position
                e.Swing={Player=player,At=now+(e.Def.Windup or 0.65),Direction=if delta.Magnitude>0.01 then delta.Unit else nil,Range=7+(if e.Kind=='Malgorth' then 3 else 0)}
                if E.OnWarning then E.OnWarning({Kind='MeleeWarning',Position=e.Root.Position,Seconds=e.Def.Windup or 0.65,Name=e.Def.Name,Target=player.UserId}) end
            end
        else e.State='CHASE';local r=Security.alive(player);target=r and r.Position end
        model:SetAttribute('State',e.State)
        if target and e.State~='IDLE' then
            if e.Waypoints and e.PathGoal and (target-e.PathGoal).Magnitude>18 then e.Waypoints=nil end
            pathTo(e,target)
            local points=e.Waypoints
            local wp=points and points[e.Waypoint]
            if wp then
                if (wp.Position-e.Root.Position).Magnitude<5 then e.Waypoint+=1;wp=points[e.Waypoint] end
                if wp then if wp.Action==Enum.PathWaypointAction.Jump then e.Hum.Jump=true end;e.Hum:MoveTo(wp.Position) end
            end
            -- Sem caminho válido não atravessa paredes tentando mover o CFrame.
        end
        if not nearest(e.Home,300,e.Spawn and e.Spawn.Root) then
            E.Active[model]=nil;e.Spawn.Enemy=nil;e.Spawn.Next=now+3;model:Destroy()
        end
    end
    for _,d in workspace:GetChildren() do
        if d.Name=='GeneratedDungeon' and d:FindFirstChild('Traps') then
            for _,trap in d.Traps:GetChildren() do
                local active=math.floor(now/2)%2==0
                trap.Transparency=if active then 0 else 0.7
                if active then
                    for _,p in Players:GetPlayers() do
                        if Security.near(p,trap,7) and Security.allow(p,'trap',1) then if E.OnPlayerHit then E.OnPlayerHit(p,12,trap.Position) end end
                    end
                end
            end
        end
    end
end
function E.clearScope(scope)
    for model,e in E.Active do
        if e.Spawn and e.Spawn.Root==scope then e.Spawn.Enemy=nil;E.Active[model]=nil;model:Destroy() end
    end
end
function E.start()
    if E.Running then return end;E.Running=true
    local last=0
    game:GetService('RunService').Heartbeat:Connect(function()
        local now=os.clock();if now-last<0.03 then return end;last=now
        for _,e in E.Active do if e.Swing then E.resolveSwing(e,now) end end
    end)
    task.spawn(function() while task.wait(0.25) do local ok,err=xpcall(E.step,debug.traceback);if not ok then warn(err) end end end)
end
return E
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">ExpeditionService</string>
            <string name="Source"><![CDATA[local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.DungeonConfig)
local Rules=require(Shared.Core.DungeonRules)
local Data=require(script.Parent.DataService)
local Security=require(script.Parent.AntiExploitService)
local Enemies=require(script.Parent.EnemyService)
local Players=game:GetService('Players')
local X={Run=nil,Participants={},Map=nil,Notice=nil,OnState=nil,OnComplete=nil}
local function tell(p,text)if X.Notice then X.Notice(p,text) end end
function X.floorRoot(part)
 local node=part
 while node and node~=workspace do
  if node:GetAttribute('FloorIndex') and node:GetAttribute('DungeonId') then return node end
  node=node.Parent
 end
end
function X.floor()
 local run=X.Run;local ex=X.Map and X.Map:FindFirstChild('Expeditions')
 local tower=run and ex and ex:FindFirstChild(run.Id)
 return tower and tower:FindFirstChild('Floor'..run.Floor)
end
function X.member(p)
 local r=X.Run
 return r and r.Members[p.UserId] and X.Participants[p.UserId]==p and not r.Eliminated[p.UserId]
end
function X.allowed(p,scope)
 local floor=scope and X.floorRoot(scope)
 if not floor then return not X.member(p) end
 return X.member(p) and floor==X.floor() and (X.Run.State=='Fighting' or X.Run.State=='Cleared')
end
local function deactivate(floor)
 if not floor then return end
 floor:SetAttribute('Active',false)
 for _,m in floor.EnemySpawns:GetChildren() do m:SetAttribute('Enabled',false) end
 Enemies.clearScope(floor)
end
function X.sync()
 local r=X.Run;if not r then return end
 for _,p in X.Participants do
  p:SetAttribute('DungeonName',Config.Dungeons[r.Id].Name);p:SetAttribute('DungeonFloor',r.Floor)
  p:SetAttribute('DungeonFloors',Config.Dungeons[r.Id].Floors);p:SetAttribute('DungeonRemaining',r.Remaining)
  p:SetAttribute('DungeonState',r.State)
  if X.OnState then X.OnState(p) end
 end
end
function X.activate()
 local r=X.Run;local floor=assert(X.floor(),'Expedições ausentes: gere/atualize o segundo Place no editor')
 local expected={}
 for _,marker in floor.EnemySpawns:GetChildren() do
  marker:SetAttribute('Defeated',false);marker:SetAttribute('Enabled',true)
  table.insert(expected,marker:GetAttribute('EnemyId'))
 end
 for _,spawn in Enemies.Spawns do if spawn.Root==floor then spawn.Next=0 end end
 Rules.beginFloor(r,expected);floor:SetAttribute('Active',true);floor:SetAttribute('Cleared',false);floor:SetAttribute('BossDefeated',false)
 Enemies.scan(floor)
 local index=0
 for _,p in X.Participants do
  if X.member(p) and Security.alive(p) then
   p.Character:PivotTo(CFrame.new(floor:GetAttribute('SpawnPosition')+Vector3.new(index*4,0,0)))
   p:SetAttribute('InDungeon',true);index+=1
  end
 end
 X.sync()
end
function X.available(id,map)
 return Config.Dungeons[id]~=nil and map~=nil and map:FindFirstChild('Expeditions')~=nil
end
function X.begin(id,list,map,nonce)
 if X.Run and X.Run.State~='Complete' and X.Run.State~='Failed' then return false,'Já existe uma expedição neste servidor de teste.' end
 if not X.available(id,map) then return false,'Gere as expedições no Place da dungeon primeiro.' end
 local ids={};for _,p in list do table.insert(ids,p.UserId) end
 if #ids<1 or #ids>Config.MaxPlayers then return false,'Grupo inválido.' end
 deactivate(X.floor());X.Participants={};X.Map=map
 X.Run=Rules.newRun(Config,id,ids,nonce,os.time())
 for _,p in list do X.Participants[p.UserId]=p end
 X.activate();return true,'Expedição iniciada: '..Config.Dungeons[id].Name
end
function X.ticket(profile,id,nonce,now,members)
 if not Config.Dungeons[id] then return false,'Dungeon desconhecida.' end
 profile.Expedition.Ticket={Dungeon=id,Run=nonce,Expires=now+Config.TicketSeconds,Members=table.clone(members)}
 return true,'Entrada reservada.'
end
function X.admit(player,map)
 local profile=Data.get(player);local ticket=profile and profile.Expedition.Ticket
 if not ticket then return false,'Sem reserva de expedição. Entre pelo guardião do continente.' end
 if not X.available(ticket.Dungeon,map) or ticket.Expires<os.time() then return false,'Reserva expirada ou mapa ausente.' end
 local r=X.Run
 if not table.find(ticket.Members,player.UserId) then return false,'Reserva não pertence a este jogador.' end
 if r and (r.Nonce~=ticket.Run or r.Id~=ticket.Dungeon or r.State~='Gathering' or not r.Members[player.UserId]) then return false,'Grupo/entrada indisponível; retorne ao continente.' end
 local n=0;for _ in X.Participants do n+=1 end
 if n>=Config.MaxPlayers then return false,'Grupo completo.' end
 local accepted,msg=Data.transaction(player,function(s)
  if not s.Expedition.Ticket or s.Expedition.Ticket.Run~=ticket.Run then return false,'Reserva já consumida.' end
  s.Expedition.Ticket=nil;return true,'Entrada confirmada.'
 end)
 if not accepted then return false,msg end
 r=X.Run -- recheck after persistence yield; arrivals may interleave
 if not r then
  X.Map=map;X.Participants={}
  r=Rules.newRun(Config,ticket.Dungeon,ticket.Members,ticket.Run,os.time());X.Run=r
  r.State='Gathering';r.GatherUntil=os.time()+90
 end
 if r.Nonce~=ticket.Run or r.State~='Gathering' then return false,'Reserva não corresponde ao grupo que chegou.' end
 X.Participants[player.UserId]=player;player:SetAttribute('InDungeon',true)
 local all=true;for uid in r.Members do if not X.Participants[uid] or not Security.alive(X.Participants[uid]) then all=false end end
 if all then X.activate() else X.sync() end
 return true,if all then 'Grupo reunido. Primeiro andar iniciado.' else 'Aguardando o restante do grupo na recepção (até 90 segundos).'
end
function X.killed(enemy)
 local floor=enemy.Spawn and X.floorRoot(enemy.Spawn.Root)
 if not floor or floor~=X.floor() then return end
 if not Rules.kill(X.Run,enemy.Spawn.Marker:GetAttribute('EnemyId')) then return end
 if X.Run.State=='Cleared' then
  floor:SetAttribute('Cleared',true)
  for _,p in X.Participants do
   if X.member(p) and Security.alive(p) then tell(p,'Andar limpo. Reúna o grupo no portal para confirmar o progresso e avançar.') end
  end
 end
 X.sync()
end
function X.advance(player,portal)
 local r=X.Run;local floor=X.floorRoot(portal)
 if not X.member(player) or floor~=X.floor() or r.State~='Cleared' or not Security.near(player,portal,15) then return false,'Derrote todos os guardiões e alcance o portal do andar atual.' end
 -- Serialized before any DataStore yield; a second prompt cannot duplicate the settlement.
 local survivors={}
 for _,p in X.Participants do
  if X.member(p) then
   if not Security.near(p,portal,35) or not Data.get(p) then return false,'Todos os sobreviventes devem estar próximos do portal e com dados disponíveis.' end
   table.insert(survivors,p)
  end
 end
 if #survivors==0 then return false,'Sem sobreviventes.' end
 r.State='Saving';X.sync()
 for _,p in survivors do
  local ok=Data.transaction(p,function(s)
   Rules.reward(s,Config,r.Id,r.Floor)
   if r.Floor==Config.Dungeons[r.Id].Floors and X.OnComplete then X.OnComplete(s,r.Id) end
   return true,'Andar registrado.'
  end)
  if not ok then r.State='Cleared';X.sync();return false,'Progresso não confirmado para todo o grupo. Reconecte o perfil indisponível; não avance com dados incertos.' end
 end
 -- A death/leave during persistence may fail the run; never revive it implicitly.
 if r.State~='Saving' then X.sync();return false,'Expedição interrompida durante o salvamento.' end
 r.State='Cleared';Rules.advance(r,Config);deactivate(floor)
 if r.State=='Complete' then
  for _,p in survivors do tell(p,'Expedição concluída! Use o portal de retorno. Primeira conclusão salva.') end
  X.sync()
 else X.activate() end
 return true,'Progresso do andar confirmado.'
end
function X.canChest(player,model)
 local floor=X.floorRoot(model)
 return floor and X.member(player) and floor==X.floor() and floor:GetAttribute('Cleared')==true
end
function X.eliminate(player)
 local r=X.Run;if not r or not r.Members[player.UserId] then return end
 if Rules.eliminate(r,player.UserId) then deactivate(X.floor()) end
 tell(player,'Você caiu ou deixou a expedição. O melhor andar confirmado foi preservado; uma nova tentativa começa no primeiro andar.')
 X.sync()
end
function X.leave(player)
 X.eliminate(player);X.Participants[player.UserId]=nil
 for _,key in {'DungeonName','DungeonFloor','DungeonFloors','DungeonRemaining','DungeonState'} do player:SetAttribute(key,nil) end
end
function X.step()
 local r=X.Run;if not r or r.State=='Complete' or r.State=='Failed' then return end
 if r.State=='Gathering' and os.time()>=r.GatherUntil then
  r.State='Failed';X.sync()
  for _,p in X.Participants do tell(p,'O grupo não chegou completo. Use o retorno e forme uma nova expedição; nenhuma tentativa paga foi consumida.') end
  return
 end
 if os.time()>=r.Expires then r.State='Failed';deactivate(X.floor());X.sync();for _,p in X.Participants do tell(p,'O prazo da expedição terminou. Use o portal de retorno.') end end
 for _,p in X.Participants do if p.Parent~=Players then X.leave(p) end end
end
return X
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Prompts=game:GetService('ProximityPromptService')
local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.WorldConfig)
local Catalog=require(Shared.Config.ContentConfig)
local Rules=require(Shared.Core.Progression)
local Data=require(script.Parent.DataService)
local Security=require(script.Parent.AntiExploitService)
local Inventory=require(script.Parent.InventoryService)
local Combat=require(script.Parent.CombatService)
local Enemies=require(script.Parent.EnemyService)
local Dungeon=require(script.Parent.DungeonService)
local Abilities=require(Shared.Config.AbilityConfig)
local CombatRules=require(Shared.Core.CombatRules)
local Identity=require(script.Parent.IdentityService)
local Purchase=require(script.Parent.PurchaseService)
local Tester=require(script.Parent.TesterService)
local Expedition=require(script.Parent.ExpeditionService)
local Tutorial=require(script.Parent.TutorialService)
local Siege=require(script.Parent.SiegeService)
local Service={Remote=nil,FX=nil}
function Service.notice(p,text) Service.Remote:FireClient(p,{Type='Notice',Text=text}) end
function Service.state(p)
    local s=Data.get(p)
    if s then
        p:SetAttribute('ProfileStatus','Ready')
        Identity.syncClass(s)
        local public=table.clone(s.Identity);public.Receipts=nil
        local copy={Adventure=s.Adventure,Expedition={Best=s.Expedition.Best,Clears=s.Expedition.Clears},StarterChosen=s.StarterChosen,Armor=s.Armor,TesterAllowed=Tester.allowed(),Identity=public,ServerTime=os.time(),Purchases={RacialRetry=Purchase.available('RacialRetry'),BasicPack=Purchase.available('BasicPack'),PremiumPack=Purchase.available('PremiumPack')},Gold=s.Gold,XP=s.XP,Rank=s.Rank,Class=s.Class,Equipment=s.Equipment,Unlocks=s.Unlocks,Inventory=s.Inventory,Quests=s.Quests,Spawn=s.Spawn,Persistent=Data.Persistent}
        Service.Remote:FireClient(p,{Type='State',State=copy,Party=Dungeon.status(p)})
    elseif Data.Sessions[p] and Data.Sessions[p].Frozen then
        p:SetAttribute('ProfileStatus','Unavailable')
    end
end
local function owned(part)
    local cursor=part
    while cursor and cursor~=workspace do
        if (cursor.Name=='GeneratedWorld' or cursor.Name=='GeneratedDungeon') and cursor:GetAttribute('ProjectId')=='ProjectMedievalRPG' then return cursor end
        cursor=cursor.Parent
    end
    return nil
end
function Service.dialogue(p,part,role,city)
    local d=Catalog.Dialogue[role] or Catalog.Dialogue.Citizen
    Security.open(p,part,role,city)
    local localText=Catalog.CityDialogue[city] and Catalog.CityDialogue[city][role] or d.Text
    local npc=part:FindFirstAncestorOfClass('Model')
    if npc and npc:GetAttribute('LocalDialogue') then localText=npc:GetAttribute('LocalDialogue') end
    Service.Remote:FireClient(p,{Type='Dialogue',Role=role,City=city,Name=npc and npc:GetAttribute('DisplayTitle') or d.Name,Text='['..city..'] '..localText,Items=Catalog.Shops[role],Party=Dungeon.status(p)})
    Service.state(p)
end
function Service.prompt(prompt,p)
    local part=prompt.Parent
    if not part or not part:IsA('BasePart') or not owned(part) or not Security.near(p,part,15) or not Security.allow(p,'prompt',0.3) then return end
    local state=Data.get(p)
    if not state then Service.notice(p,'Perfil indisponível; aguarde ou reconecte.');return end
    if owned(part).Name=='GeneratedDungeon' and state.Rank=='' and not part:GetAttribute('ReturnPortal') then Service.notice(p,'A dungeon exige registro na guilda.');return end
    local model=part:FindFirstAncestorOfClass('Model')
    if model and model:GetAttribute('NpcId') then
        local role=model:GetAttribute('Role')
        Identity.event(state,'Talk:'..(model:GetAttribute('City') or '')..':'..role)
        if role=='Mage' then Identity.event(state,'Mage') end
        Rules.event(state,Catalog,'Talk:'..(model:GetAttribute('City') or '')..':'..role,1)
        if role=='Mage' then Rules.event(state,Catalog,'Mage',1) end
        Service.dialogue(p,part,role,model:GetAttribute('City') or 'Região')
    elseif model and model:GetAttribute('ChestId') then
        if model:GetAttribute('FloorLocked') and not Expedition.canChest(p,model) then Service.notice(p,'Limpe o andar atual da sua expedição antes de abrir o baú.');return end
        local dungeon=owned(part)
        if model:GetAttribute('BossLocked') and not dungeon:GetAttribute('BossDefeated') then Service.notice(p,'Derrote Malgorth para abrir este baú.');return end
        local ok,msg=Rules.chest(state,Catalog,model:GetAttribute('ChestId'),model:GetAttribute('Rarity'))
        Service.notice(p,msg)
        if ok then Service.FX:FireClient(p,{Kind='Chest',Position=part.Position}) end
    elseif part:GetAttribute('ExpeditionNext') then
        local _,msg=Expedition.advance(p,part);Service.notice(p,msg)
    elseif part:GetAttribute('QuestBoard') then Service.dialogue(p,part,'Quest', 'Quadro de avisos')
    elseif part:GetAttribute('Objective') then
        Identity.event(state,part:GetAttribute('Objective'))
        if part:GetAttribute('Objective')=='Ruins' then
            local region=part:FindFirstAncestorOfClass('Model')
            if region and Identity.discover(state,region.Name) then Service.notice(p,'Uma história secreta foi descoberta. Veja sua árvore de evolução.') end
        end
        Rules.event(state,Catalog,part:GetAttribute('Objective'),1);Service.notice(p,'Objetivo investigado. Consulte suas missões.')
    elseif part:GetAttribute('ReturnPortal') then
        local _,msg=Dungeon.returnPlayer(p);Service.notice(p,msg)
    end
    Service.state(p)
end
function Service.action(p,action,value)
    if action=='Control' then
        if type(value)=='string' and ({BlockOn=true,BlockOff=true,RunOn=true,RunOff=true,Dodge=true})[value] and Security.allow(p,'control:'..value,0.05) then Combat.control(p,value) end
        return
    end
    if type(action)~='string' or #action>30 or not Security.allow(p,'remote',0.1) then return end
    if action=='TesterPreview' then
        if type(value)~='string' or #value>30 then return end
        local result,msg=Tester.preview(p,value)
        if result then Service.Remote:FireClient(p,{Type='Preview',Preview=result})else Service.notice(p,msg)end
        return
    end
    if action=='Hello' then Service.state(p);return end
    local state=Data.get(p)
    if not state then return end
    if action=='Attack' then
        if type(value)=='table' and type(value.Mode)=='string' and #value.Mode<=50 then Combat.attack(p,value.Target,value.Mode) end
        return
    end
    if action=='Control' and type(value)=='string' then Combat.control(p,value);return end
    if value~=nil and type(value)~='string' and type(value)~='number' then return end
    if type(value)=='string' and #value>80 then return end
    local context=Security.context(p)
    local ok,msg=false,'Converse novamente com o NPC.'
    if action=='TutorialInventory' then
        Tutorial.event(p,'Inventory');return -- records presentation only; grants no XP/Gold/items
    elseif action=='CreateCharacter' and Security.alive(p) then
        if table.find({'Longsword','Katana','Staff','Bow'},value) then
            ok,msg=Rules.choose(state,Catalog,value)
            if ok then Inventory.sync(p,state,Combat);Tutorial.event(p,'Weapon') end
        end
    elseif ({RacialStart=true,RacialClaim=true,ClassStart=true,ClassClaim=true,ClassSelect=true,FusionGold=true,Fuse=true,Purchase=true})[action] then
        ok,msg=Identity.action(p,action,value)
        if ok then
            local fresh=Data.get(p)
            if fresh then
                if action=='ClassSelect' then Inventory.sync(p,fresh,Combat);Combat.changeClass(p) end
                if action=='RacialClaim' then Identity.appearance(p) end
            end
        end
    elseif action=='Potion' then
        local hum=p.Character and p.Character:FindFirstChildOfClass('Humanoid')
        if hum and hum.Health>0 and hum.Health<hum.MaxHealth and (state.Inventory.Potion or 0)>0 and Security.allow(p,'potion',2) then
            state.Inventory.Potion-=1;hum.Health=math.min(hum.MaxHealth,hum.Health+50);ok,msg=true,'Vida recuperada.'
        else msg='Sem poção ou vida já completa.' end
    elseif action=='UnequipArmor' then state.Armor='';Inventory.sync(p,state,Combat);ok,msg=true,'Armadura guardada.'
    elseif action=='Unequip' then state.Equipment='';Inventory.sync(p,state,Combat);ok,msg=true,'Arma guardada.'
    elseif action=='Equip' then
        local item=Catalog.Items[value]
        if item and (state.Inventory[value] or 0)>0 then
            if item.Kind=='Armor' then state.Armor=value;Inventory.sync(p,state,Combat);ok,msg=true,'Armadura equipada.'
            elseif item.Kind=='Weapon' and (state.Class=='' or Abilities.Classes[state.Class] and Abilities.Classes[state.Class].Weapon==value) then
                state.Equipment=value;Inventory.sync(p,state,Combat);ok,msg=true,'Equipado.'
            else msg='Este equipamento não corresponde à sua classe.' end
        end
    elseif context then
        local role=context.Role
        if action=='Learn' and (role=='ShopMagic' or role=='Equipment' or role=='Mage') then ok,msg=CombatRules.unlock(state,value,Abilities)
        elseif action=='Sell' and role=='Merchant' then ok,msg=Rules.sell(state,Catalog,value);if ok then Inventory.sync(p,state,Combat) end
        elseif action=='Buy' then ok,msg=Rules.buy(state,Catalog,value,role);if ok then Inventory.sync(p,state,Combat) end
        elseif action=='Choose' and role=='Equipment' then ok,msg=Rules.choose(state,Catalog,value);if ok then Inventory.sync(p,state,Combat) end
        elseif action=='Register' and role=='Guild' then ok,msg=Rules.register(state)
        elseif action=='Accept' and (role=='Guild' or role=='Quest') then ok,msg=Rules.accept(state,Catalog,value)
        elseif action=='Claim' and role=='Guild' then ok,msg=Rules.claimQuest(state,Catalog,value)
        elseif action=='Inn' and role=='Inn' then
            for _,city in Config.Cities do if city.Id==context.City then state.Spawn=city.Id;ok,msg=true,'Hospedaria registrada.' end end
        elseif action=='Heal' and role=='Healer' then
            local hum=p.Character and p.Character:FindFirstChildOfClass('Humanoid')
            if hum and hum.Health>0 then hum.Health=hum.MaxHealth;ok,msg=true,'Feridas curadas.' end
        elseif string.sub(action,1,7)=='Dungeon' and role=='Dungeon' then ok,msg=Dungeon.action(p,string.sub(action,8),if type(value)=='number' then value else nil)
        end
    end
    if ok then local fresh=Data.get(p);if fresh then fresh.Revision+=1 end end
    Service.notice(p,msg);Service.state(p)
end
local function character(p,char)
    local root=char:WaitForChild('HumanoidRootPart',10)
    if not root then return end
    local deadline=os.clock()+15
    while not Data.get(p) and os.clock()<deadline do task.wait(0.1) end
    local s=Data.get(p)
    if not s then return end
    local dungeon=workspace:FindFirstChild('GeneratedDungeon')
    local world=workspace:FindFirstChild('GeneratedWorld')
    if world and world:GetAttribute('Status')=='Complete' then
        if Expedition.Run and Expedition.Run.Eliminated[p.UserId] then Expedition.leave(p) end
        for _,city in Config.Cities do
            if city.Id==s.Spawn then char:PivotTo(CFrame.new(city.X,city.Height+6,city.Z));break end
        end
        p:SetAttribute('InDungeon',false)
    elseif dungeon and dungeon:GetAttribute('Status')=='Complete' then
        if game:GetService('RunService'):IsStudio() and Config.StudioDungeonTest and not Data.Persistent and s.Equipment=='' then
            Rules.register(s);Rules.choose(s,Catalog,'Staff');s.Inventory.Potion=5;s.Inventory.Armor=1;s.Armor='Armor'
            Service.notice(p,'TESTE STUDIO da dungeon: kit volátil de cajado, couraça e cinco poções. Nada será salvo.')
        end
        char:PivotTo(CFrame.new(dungeon:GetAttribute('SpawnPosition')));p:SetAttribute('InDungeon',true)
        if s.Expedition and s.Expedition.Ticket then
            local admitted,msg=Expedition.admit(p,dungeon);Service.notice(p,msg)
            s=Data.get(p);if not admitted and not s then return end
        elseif Expedition.Run and Expedition.Run.Eliminated[p.UserId] then Expedition.leave(p) end
    else Service.notice(p,'Mapa ausente: pare Play e gere pelo Command Bar no editor.') end
    Combat.clear(p)
    Identity.appearance(p)
    local mortality=char:FindFirstChildOfClass('Humanoid')
    if mortality then mortality.Died:Connect(function()
        Combat.clear(p);Expedition.eliminate(p);Data.noteDeath(p);Service.state(p)
    end) end
    Inventory.sync(p,s,Combat)
    local hum=char:FindFirstChildOfClass('Humanoid');if hum then hum.Health=hum.MaxHealth end
    Service.state(p)
end
function Service.start(remote,fx)
    require(script.Parent.ProjectileService).start(fx)
    Service.Remote,Service.FX=remote,fx;Combat.FX=fx;Dungeon.Notice=Service.notice
    Tutorial.OnState=Service.state;Combat.OnAction=Tutorial.event
    Expedition.Notice=Service.notice;Expedition.OnState=Service.state
    Expedition.OnComplete=function(profile,id)Rules.event(profile,Catalog,'Dungeon:'..id,1)end
    Siege.Notice=Service.notice;Siege.OnState=Service.state
    Enemies.CanTarget=Expedition.allowed
    Dungeon.OnDungeonReady=function(map) Enemies.scan(map) end
    Purchase.OnGrant=Service.state
    Purchase.OnPending=function(p) Service.notice(p,'Compra pendente de gravação; não compre novamente. A plataforma tentará entregar o mesmo recibo. Reconecte se o perfil ficar bloqueado.') end
    Purchase.start()
    Enemies.OnKill=function(e)
        Expedition.killed(e)
        for p,damage in e.Contributors do
            local state=Data.get(p)
            if state and damage>0 and Security.near(p,e.Root,130) then
                state.Gold=math.min(1000000000,state.Gold+e.Def.Reward);state.XP=math.min(1000000000,state.XP+e.Def.XP)
                Rules.grantItem(state,Catalog,'Ore')
                Identity.event(state,e.Kind)
                Identity.fragments(state,e.Kind,e.Spawn.Root)
                Rules.event(state,Catalog,e.Kind,1);Service.state(p)
            end
        end
        Siege.killed(e)
    end
    remote.OnServerEvent:Connect(function(p,a,v)
        local ok,err=xpcall(function() Service.action(p,a,v) end,debug.traceback)
        if not ok then warn(err);Service.notice(p,'Não foi possível concluir a ação; consulte Output.') end
    end)
    Prompts.PromptTriggered:Connect(function(prompt,p)
        local ok,err=xpcall(function() Service.prompt(prompt,p) end,debug.traceback)
        if not ok then warn(err) end
    end)
    local function add(p)
        p:SetAttribute('ProfileStatus','Loading')
        p.CharacterAdded:Connect(function(char) character(p,char) end)
        task.spawn(function()
            local ok,msg=Data.load(p)
            if p.Parent==Players then p:SetAttribute('ProfileStatus',if ok then 'Ready' else 'Unavailable');Service.notice(p,msg);if ok then Service.state(p) end end
        end)
        if p.Character then task.spawn(character,p,p.Character) end
    end
    Players.PlayerAdded:Connect(add)
    Players.PlayerRemoving:Connect(function(p) Combat.clear(p);Expedition.leave(p);Tutorial.clear(p);Dungeon.leave(p,true);Security.clear(p);Data.remove(p) end)
    for _,p in Players:GetPlayers() do add(p) end
    for _,name in {'GeneratedWorld','GeneratedDungeon'} do local r=workspace:FindFirstChild(name);if r then Enemies.scan(r) end end
    Enemies.OnWarning=function(data)fx:FireAllClients(data)end
    Enemies.OnPlayerHit=Combat.hurt
    task.spawn(function()
        while task.wait(0.25) do
            Combat.tick(0.25)
            Expedition.step();Siege.step()
            for _,p in Players:GetPlayers() do
                local state=Data.get(p);local root=Security.alive(p)
                if state and root then
                    Tutorial.step(p)
                    if Identity.refresh(state) then Data.save(p,false);Service.state(p) end
                    for _,list in {Config.Cities,Config.Forests} do for _,region in list do
                        if (Vector2.new(root.Position.X,root.Position.Z)-Vector2.new(region.X,region.Z)).Magnitude<region.Radius then local identityChanged=Identity.event(state,'Visit:'..region.Id);if Rules.event(state,Catalog,'Visit:'..region.Id,1) or identityChanged then Service.state(p) end end
                    end end
                elseif Data.Sessions[p] and Data.Sessions[p].Frozen then p:SetAttribute('ProfileStatus','Unavailable') end
            end
        end
    end)
    Data.start();Dungeon.start();Enemies.start()
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">IdentityService</string>
            <string name="Source"><![CDATA[local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.IdentityConfig)
local Rules=require(Shared.Core.IdentityRules)
local Stats=require(Shared.Core.CombatRules)
local Abilities=require(Shared.Config.AbilityConfig)
local Data=require(script.Parent.DataService)
local Purchase=require(script.Parent.PurchaseService)
local Security=require(script.Parent.AntiExploitService)
local Service={}
function Service.refresh(profile)
 local before=profile.Identity.Racial.Status
 Rules.refresh(profile,Config,os.time())
 return before~=profile.Identity.Racial.Status
end
function Service.event(profile,event)
 return Rules.event(profile,Config,event,os.time())
end
function Service.discover(profile,region)
 local found=false
 for id,secret in Config.Secrets do if secret.Region==region then found=Rules.discover(profile,Config,id) or found end end
 return found
end
function Service.action(player,action,value)
 local p=Data.get(player);if not Security.alive(player) then return false,'Personagem precisa estar vivo.' end
 if not p or p.Identity.Race=='' then return false,'Identidade requer persistência confirmada.' end
 if not Security.allow(player,'identityAction',1) then return false,'Aguarde antes de outra operação de identidade.' end
 local now=os.time()
 if action=='Purchase' then return Purchase.prompt(player,value) end
 return Data.changeIdentity(player,function(profile)
    local level=Stats.level(profile.XP,Abilities)
    if action=='RacialStart' then return Rules.startRacial(profile,Config,level,now)
    elseif action=='RacialClaim' then return Rules.claimRacial(profile,Config,now)
    elseif action=='ClassStart' then return Rules.startClass(profile,Config,value,level)
    elseif action=='ClassClaim' then return Rules.claimClass(profile,Config,value)
    elseif action=='ClassSelect' then return Rules.selectClass(profile,Config,value)
    elseif action=='FusionGold' then return Rules.buyFusion(profile,Config,value)
    elseif action=='Fuse' then return Rules.fuse(profile,Config,value,now) end
    return false,'Ação de identidade inválida.'
 end)
end

function Service.syncClass(profile)
 for _,id in {'Guerreiro','Espadachim','Mago','Arqueiro'} do if profile.Class==id then profile.Identity.Classes[id]=true end end
 profile.Identity.CurrentClass=profile.Class
end
function Service.fragments(profile,enemy,root)
 local cursor=root;local valid=false
 while cursor and cursor~=workspace do
  if cursor.Name=='GeneratedDungeon' and cursor:GetAttribute('ProjectId')=='ProjectMedievalRPG' then valid=true;break end
  cursor=cursor.Parent
 end
 if not valid then return end
 local amount=Config.DungeonFragments[enemy]
 if amount then profile.Identity.Fragments=math.min(1000000,profile.Identity.Fragments+amount) end
end
function Service.appearance(player)
 local p=Data.get(player);local char=player.Character;local race=p and Config.Races[p.Identity.Race]
 if not char or not race then return end
 local old=char:FindFirstChild('MedievalRaceAppearance');if old then old:Destroy() end
 local head=char:FindFirstChild('Head');if not head then return end
 local folder=Instance.new('Folder');folder.Name='MedievalRaceAppearance';folder.Parent=char
 local color=Color3.fromRGB(table.unpack(race.Color))
 local function piece(name,size,cf)
  local part=Instance.new('Part');part.Name=name;part.Size=size;part.CFrame=head.CFrame*cf;part.Color=color
  part.Material=Enum.Material.SmoothPlastic;part.Massless=true;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.Parent=folder
  local weld=Instance.new('WeldConstraint');weld.Part0=head;weld.Part1=part;weld.Parent=part
 end
 if race.Shape=='Ears' or race.Shape=='DarkEars' then
  for _,side in {-1,1} do piece('Ear',Vector3.new(0.7,0.3,0.35),CFrame.new(side*1.1,0,0)*CFrame.Angles(0,0,side*0.3)) end
 elseif race.Shape=='Horns' then
  for _,side in {-1,1} do piece('Horn',Vector3.new(0.25,1.1,0.25),CFrame.new(side*0.65,0.8,0)*CFrame.Angles(0,0,-side*0.3)) end
 elseif race.Shape=='Halo' then
  for i=1,8 do local a=i*math.pi/4;piece('Halo',Vector3.new(0.5,0.12,0.15),CFrame.new(math.sin(a)*0.8,1,math.cos(a)*0.8)*CFrame.Angles(0,a,0)) end
 else piece('Crest',Vector3.new(0.35,0.35,0.12),CFrame.new(0,0.3,-0.6)) end
 if p.Identity.Evolution~='' then piece('EvolvedSigil',Vector3.new(0.2,0.65,0.2),CFrame.new(0,1.5,0)) end
 char:SetAttribute('OriginalRace',p.Identity.Race);char:SetAttribute('RaceEvolution',p.Identity.Evolution)
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[local Shared=game.ReplicatedStorage.MedievalRPG
local Catalog=require(Shared.Config.ContentConfig)
local Stats=require(Shared.Core.CombatRules)
local Abilities=require(Shared.Config.AbilityConfig)
local I={}
function I.tool(player,id,combat)
    local item=Catalog.Items[id]
    if not item or item.Kind~='Weapon' then return end
    local tool=Instance.new('Tool');tool.Name=item.Name;tool:SetAttribute('ItemId',id);tool.CanBeDropped=false
    local function piece(name,size,cf,color)
        local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=cf;p.CanCollide=false;p.CanTouch=false;p.Massless=true
        p.Color=color;p.Material=Enum.Material.Metal;p.Parent=tool;return p
    end
    local handle=piece('Handle',Vector3.new(0.4,1.4,0.4),CFrame.identity,Color3.fromRGB(91,59,39))
    local blade=piece('Blade',if id=='Staff' then Vector3.new(0.5,5,0.5) elseif id=='Bow' then Vector3.new(0.3,4,0.4) else Vector3.new(0.45,4,0.2),CFrame.new(0,2.2,0),Color3.fromRGB(192,207,220))
    if id=='Staff' then blade.Color=Color3.fromRGB(129,100,222);blade.Material=Enum.Material.Neon end
    if id=='Bow' then blade.Color=Color3.fromRGB(114,74,43);blade.Material=Enum.Material.Wood end
    local weld=Instance.new('WeldConstraint');weld.Part0=handle;weld.Part1=blade;weld.Parent=blade
    if id=='Katana' or id=='Longsword' then
        local guard=piece('Guard',Vector3.new(1.5,0.2,0.4),CFrame.new(0,0.8,0),Color3.fromRGB(199,164,71))
        local w=Instance.new('WeldConstraint');w.Part0=handle;w.Part1=guard;w.Parent=guard
    elseif id=='Bow' then
        local stringPart=piece('BowString',Vector3.new(0.05,4,0.05),CFrame.new(0,1.5,-0.8),Color3.fromRGB(224,213,181))
        local w=Instance.new('WeldConstraint');w.Part0=handle;w.Part1=stringPart;w.Parent=stringPart
    end
    tool.Grip=CFrame.Angles(0,0,0)
    tool.Parent=player:FindFirstChildOfClass('Backpack')
    return tool
end
function I.sync(player,state,combat)
    for _,container in {player:FindFirstChildOfClass('Backpack'),player.Character} do
        if container then
            for _,child in container:GetChildren() do if child:IsA('Tool') and child:GetAttribute('ItemId') then child:Destroy() end end
        end
    end
    local hum=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
    if state.Equipment~='' and (state.Inventory[state.Equipment] or 0)>0 then
        local tool=I.tool(player,state.Equipment,combat)
        if tool and tool.Parent and hum and hum.Health>0 then hum:EquipTool(tool) end
    end
    local char=player.Character
    if char then
        local old=char:FindFirstChild('MedievalArmor');if old then old:Destroy() end
        local torso=char:FindFirstChild('UpperTorso') or char:FindFirstChild('Torso')
        if torso and state.Armor=='Armor' and (state.Inventory.Armor or 0)>0 then
            local plate=Instance.new('Part');plate.Name='MedievalArmor';plate.Size=Vector3.new(torso.Size.X*0.95,torso.Size.Y*0.85,0.25)
            plate.CFrame=torso.CFrame*CFrame.new(0,0,-torso.Size.Z/2-0.1);plate.Color=Color3.fromRGB(116,132,151);plate.Material=Enum.Material.Metal
            plate.Massless=true;plate.CanCollide=false;plate.CanTouch=false;plate.CanQuery=false;plate.Parent=char
            local weld=Instance.new('WeldConstraint');weld.Part0=torso;weld.Part1=plate;weld.Parent=plate
        end
    end
    if hum then hum.MaxHealth=Stats.stats(state,Abilities).Health;hum.Health=math.min(hum.Health,hum.MaxHealth) end
end
return I
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">ProjectileService</string>
            <string name="Source"><![CDATA[-- No physical Parts on server. Swept rays are authoritative; clients render only visuals.
local RunService=game:GetService('RunService')
local Math=require(game.ReplicatedStorage.MedievalRPG.Core.ActionMath)
local P={Active={},Count=0,ByOwner={},Serial=0,Effects=nil,Started=false}
function P.available(owner)return P.Count<64 and (P.ByOwner[owner] or 0)<4 end
function P.finish(id,shot)
 if not P.Active[id] then return end
 P.Active[id]=nil;P.Count-=1;P.ByOwner[shot.Owner]=math.max(0,(P.ByOwner[shot.Owner] or 1)-1)
 if P.Effects then P.Effects:FireAllClients({Kind='ProjectileEnd',Id=id,Position=shot.Position})end
end
function P.cancel(owner)
 for id,shot in P.Active do if shot.Owner==owner then P.finish(id,shot)end end
 P.ByOwner[owner]=nil
end
function P.launch(owner,origin,direction,speed,range,style,valid,impact)
 if not P.available(owner)then return false end
 if direction.Magnitude<0.99 or direction.Magnitude>1.01 then return false end
 P.Serial+=1;local id=P.Serial
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={owner.Character}
 local shot={Owner=owner,Position=origin,Direction=direction,Speed=speed,Remaining=range,Params=params,Valid=valid,Impact=impact}
 P.Active[id]=shot;P.Count+=1;P.ByOwner[owner]=(P.ByOwner[owner] or 0)+1
 if P.Effects then P.Effects:FireAllClients({Kind='Projectile',Id=id,Origin=origin,Direction=direction,Speed=speed,Range=range,Style=style})end
 return true
end
function P.step(dt)
 for id,s in P.Active do
  if not s.Valid()then P.finish(id,s);continue end
  local travel=Math.travel(s.Speed,s.Remaining,dt)
  local delta=s.Direction*travel
  local hit=workspace:Raycast(s.Position,delta,s.Params)
  if hit then
   s.Position=hit.Position;P.finish(id,s)
   local ok,err=xpcall(function()s.Impact(hit.Position,hit.Instance)end,debug.traceback)
   if not ok then warn(err)end
  else s.Position+=delta;s.Remaining-=travel;if s.Remaining<=0 then P.finish(id,s)end end
 end
end
function P.start(effects)
 P.Effects=effects;if P.Started then return end;P.Started=true
 RunService.Heartbeat:Connect(P.step)
end
return P
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[-- Único ProcessReceipt da Experience. Ambos os Places usam o mesmo perfil/ledger.
local Market=game:GetService('MarketplaceService')
local Players=game:GetService('Players')
local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.IdentityConfig)
local Rules=require(Shared.Core.IdentityRules)
local Data=require(script.Parent.DataService)
local Purchase={OnGrant=nil,OnPending=nil}
function Purchase.available(key)
 local p=Config.Products[key]
 return p~=nil and p.Id>0 and Data.Persistent and (key=='RacialRetry' or next(Config.Fusion.Recipes)~=nil)
end
function Purchase.prompt(player,key)
 local profile=Data.get(player);local p=Config.Products[key]
 if not profile or not Purchase.available(key) then return false,'Compra desativada: produto real e catálogo devem estar configurados.' end
 if key=='RacialRetry' then
  Rules.refresh(profile,Config,os.time())
  if profile.Identity.Racial.Status~='Failed' or os.time()>=profile.Identity.Racial.ReadyAt or profile.Identity.RetryCredits>0 then return false,'Nova tentativa paga não é necessária.' end
 end
 local receiptCount=0;for _ in profile.Identity.Receipts do receiptCount+=1 end
 if receiptCount>=1024 then return false,'Novas compras pausadas; o histórico precisa de manutenção segura.' end
 local ok,info=pcall(function() return Market:GetProductInfoAsync(p.Id,Enum.InfoType.Product) end)
 if not ok or not info.IsForSale or info.PriceInRobux~=p.Robux then return false,'Produto/preço oficial não corresponde à configuração. Nenhuma compra aberta.' end
 local prompted=pcall(function() Market:PromptProductPurchase(player,p.Id) end)
 return prompted,if prompted then 'Confirme somente na janela oficial Roblox.' else 'Não foi possível abrir a compra.'
end
function Purchase.process(receipt)
 local pending=Enum.ProductPurchaseDecision.NotProcessedYet
 if type(receipt)~='table' or type(receipt.PurchaseId)~='string' or #receipt.PurchaseId<1 or #receipt.PurchaseId>200 then return pending end
 local known=false
 for _,p in Config.Products do if p.Id>0 and p.Id==receipt.ProductId then known=true end end
 if not known then return pending end
 local player=Players:GetPlayerByUserId(receipt.PlayerId)
 if not player then return pending end
 if not Data.receipt(player,receipt.PurchaseId,receipt.ProductId) then
    if Purchase.OnPending then Purchase.OnPending(player) end
    return pending
 end
 if Purchase.OnGrant then Purchase.OnGrant(player) end
 return Enum.ProductPurchaseDecision.PurchaseGranted
end
function Purchase.start()
 Rules.validate(Config)
 Market.ProcessReceipt=Purchase.process
end
return Purchase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">SiegeService</string>
            <string name="Source"><![CDATA[-- One bounded defense event per server, only near an occupied city frontier.
local Players=game:GetService('Players')
local Shared=game.ReplicatedStorage.MedievalRPG
local World=require(Shared.Config.WorldConfig)
local Config=require(Shared.Config.AdventureConfig).DefenseEvent
local Data=require(script.Parent.DataService)
local Security=require(script.Parent.AntiExploitService)
local Progress=require(Shared.Core.Progression)
local Catalog=require(Shared.Config.ContentConfig)
local E={Current=nil,Next=0,Notice=nil,OnState=nil}
function E.step()
 local now=os.time();local event=E.Current
 if event then
  if now>=event.Expires then
   for _,m in event.Markers do m:SetAttribute('Enabled',false) end
   for _,p in Players:GetPlayers() do if E.Notice then E.Notice(p,'A defesa de '..event.City..' terminou. A próxima convocação chegará pelos sinos.') end end
   E.Current=nil
  end
  return
 end
 if now<E.Next then return end
 local map=workspace:FindFirstChild('GeneratedWorld')
 if not map or map:GetAttribute('Status')~='Complete' then return end
 local choice,markers
 for _,city in {'Valoria','Arkheim'} do
  local found={}
  for _,marker in map.EnemySpawns:GetChildren() do if marker:GetAttribute('DefenseCity')==city then table.insert(found,marker) end end
  if #found>0 then for _,p in Players:GetPlayers() do
   if Data.get(p) and Security.near(p,found[1],Config.Radius) then choice=city;markers=found;break end
  end end
  if choice then break end
 end
 if not choice then return end
 E.Next=now+Config.Interval
 E.Current={City=choice,Markers=markers,Remaining=#markers,Kills={},Contributors={},Expires=now+Config.Duration,Id=now}
 for _,m in markers do m:SetAttribute('Defeated',false);m:SetAttribute('Enabled',true) end
 for _,p in Players:GetPlayers() do if Security.near(p,markers[1],Config.Radius) and E.Notice then E.Notice(p,'Sinos de '..choice..': derrote cinco invasores junto ao estandarte em quatro minutos!') end end
end
function E.killed(enemy)
 local event=E.Current;local marker=enemy.Spawn and enemy.Spawn.Marker
 if not event or not marker or marker:GetAttribute('DefenseCity')~=event.City or not table.find(event.Markers,marker) or event.Kills[marker] then return end
 event.Kills[marker]=true;event.Remaining-=1
 for p,damage in enemy.Contributors do if damage>0 and Security.near(p,enemy.Root,Config.Radius) then event.Contributors[p]=true end end
 if event.Remaining~=0 then return end
 E.Current=nil -- settle exactly once, before yielding for persistence
 for _,m in event.Markers do m:SetAttribute('Enabled',false) end
 for p in event.Contributors do
  if Data.get(p) then
   local ok=Data.transaction(p,function(s)
    local claims=s.Adventure.DefenseClaims
    if (claims[event.City] or 0)>=event.Id then return false,'Defesa já recompensada.' end
    claims[event.City]=event.Id
    s.Gold=math.min(1e9,s.Gold+Config.Gold);s.XP=math.min(1e9,s.XP+Config.XP)
    Progress.event(s,Catalog,'Defense:'..event.City,1)
    return true,'Defesa concluída.'
   end)
   if E.Notice then E.Notice(p,if ok then 'Cidade defendida: +80 Gold e +100 XP. Consulte sua missão.' else 'A recompensa da defesa não foi confirmada; perfil indisponível.') end
   if E.OnState then E.OnState(p) end
  end
 end
end
return E
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">TesterService</string>
            <string name="Source"><![CDATA[local Run=game:GetService('RunService')
local Shared=game.ReplicatedStorage.MedievalRPG
local Settings=require(Shared.Config.WorldConfig)
local Config=require(Shared.Config.IdentityConfig)
local Preview=require(Shared.Core.BenefitPreview)
local Data=require(script.Parent.DataService)
local T={}
function T.allowed()return Run:IsStudio() and Settings.EnableStudioTester==true and not Data.Persistent end
function T.preview(player,key)
 if not T.allowed()then return nil,'Tester permitido somente no Studio, opt-in e sem persistência.' end
 local profile=Data.get(player);if not profile then return nil,'Perfil indisponível.' end
 return Preview.report(profile,Config,key)
end
return T
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.AdventureConfig)
local Rules=require(Shared.Core.AdventureRules)
local Data=require(script.Parent.DataService)
local Security=require(script.Parent.AntiExploitService)
local T={Origins={},OnState=nil}
function T.event(player,event)
 local profile=Data.get(player)
 if profile and Rules.event(profile,Config,event) and T.OnState then T.OnState(player) end
end
function T.step(player)
 local root=Security.alive(player);local s=Data.get(player)
 if not root or not s then return end
 if not T.Origins[player] then T.Origins[player]=root.Position end
 if (root.Position-T.Origins[player]).Magnitude>=12 then T.event(player,'Move') end
 if s.StarterChosen then T.event(player,'Weapon') end
 if s.Rank~='' then T.event(player,'Guild') end
 if s.Quests.FirstSteps and s.Quests.FirstSteps.Claimed then T.event(player,'Quest') end
end
function T.clear(player)T.Origins[player]=nil end
return T
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="40">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="StringValue" referent="41">
      <Properties>
        <string name="Name">MedievalPlaceKind</string>
        <string name="Value">World</string>
      </Properties>
    </Item>
    <Item class="Folder" referent="42">
      <Properties>
        <string name="Name">MedievalWorldgen</string>
      </Properties>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">BuildingGenerator</string>
          <string name="Source"><![CDATA[local G=require(script.Parent.Geometry)
local Catalog=require(game.ReplicatedStorage.MedievalRPG.Config.ContentConfig)
local Interiors=require(game.ReplicatedStorage.MedievalRPG.Core.InteriorPlan)
local B={}
local palette={Valoria=Color3.fromRGB(144,65,45),Arkheim=Color3.fromRGB(63,88,123),Eldoria=Color3.fromRGB(72,121,91),Durakh=Color3.fromRGB(136,94,56),Asterion=Color3.fromRGB(67,88,147)}
function B.build(parent,lot,city,index)
    local kind=lot.Kind
    local m=G.model(parent,lot.Id); m:SetAttribute('Template',kind)
    local cf=CFrame.new(lot.X,lot.H,lot.Z)*CFrame.Angles(0,lot.Yaw,0)
    local roofColor=palette[city] or G.Palette.Roof
    local width,depth,height=26+(index%3)*2,28+(index%2)*2,16+(index%3)*2
    if kind=='Castle' then width,depth,height=44,40,26 end
    if kind=='ArcaneTower' then width,depth,height=24,24,48 end
    if kind=='Forge' then width,depth,height=38,34,23 end
    local function part(name,size,x,y,z,color,mat)
        return G.part(m,name,size,cf*CFrame.new(x,y,z),color,mat)
    end
    part('Foundation',Vector3.new(width+2,2,depth+2),0,0,0,G.Palette.Stone,Enum.Material.Cobblestone)
    part('Floor',Vector3.new(width,1,depth),0,1,0,G.Palette.Wood,Enum.Material.WoodPlanks)
    part('Back',Vector3.new(width,height,1),0,height/2,-(-depth/2),G.Palette.Plaster,Enum.Material.Limestone)
    for _,side in {-1,1} do
        part('SideWall',Vector3.new(1,height,depth),side*width/2,height/2,0,G.Palette.Plaster,Enum.Material.Limestone)
        part('DoorSide',Vector3.new((width-7)/2,height,1),side*(width+7)/4,height/2,-depth/2,G.Palette.Plaster,Enum.Material.Limestone)
        for _,z in {-depth/2,depth/2} do
            part('TimberPost',Vector3.new(1.2,height+1,1.2),side*width/2,height/2,z,G.Palette.Wood,Enum.Material.Wood)
        end
        for _,y in {4,height-2} do
            if side==-1 and y<9 then
                for _,xSide in {-1,1} do part('TimberRail',Vector3.new((width-8)/2,0.6,1.3),xSide*(width+8)/4,y,-depth/2,G.Palette.Wood,Enum.Material.Wood) end
            else part('TimberRail',Vector3.new(width+1,0.6,1.3),0,y,side*depth/2,G.Palette.Wood,Enum.Material.Wood) end
        end
        local glass=part('Window',Vector3.new(4,4,0.25),side*width*0.32,9,-depth/2-0.7,Color3.fromRGB(241,200,103),Enum.Material.Glass)
        glass.CanCollide=false
        for _,dx in {-2.2,2.2} do part('WindowFrame',Vector3.new(0.4,4.8,0.6),side*width*0.32+dx,9,-depth/2-0.8,G.Palette.Wood,Enum.Material.Wood) end
        part('WindowSill',Vector3.new(5,0.5,1),side*width*0.32,6.5,-depth/2-0.8,G.Palette.Wood,Enum.Material.Wood)
    end
    part('DoorLintel',Vector3.new(7,height-9,1),0,9+(height-9)/2,-depth/2,G.Palette.Wood,Enum.Material.Wood)
    -- Porta aberta permanentemente: abertura livre de sete studs, sem bloqueio invisível.
    for _,side in {-1,1} do
        part('DoorFrame',Vector3.new(0.6,9,1.5),side*3.6,4.5,-depth/2,G.Palette.Wood,Enum.Material.Wood)
    end
    local rise=if kind=='ArcaneTower' then 14 else 7
    local slope=math.atan2(rise,width/2+2)
    local length=math.sqrt((width/2+2)^2+rise^2)
    for _,side in {-1,1} do
        G.part(m,'PitchedRoof',Vector3.new(length,1,depth+5),cf*CFrame.new(side*(width/4+1),height+rise/2,0)*CFrame.Angles(0,0,-side*slope),roofColor,Enum.Material.Slate)
    end
    part('Ridge',Vector3.new(1,1,depth+6),0,height+rise,0,G.Palette.Wood,Enum.Material.Wood)
    part('Chimney',Vector3.new(3,9,3),width/3,height+5,depth/4,G.Palette.Stone,Enum.Material.Brick)
    -- Balcão externo e acesso escalonado: as lojas funcionam sem atravessar paredes.
    local role=Catalog.Roles[kind] or 'Citizen'
    if Catalog.Shops[role] or role=='Guild' then
        part('Counter',Vector3.new(10,3,3),-8,2,-depth/2-6,G.Palette.Wood,Enum.Material.WoodPlanks)
        part('Awning',Vector3.new(13,0.5,8),-8,8,-depth/2-5,roofColor,Enum.Material.Fabric)
        for _,x in {-14,-4} do part('AwningPost',Vector3.new(0.5,8,0.5),x,4,-depth/2-9,G.Palette.Wood,Enum.Material.Wood) end
    end
    for i=1,3 do part('Step',Vector3.new(7,0.5,2),0,0.25*i,-depth/2-4+i,G.Palette.Stone,Enum.Material.Cobblestone) end
    G.sign(m,Catalog.Labels[kind] or kind,cf*CFrame.new(0,12,-depth/2-1),math.min(20,width))
    if kind=='Tavern' or kind=='LargeHouse' then
        part('Balcony',Vector3.new(13,0.7,5),0,11,-depth/2-2,G.Palette.Wood,Enum.Material.WoodPlanks)
        part('BalconyRail',Vector3.new(13,0.5,0.5),0,14,-depth/2-4.5,G.Palette.Wood,Enum.Material.Wood)
        for x=-6,6,3 do part('Baluster',Vector3.new(0.4,3,0.4),x,12.5,-depth/2-4.5,G.Palette.Wood,Enum.Material.Wood) end
    end
    if kind=='Castle' or kind=='GuardTower' or kind=='WatchTower' or kind=='Barracks' then
        local towerH=if kind=='Castle' then 38 else height+5
        for _,side in {-1,1} do
            local x=side*(width/2+4)
            part('Turret',Vector3.new(9,towerH,9),x,towerH/2,depth/2-4,G.Palette.Stone,Enum.Material.Cobblestone)
            for i=-1,1 do part('Battlement',Vector3.new(2,3,2),x+i*3,towerH+1,depth/2-8,G.Palette.Stone,Enum.Material.Cobblestone) end
            local flag=part('Banner',Vector3.new(3,8,0.3),x,towerH-6,depth/2-9,roofColor,Enum.Material.Fabric)
            flag:SetAttribute('Flutter',true)
        end
    elseif kind=='ArcaneTower' or kind=='MagicSchool' or kind=='MagicShop' or kind=='Temple' then
        for _,side in {-1,1} do G.crystal(m,cf*CFrame.new(side*7,height+rise+3,0),Color3.fromRGB(124,177,255),1) end
    elseif kind=='Forge' or kind=='Blacksmith' or kind=='SmithGuild' then
        part('Furnace',Vector3.new(9,7,7),width/2-5,4,-depth/2-5,G.Palette.Stone,Enum.Material.Brick)
        G.detail(m,'Embers',Vector3.new(6,2,1),cf*CFrame.new(width/2-5,3,-depth/2-9),Color3.fromRGB(255,105,33),Enum.Material.Neon)
        local anvil=part('Anvil',Vector3.new(5,2,2),-width/2+5,4,-depth/2-5,Color3.fromRGB(49,52,58),Enum.Material.Metal)
        anvil:SetAttribute('Forge',true)
    elseif kind=='Windmill' then
        part('MillTower',Vector3.new(8,30,8),0,15,0,G.Palette.Plaster,Enum.Material.Limestone)
        for i=0,3 do
            G.detail(m,'Sail',Vector3.new(2,16,0.5),cf*CFrame.new(0,24,-depth/2-2)*CFrame.Angles(0,0,i*math.pi/2)*CFrame.new(0,8,0),Color3.fromRGB(220,211,173),Enum.Material.Fabric)
        end
    elseif kind=='Stable' or kind=='Barn' then
        for i=-2,2 do part('FencePost',Vector3.new(0.7,4,0.7),i*5,2,-depth/2-10,G.Palette.Wood,Enum.Material.Wood) end
        part('FenceRail',Vector3.new(22,0.5,0.6),0,3,-depth/2-10,G.Palette.Wood,Enum.Material.Wood)
        if kind=='Barn' then
            part('FarmSoil',Vector3.new(6,0.4,18),width/2+5,0.4,0,Color3.fromRGB(89,68,43),Enum.Material.Ground)
            for row=1,3 do
                for z=-6,6,4 do part('Crop',Vector3.new(0.5,2,0.5),width/2+2+row*1.5,1.5,z,Color3.fromRGB(156,177,70),Enum.Material.Grass) end
            end
        end
        for i=1,4 do part('Hay',Vector3.new(4,3,4),width/2+3,1.5,depth/2-i*5,Color3.fromRGB(207,172,77),Enum.Material.Grass) end
    elseif kind=='Mine' then
        -- Galeria visitável, com piso e pórticos, não escava Terrain alheio.
        for i=1,3 do
            for _,x in {-5,5} do part('MineSupport',Vector3.new(1,7,1),x,3.5,-i*6,G.Palette.Wood,Enum.Material.Wood) end
            part('MineBeam',Vector3.new(12,1,1),0,7,-i*6,G.Palette.Wood,Enum.Material.Wood)
            G.crystal(m,cf*CFrame.new(8,2,-i*6),Color3.fromRGB(126,164,177),0.5)
        end
    elseif kind=='Market' then
        for _,x in {-9,9} do part('Stall',Vector3.new(7,3,5),x,2,-depth/2-5,G.Palette.Wood,Enum.Material.Wood) end
    elseif kind=='Library' then
        for i=1,4 do part('Bookshelf',Vector3.new(10,1,2),0,i*2,depth/2-2,G.Palette.Wood,Enum.Material.Wood); part('Books',Vector3.new(9,1.5,1.5),0,i*2+1,depth/2-2,roofColor,Enum.Material.Fabric) end
    elseif kind=='TrainingHall' then
        for _,x in {-8,8} do
            part('TrainingDummy',Vector3.new(3,5,2),x,3,-depth/2-6,G.Palette.Wood,Enum.Material.Wood)
            part('DummyArms',Vector3.new(7,1,1),x,5,-depth/2-6,G.Palette.Wood,Enum.Material.Wood)
        end
    end
    -- Furnished ground floor; central entry lane remains open.
    local furniture=G.model(m,'Interior')
    for _,spec in Interiors.build(kind,width,depth,height)do
        local tint=if spec.Material=='Fabric' then roofColor elseif spec.Material=='Neon' then Color3.fromRGB(247,207,132)else G.Palette.Wood
        local piece=G.part(furniture,spec.Name,Vector3.new(table.unpack(spec.Size)),cf*CFrame.new(table.unpack(spec.Position)),tint,Enum.Material[spec.Material])
        if not spec.Collide then piece.CanCollide=false;piece.CanQuery=false end
    end
    for _,side in {-1,1}do
        G.detail(m,'DiagonalTimber',Vector3.new(width*0.35,0.5,0.6),cf*CFrame.new(side*width*0.3,height*0.4,-depth/2-0.7)*CFrame.Angles(0,0,side*0.55),G.Palette.Wood,Enum.Material.Wood)
    end
    for i=1,2 do
        G.detail(m,'Barrel',Vector3.new(3,3,3),cf*CFrame.new(width/2+2,1.5,i*4),G.Palette.Wood,Enum.Material.WoodPlanks,Enum.PartType.Cylinder)
    end
    return m,cf:PointToWorldSpace(Vector3.new(0,0,-depth/2-8)),role
end
return B
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">ContentGenerator</string>
          <string name="Source"><![CDATA[local G=require(script.Parent.Geometry)
local Buildings=require(script.Parent.BuildingGenerator)
local Shared=game.ReplicatedStorage.MedievalRPG
local Catalog=require(Shared.Config.ContentConfig)
local Rig=require(Shared.RigFactory)
local C={}
local Landmarks=require(script.Parent.LandmarkGenerator)
local function color(t) return Color3.fromRGB(t[1],t[2],t[3]) end
function C.npc(parent,id,position,role,city)
    local dialogue=Catalog.Dialogue[role] or Catalog.Dialogue.Citizen
    local paint=if city=='Eldoria' then Color3.fromRGB(94,73,148) elseif city=='Durakh' then Color3.fromRGB(86,81,72) else Color3.fromRGB(91,119,130)
    local model,_,root=Rig.create(parent,dialogue.Name,position,paint,false,role)
    model.Name=id; model:SetAttribute('NpcId',id); model:SetAttribute('Role',role); model:SetAttribute('City',city)
    if role=='Citizen' and Catalog.ResidentStories[city] then
        local hash=0;for i=1,#id do hash+=string.byte(id,i) end
        local name=Catalog.ResidentNames[hash%#Catalog.ResidentNames+1]
        model:SetAttribute('DisplayTitle',name..' • morador de '..city)
        model:SetAttribute('LocalDialogue',Catalog.ResidentStories[city][hash%#Catalog.ResidentStories[city]+1])
        model:FindFirstChildOfClass('Humanoid').DisplayName=name
    end
    G.prompt(root,'Conversar',model:GetAttribute('DisplayTitle') or dialogue.Name)
    return model
end
function C.chest(parent,id,pos,rarity,locked)
    local m=G.model(parent,id); m:SetAttribute('ChestId',id); m:SetAttribute('Rarity',rarity); m:SetAttribute('BossLocked',locked==true)
    G.part(m,'Base',Vector3.new(5,3,3),CFrame.new(pos+Vector3.new(0,1.5,0)),G.Palette.Wood,Enum.Material.WoodPlanks)
    local lid=G.part(m,'Lid',Vector3.new(5.2,1,3.2),CFrame.new(pos+Vector3.new(0,3.5,0)),G.Palette.Gold,Enum.Material.Metal)
    G.prompt(lid,'Abrir',rarity..' • Baú'); return m
end
function C.enemyMarker(parent,id,pos,kind)
    return G.marker(parent,id,pos,{EnemyId=id,EnemyKind=kind})
end
function C.tree(parent,t)
    local cf=CFrame.new(t.X,t.H,t.Z); local s=t.Scale
    local m=G.model(parent,'Tree_'..t.Variant)
    G.part(m,'Trunk',Vector3.new(2*s,18*s,2*s),cf*CFrame.new(0,9*s,0),G.Palette.Wood,Enum.Material.Wood)
    local dark=t.Forest=='Nocthar' or t.Forest=='Vespera'
    for i=1,3 do
        local canopy=color(if dark then {49,65+i*7,66} else {68+i*12,125+i*12,76})
        local size=if t.Variant==0 then Vector3.new(16-i*3,10,16-i*3)*s else Vector3.new(16-i,9,13+i)*s
        G.detail(m,'Canopy',size,cf*CFrame.new(if t.Variant==0 then 0 else math.sin(i+t.Variant)*3*s,(14+i*4)*s,0),canopy,Enum.Material.Grass,Enum.PartType.Ball)
    end
    if t.Variant==2 then G.detail(m,'GroundShrub',Vector3.new(5,2,4)*s,cf*CFrame.new(4,1,2),color(if dark then {70,76,81}else{82,129,71}),Enum.Material.Grass,Enum.PartType.Ball)end
    G.beam(m,cf:PointToWorldSpace(Vector3.new(0,10*s,0)),cf:PointToWorldSpace(Vector3.new(6*s,17*s,0)),s,G.Palette.Wood,Enum.Material.Wood)
    return m
end
function C.cities(root,c,plan,checkpoint)
    for _,city in plan.Cities do
        print('[Cidade] '..city.Name)
        local parent=G.model(root.Cities,city.Id)
        parent:SetAttribute('RegionName',city.Name)
        local cf=CFrame.new(city.X,city.H,city.Z)
        G.part(parent,'Plaza',Vector3.new(64,0.5,64),cf,Color3.fromRGB(149,147,128),Enum.Material.Cobblestone)
        local well=G.model(parent,'Well')
        G.part(well,'Basin',Vector3.new(10,3,10),cf*CFrame.new(23,1.5,0),G.Palette.Stone,Enum.Material.Cobblestone)
        G.detail(well,'Water',Vector3.new(8,0.3,8),cf*CFrame.new(23,3,0),Color3.fromRGB(85,161,186),Enum.Material.Glass)
        for _,x in {18,28} do G.part(well,'Post',Vector3.new(0.8,10,0.8),cf*CFrame.new(x,5,0),G.Palette.Wood,Enum.Material.Wood) end
        G.part(well,'Canopy',Vector3.new(13,1,12),cf*CFrame.new(23,10,0),G.Palette.Roof,Enum.Material.Slate)
        for index,lot in city.Lots do
            local _,pos,role=Buildings.build(parent,lot,city.Id,index)
            local npc=C.npc(root.NPCs,lot.Id..'_NPC',pos,role,city.Id)
            npc:PivotTo(CFrame.lookAt(npc.PrimaryPart.Position,Vector3.new(city.X,npc.PrimaryPart.Position.Y,city.Z)))
            checkpoint()
        end
        local radius
        for _,config in c.Cities do if config.Id==city.Id then radius=config.Radius-6 end end
        -- Muralha com vãos reservados às rotas. Nada fecha uma estrada.
        if city.Id=='Arkheim' or city.Id=='Valoria' then
            for i=1,64 do
                local a=i/64*math.pi*2
                local x,z=city.X+math.sin(a)*radius,city.Z+math.cos(a)*radius
                local free=true
                for _,road in c.Roads do
                    local dx,dz=road.B.X-road.A.X,road.B.Z-road.A.Z
                    local t=math.clamp(((x-road.A.X)*dx+(z-road.A.Z)*dz)/(dx*dx+dz*dz),0,1)
                    if math.sqrt((x-road.A.X-t*dx)^2+(z-road.A.Z-t*dz)^2)<30 then free=false end
                end
                if free then
                    local h=if city.Id=='Arkheim' then 12 else 6
                    local frame=CFrame.new(x,city.H+h/2,z)*CFrame.Angles(0,a,0)
                    G.part(parent,'CityWall',Vector3.new(radius*math.pi/32+1,h,3),frame,G.Palette.Stone,Enum.Material.Cobblestone)
                    if i%2==0 then G.part(parent,'Merlon',Vector3.new(3,2,3),frame*CFrame.new(0,h/2+1,0),G.Palette.Stone,Enum.Material.Cobblestone) end
                end
            end
        end
        for _,offset in {Vector3.new(-24,0,-24),Vector3.new(24,0,24)} do G.torch(parent,cf*CFrame.new(offset+Vector3.new(0,2,0)),true) end
        local board=G.sign(parent,'MISSÕES • GUILDA',cf*CFrame.new(-23,5,0),12)
        board:SetAttribute('QuestBoard',true); G.prompt(board,'Consultar','Quadro de missões')
        local handoff=G.marker(root.InteractiveObjects,city.Id..'_Supplies',Vector3.new(city.X-24,city.H+3,city.Z+12),{Objective='Supplies'})
        if city.Id=='Durakh' then handoff.Transparency=0; G.prompt(handoff,'Entregar','Suprimentos') end
        G.marker(root.CinematicMarkers,city.Id..'_Shot',Vector3.new(city.X,city.H+60,city.Z+120),{
            ShotName=city.Id..'_Plaza',RegionName=city.Name,CameraPosition=Vector3.new(city.X,city.H+60,city.Z+120),LookAtPosition=Vector3.new(city.X,city.H+10,city.Z),Duration=8,Category='City'})
        Landmarks.city(parent,city,c,C)
        Landmarks.defenses(root,c,C,parent,city)
        if city.Id=='Valoria' then Landmarks.camp(root,c,C,parent) end
        checkpoint()
    end
end
function C.roads(root,plan,checkpoint)
    for _,route in plan.Roads do
        local parent=G.model(root.Roads,route.Id)
        parent:SetAttribute('RouteId',route.Id)
        for i,s in route.Segments do
            local a,b=Vector3.new(s.A.X,s.A.H+0.5,s.A.Z),Vector3.new(s.B.X,s.B.H+0.5,s.B.Z)
            local cf=CFrame.lookAt((a+b)/2,b)
            G.part(parent,if s.Bridge then 'BridgeDeck' else 'Road',Vector3.new(18,0.7,(b-a).Magnitude+0.2),cf,
                if s.Bridge then G.Palette.Wood else Color3.fromRGB(149,128,93),if s.Bridge then Enum.Material.WoodPlanks else Enum.Material.Ground)
            if s.Bridge then
                local bridge=G.model(root.Bridges,route.Id..'_'..i)
                for _,side in {-1,1} do
                    G.part(bridge,'Rail',Vector3.new(0.5,0.8,(b-a).Magnitude+0.2),cf*CFrame.new(side*9,3,0),G.Palette.Wood,Enum.Material.Wood)
                    G.part(bridge,'Support',Vector3.new(1,18,1),cf*CFrame.new(side*8,-9,0),G.Palette.Stone,Enum.Material.Cobblestone)
                end
            end
        end
        G.sign(parent,route.Id,CFrame.new(route.A.X+15,route.A.H+5,route.A.Z),14)
        checkpoint()
    end
end
function C.forests(root,c,plan,checkpoint)
    local chestOverrides={}
    local folders={}
    for _,f in c.Forests do folders[f.Id]=G.model(root.Forests,f.Id); folders[f.Id]:SetAttribute('RegionName',f.Name) end
    for i,t in plan.Trees do C.tree(folders[t.Forest],t); if i%20==0 then checkpoint() end end
    for _,land in plan.Landmarks do
        local cf=CFrame.new(land.X,land.H,land.Z)
        local parent=folders[land.Id]
        -- Clareira central: ruínas, altar, missão e acampamento.
        for i=1,6 do
            local a=i/6*math.pi*2
            G.part(parent,'RuinedPillar',Vector3.new(4,8+i%3*3,4),cf*CFrame.new(math.sin(a)*35,4,math.cos(a)*35),G.Palette.Stone,Enum.Material.Rock)
        end
        local altar=G.part(parent,'Altar',Vector3.new(10,3,7),cf*CFrame.new(0,1.5,0),G.Palette.Stone,Enum.Material.Slate)
        altar:SetAttribute('Objective','Ruins'); G.prompt(altar,'Investigar','Ruínas antigas')
        local herb=G.crystal(parent,cf*CFrame.new(20,2,12),Color3.fromRGB(107,237,152),0.5)
        herb:SetAttribute('Objective','Herb'); G.prompt(herb,'Coletar','Erva rara')
        C.npc(root.NPCs,land.Id..'_Explorer',Vector3.new(land.X-20,land.H,land.Z), 'Quest',land.Id)
        if land.Id=='Nocthar' then
            for i=1,3 do G.part(parent,'BanditTent',Vector3.new(12,7,10),cf*CFrame.new(i*18-36,3.5,-40)*CFrame.Angles(0,0,0.2),Color3.fromRGB(91,75,61),Enum.Material.Fabric) end
            G.sign(parent,'O selo está quebrado...',cf*CFrame.new(0,6,-15),20)
        end
        -- Small explorable cave in the reserved clearing, without deleting Terrain or adding loot IDs.
        local caveZ=land.Z+45
        local caveY=require(script.Parent.TerrainMath).height(c,land.X,caveZ)
        local cave=G.model(parent,'HiddenCave');local caveFrame=CFrame.new(land.X,caveY,caveZ)
        G.part(cave,'CaveFoundation',Vector3.new(24,5,24),caveFrame,G.Palette.Stone,Enum.Material.Rock)
        for _,side in {-1,1}do G.part(cave,'CaveSide',Vector3.new(4,11,24),caveFrame*CFrame.new(side*11,7,0),G.Palette.Stone,Enum.Material.Rock)end
        G.part(cave,'CaveRoof',Vector3.new(26,4,26),caveFrame*CFrame.new(0,14,0),G.Palette.Stone,Enum.Material.Rock)
        for i=1,3 do G.part(cave,'CaveStep',Vector3.new(8,i*0.8,2),caveFrame*CFrame.new(0,i*0.4,-19+i*2),G.Palette.Stone,Enum.Material.Rock)end
        for _,side in {-1,1}do
            G.detail(cave,'EntranceBoulder',Vector3.new(8,11,8),caveFrame*CFrame.new(side*11,7,-9),G.Palette.Stone,Enum.Material.Rock,Enum.PartType.Ball)
        end
        G.detail(cave,'CaveCrown',Vector3.new(24,6,23),caveFrame*CFrame.new(0,15,1),G.Palette.Stone,Enum.Material.Rock,Enum.PartType.Ball)
        G.part(cave,'CaveBack',Vector3.new(24,11,3),caveFrame*CFrame.new(0,7,11),G.Palette.Stone,Enum.Material.Rock)
        G.crystal(cave,caveFrame*CFrame.new(7,6,5),if land.Id=='Sylvarin' then Color3.fromRGB(95,188,171)else Color3.fromRGB(155,97,177),0.5)
        chestOverrides[land.Id..'Chest5']=Vector3.new(land.X,caveY+2.6,caveZ+5)
        for i=1,8 do
            local r=15+i*2
            G.detail(parent,'Rock',Vector3.new(3+i%3,2,4),cf*CFrame.new(math.sin(i*2)*r,0.8,math.cos(i*2)*r),G.Palette.Stone,Enum.Material.Rock,Enum.PartType.Ball)
        end
        G.marker(root.CinematicMarkers,land.Id..'_Shot',Vector3.new(land.X,land.H+25,land.Z+65),{
            ShotName=land.Id,RegionName=land.Id,CameraPosition=Vector3.new(land.X,land.H+25,land.Z+65),LookAtPosition=Vector3.new(land.X,land.H+8,land.Z),Duration=7,Category='Forest'})
        C.enemyMarker(root.EnemySpawns,land.Id..'_Boss',Vector3.new(land.X+45,land.H,land.Z),if land.Id=='Sylvarin' then 'SylvarinBoss' elseif land.Id=='Vespera' then 'VesperaBoss' else 'NoctharBoss')
        checkpoint()
    end
    for _,s in plan.EnemySpawns do C.enemyMarker(root.EnemySpawns,s.Id,Vector3.new(s.X,s.H,s.Z),s.Kind) end
    for _,chest in plan.Chests do C.chest(root.TreasureChests,chest.Id,chestOverrides[chest.Id] or Vector3.new(chest.X,chest.H,chest.Z),chest.Rarity) end
end
function C.entrance(root,c,terrain)
    local d=c.DungeonEntrance
    local pos=Vector3.new(d.X,terrain.height(c,d.X,d.Z),d.Z)
    local cf=CFrame.new(pos); local m=root.DungeonEntrance
    G.part(m,'StairPlatform',Vector3.new(60,2,40),cf,G.Palette.Stone,Enum.Material.Cobblestone)
    for _,x in {-20,20} do
        G.part(m,'GateTower',Vector3.new(12,36,12),cf*CFrame.new(x,18,0),G.Palette.Stone,Enum.Material.Slate)
        G.crystal(m,cf*CFrame.new(x,38,0),Color3.fromRGB(210,58,107),2)
        G.torch(m,cf*CFrame.new(x,7,9),true)
    end
    G.part(m,'Lintel',Vector3.new(48,7,10),cf*CFrame.new(0,30,0),G.Palette.Stone,Enum.Material.Slate)
    for i=1,5 do G.part(m,'Stairs',Vector3.new(30,i,4),cf*CFrame.new(0,i/2,28-i*4),G.Palette.Stone,Enum.Material.Cobblestone) end
    G.sign(m,'ABISMO DE MALGORTH',cf*CFrame.new(0,23,6),26)
    C.npc(root.NPCs,'DungeonGuardian',pos+Vector3.new(0,1,15),'Dungeon','Malgorth'):SetAttribute('DungeonId','MalgorthDepths')
    local second=c.SecondDungeonEntrance
    if second then
        local p=Vector3.new(second.X,terrain.height(c,second.X,second.Z),second.Z)
        local shrine=G.model(m,'FallenSanctumGate')
        G.part(shrine,'ShrineFloor',Vector3.new(50,2,38),CFrame.new(p),G.Palette.Stone,Enum.Material.Cobblestone)
        for _,side in {-1,1} do
            G.part(shrine,'Pillar',Vector3.new(6,28,6),CFrame.new(p+Vector3.new(side*17,14,0)),G.Palette.Stone,Enum.Material.Marble)
            G.crystal(shrine,CFrame.new(p+Vector3.new(side*17,31,0)),Color3.fromRGB(136,159,223),1.5)
        end
        G.part(shrine,'Pediment',Vector3.new(42,4,8),CFrame.new(p+Vector3.new(0,28,0)),G.Palette.Stone,Enum.Material.Marble)
        G.sign(shrine,'REINO CAÍDO • 20 ANDARES',CFrame.new(p+Vector3.new(0,22,-4)),28)
        C.npc(root.NPCs,'SanctumGuardian',p+Vector3.new(0,1,-12),'Dungeon','Vespera'):SetAttribute('DungeonId','FallenSanctum')
    end
    G.marker(root.CinematicMarkers,'DungeonShot',pos+Vector3.new(0,48,100),{ShotName='DungeonGate',RegionName='Malgorth',CameraPosition=pos+Vector3.new(0,48,100),LookAtPosition=pos+Vector3.new(0,20,0),Duration=8,Category='Dungeon'})
end
return C
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">DecorationGenerator</string>
          <string name="Source"><![CDATA[local G=require(script.Parent.Geometry)
local D={}
function D.generate(parent,c,plan,terrain)
    require(script.Parent.LandmarkGenerator).waterfall(parent,c,terrain)
    local budget=c.QualityProfiles[c.Quality].DecorationBudget
    local count=0
    for _,road in plan.Roads do
        for i,s in road.Segments do
            if i%7~=0 or s.Bridge then continue end
            local a,b=Vector3.new(s.A.X,0,s.A.Z),Vector3.new(s.B.X,0,s.B.Z)
            local mid=(a+b)/2;local side=Vector3.new(-(b-a).Z,0,(b-a).X).Unit
            for _,sign in {-1,1} do
                if count>=budget then return count end
                local pos=mid+side*sign*28
                local free=true
                for _,city in plan.Cities do
                    for _,lot in city.Lots do
                        if (Vector2.new(lot.X,lot.Z)-Vector2.new(pos.X,pos.Z)).Magnitude<lot.Radius+8 then free=false end
                    end
                end
                if free and terrain.riverDistance(c,pos.X,pos.Z)>65 then
                    local ground=terrain.height(c,pos.X,pos.Z)
                    G.detail(parent,'RoadsideRock',Vector3.new(4,2,3),CFrame.new(pos.X,ground+0.6,pos.Z),Color3.fromRGB(116,124,111),Enum.Material.Rock,Enum.PartType.Ball)
                    count+=1
                end
            end
        end
    end
    return count
end
return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">DungeonInteriorGenerator</string>
          <string name="Source"><![CDATA[local G=require(script.Parent.Geometry)
local Content=require(script.Parent.ContentGenerator)
local TerrainGenerator=require(script.Parent.TerrainGenerator)
local D={}
function D.GenerateDungeon(options)
    options=options or {}
    assert(not game:GetService('RunService'):IsRunning() or options.StudioTest==true and game:GetService('RunService'):IsStudio(), 'Dungeon do editor só pode ser gerada fora do Play')
    assert(not workspace:FindFirstChild('GeneratedDungeon'),'GeneratedDungeon já existe; nada foi substituído')
    assert(options.StudioTest==true or not workspace:FindFirstChild('GeneratedWorld'),'Use outro Place para a dungeon')
    local origin=options.Origin or Vector3.new(0,20,0)
    local Expeditions=require(script.Parent.ExpeditionGenerator)
    Expeditions.preflight(origin)
    local params=OverlapParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances={workspace.Terrain}
    assert(#workspace:GetPartBoundsInBox(CFrame.new(origin+Vector3.new(30,35,330)),Vector3.new(220,100,800),params)==0,'Área da dungeon contém objetos existentes')
    local volume=Region3.new(origin+Vector3.new(-80,-15,-70),origin+Vector3.new(140,85,730)):ExpandToGrid(4)
    TerrainGenerator.assertRegionEmpty(workspace.Terrain,volume,'Área da dungeon contém Terrain existente; use um Place novo')
    local m=G.model(workspace,'GeneratedDungeon'); m:SetAttribute('ProjectId','ProjectMedievalRPG'); m:SetAttribute('BossDefeated',false)
    m:SetAttribute('StudioTest',options.StudioTest==true); m:SetAttribute('Status','Generating')
    m:SetAttribute('Origin',origin)
    for _,name in {'Rooms','EnemySpawns','TreasureChests','Traps','CinematicMarkers','NPCs'} do local f=Instance.new('Folder');f.Name=name;f.Parent=m end
    local ok,err=xpcall(function()
        local titles={'Salão do Juramento','Galeria das Sombras','Ponte do Abismo','Salão das Lâminas','Capela Corrompida','Antecâmara do Cavaleiro','Trono de Malgorth'}
        for i,title in titles do
            local room=G.model(m.Rooms,'Room'..i); room:SetAttribute('RoomName',title)
            local cf=CFrame.new(origin+Vector3.new(0,0,(i-1)*110)); local width=if i==7 then 84 else 52
            if i==3 then
                for _,side in {-1,1}do G.part(room,'AbysmPlatform',Vector3.new(width,3,20),cf*CFrame.new(0,0,side*22),G.Palette.Stone,Enum.Material.Slate)end
                G.part(room,'AbysmBridge',Vector3.new(16,3,24),cf,G.Palette.Stone,Enum.Material.Cobblestone)
                for _,side in {-1,1}do G.part(room,'BridgeRail',Vector3.new(1,3,24),cf*CFrame.new(side*8.5,3,0),G.Palette.Stone,Enum.Material.Slate)end
            else G.part(room,'Floor',Vector3.new(width,3,62),cf,G.Palette.Stone,Enum.Material.Slate)end
            for _,x in {-width/2,width/2} do
                for _,z in {-21,21} do G.part(room,'SideWall',Vector3.new(3,24,20),cf*CFrame.new(x,12,z),G.Palette.Stone,Enum.Material.Slate) end
                if i~=3 or x<0 then G.part(room,'ClosedSide',Vector3.new(3,24,22),cf*CFrame.new(x,12,0),G.Palette.Stone,Enum.Material.Slate)end
                G.part(room,'SideLintel',Vector3.new(3,10,22),cf*CFrame.new(x,20,0),G.Palette.Stone,Enum.Material.Slate)
            end
            for _,z in {-31,31} do
                for _,side in {-1,1} do G.part(room,'DoorWall',Vector3.new((width-16)/2,24,3),cf*CFrame.new(side*(width+16)/4,12,z),G.Palette.Stone,Enum.Material.Cobblestone) end
                G.part(room,'ArchLintel',Vector3.new(16,8,3),cf*CFrame.new(0,20,z),G.Palette.Stone,Enum.Material.Cobblestone)
            end
            G.part(room,'Ceiling',Vector3.new(width,2,62),cf*CFrame.new(0,28,0),Color3.fromRGB(53,45,61),Enum.Material.Slate)
            for _,x in {-width/2+5,width/2-5} do G.torch(room,cf*CFrame.new(x,6,0),true) end
            for _,x in {-width/2+5,width/2-5}do
                G.part(room,'PillarFoot',Vector3.new(5,2,5),cf*CFrame.new(x,2,22),G.Palette.Stone,Enum.Material.Cobblestone)
                G.part(room,'Pillar',Vector3.new(2,20,2),cf*CFrame.new(x,12,22),G.Palette.Stone,Enum.Material.Slate)
            end
            if i==5 then G.part(room,'CorruptedAltar',Vector3.new(12,4,8),cf*CFrame.new(15,3,12),G.Palette.Stone,Enum.Material.CrackedLava)end
            if i==7 then
                G.part(room,'ThroneDais',Vector3.new(20,2,10),cf*CFrame.new(0,2,20),G.Palette.Stone,Enum.Material.Cobblestone)
                G.part(room,'ThroneBack',Vector3.new(8,12,2),cf*CFrame.new(0,9,24),Color3.fromRGB(97,39,53),Enum.Material.Slate)
                for _,side in {-1,1}do G.crystal(room,cf*CFrame.new(side*30,8,20),Color3.fromRGB(185,62,107),1.5)end
            end
            G.sign(room,title,cf*CFrame.new(0,23,-29),30)
            if i<7 then
                local bridge=G.model(m.Rooms,'Corridor'..i)
                G.part(bridge,'Deck',Vector3.new(16,2,50),cf*CFrame.new(0,0,55),G.Palette.Stone,Enum.Material.Cobblestone)
                for _,x in {-9,9} do G.part(bridge,'Rail',Vector3.new(2,3,50),cf*CFrame.new(x,2,55),G.Palette.Stone,Enum.Material.Slate) end
            end
            if i==4 then
                local trap=G.detail(m.Traps,'DemonRune',Vector3.new(12,0.2,12),cf*CFrame.new(0,1.7,0),Color3.fromRGB(208,47,78),Enum.Material.Neon)
                trap:SetAttribute('TrapDamage',12)
            end
            if i>1 then
                local kind=if i==7 then 'Malgorth' elseif i==6 then 'Knight' elseif i==5 then 'Shadow' elseif i%2==0 then 'Demon' else 'Skeleton'
                Content.enemyMarker(m.EnemySpawns,'DungeonEnemy'..i,origin+Vector3.new(0,2,(i-1)*110),kind)
            end
            task.wait()
        end
        -- Sala secreta e ligação lateral explorável.
        local secret=G.model(m.Rooms,'SecretRoom')
        G.part(secret,'SecretFloor',Vector3.new(80,3,24),CFrame.new(origin+Vector3.new(54,0,220)),G.Palette.Stone,Enum.Material.Slate)
        for _,z in {-13,13}do G.part(secret,'SecretRail',Vector3.new(70,5,2),CFrame.new(origin+Vector3.new(59,3,z+220)),G.Palette.Stone,Enum.Material.Slate)end
        G.part(secret,'SecretBack',Vector3.new(2,16,24),CFrame.new(origin+Vector3.new(95,8,220)),G.Palette.Stone,Enum.Material.Slate)
        Content.chest(m.TreasureChests,'MalgorthSecret',origin+Vector3.new(86,2,220),'Epic')
        Content.chest(m.TreasureChests,'MalgorthReward',origin+Vector3.new(18,2,680),'Legendary',true)
        local portal=G.part(m,'ReturnPortal',Vector3.new(10,16,2),CFrame.new(origin+Vector3.new(0,9,690)),Color3.fromRGB(98,127,241),Enum.Material.Neon)
        portal.CanCollide=false; portal:SetAttribute('ReturnPortal',true); G.prompt(portal,'Retornar','Portal de retorno')
        local spawn=Instance.new('SpawnLocation');spawn.Name='DungeonSpawn';spawn.Anchored=true;spawn.Neutral=true
        spawn.Size=Vector3.new(10,1,10);spawn.Position=origin+Vector3.new(0,2,-18);spawn.Parent=m
        m:SetAttribute('SpawnPosition',spawn.Position+Vector3.new(0,4,0))
        Content.npc(m.NPCs,'DepthsReception',origin+Vector3.new(-16,2,-18),'Dungeon','Malgorth'):SetAttribute('DungeonId','MalgorthDepths')
        Content.npc(m.NPCs,'SanctumReception',origin+Vector3.new(16,2,-18),'Dungeon','Vespera'):SetAttribute('DungeonId','FallenSanctum')
        local retreat=G.detail(m,'LobbyReturn',Vector3.new(6,9,2),CFrame.new(origin+Vector3.new(18,6,-25)),Color3.fromRGB(101,158,180),Enum.Material.Neon)
        retreat:SetAttribute('ReturnPortal',true);G.prompt(retreat,'Retornar','Continente')
        G.marker(m.CinematicMarkers,'BossShot',origin+Vector3.new(0,20,610),{ShotName='MalgorthArena',RegionName='Abismo de Malgorth',CameraPosition=origin+Vector3.new(0,20,610),LookAtPosition=origin+Vector3.new(0,8,660),Duration=8,Category='Boss'})
        Expeditions.build(m,origin)
        m:SetAttribute('Status','Complete')
    end,debug.traceback)
    if not ok then m:SetAttribute('Status','Failed');error(err,0) end
    print('[Dungeon] Mapa separado gerado. Teleporte real NÃO TESTADO. Salve o Place.')
    return m
end
return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">ExpeditionGenerator</string>
          <string name="Source"><![CDATA[local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.DungeonConfig)
local Rules=require(Shared.Core.DungeonRules)
local G=require(script.Parent.Geometry)
local Content=require(script.Parent.ContentGenerator)
local TerrainGenerator=require(script.Parent.TerrainGenerator)
local Generator={}
function Generator.preflight(origin)
 for _,id in Config.Order do
  local d=Config.Dungeons[id]
  local low=origin+Vector3.new(d.X-85,-6,d.Z-85)
  local high=origin+Vector3.new(d.X+85,(d.Floors-1)*96+45,d.Z+85)
  local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={workspace.Terrain}
  assert(#workspace:GetPartBoundsInBox(CFrame.new((low+high)/2),high-low,params)==0,'Área da expedição ocupada; preserve o mapa e use outro Place')
  -- Small per-floor reads avoid an enormous empty vertical voxel allocation.
  for n=1,d.Floors do
   local p=origin+Vector3.new(d.X,(n-1)*96,d.Z)
   TerrainGenerator.assertRegionEmpty(workspace.Terrain,
    Region3.new(p-Vector3.new(85,6,85),p+Vector3.new(85,45,85)):ExpandToGrid(4),
    'Terrain existente na área da expedição')
  end
 end
end
function Generator.build(map,origin)
 local expeditions=G.model(map,'Expeditions')
 for _,id in Config.Order do
  local d=Config.Dungeons[id];local tower=G.model(expeditions,id)
  tower:SetAttribute('DungeonId',id);tower:SetAttribute('FloorCount',d.Floors)
  local tint=Color3.fromRGB(table.unpack(d.Tint))
  for n=1,d.Floors do
   local plan=Rules.floor(Config,id,n);local pos=origin+Vector3.new(plan.X,plan.Y,plan.Z)
   local floor=G.model(tower,'Floor'..n)
   floor:SetAttribute('DungeonId',id);floor:SetAttribute('FloorIndex',n);floor:SetAttribute('Layout',plan.Layout)
   floor:SetAttribute('FloorName',plan.Name);floor:SetAttribute('SpawnPosition',pos+Vector3.new(0,6,-56))
   floor:SetAttribute('Center',pos);floor:SetAttribute('Active',false)
   for _,name in {'EnemySpawns','TreasureChests'} do local f=Instance.new('Folder');f.Name=name;f.Parent=floor end
   local function part(name,size,x,y,z,color,material)
    return G.part(floor,name,size,CFrame.new(pos+Vector3.new(x,y,z)),color or G.Palette.Stone,material or Enum.Material.Slate)
   end
   if plan.Layout=='Bridge' then
    for _,z in {-53,53} do part('Landing',Vector3.new(140,3,40),0,0,z) end
    part('Crossing',Vector3.new(22,3,70),0,0,0)
    for _,x in {-12,12} do part('BridgeRail',Vector3.new(2,4,70),x,3,0) end
   else part('Floor',Vector3.new(140,3,150),0,0,0) end
   for _,x in {-71,71} do part('Wall',Vector3.new(3,34,150),x,17,0) end
   for _,z in {-76,76} do part('Wall',Vector3.new(140,34,3),0,17,z) end
   part('Vault',Vector3.new(144,2,154),0,36,0,Color3.fromRGB(43,42,57))
   for _,x in {-58,58} do
    for _,z in {-48,0,48} do
     part('ColumnBase',Vector3.new(8,3,8),x,3,z)
     part('Column',Vector3.new(4,30,4),x,18,z)
     local banner=G.detail(floor,'Banner',Vector3.new(6,12,0.3),CFrame.new(pos+Vector3.new(x,24,z-3)),tint,Enum.Material.Fabric);banner:SetAttribute('Flutter',true)
    end
    G.torch(floor,CFrame.new(pos+Vector3.new(x,8,0)),true)
   end
   -- Six different traversal silhouettes; a central corridor remains at least 16 studs wide.
   for _,side in {-1,1} do
    if plan.Layout=='Crypt' then
     for row=-1,1 do part('Sarcophagus',Vector3.new(14,4,9),side*39,3,row*24);part('CarvedLid',Vector3.new(15,1,10),side*39,5.5,row*24,tint) end
    elseif plan.Layout=='Library' then
     for row=-1,1 do
      part('Bookshelf',Vector3.new(24,18,3),side*39,10,row*25,G.Palette.Wood,Enum.Material.WoodPlanks)
      for y=5,17,4 do part('Books',Vector3.new(22,2,2),side*39,y,row*25-2,tint,Enum.Material.Fabric) end
     end
    elseif plan.Layout=='Garden' then
     part('Planter',Vector3.new(24,3,50),side*40,2,0)
     for row=-1,1 do Content.tree(floor,{X=pos.X+side*40,H=pos.Y+3,Z=pos.Z+row*18,Scale=0.65,Variant=(n+row)%3,Forest='Vespera'}) end
    elseif plan.Layout=='Forge' then
     part('Furnace',Vector3.new(20,14,22),side*42,8,10,G.Palette.Stone,Enum.Material.Brick)
     G.detail(floor,'Embers',Vector3.new(15,5,0.5),CFrame.new(pos+Vector3.new(side*42,6,-1.5)),Color3.fromRGB(249,124,61),Enum.Material.Neon)
     for row=-1,1 do part('Anvil',Vector3.new(8,3,5),side*32,4,row*28,Color3.fromRGB(71,75,82),Enum.Material.Metal) end
    elseif plan.Layout=='Arena' then
     part('ThroneDais',Vector3.new(18,2,18),side*46,2,38)
     G.crystal(floor,CFrame.new(pos+Vector3.new(side*46,8,38)),tint,1.5)
    end
   end
   for i,kind in plan.Enemies do
    local x=if plan.Layout=='Bridge' or plan.Boss then 0 else (if i%2==0 then -18 else 18)
    local z=if plan.Layout=='Bridge' then 40+(i-1)*7 else -8+(i-1)*14
    local marker=Content.enemyMarker(floor.EnemySpawns,id..'_'..n..'_'..i,pos+Vector3.new(x,2,z),kind)
    marker:SetAttribute('Enabled',false);marker:SetAttribute('Once',true);marker:SetAttribute('Difficulty',plan.Scale)
   end
   local nextPortal=part('NextFloor',Vector3.new(9,12,2),0,7,64,tint,Enum.Material.Neon)
   nextPortal.CanCollide=false;nextPortal:SetAttribute('ExpeditionNext',true);G.prompt(nextPortal,'Avançar',n..'/'..d.Floors..' • elimine os guardiões')
   local leave=part('RetreatPortal',Vector3.new(6,9,2),-29,6,-62,Color3.fromRGB(101,158,180),Enum.Material.Neon)
   leave.CanCollide=false;leave:SetAttribute('ReturnPortal',true);G.prompt(leave,'Retornar','Abandonar expedição')
   local chest=Content.chest(floor.TreasureChests,id..'_Floor_'..n,pos+Vector3.new(28,2,60),if plan.Boss then 'Epic' else 'Uncommon')
   chest:SetAttribute('FloorLocked',true)
   G.sign(floor,string.format('%02d • %s',n,plan.Name),CFrame.new(pos+Vector3.new(0,27,73)),45)
   task.wait()
  end
 end
 return expeditions
end
return Generator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Geometry</string>
          <string name="Source"><![CDATA[local G={}
G.Palette={Stone=Color3.fromRGB(112,119,124),Wood=Color3.fromRGB(86,53,35),Plaster=Color3.fromRGB(221,202,160),Roof=Color3.fromRGB(133,58,47),Gold=Color3.fromRGB(224,177,74)}
function G.model(parent,name)
    local m=Instance.new('Model'); m.Name=name; m.Parent=parent
    m:SetAttribute('GeneratedBy','ProjectMedievalRPG'); return m
end
function G.part(parent,name,size,cf,color,material,shape)
    local p=Instance.new('Part'); p.Name=name; p.Size=size; p.CFrame=cf
    p.Anchored=true; p.Color=color or G.Palette.Stone; p.Material=material or Enum.Material.Slate
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    if shape then p.Shape=shape end
    p.CanTouch=false; p.Parent=parent; return p
end
function G.detail(parent,name,size,cf,color,material,shape)
    local p=G.part(parent,name,size,cf,color,material,shape)
    p.CanCollide=false; p.CanQuery=false; return p
end
function G.sign(parent,text,cf,width)
    local p=G.detail(parent,'Sign',Vector3.new(width or 12,3,0.4),cf,G.Palette.Wood,Enum.Material.Wood)
    local ui=Instance.new('SurfaceGui'); ui.Face=Enum.NormalId.Front; ui.CanvasSize=Vector2.new(500,130); ui.Parent=p
    local label=Instance.new('TextLabel'); label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1
    label.Text=text; label.TextColor3=G.Palette.Gold; label.TextScaled=true; label.Font=Enum.Font.Garamond; label.Parent=ui
    return p
end
function G.prompt(part,action,object)
    local p=Instance.new('ProximityPrompt'); p.ActionText=action; p.ObjectText=object
    p.KeyboardKeyCode=Enum.KeyCode.E; p.MaxActivationDistance=12; p.RequiresLineOfSight=true; p.HoldDuration=0.2; p.Parent=part; return p
end
function G.marker(parent,id,pos,attrs)
    local p=G.detail(parent,id,Vector3.new(2,2,2),CFrame.new(pos),G.Palette.Gold)
    p.Transparency=1
    for key,value in attrs or {} do p:SetAttribute(key,value) end
    return p
end
function G.crystal(parent,cf,color,scale)
    return G.detail(parent,'Crystal',Vector3.new(2,6,2)*(scale or 1),cf*CFrame.Angles(0,0,0.3),color,Enum.Material.Neon)
end
function G.torch(parent,cf,light)
    G.detail(parent,'TorchWood',Vector3.new(0.6,3,0.6),cf,G.Palette.Wood,Enum.Material.Wood)
    local flame=G.detail(parent,'Flame',Vector3.new(1,1.8,1),cf*CFrame.new(0,2,0),Color3.fromRGB(255,155,58),Enum.Material.Neon,Enum.PartType.Ball)
    if light then local l=Instance.new('PointLight'); l.Range=18; l.Brightness=1; l.Color=flame.Color; l.Shadows=false; l.Parent=flame end
end
function G.beam(parent,a,b,width,color,material)
    local delta=b-a
    return G.part(parent,'Beam',Vector3.new(width,width,delta.Magnitude),CFrame.lookAt((a+b)/2,b),color,material)
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">LandmarkGenerator</string>
          <string name="Source"><![CDATA[local G=require(script.Parent.Geometry)
local L={}
function L.city(parent,city,config,Content)
 local cf=CFrame.new(city.X,city.H,city.Z)
 local tint=if city.Id=='Eldoria' then Color3.fromRGB(92,154,108) elseif city.Id=='Asterion' then Color3.fromRGB(135,153,217) else G.Palette.Gold
 -- A furnished civic square with clear north/south and east/west crossing lanes.
 for _,side in {-1,1} do
  for _,z in {-23,23} do
   G.part(parent,'GardenBorder',Vector3.new(14,1.3,7),cf*CFrame.new(side*20,0.8,z),G.Palette.Stone,Enum.Material.Cobblestone)
   G.detail(parent,'FlowerBed',Vector3.new(12,0.8,5),cf*CFrame.new(side*20,1.8,z),Color3.fromRGB(71,123,76),Enum.Material.Grass)
   for i=1,3 do G.detail(parent,'Flower',Vector3.new(1.5,1,1.5),cf*CFrame.new(side*20+i*3-6,2.3,z),tint,Enum.Material.SmoothPlastic,Enum.PartType.Ball) end
  end
  G.part(parent,'PublicBench',Vector3.new(10,0.7,3),cf*CFrame.new(side*20,2,12),G.Palette.Wood,Enum.Material.WoodPlanks)
  for _,x in {-4,4} do G.part(parent,'BenchLeg',Vector3.new(0.7,2,2),cf*CFrame.new(side*20+x,1,12),G.Palette.Wood,Enum.Material.Wood) end
 end
 if city.Id=='Eldoria' then
  for _,x in {-48,48} do Content.tree(parent,{X=city.X+x,H=city.H,Z=city.Z+25,Scale=1.6,Variant=2,Forest='Sylvarin'}) end
 elseif city.Id=='Asterion' then
  for _,x in {-48,48} do
   G.part(parent,'CelestialObelisk',Vector3.new(5,24,5),cf*CFrame.new(x,12,28),G.Palette.Stone,Enum.Material.Marble)
   G.crystal(parent,cf*CFrame.new(x,28,28),tint,1.4)
  end
 elseif city.Id=='Durakh' then
  G.part(parent,'CaravanBed',Vector3.new(12,2,6),cf*CFrame.new(46,3,25),G.Palette.Wood,Enum.Material.WoodPlanks)
  for _,x in {42,50} do for _,z in {21,29} do G.part(parent,'CartWheel',Vector3.new(1,4,4),CFrame.new(city.X+x,city.H+2,city.Z+z),G.Palette.Wood,Enum.Material.Wood,Enum.PartType.Cylinder) end end
 end
 local cityConfig;for _,c in config.Cities do if c.Id==city.Id then cityConfig=c end end
 -- Paths start at each real entrance; purely visual paving never blocks traversal.
 for _,lot in city.Lots do
  if lot.External then continue end
  local a=Vector3.new(lot.X,city.H+0.3,lot.Z);local center=Vector3.new(city.X,city.H+0.3,city.Z)
  local direction=(center-a).Unit;local front=a+direction*24;local inner=center+(a-center).Unit*38
  local length=(front-inner).Magnitude
  G.detail(parent,'Footpath',Vector3.new(6,0.2,length),CFrame.lookAt((front+inner)/2,front),Color3.fromRGB(142,138,122),Enum.Material.Cobblestone)
 end
 if cityConfig and city.Id=='Arkheim' then G.sign(parent,'O BASTIÃO RESISTE',cf*CFrame.new(0,9,cityConfig.Radius-22),26) end
end
function L.camp(root,c,Content,parent)
 local p=c.Guild;local cf=CFrame.new(p.X,p.Height,p.Z)
 G.part(parent,'GuildCamp',Vector3.new(150,0.5,130),cf,Color3.fromRGB(148,136,112),Enum.Material.Cobblestone)
 G.sign(parent,'GUILDA • TREINO • RANK F',cf*CFrame.new(0,8,-56),30)
 local marker=Content.enemyMarker(root.EnemySpawns,'Valoria_Training',Vector3.new(p.X-35,p.Height+1,p.Z),'Training')
 marker:SetAttribute('Training',true)
 G.sign(parent,'ESPERE O AVISO • APARE COM F',cf*CFrame.new(-35,9,13),26)
 for _,side in {-1,1} do G.torch(parent,cf*CFrame.new(side*65,3,-40),true) end
end
function L.defenses(root,c,Content,parent,city)
 do
  if city.Id~='Valoria' and city.Id~='Arkheim' then return end
  local z=city.Z-(city.Radius+60);local x=city.X+75
  local terrain=require(script.Parent.TerrainMath);local h=terrain.height(c,x,z)
  G.sign(parent,'FRONTEIRA • DEFENDA OS SINOS',CFrame.new(x,h+8,z),30)
  for i=1,5 do
   local px,pz=x+(i-3)*12,z+12
   local marker=Content.enemyMarker(root.EnemySpawns,city.Id..'_Defense_'..i,Vector3.new(px,terrain.height(c,px,pz),pz),'Demon')
   marker:SetAttribute('DefenseCity',city.Id);marker:SetAttribute('Enabled',false);marker:SetAttribute('Once',true)
  end
 end
end
function L.waterfall(root,c,terrain)
 local lake=c.Lake;if not lake then return end
 local p=Vector3.new(lake.X+lake.Radius-20,lake.WaterY,lake.Z)
 local m=G.model(root,'CascadeOfMemories')
 for _,side in {-1,1} do
  G.part(m,'CascadeRock',Vector3.new(16,26,22),CFrame.new(p+Vector3.new(12,10,side*13)),G.Palette.Stone,Enum.Material.Rock)
 end
 G.part(m,'UpperBasin',Vector3.new(22,3,20),CFrame.new(p+Vector3.new(12,25,0)),G.Palette.Stone,Enum.Material.Rock)
 local upper=G.detail(m,'UpperWater',Vector3.new(22,0.3,12),CFrame.new(p+Vector3.new(12,26.6,0)),Color3.fromRGB(137,200,210),Enum.Material.Glass);upper.Transparency=0.3
 local sheet=G.detail(m,'Waterfall',Vector3.new(0.7,28,11),CFrame.new(p+Vector3.new(1,13,0)),Color3.fromRGB(137,200,210),Enum.Material.Glass)
 sheet.Transparency=0.35
 for i=1,5 do G.detail(m,'Foam',Vector3.new(7,0.4,3),CFrame.new(p+Vector3.new(-i*3,0.2,i%2*3-2)),Color3.fromRGB(224,242,239),Enum.Material.SmoothPlastic,Enum.PartType.Ball) end
 local shoreX=lake.X-lake.Radius-lake.Bank-12
 local objective=G.marker(m,'LakeDiscovery',Vector3.new(shoreX,terrain.height(c,shoreX,lake.Z)+3,lake.Z),{Objective='LakeDiscovery'})
 objective.Transparency=0;G.prompt(objective,'Recordar','Lago das Memórias')
end
return L
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">RegenerationService</string>
          <string name="Source"><![CDATA[-- Substituições de instâncias próprias, com arquivo recuperável no ServerStorage.
-- Terrain nunca é removido/substituído por este serviço.
local G=require(script.Parent.Geometry)
local Plan=require(script.Parent.WorldPlan)
local Terrain=require(script.Parent.TerrainMath)
local Content=require(script.Parent.ContentGenerator)
local Decor=require(script.Parent.DecorationGenerator)
local Catalog=require(game.ReplicatedStorage.MedievalRPG.Config.ContentConfig)
local Config=require(game.ReplicatedStorage.MedievalRPG.Config.WorldConfig)
local R={Busy=false}
local function root()
    assert(not game:GetService('RunService'):IsRunning(),'Regeneração apenas no editor')
    local w=workspace:FindFirstChild('GeneratedWorld')
    assert(w and w:GetAttribute('ProjectId')==Config.ProjectId and w:GetAttribute('Status')=='Complete','Mundo próprio completo ausente')
    assert(not R.Busy,'Regeneração já em andamento')
    assert(w:GetAttribute('Seed')==Config.Seed,'Mudança de seed exige um Place novo: Terrain atual será preservado')
    assert(w:GetAttribute('ConfigSignature')==Terrain.signature(Config),'Geografia mudou; use um Place novo para preservar o Terrain existente')
    return w
end
local function stage()
    local m=G.model(game.ServerStorage,'MedievalStage_'..game:GetService('HttpService'):GenerateGUID(false))
    for _,name in {'Cities','Forests','NPCs','EnemySpawns','TreasureChests','InteractiveObjects','CinematicMarkers','Decorations'} do local f=Instance.new('Folder');f.Name=name;f.Parent=m end
    return m
end
local function archive()
    local folder=game.ServerStorage:FindFirstChild('MedievalBackups')
    if not folder then folder=Instance.new('Folder');folder.Name='MedievalBackups';folder.Parent=game.ServerStorage end
    local a=G.model(folder,'Backup_'..game:GetService('HttpService'):GenerateGUID(false))
    a:SetAttribute('CreatedAt',os.time());return a
end
local function run(build,commit)
    local w=root();R.Busy=true;local s=stage();local backup
    local ok,result=xpcall(function()
        build(s);backup=archive();commit(w,s,backup)
        s:Destroy();print('Regeneração concluída. Objetos anteriores preservados em '..backup.Name);return backup.Name
    end,debug.traceback)
    R.Busy=false
    if not ok then
        -- O estágio/backup é mantido se o commit falhar; nunca descarta objetos movidos.
        if not backup then s:Destroy() end
        error(result,0)
    end
    return result
end
local function moveChildren(from,to)
    for _,child in from:GetChildren() do child.Parent=to end
end
function R.city(id)
    assert(type(id)=='string' and Catalog.CityBuildings[id],'Cidade inválida')
    local plan=Plan.build(Config,Terrain,Catalog);local subset={Cities={}}
    for _,c in plan.Cities do if c.Id==id then table.insert(subset.Cities,c) end end
    return run(function(s) Content.cities(s,Config,subset,function()end) end,function(w,s,a)
        local old=w.Cities:FindFirstChild(id)
        assert(old and old:GetAttribute('GeneratedBy')==Config.ProjectId,'Cidade não reconhecida')
        old.Parent=a
        for _,npc in w.NPCs:GetChildren() do if npc:GetAttribute('City')==id then npc.Parent=a end end
        for _,name in {'InteractiveObjects','CinematicMarkers','EnemySpawns'} do
            for _,p in w[name]:GetChildren() do if string.sub(p.Name,1,#id+1)==id..'_' then p.Parent=a end end
        end
        for _,name in {'Cities','NPCs','InteractiveObjects','CinematicMarkers','EnemySpawns'} do moveChildren(s[name],w[name]) end
    end)
end
function R.forest(id)
    local valid=false;for _,forest in Config.Forests do if forest.Id==id then valid=true end end
    assert(valid,'Floresta inválida')
    local plan=Plan.build(Config,Terrain,Catalog);local subset={Trees={},Landmarks={},EnemySpawns={},Chests={}}
    for _,t in plan.Trees do if t.Forest==id then table.insert(subset.Trees,t) end end
    for _,key in {'Landmarks','EnemySpawns','Chests'} do
        for _,item in plan[key] do if string.sub(item.Id,1,#id)==id then table.insert(subset[key],item) end end
    end
    local c=table.clone(Config);c.Forests={}
    for _,f in Config.Forests do if f.Id==id then table.insert(c.Forests,f) end end
    return run(function(s) Content.forests(s,c,subset,function()end) end,function(w,s,a)
        local old=w.Forests:FindFirstChild(id);assert(old and old:GetAttribute('GeneratedBy')==Config.ProjectId,'Floresta não reconhecida');old.Parent=a
        for _,npc in w.NPCs:GetChildren() do if npc:GetAttribute('City')==id then npc.Parent=a end end
        for _,name in {'EnemySpawns','TreasureChests','CinematicMarkers'} do
            for _,item in w[name]:GetChildren() do if string.sub(item.Name,1,#id)==id then item.Parent=a end end
        end
        for _,name in {'Forests','NPCs','EnemySpawns','TreasureChests','CinematicMarkers'} do moveChildren(s[name],w[name]) end
    end)
end
function R.decorations()
    return run(function(s) Decor.generate(s.Decorations,Config,Plan.build(Config,Terrain,Catalog),Terrain) end,function(w,s,a)
        w.Decorations.Parent=a;s.Decorations.Parent=w
    end)
end
function R.markers()
    return run(function(s)
        local f=Instance.new('Folder');f.Name='NPCSpawns';f.Parent=s
        for _,npc in workspace.GeneratedWorld.NPCs:GetChildren() do
            if npc.PrimaryPart and npc:GetAttribute('NpcId') then
                G.marker(f,npc:GetAttribute('NpcId'),npc.PrimaryPart.Position,{Role=npc:GetAttribute('Role'),City=npc:GetAttribute('City')})
            end
        end
    end,function(w,s,a) w.NPCSpawns.Parent=a;s.NPCSpawns.Parent=w end)
end
return R
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">TerrainGenerator</string>
          <string name="Source"><![CDATA[local TerrainMath = require(script.Parent.TerrainMath)
local TerrainGenerator = {}

function TerrainGenerator.region(c, chunk)
    return Region3.new(Vector3.new(chunk.X, c.MinY, chunk.Z),
        Vector3.new(chunk.X + chunk.Width, c.MaxY, chunk.Z + chunk.Depth))
end

-- ReadVoxels returns TWO 3D arrays, each with a non-array Size: Vector3 field.
-- Iterate numeric coordinates only; generalized iteration also visits Size.
-- Shared by continent, legacy dungeon and expedition preflights.
function TerrainGenerator.assertRegionEmpty(terrain, region, message)
    local _, occupancy = terrain:ReadVoxels(region, 4)
    local size = occupancy.Size
    assert(typeof(size) == "Vector3"
        and size.X >= 1 and size.Y >= 1 and size.Z >= 1
        and size.X % 1 == 0 and size.Y % 1 == 0 and size.Z % 1 == 0,
        "ReadVoxels retornou dimensões inválidas; geração bloqueada para preservar o Terrain.")
    for x = 1, size.X do
        local plane = occupancy[x]
        for y = 1, size.Y do
            local row = plane[y]
            for z = 1, size.Z do
                -- Any nonzero occupancy (including partial water) is occupied.
                -- Missing/unexpected cells also fail closed, never release writes.
                assert(row[z] == 0, message or "Terrain existente na área reservada. Use um Place novo ou altere o projeto; nada foi sobrescrito.")
            end
        end
    end
end

-- Executado em todos os chunks ANTES da primeira escrita. Não confunde
-- voxels de água com espaço livre e nunca limpa o Terrain global.
function TerrainGenerator.assertEmpty(terrain, c, chunks, checkpoint)
    for index, chunk in chunks do
        TerrainGenerator.assertRegionEmpty(terrain, TerrainGenerator.region(c, chunk))
        checkpoint(index, #chunks)
    end
end

function TerrainGenerator.writeChunk(terrain, c, chunk)
    local nx, ny, nz = chunk.Width/4, (c.MaxY-c.MinY)/4, chunk.Depth/4
    local materials, occupancy = table.create(nx), table.create(nx)
    for ix = 1, nx do
        materials[ix], occupancy[ix] = table.create(ny), table.create(ny)
        for iy = 1, ny do
            materials[ix][iy], occupancy[ix][iy] = table.create(nz), table.create(nz)
        end
        for iz = 1, nz do
            local h, water, surface = TerrainMath.column(c, chunk.X+(ix-0.5)*4, chunk.Z+(iz-0.5)*4)
            for iy = 1, ny do
                local y = c.MinY+(iy-0.5)*4
                local fill = math.clamp((h-y)/4 + 0.5, 0, 1)
                local material = Enum.Material.Rock
                if y >= h-8 and h <= c.BaseHeight+c.MountainHeight*0.65 then
                    material = Enum.Material[surface]
                elseif y < h-8 and y > h-20 then
                    material = Enum.Material.Ground
                end
                if fill == 0 and water and y < water then
                    fill = math.clamp((water-y)/4+0.5,0,1)
                    material = Enum.Material.Water
                elseif water and y >= h-8 then
                    material = Enum.Material.Mud
                end
                materials[ix][iy][iz] = if fill == 0 then Enum.Material.Air else material
                occupancy[ix][iy][iz] = fill
            end
        end
    end
    terrain:WriteVoxels(TerrainGenerator.region(c, chunk), 4, materials, occupancy)
end
return TerrainGenerator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">TerrainMath</string>
          <string name="Source"><![CDATA[-- Núcleo puro. math.noise está disponível tanto em Luau CLI quanto no Studio.
local TerrainMath = {}
local function finite(n)
    return type(n) == "number" and n == n and math.abs(n) < math.huge
end
local function smooth(t)
    t = math.clamp(t, 0, 1)
    return t * t * (3 - 2 * t)
end

function TerrainMath.validate(c)
    assert(c.ProjectId == "ProjectMedievalRPG", "Identidade de projeto inválida")
    for _, key in { "WorldSize", "Seed", "ChunkSize", "MinY", "MaxY", "BaseHeight",
        "Amplitude", "Frequency", "MountainHeight", "CityBlend", "MaxChunks" } do
        assert(finite(c[key]), "Configuração numérica inválida: " .. key)
    end
    assert(c.Resolution == 4, "Resolution deve ser 4")
    assert(c.WorldSize > 0 and c.WorldSize <= 8000 and c.WorldSize % 8 == 0, "WorldSize inválido")
    assert(c.Seed % 1 == 0 and math.abs(c.Seed) <= 1000000, "Seed deve ser inteiro entre -1000000 e 1000000")
    assert(c.ChunkSize >= 32 and c.ChunkSize <= 256 and c.ChunkSize % 4 == 0, "ChunkSize inválido")
    assert(c.MinY % 4 == 0 and c.MaxY % 4 == 0 and c.MinY < c.MaxY, "Limites verticais inválidos")
    assert(c.MaxY - c.MinY <= 512, "Volume vertical excessivo")
    assert(c.Amplitude >= 0 and c.Frequency > 0 and c.MountainHeight >= 0 and c.CityBlend > 0, "Relevo inválido")
    assert(c.BaseHeight - c.Amplitude > c.MinY + 4, "Solo pode ficar abaixo do volume")
    assert(c.BaseHeight + c.Amplitude + c.MountainHeight < c.MaxY - 4, "Relevo pode ultrapassar MaxY")
    assert(c.QualityProfiles[c.Quality], "Qualidade inválida")
    assert(#c.Cities >= 4 and #c.Forests >= 2, "Conteúdo legado deve ser preservado")
    local ids = {}
    for _, regions in { c.Cities, c.Forests } do
        for _, region in regions do
            assert(type(region.Id) == "string" and not ids[region.Id], "ID ausente ou duplicado")
            ids[region.Id] = true
            for _, key in { "X", "Z", "Radius" } do
                assert(finite(region[key]), "Região inválida: " .. key)
            end
            assert(region.Radius > 0, "Raio deve ser positivo")
            assert(math.abs(region.X) + region.Radius + c.CityBlend < c.WorldSize / 2
                and math.abs(region.Z) + region.Radius + c.CityBlend < c.WorldSize / 2, "Região fora do continente")
        end
    end
    for i, city in c.Cities do
        assert(finite(city.Height) and city.Height > c.MinY + 4 and city.Height < c.MaxY - 4, "Altura da cidade inválida")
        for j = i + 1, #c.Cities do
            local other = c.Cities[j]
            local distance = math.sqrt((city.X - other.X)^2 + (city.Z - other.Z)^2)
            assert(distance > city.Radius + other.Radius + 2 * c.CityBlend, "Reservas de cidades se sobrepõem")
        end
    end
    assert(finite(c.DungeonEntrance.X) and finite(c.DungeonEntrance.Z), "Entrada inválida")
    assert(math.abs(c.DungeonEntrance.X) < c.WorldSize/2 and math.abs(c.DungeonEntrance.Z) < c.WorldSize/2, "Entrada fora do mapa")
    assert(math.ceil(c.WorldSize / c.ChunkSize)^2 <= c.MaxChunks, "Orçamento de chunks excedido")
    local profile=c.QualityProfiles[c.Quality]
    for key,limit in {TreesPerForest=1000,DecorationBudget=2000,ActiveEnemies=64} do
        assert(finite(profile[key]) and profile[key]%1==0 and profile[key]>0 and profile[key]<=limit,"Orçamento inválido: "..key)
    end
    assert(type(c.River)=="table" and type(c.Roads)=="table" and #c.Roads>=3,"Rio e rotas são obrigatórios")
    for _,key in {"Z","Meander","Frequency","HalfWidth","BankWidth","WaterY","BedY"} do assert(finite(c.River[key]),"Rio inválido: "..key) end
    local river=c.River
    assert(river.HalfWidth>=8 and river.BankWidth>=24 and river.Meander>=0 and river.Frequency>0,"Margens do rio inválidas")
    assert(river.BedY>c.MinY+4 and river.BedY<river.WaterY and river.WaterY<c.MaxY-4,"Alturas do rio inválidas")
    assert(math.abs(river.Z)+river.Meander+river.HalfWidth+river.BankWidth<c.WorldSize/2,"Rio fora do continente")
    local roadIds={}
    for _,road in c.Roads do
        assert(type(road.Id)=="string" and not roadIds[road.Id],"ID de estrada inválido/duplicado");roadIds[road.Id]=true
        for _,point in {road.A,road.B} do
            assert(type(point)=="table" and finite(point.X) and finite(point.Z) and finite(point.H),"Extremo de estrada inválido")
            assert(math.abs(point.X)<c.WorldSize/2 and math.abs(point.Z)<c.WorldSize/2 and point.H>river.WaterY+8 and point.H<c.MaxY-4,"Estrada fora do volume transitável")
        end
        local length=math.sqrt((road.A.X-road.B.X)^2+(road.A.Z-road.B.Z)^2)
        assert(length>=32 and math.abs(road.A.H-road.B.H)/length<0.15,"Estrada curta/demasiado íngreme")
    end
    return true
end

function TerrainMath.baseHeight(c, x, z)
    local seed = c.Seed * 0.0137
    local f = c.Frequency
    local hills = math.noise(x*f, z*f, seed) * 0.72
        + math.noise(x*f*2, z*f*2, seed + 19) * 0.28
    local west = math.exp(-((x + c.WorldSize*0.39)/(c.WorldSize*0.13))^2)
    local north = math.exp(-((z + c.WorldSize*0.40)/(c.WorldSize*0.12))^2)
    local ridge = (west * 0.7 + north * 0.3) * c.MountainHeight
    local h = c.BaseHeight + hills*c.Amplitude + ridge
    for _, city in c.Cities do
        local distance = math.sqrt((x-city.X)^2 + (z-city.Z)^2)
        local blend = smooth((distance-city.Radius)/c.CityBlend)
        h = city.Height + (h-city.Height)*blend
    end
    return h
end

function TerrainMath.signature(c)
    local tokens={}
    for _,key in {"WorldSize","Seed","MinY","MaxY","BaseHeight","Amplitude","Frequency","MountainHeight","CityBlend"} do table.insert(tokens,tostring(c[key])) end
    if c.River then for _,key in {"Z","Meander","Frequency","HalfWidth","BankWidth","WaterY","BedY"} do table.insert(tokens,tostring(c.River[key])) end end
    if c.Lake then for _,key in {'X','Z','Radius','Bank','WaterY','BedY'} do table.insert(tokens,tostring(c.Lake[key])) end end
    if c.Guild then for _,key in {'X','Z','Height'} do table.insert(tokens,tostring(c.Guild[key])) end end
    for _,city in c.Cities do for _,key in {"Id","X","Z","Radius","Height"} do table.insert(tokens,tostring(city[key])) end end
    for _,forest in c.Forests do for _,key in {"Id","X","Z","Radius"} do table.insert(tokens,tostring(forest[key])) end end
    for _,road in c.Roads or {} do
        table.insert(tokens,road.Id)
        for _,p in {road.A,road.B} do for _,key in {"X","Z","H"} do table.insert(tokens,tostring(p[key])) end end
    end
    return table.concat(tokens,"|")
end

function TerrainMath.segment(x,z,a,b)
    local dx,dz=b.X-a.X,b.Z-a.Z
    local t=math.clamp(((x-a.X)*dx+(z-a.Z)*dz)/(dx*dx+dz*dz),0,1)
    return math.sqrt((x-a.X-t*dx)^2+(z-a.Z-t*dz)^2),t
end
function TerrainMath.riverDistance(c,x,z)
    if not c.River then return math.huge end
    return math.abs(z-(c.River.Z+c.River.Meander*math.sin(x*c.River.Frequency)))
end
function TerrainMath.height(c,x,z)
    local h=TerrainMath.baseHeight(c,x,z)
    local river=TerrainMath.riverDistance(c,x,z)
    for _,road in c.Roads or {} do
        local distance,t=TerrainMath.segment(x,z,road.A,road.B)
        local weight=1-smooth((distance-14)/32)
        h=h+(road.A.H+(road.B.H-road.A.H)*t-h)*weight
    end
    -- Cidades permanecem planas; leito só corta fora de suas reservas.
    if c.River then
        local r=c.River
        local blend=smooth((river-r.HalfWidth)/r.BankWidth)
        h=r.BedY+(h-r.BedY)*blend
    end
    for _,city in c.Cities do
        local d=math.sqrt((x-city.X)^2+(z-city.Z)^2)
        local blend=smooth((d-city.Radius)/c.CityBlend)
        h=city.Height+(h-city.Height)*blend
    end
    if c.Guild then
        local g=c.Guild;local d=math.sqrt((x-g.X)^2+(z-g.Z)^2)
        h=g.Height+(h-g.Height)*smooth((d-100)/48)
    end
    if c.Lake then
        local l=c.Lake;local d=math.sqrt((x-l.X)^2+(z-l.Z)^2)
        h=l.BedY+(h-l.BedY)*smooth((d-l.Radius)/l.Bank)
    end
    return h
end
function TerrainMath.column(c,x,z)
    local h=TerrainMath.height(c,x,z)
    local water=if c.River and TerrainMath.riverDistance(c,x,z)<c.River.HalfWidth+c.River.BankWidth and h<c.River.WaterY then c.River.WaterY else nil
    if c.Lake then local l=c.Lake;if (x-l.X)^2+(z-l.Z)^2<(l.Radius+l.Bank)^2 and h<l.WaterY then water=l.WaterY end end
    local bank=c.River and TerrainMath.riverDistance(c,x,z)<c.River.HalfWidth+c.River.BankWidth and h<c.River.WaterY+7
    return h,water,if bank then (if water then 'Mud' else 'Sand')else 'Grass'
end

function TerrainMath.chunks(c)
    local result = {}
    local half = c.WorldSize/2
    for x = -half, half-1, c.ChunkSize do
        for z = -half, half-1, c.ChunkSize do
            table.insert(result, { X=x, Z=z, Width=math.min(c.ChunkSize, half-x), Depth=math.min(c.ChunkSize, half-z) })
        end
    end
    return result
end

function TerrainMath.voxel(c, x, y, z)
    local h,water,surface = TerrainMath.column(c, x, z)
    local occupancy = math.clamp((h-y)/c.Resolution + 0.5, 0, 1)
    local material = "Rock"
    if y >= h-8 then
        material = if h > c.BaseHeight + c.MountainHeight*0.65 then "Rock" else surface
    elseif y > h-20 then
        material = "Ground"
    end
    if occupancy==0 and water and y<water then occupancy=math.clamp((water-y)/4+0.5,0,1);material='Water'
    elseif water and y>=h-8 then material='Mud' end
    if occupancy==0 then material='Air' end
    return material, occupancy
end
return TerrainMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">ValidationGenerator</string>
          <string name="Source"><![CDATA[local Validation={}
function Validation.validate(ws,c)
    local checks={}
    local function check(name,passed)
        local status=if passed then 'PASSOU' else 'FALHOU'
        table.insert(checks,{Name=name,Status=status});print('['..status..'] '..name)
    end
    local root=ws:FindFirstChild('GeneratedWorld')
    check('Pasta e identidade',root~=nil and root:GetAttribute('ProjectId')==c.ProjectId)
    if not root then return checks end
    local marker=root:FindFirstChild('TerrainMarkers');check('Reservas de regiões',marker~=nil and #marker:GetChildren()==#c.Cities+#c.Forests+1)
    local spawns=root:FindFirstChild('Spawns');local spawn=spawns and spawns:FindFirstChild('ValoriaSpawn')
    check('Spawn inicial',spawn~=nil and spawn:IsA('SpawnLocation') and spawn.Anchored and spawn.Enabled)
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={ws.Terrain}
    for _,city in c.Cities do
        local hit=ws:Raycast(Vector3.new(city.X,c.MaxY,city.Z),Vector3.new(0,c.MinY-c.MaxY,0),params)
        check('Solo em '..city.Id,hit~=nil and math.abs(hit.Position.Y-city.Height)<=4)
        local model=root.Cities:FindFirstChild(city.Id)
        local buildings=0
        if model then
            for _,m in model:GetChildren() do if m:GetAttribute('Template') then buildings+=1 end end
        end
        check('Edifícios em '..city.Id,buildings>=13)
    end
    check('Cidades configuradas',#root.Cities:GetChildren()==#c.Cities)
    check('Florestas configuradas',#root.Forests:GetChildren()==#c.Forests)
    check('Estradas',#root.Roads:GetChildren()==#c.Roads)
    check('Pontes sobre o rio',#root.Bridges:GetChildren()>0)
    local interactive=0
    for _,m in root.NPCs:GetChildren() do
        if m:FindFirstChildOfClass('Humanoid') and m:FindFirstChild('HumanoidRootPart') and m.HumanoidRootPart:FindFirstChildOfClass('ProximityPrompt') then interactive+=1 end
    end
    check('NPCs com rig e interação',interactive>=40)
    check('Spawns de inimigos',#root.EnemySpawns:GetChildren()>=12)
    check('Baús configurados',#root.TreasureChests:GetChildren()==#c.Forests*5)
    check('Guardião da dungeon',root.NPCs:FindFirstChild('DungeonGuardian')~=nil)
    check('Marcadores cinematográficos',#root.CinematicMarkers:GetChildren()>=7)
    table.insert(checks,{Name='Gameplay real, DataStore e teleporte',Status='NÃO TESTADO',Reason='Execute matriz de testes no Studio e cliente Roblox.'})
    return checks
end
return Validation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">WorldGenerator</string>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(game:GetService("ReplicatedStorage").MedievalRPG.Config.WorldConfig)
local TerrainMath = require(script.Parent.TerrainMath)
local TerrainGenerator = require(script.Parent.TerrainGenerator)
local Validation = require(script.Parent.ValidationGenerator)
local Plan = require(script.Parent.WorldPlan)
local Content = require(script.Parent.ContentGenerator)
local Catalog = require(game.ReplicatedStorage.MedievalRPG.Config.ContentConfig)
local WorldGenerator = {}

local folders = { "TerrainMarkers", "Roads", "Bridges", "Cities", "Forests", "DungeonEntrance", "Ruins",
    "Decorations", "Spawns", "InteractiveObjects", "TreasureChests", "NPCSpawns", "EnemySpawns", "CinematicMarkers", "NPCs" }

function WorldGenerator.PreviewGeneration(config)
    local c = config or Config
    TerrainMath.validate(c)
    local chunks = TerrainMath.chunks(c)
    local report = {
        ProjectId = c.ProjectId, Seed = c.Seed, WorldSize = c.WorldSize,
        Chunks = #chunks, Voxels = (c.WorldSize/4)^2 * ((c.MaxY-c.MinY)/4),
        CitiesReserved = #c.Cities, ForestsReserved = #c.Forests,
        ImplementedPhase = 11, TerrainWritten = false,
    }
    local plan = Plan.build(c, TerrainMath, Catalog)
    report.Buildings = 0
    for _, city in plan.Cities do report.Buildings += #city.Lots end
    report.Trees = #plan.Trees
    print(string.format("[Preview] %dx%d studs, %d chunks, %d voxels. Continente completo: terreno, rotas, cidades, florestas e marcadores de gameplay.",
        c.WorldSize, c.WorldSize, report.Chunks, report.Voxels))
    return report
end

local function marker(parent, name, position, radius, kind)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = Vector3.new(4, 4, 4)
    part.Position = position
    part.Anchored = true
    part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
    part.Transparency = 1
    part:SetAttribute("RegionId", name)
    part:SetAttribute("Radius", radius)
    part:SetAttribute("Kind", kind)
    part.Parent = parent
    return part
end

function WorldGenerator.GenerateNewWorld(config)
    assert(not RunService:IsRunning(), "Execute pela Command Bar no modo de edição, fora do Play/Run.")
    assert(script:IsDescendantOf(ServerStorage), "Gerador deve estar em ServerStorage")
    local c = config or Config
    local report = WorldGenerator.PreviewGeneration(c)
    assert(not workspace:FindFirstChild("GeneratedWorld"),
        "GeneratedWorld já existe. Use regeneração seletiva ou outro Place; Terrain não será substituído.")

    -- O folder é também o lock: criado antes de qualquer yield.
    local root = Instance.new("Folder")
    root.Name = "GeneratedWorld"
    root:SetAttribute("ProjectId", c.ProjectId)
    root:SetAttribute("SchemaVersion", c.SchemaVersion)
    root:SetAttribute("Seed", c.Seed)
    root:SetAttribute("ConfigSignature",TerrainMath.signature(c))
    root:SetAttribute("Status", "Preflight")
    root:SetAttribute("ChunksWritten", 0)
    root:SetAttribute("CancelRequested", false)
    root.Parent = workspace
    local wrote = false
    local function checkpoint()
        assert(root.Parent == workspace, "Lock removido durante geração")
        assert(not root:GetAttribute("CancelRequested"), "Geração cancelada; consulte ChunksWritten antes de qualquer recuperação.")
        task.wait()
    end
    local ok, result = xpcall(function()
        print("[01/09] Conferindo a área; nenhum voxel escrito ainda...")
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { root, workspace.Terrain }
        local parts = workspace:GetPartBoundsInBox(CFrame.new(0, (c.MinY+c.MaxY)/2, 0),
            Vector3.new(c.WorldSize, c.MaxY-c.MinY, c.WorldSize), params)
        assert(#parts == 0, "Há Parts na área do terreno (incluindo possível Baseplate). Use um Place vazio; objetos existentes foram preservados.")
        local chunks = TerrainMath.chunks(c)
        TerrainGenerator.assertEmpty(workspace.Terrain, c, chunks, function(i, total)
            if i % 32 == 0 or i == total then print(string.format("[Preflight] %d/%d", i, total)) end
            checkpoint()
        end)
        print("[02/09] Gerando terreno por chunks...")
        root:SetAttribute("Status", "WritingTerrain")
        for i, chunk in chunks do
            -- Marca antes da chamada: uma falha do engine pode deixar escrita parcial.
            wrote = true
            root:SetAttribute("LastAttemptedChunk", i)
            TerrainGenerator.writeChunk(workspace.Terrain, c, chunk)
            root:SetAttribute("ChunksWritten", i)
            if i % 16 == 0 or i == #chunks then print(string.format("[Terreno] %d/%d", i, #chunks)) end
            checkpoint()
        end
        print("[03/09] Criando reservas e spawn inicial...")
        for _, name in folders do
            local folder = Instance.new("Folder")
            folder.Name, folder.Parent = name, root
        end
        for _, city in c.Cities do
            marker(root.TerrainMarkers, city.Id, Vector3.new(city.X, city.Height+2, city.Z), city.Radius, "CityReservation")
        end
        for _, forest in c.Forests do
            marker(root.TerrainMarkers, forest.Id, Vector3.new(forest.X, TerrainMath.height(c, forest.X, forest.Z)+2, forest.Z), forest.Radius, "ForestReservation")
        end
        local d = c.DungeonEntrance
        marker(root.TerrainMarkers, "Malgorth", Vector3.new(d.X, TerrainMath.height(c,d.X,d.Z)+2,d.Z), 60, "DungeonReservation")
        local city = c.Cities[1]
        local spawn = Instance.new("SpawnLocation")
        spawn.Name, spawn.Anchored, spawn.Neutral = "ValoriaSpawn", true, true
        spawn.Size = Vector3.new(10, 1, 10)
        spawn.Position = Vector3.new(city.X, city.Height+1, city.Z)
        spawn.Material = Enum.Material.Cobblestone
        spawn.Color = Color3.fromRGB(170, 164, 140)
        spawn.Parent = root.Spawns
        assert(#root.TerrainMarkers:GetChildren() == #c.Cities+#c.Forests+1 and spawn.Parent, "Validação das reservas falhou")
        local plan=Plan.build(c,TerrainMath,Catalog)
        print('[04/09] Estradas e pontes...'); Content.roads(root,plan,checkpoint)
        print('[05/09] Cidades e NPCs...'); Content.cities(root,c,plan,checkpoint)
        print('[06/09] Florestas, inimigos e baús...'); Content.forests(root,c,plan,checkpoint)
        print('[07/09] Entrada da dungeon e decoração...'); Content.entrance(root,c,TerrainMath)
        require(script.Parent.DecorationGenerator).generate(root.Decorations,c,plan,TerrainMath)
        print('[08/09] Validação...')
        report.Checks = Validation.validate(workspace, c)
        for _, check in report.Checks do
            assert(check.Status ~= "FALHOU", "Validação falhou: " .. check.Name)
        end
        root:SetAttribute("Status", "Complete")
        report.TerrainWritten = true
        report.ChunksWritten = #chunks
        print("[09/09] Continente gerado. Salve o Place e valide no Play. Dungeon: gere em outro Place.")
        return report
    end, debug.traceback)
    if not ok then
        if wrote then
            root:SetAttribute("Status", "FailedPartialTerrain")
            root:SetAttribute("Error", tostring(result))
            warn("Geração interrompida. Terrain parcial preservado; não repita em cima dele. Reabra a cópia salva antes da geração.")
        else
            root:Destroy() -- Nenhuma escrita de Terrain ocorreu.
        end
        error(result, 0)
    end
    return result
end

function WorldGenerator.ValidateWorld(config)
    return Validation.validate(workspace, config or Config)
end
-- One editor command for files built by either Rojo project. It never deletes old maps.
function WorldGenerator.PrepareStudio(options)
    assert(RunService:IsStudio() and not RunService:IsRunning(),'Prepare no editor do Studio, antes de Play')
    options=options or {}
    local kind=ServerStorage:FindFirstChild('MedievalPlaceKind')
    assert(kind and (kind.Value=='World' or kind.Value=='Dungeon'),'Use um dos Places gerados pelo projeto Rojo')
    if kind.Value=='World' then
        local existing=workspace:FindFirstChild('GeneratedWorld')
        if not existing then WorldGenerator.GenerateNewWorld() else
            assert(existing:GetAttribute('ProjectId')==Config.ProjectId and existing:GetAttribute('Status')=='Complete','Mapa existente incompleto/desconhecido; foi preservado')
            assert(existing:GetAttribute('ConfigSignature')==TerrainMath.signature(Config),'O mapa salvo usa outra geografia. Abra o build em uma cópia nova; seu mapa foi preservado.')
            for _,check in WorldGenerator.ValidateWorld() do assert(check.Status~='FALHOU',check.Name) end
        end
    else
        local existing=workspace:FindFirstChild('GeneratedDungeon')
        if not existing then WorldGenerator.GenerateDungeon() else
            assert(existing:GetAttribute('ProjectId')==Config.ProjectId and existing:GetAttribute('Status')=='Complete','Dungeon existente incompleta/desconhecida; foi preservada')
            if not existing:FindFirstChild('Expeditions') then WorldGenerator.AddExpeditions() end
        end
    end
    workspace:SetAttribute('StudioSessionPreview',options.Persistent~=true)
    workspace:SetAttribute('EldravynPrepared',true)
    print('[Eldravyn] Cenário preparado. Salve como uma cópia .rbxl/.rbxlx e clique Play. Prévia Studio: '..tostring(options.Persistent~=true)..'. Não publica o jogo.')
    return {Kind=kind.Value,StudioSessionPreview=options.Persistent~=true,Status='Prepared',RequiresSave=true}
end

-- Substituições seletivas preservam o conteúdo anterior em ServerStorage.
function WorldGenerator.RegenerateCity(id) return require(script.Parent.RegenerationService).city(id) end
function WorldGenerator.RegenerateForest(id) return require(script.Parent.RegenerationService).forest(id) end
function WorldGenerator.RegenerateDecorations() return require(script.Parent.RegenerationService).decorations() end
function WorldGenerator.RegenerateNPCMarkers() return require(script.Parent.RegenerationService).markers() end
function WorldGenerator.RegenerateGeneratedWorld()
    error("Substituição global de Terrain bloqueada. Gere em um Place novo para preservar voxels e mapas editados.",0)
end
function WorldGenerator.GenerateDungeon(options)
    return require(script.Parent.DungeonInteriorGenerator).GenerateDungeon(options)
end
function WorldGenerator.AddExpeditions()
    assert(not RunService:IsRunning(),'Execute fora do Play')
    local map=workspace:FindFirstChild('GeneratedDungeon')
    assert(map and map:GetAttribute('ProjectId')==Config.ProjectId and map:GetAttribute('Status')=='Complete','Dungeon própria completa ausente')
    assert(not map:FindFirstChild('Expeditions'),'Expedições já existem; nenhuma substituição será feita')
    local origin=map:GetAttribute('Origin') or map:GetAttribute('SpawnPosition')-Vector3.new(0,6,-18)
    local generator=require(script.Parent.ExpeditionGenerator)
    generator.preflight(origin)
    return generator.build(map,origin)
end
return WorldGenerator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">WorldPlan</string>
          <string name="Source"><![CDATA[-- Planejamento puro: os mesmos lotes são usados no editor e nos testes CLI.
local Plan={}
local function distance(a,b) return math.sqrt((a.X-b.X)^2+(a.Z-b.Z)^2) end
function Plan.clear(c,mathTerrain,x,z,radius)
    for _,road in c.Roads do if mathTerrain.segment(x,z,road.A,road.B)<radius+20 then return false end end
    return true
end
function Plan.build(c,mathTerrain,content)
    local plan={Cities={},Roads={},Trees={},Landmarks={},EnemySpawns={},Chests={}}
    for _,road in c.Roads do
        local segments={}
        local n=math.ceil(distance(road.A,road.B)/16)
        for i=0,n-1 do
            local a,b=i/n,(i+1)/n
            local function point(t)
                return {X=road.A.X+(road.B.X-road.A.X)*t,Z=road.A.Z+(road.B.Z-road.A.Z)*t,H=road.A.H+(road.B.H-road.A.H)*t}
            end
            local p,q=point(a),point(b)
            local x,z=(p.X+q.X)/2,(p.Z+q.Z)/2
            table.insert(segments,{A=p,B=q,Bridge=mathTerrain.riverDistance(c,x,z)<c.River.HalfWidth+c.River.BankWidth+16})
        end
        table.insert(plan.Roads,{Id=road.Id,Segments=segments,A=road.A,B=road.B})
    end
    for _,city in c.Cities do
        local result={Id=city.Id,Name=city.Name,X=city.X,Z=city.Z,H=city.Height,Radius=city.Radius,Lots={}}
        for index,kind in content.CityBuildings[city.Id] do
            local major=kind=="Castle" or kind=="ArcaneTower" or kind=="Forge"
            local radius=if major then 39 else 30
            local found
            if city.Id=='Valoria' and kind=='GuildHall' and c.Guild then
                table.insert(result.Lots,{Id=city.Id..'_'..index,Kind=kind,X=c.Guild.X+50,Z=c.Guild.Z,H=c.Guild.Height,Radius=30,Yaw=math.pi/2,External=true})
                continue
            end
            -- Espiral determinística: grandes edifícios primeiro, círculo conservador evita sobreposição rotacionada.
            for ring=1,9 do
                if found then break end
                local r=65+ring*32
                local slots=math.floor(2*math.pi*r/(radius*2+10))
                for slot=1,slots do
                    local angle=slot/slots*math.pi*2+index*0.31
                    local x,z=city.X+math.sin(angle)*r,city.Z+math.cos(angle)*r
                    local candidate={X=x,Z=z,Radius=radius}
                    local free=r+radius<city.Radius-5 and Plan.clear(c,mathTerrain,x,z,radius)
                    for _,lot in result.Lots do if distance(candidate,lot)<radius+lot.Radius+6 then free=false end end
                    if free then
                        found={Id=city.Id.."_"..index,Kind=kind,X=x,Z=z,H=city.Height,Radius=radius,Yaw=angle}
                        table.insert(result.Lots,found); break
                    end
                end
            end
            assert(found,"Sem lote seguro para "..city.Id.."/"..kind..". Amplie o raio ou reduza a lista.")
        end
        table.insert(plan.Cities,result)
    end
    -- Hash local independente de Random do engine: resultados idênticos no CLI/Studio.
    local state=math.max(1,c.Seed%2147483647)
    local function random()
        state=(state*48271)%2147483647
        return state/2147483647
    end
    for _,forest in c.Forests do
        local target=c.QualityProfiles[c.Quality].TreesPerForest
        local occupied={}
        local count=0
        for _=1,target*12 do
            if count>=target then break end
            local angle=random()*math.pi*2
            local r=math.sqrt(random())*forest.Radius
            local x,z=forest.X+math.sin(angle)*r,forest.Z+math.cos(angle)*r
            local key=math.floor(x/20)..":"..math.floor(z/20)
            local free=not occupied[key] and r>70 and Plan.clear(c,mathTerrain,x,z,12) and mathTerrain.riverDistance(c,x,z)>65
            for _,city in c.Cities do if distance({X=x,Z=z},city)<city.Radius+30 then free=false end end
            if free then
                occupied[key]=true; count+=1
                table.insert(plan.Trees,{X=x,Z=z,H=mathTerrain.height(c,x,z),Scale=0.8+random()*0.8,Variant=count%3,Forest=forest.Id})
            end
        end
        assert(count>=target*0.8,"Densidade mínima da floresta não atingida")
        for i=1,6 do
            local x,z=forest.X+math.cos(i*1.9)*80,forest.Z+math.sin(i*1.9)*80
            table.insert(plan.EnemySpawns,{Id=forest.Id..i,X=x,Z=z,H=mathTerrain.height(c,x,z),Kind=if forest.Id=='Vespera' then (if i%2==0 then 'Demon' else 'DarkWolf') elseif forest.Id=="Nocthar" then (if i%3==0 then "Skeleton" else "Bandit") else (if i%3==0 then "Slime" else "Wolf")})
        end
        for i=1,5 do
            local x,z=forest.X+math.cos(i*2.1)*200,forest.Z+math.sin(i*2.1)*200
            table.insert(plan.Chests,{Id=forest.Id.."Chest"..i,X=x,Z=z,H=mathTerrain.height(c,x,z),Rarity=if i==5 then "Rare" else "Common"})
        end
        table.insert(plan.Landmarks,{Id=forest.Id,X=forest.X,Z=forest.Z,H=mathTerrain.height(c,forest.X,forest.Z)})
    end
    return plan
end
return Plan
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="56">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="57">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="58">
        <Properties>
          <string name="Name">MedievalClient</string>
        </Properties>
        <Item class="Folder" referent="59">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">AdventureController</string>
              <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Shared=game.ReplicatedStorage.MedievalRPG
local Config=require(Shared.Config.AdventureConfig)
local Rules=require(Shared.Core.AdventureRules)
local Identity=require(Shared.Config.IdentityConfig)
local Dungeon=require(Shared.Config.DungeonConfig)
local A={}
function A.bind(ui)
 function ui.character()
  ui.clear();ui.Panel.Visible=true;ui.Role=nil;ui.View='Character';ui.Title.Text='Seu personagem'
  local state=ui.State;local race=state and state.Identity and Identity.Races[state.Identity.Race]
  ui.Dialogue.Text=Config.Title..'\n'..(race and ('Linhagem permanente: '..race.Name..' • '..race.Identity) or 'Linhagem aguardando gravação segura.')
  if not state then ui.info('Aguardando o perfil salvo.');return end
  if state.StarterChosen then
   ui.info('Classe atual: '..state.Class..'. O mesmo personagem e a raça original são carregados ao reconectar.')
   ui.button('Árvore de classes e evolução racial',ui.identity)
  else
   ui.info('A primeira arma é gratuita. Escolha o estilo que deseja aprender; o servidor registra uma única escolha.')
   for _,v in {{'Guerreiro','Longsword','Resistência, defesa e golpes amplos.'},{'Espadachim','Katana','Combos rápidos e precisão.'},{'Mago','Staff','Projéteis, controle e cura.'},{'Arqueiro','Bow','Alternativa preservada: ataques à distância.'}} do
    ui.info(v[3]);ui.button(v[1],'CreateCharacter',v[2])
   end
  end
  ui.button('Tutorial e história',ui.tutorial)
 end
 function ui.tutorial()
  ui.clear();ui.Panel.Visible=true;ui.Role=nil;ui.View='Tutorial';ui.Title.Text='O primeiro juramento'
  ui.Dialogue.Text='Os sinos de Valoria ainda anunciam manhãs tranquilas. Maelis pede ajuda para manter as estradas abertas enquanto a corrupção desperta no norte.'
  local state=ui.State
  for _,step in Config.Tutorial do
   local done=state and state.Adventure and state.Adventure.Tutorial[step.Id]
   ui.info((if done then '✓ ' else '○ ')..step.Name..'\n'..step.Text)
  end
  ui.info('Guilda: ao sul de Valoria, X 0 / Z 1480. O parceiro de treino não concede saque e anuncia cada ataque.')
  ui.button('Personagem',ui.character);ui.button('Atlas',ui.map)
 end
 function ui.expeditions()
  ui.clear();ui.Panel.Visible=true;ui.Role=nil;ui.View='Expeditions';ui.Title.Text='Expedições'
  ui.Dialogue.Text='Solo ou até quatro aventureiros. Reúna sobreviventes no portal após limpar cada andar. Morte elimina você desta tentativa.'
  for _,id in Dungeon.Order do
   local d=Dungeon.Dungeons[id];local best=ui.State and ui.State.Expedition and ui.State.Expedition.Best[id] or 0
   ui.info(d.Name..' • '..d.Floors..' andares • nível '..d.MinLevel..'\nMelhor andar confirmado: '..best..'. Recompensa de avanço é concedida uma vez por andar.')
  end
  ui.info('As tentativas recomeçam no andar 1. Melhor andar, primeira conclusão e baús individuais ficam salvos. O progresso é confirmado ao usar o portal.')
  ui.button('Atlas das entradas',ui.map)
 end
 local gui=ui.Hud.Parent
 local guide=Instance.new('TextButton');guide.Name='TutorialTracker';guide.Size=UDim2.new(0.56,0,0,48);guide.Position=UDim2.fromOffset(10,134)
 guide.TextSize=14;guide.TextWrapped=true;guide.Font=Enum.Font.Garamond;guide.TextColor3=Color3.fromRGB(235,204,142);guide.BackgroundColor3=Color3.fromRGB(31,34,39);guide.BackgroundTransparency=0.2;guide.Parent=gui
 guide.Activated:Connect(ui.tutorial);ui.Guide=guide
 local function screen(name,title)
  local frame=Instance.new('Frame');frame.Name=name;frame.Size=UDim2.fromScale(1,1);frame.BackgroundColor3=Color3.fromRGB(20,24,33);frame.BackgroundTransparency=0.12;frame.ZIndex=20;frame.Visible=false;frame.Parent=gui
  local text=Instance.new('TextLabel');text.Size=UDim2.fromScale(0.8,0.3);text.Position=UDim2.fromScale(0.1,0.3);text.BackgroundTransparency=1;text.TextColor3=Color3.fromRGB(236,209,152);text.TextWrapped=true;text.TextSize=24;text.Font=Enum.Font.Garamond;text.ZIndex=21;text.Text=title;text.Parent=frame
  return frame,text
 end
 local loading,loadingText=screen('ProfileLoading',Config.Title..'\nCarregando seu personagem...')
 local death,deathText=screen('DeathScreen','O juramento permanece.\nAguardando o renascimento...')
 loading.Visible=ui.State==nil
 function ui.refreshAdventure()
  local state=ui.State;loading.Visible=state==nil or Players.LocalPlayer:GetAttribute('ProfileStatus')=='Unavailable'
  if loading.Visible and Players.LocalPlayer:GetAttribute('ProfileStatus')=='Unavailable' then loadingText.Text='Perfil indisponível. Seu progresso foi preservado. Reconecte para tentar novamente.' end
  local p=Players.LocalPlayer;local hum=p.Character and p.Character:FindFirstChildOfClass('Humanoid')
  death.Visible=state~=nil and hum~=nil and hum.Health<=0
  deathText.Text='Você caiu. Seu personagem renascerá em instantes.\n'..(if p:GetAttribute('InDungeon') then 'Esta tentativa terminou para você. Andares confirmados e itens salvos permanecem.' else 'Retorne à hospedaria e prepare sua próxima jornada.')
  if p:GetAttribute('DungeonName') then
   guide.Visible=true;guide.Text=p:GetAttribute('DungeonName')..' • '..tostring(p:GetAttribute('DungeonFloor'))..'/'..tostring(p:GetAttribute('DungeonFloors'))..'\nGuardiões restantes: '..tostring(p:GetAttribute('DungeonRemaining'))..' • '..tostring(p:GetAttribute('DungeonState'))
  elseif state then
   local step,index=Rules.current(state,Config)
   guide.Visible=step~=nil;guide.Text=if step then 'Tutorial '..index..'/'..#Config.Tutorial..' • '..step.Name..'\nToque para ver o objetivo.' else ''
  end
 end
 return ui
end
return A
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Shared=game.ReplicatedStorage.MedievalRPG
local Catalog=require(Shared.Config.ContentConfig)
local Abilities=require(Shared.Config.AbilityConfig)
local IdentityConfig=require(Shared.Config.IdentityConfig)
local AdventureConfig=require(Shared.Config.AdventureConfig)
local DungeonConfig=require(Shared.Config.DungeonConfig)
local UIS=game:GetService('UserInputService')
local UI={SkillButtons={},Settings={Quality='LOW',ReducedMotion=false,Sound=true},Cooldowns={},State=nil,Role=nil,City=nil,Party=nil,Remote=nil}
local color={Bg=Color3.fromRGB(30,29,35),Panel=Color3.fromRGB(48,43,43),Gold=Color3.fromRGB(232,195,116),Text=Color3.fromRGB(239,230,208)}
local function label(parent,text,size)
    local l=Instance.new('TextLabel');l.BackgroundTransparency=1;l.TextColor3=color.Text;l.Font=Enum.Font.Garamond
    l.TextSize=size or 20;l.TextWrapped=true;l.TextXAlignment=Enum.TextXAlignment.Left;l.Text=text;l.Parent=parent;return l
end
local function corner(parent) local c=Instance.new('UICorner');c.CornerRadius=UDim.new(0,7);c.Parent=parent end
function UI.adapt(width,height)
    UI.Compact=UIS.TouchEnabled or width<720 or height<600
    if not UI.Guide then return end
    if UI.Compact then
        UI.Guide.Size=UDim2.new(0.4,-16,0,40);UI.Guide.Position=UDim2.fromOffset(10,124)
        UI.Toast.Position=UDim2.new(0.64,0,0,50);UI.Toast.Size=UDim2.new(0.34,0,0,math.max(40,math.min(105,height-270)));UI.Toast.TextSize=14
        UI.Hud.Size=UDim2.new(0.62,0,0,48)
        UI.Panel.Size=UDim2.fromScale(0.9,0.9);UI.Panel.Position=UDim2.fromScale(0.5,0.52)
    else
        UI.Guide.Size=UDim2.new(0.56,0,0,48);UI.Guide.Position=UDim2.fromOffset(10,134)
        UI.Toast.Position=UDim2.fromScale(0.1,0.31);UI.Toast.Size=UDim2.new(0.8,0,0,70);UI.Toast.TextSize=17
        UI.Hud.Size=UDim2.new(1,-100,0,48)
        UI.Panel.Size=UDim2.fromScale(0.85,0.64);UI.Panel.Position=UDim2.fromScale(0.5,0.56)
    end
    UI.Region.Visible=not UI.Compact
end
function UI.send(action,value) UI.Remote:FireServer(action,value) end
function UI.attack(mode)
    local skill=Abilities.Skills[mode]
    if skill and UI.State then
        if (Players.LocalPlayer:GetAttribute('Level') or 1)<skill.Level then UI.notice('Requer nível '..skill.Level..'.');return end
        if skill.Level>1 and not UI.State.Unlocks[mode] then UI.notice('Aprenda esta habilidade com um instrutor.');return end
    end
    UI.send('Attack',{Mode=mode,Target=UI.GetAim and UI.GetAim() or nil})
end
function UI.notice(text)
    UI.Toast.Text=text;UI.Toast.Visible=true;UI.Toast:SetAttribute('Shown',os.clock())
    local time=UI.Toast:GetAttribute('Shown')
    task.delay(6,function() if UI.Toast:GetAttribute('Shown')==time then UI.Toast.Visible=false end end)
end
function UI.button(text,action,value,parent)
    local b=Instance.new('TextButton');b.Size=UDim2.new(1,-12,0,36);b.BackgroundColor3=color.Panel;b.TextColor3=color.Gold
    b.TextSize=16;b.Font=Enum.Font.Garamond;b.TextWrapped=true;b.Text=text;if not parent or parent==UI.List then b.AutomaticSize=Enum.AutomaticSize.Y end;corner(b);b.Parent=parent or UI.List
    b.Activated:Connect(function() if type(action)=='function' then action() else UI.send(action,value) end end)
    return b
end
function UI.info(text)
 local l=label(UI.List,text,17);l.Size=UDim2.new(1,-12,0,32);l.AutomaticSize=Enum.AutomaticSize.Y;return l
end
function UI.menu()
 UI.clear();UI.Panel.Visible=true;UI.Role=nil;UI.View='Menu';UI.Title.Text='Eldravyn';UI.Dialogue.Text=AdventureConfig.Title
 for _,entry in {{'Continuar',function()UI.Panel.Visible=false end},{'Personagem',UI.character},{'Tutorial e história',UI.tutorial},{'Inventário',UI.inventory},{'Missões',UI.quests},{'Expedições',UI.expeditions},{'Mapa do continente',UI.map},{'Classes e habilidades',UI.skills},{'Linhagem e fusões',UI.identity},{'Configurações',UI.settings},{'Ofertas planejadas',UI.offers}}do UI.button(entry[1],entry[2])end
 if UI.TesterAllowed then UI.button('Admin Tester • prévia segura',UI.tester)end
end
function UI.map()
 UI.clear();UI.Panel.Visible=true;UI.Role=nil;UI.View='Map';UI.Title.Text='Atlas do Continente';UI.Dialogue.Text='Norte para cima. Toque numa região para ver seu nome e coordenadas; as linhas indicam rotas terrestres.'
 local world=require(game.ReplicatedStorage.MedievalRPG.Config.WorldConfig)
 local canvas=Instance.new('Frame');canvas.Size=UDim2.new(1,-12,0,330);canvas.BackgroundColor3=Color3.fromRGB(45,69,53);canvas.Parent=UI.List
 local square=Instance.new('UIAspectRatioConstraint');square.AspectRatio=1;square.Parent=canvas
 for _,road in world.Roads do
  local dx,dz=road.B.X-road.A.X,road.B.Z-road.A.Z
  local line=Instance.new('Frame');line.AnchorPoint=Vector2.new(0.5,0.5)
  line.Position=UDim2.fromScale(0.5+(road.A.X+road.B.X)/2/world.WorldSize,0.5+(road.A.Z+road.B.Z)/2/world.WorldSize)
  line.Size=UDim2.fromScale(math.sqrt(dx*dx+dz*dz)/world.WorldSize,0.009);line.Rotation=math.deg(math.atan2(dz,dx));line.BorderSizePixel=0;line.BackgroundColor3=color.Gold;line.Parent=canvas
 end
 local function region(id,name,x,z)
  local button=UI.button(id,function()UI.notice(name..' • X '..x..' / Z '..z)end,nil,canvas)
  button.AnchorPoint=Vector2.new(0.5,0.5);button.Position=UDim2.fromScale(0.5+x/world.WorldSize,0.5+z/world.WorldSize);button.Size=UDim2.fromScale(0.23,0.08);button.TextSize=12
 end
 for _,list in {world.Cities,world.Forests}do for _,r in list do region(r.Id,r.Name,r.X,r.Z)end end
 region('Malgorth','Entrada da dungeon',world.DungeonEntrance.X,world.DungeonEntrance.Z)
 if world.SecondDungeonEntrance then region('Santuário','Reino Caído • 20 andares',world.SecondDungeonEntrance.X,world.SecondDungeonEntrance.Z) end
 if world.Guild then region('Guilda','Sede e parceiro de treino',world.Guild.X,world.Guild.Z) end
 local root=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart')
 if root then UI.info('Posição ao abrir: X '..math.floor(root.Position.X)..' / Z '..math.floor(root.Position.Z))end
 UI.button('Menu principal',UI.menu)
end
function UI.settings()
 UI.clear();UI.Panel.Visible=true;UI.Role=nil;UI.View='Settings';UI.Title.Text='Configurações';UI.Dialogue.Text='Preferências locais para efeitos e acessibilidade. Não alteram dano, IA ou recompensas.'
 for _,q in {'LOW','MEDIUM','HIGH'}do UI.button('Qualidade: '..q..(if UI.Settings.Quality==q then ' ✓' else ''),function()UI.Settings.Quality=q;UI.settings()end)end
 UI.button('Movimento reduzido: '..tostring(UI.Settings.ReducedMotion),function()UI.Settings.ReducedMotion=not UI.Settings.ReducedMotion;UI.settings()end)
 UI.button('Sons próprios: '..tostring(UI.Settings.Sound),function()UI.Settings.Sound=not UI.Settings.Sound;UI.settings()end)
 UI.button('Menu principal',UI.menu)
end
function UI.offers()
 UI.clear();UI.Panel.Visible=true;UI.Role=nil;UI.View='Offers';UI.Title.Text='VIP e pacotes';UI.Dialogue.Text='Nenhuma compra será ativada sem produto oficial e benefício aprovado.'
 UI.info('Pacote iniciante: cerca de 300 Robux; troca de classe: cerca de 100 Robux. Propostas registradas, sem IDs/benefícios finais, portanto indisponíveis. Cosméticos e conveniências aguardam catálogo.')
 UI.info('Produtos já planejados: retry racial 150 Robux; 3 básicas 79; 3 premium 149. Veja Linhagem para elegibilidade. Compras indisponíveis nesta versão.')
 UI.button('Linhagem e tentativas',UI.identity);UI.button('Menu principal',UI.menu)
end
function UI.tester()
 UI.clear();UI.Panel.Visible=true;UI.Role=nil;UI.View='Tester';UI.Title.Text='Admin Tester • sem gravação';UI.Dialogue.Text='Relatório de benefícios aprovados. Nunca modifica Gold, raça, créditos reais ou recibos.'
 if not UI.TesterAllowed then UI.info('Desativado. Exige Studio, EnableStudioTester=true e persistência desligada.');return end
 for _,key in {'RacialRetry','BasicPack','PremiumPack'}do UI.button('Prévia: '..key,'TesterPreview',key)end
end
function UI.clear()
    UI.SkillButtons={}
    for _,child in UI.List:GetChildren() do if child:IsA('GuiObject') then child:Destroy() end end
end
function UI.quests()
    UI.clear();UI.Panel.Visible=true;UI.Role=nil;UI.View='Quests';UI.Title.Text='Diário de missões';UI.Dialogue.Text='Aceite missões na guilda ou com exploradores; entregue recompensas na guilda.'
    if not UI.State then return end
    local ids={};for id in Catalog.Quests do table.insert(ids,id)end;table.sort(ids)
    for _,id in ids do
        local q=Catalog.Quests[id]
        local s=UI.State.Quests[id]
        if s then
            UI.button(q.Name..': '..s.Count..'/'..q.Required..(if s.Claimed then ' • concluída' else ''),function() UI.notice('Para entregar, converse com a Guilda.') end)
        end
    end
end
function UI.inventory()
    UI.clear();UI.Panel.Visible=true;UI.Role=nil;UI.View='Inventory';UI.Title.Text='Inventário';UI.Dialogue.Text='Equipe uma arma ou use uma poção. Preços e saldo são calculados no servidor.'
    if not UI.State then return end
    if not UI.State.Adventure or not UI.State.Adventure.Tutorial.Inventory then UI.send('TutorialInventory') end
    UI.button('Linhagem, classes e fragmentos',UI.identity)
    UI.button('Desequipar arma','Unequip')
    UI.button('Desequipar armadura','UnequipArmor')
    for id,count in UI.State.Inventory do
        local item=Catalog.Items[id]
        if item and count>0 then
            UI.info(item.Description or item.Name)
            UI.button(item.Name..' ×'..count..(if UI.State.Equipment==id or UI.State.Armor==id then ' • equipado' else ''),if item.Kind=='Consumable' then 'Potion' elseif item.Kind=='Weapon' or item.Kind=='Armor' then 'Equip' else function() UI.notice(if item.Kind=='Quest' then 'Item reservado à sua missão.' else 'Material negociável: procure um mercador.') end,id)
        end
    end
end
function UI.skills()
    UI.clear();UI.Panel.Visible=true;UI.Role=nil;UI.View='Skills';UI.Title.Text='Classes e habilidades'
    UI.Dialogue.Text='Classe desbloqueada pela missão inicial. Aprenda habilidades com o mestre de armas ou arcanista; custos e níveis são validados no servidor.'
    local class=UI.State and UI.State.Class or ''
    for id,skill in Abilities.Skills do
        if skill.Class==class or Abilities.Classes[class] and Abilities.Classes[class].Base==skill.Class then
            local text=skill.Name..' • Nv '..skill.Level..' • Mana '..skill.Mana..' / Stamina '..skill.Stamina..' • CD '..skill.Cooldown..'s'
            local button=UI.button(text,function()UI.attack(id)end)
            UI.SkillButtons[id]={Button=button,Text=text}
            if skill.Level<=1 or UI.State and UI.State.Unlocks[id] then UI.info('Disponível • '..skill.Name)else UI.button('Aprender '..skill.Name..' • '..skill.Price..' Gold','Learn',id)end
        end
    end
end
function UI.identity()
    UI.clear();UI.Panel.Visible=true;UI.Role=nil;UI.View='Identity';UI.Title.Text='Linhagem • Classes • Fusões'
    UI.button('Habilidades da classe',UI.skills)
    local state=UI.State;local s=state and state.Identity
    if not s then UI.Dialogue.Text='Aguardando perfil de identidade.';return end
    local race=IdentityConfig.Races[s.Race]
    UI.Dialogue.Text=(race and (race.Name..' • '..race.Identity) or 'Raça pendente: exige persistência confirmada.')..' | Classe: '..(state.Class~='' and state.Class or 'indefinida')..' | Fragmentos: '..s.Fragments
    local function info(text) UI.info(text) end
    if race then
        info('Traços: Vida '..race.Health..' • Mana '..race.Mana..' • Stamina '..race.Stamina..'. Raridade não multiplica dano.')
        info('Evolução: '..(s.Evolution~='' and s.Evolution or race.Evolution)..' • missão + '..IdentityConfig.EvolutionFragments..' fragmentos')
        local q=s.Racial;info('Missão racial: '..q.Status)
        if not race.Secret or s.Discoveries[race.Secret] then
            for i,step in race.Steps do info(step.Event..' • '..(q.Counts[tostring(i)] or 0)..'/'..step.Count) end
        else info('História racial secreta: procure sinais nas ruínas.') end
        if q.ReadyAt>(UI.ServerTime or 0) then info('Espera: '..math.ceil((q.ReadyAt-(UI.ServerTime or 0))/60)..' min (atualize para consultar)') end
        UI.button('Iniciar / repetir missão racial','RacialStart')
        UI.button('Concluir evolução racial','RacialClaim')
        UI.button('Usar habilidade racial (R)',function()UI.attack('Racial')end)
        info('Créditos de nova tentativa: '..s.RetryCredits)
        if UI.Purchases and UI.Purchases.RacialRetry then UI.button('Nova tentativa • 150 Robux • janela oficial','Purchase','RacialRetry')
        else info('Nova tentativa paga indisponível. A repetição gratuita após 24h permanece disponível.') end
    end
    for _,base in IdentityConfig.PrimaryClasses do info('Classe principal: '..base) end
    info('Arqueiro preservado como classe alternativa compatível.')
    for id,def in IdentityConfig.Advanced do
        local challenge=s.Challenges[id]
        info(def.Base..' → '..id..' • nível '..def.Level..' • '..(s.Classes[id] and 'desbloqueada' or 'bloqueada'))
        if def.Secret and not s.Discoveries[def.Secret] then info('Missão secreta ainda não descoberta.')
        else
            for i,step in def.Steps do info(step.Event..' • '..(challenge and challenge.Counts[tostring(i)] or 0)..'/'..step.Count) end
            UI.button('Iniciar desafio: '..id,'ClassStart',id)
            UI.button('Concluir desafio: '..id,'ClassClaim',id)
        end
    end
    for id,unlocked in s.Classes do if unlocked then UI.button('Selecionar '..id,'ClassSelect',id) end end
    local week=math.floor(((UI.ServerTime or 0)+3*86400)/604800)
    local used=if week>s.Fusion.Week then 0 else s.Fusion.FreeUsed
    info('Fusões semanais: '..math.max(0,IdentityConfig.Fusion.WeeklyFree-used)..' grátis • '..s.Fusion.Basic..' básicas • '..s.Fusion.Premium..' premium')
    info('Combinações aguardam definição. Nenhuma tentativa/fragmento será consumido.')
    UI.info('Serviço de fusão em preparação. Tentativas e fragmentos permanecem guardados; compra com Gold indisponível.')
    for _,entry in {{'BasicPack',79},{'PremiumPack',149}} do
        if UI.Purchases and UI.Purchases[entry[1]] then UI.button('Pacote 3 • '..entry[2]..' Robux','Purchase',entry[1]) end
    end
    UI.button('Atualizar identidade','Hello')
end
function UI.dialogue(data)
    UI.View='Dialogue'
    UI.Role,UI.City,UI.Party=data.Role,data.City,data.Party
    UI.Panel.Visible=true;UI.Title.Text=data.Name;UI.Dialogue.Text=data.Text
    UI.render()
end
function UI.render()
    local role=UI.Role
    if not role then return end
    UI.clear()
    for _,id in Catalog.Shops[role] or {} do
        local item=Catalog.Items[id]
        UI.button(item.Name..' • '..item.Price..' Gold','Buy',id)
    end
    if role=='Merchant' and UI.State then
        for id,count in UI.State.Inventory do
            local item=Catalog.Items[id]
            if item and item.Price and item.Kind~='Quest' and count>0 then UI.button('Vender '..item.Name..' • '..math.floor(item.Price*0.4)..' Gold','Sell',id) end
        end
    end
    if role=='Equipment' or role=='ShopMagic' or role=='Mage' then UI.button('Abrir habilidades',UI.skills) end
    if role=='Guild' or role=='Quest' then
        if role=='Guild' and (not UI.State or UI.State.Rank=='')then UI.button('Registrar como aventureiro Rank F','Register')else UI.info('Guilda • Rank '..(UI.State and UI.State.Rank or 'pendente'))end
        if UI.State and UI.State.Rank~='' then
            local nextRank=Catalog.Ranks[(table.find(Catalog.Ranks,UI.State.Rank) or 1)+1]
            local req=nextRank and Catalog.RankRequirements[nextRank]
            if req then UI.info('Próximo rank '..nextRank..': '..req.Quests..' missões concluídas e '..req.XP..' XP total. Promoção automática ao entregar missões.') end
        end
        local ids={};for id in Catalog.Quests do table.insert(ids,id)end;table.sort(ids)
        for _,id in ids do
            local q=Catalog.Quests[id]
            local s=UI.State and UI.State.Quests[id]
            if not s then
                local ready=true;for _,pre in q.Prerequisites or {}do if not UI.State or not UI.State.Quests[pre] or not UI.State.Quests[pre].Claimed then ready=false end end
                if not UI.State or UI.State.Rank=='' then ready=false end
                if q.MinRank and (table.find(Catalog.Ranks,UI.State and UI.State.Rank) or 0)<(table.find(Catalog.Ranks,q.MinRank) or 99) then ready=false end
                if ready then UI.info(q.Description..' • '..q.Gold..' Gold / '..q.XP..' XP');UI.button('Aceitar: '..q.Name,'Accept',id)else UI.info(q.Name..' • requer '..table.concat(q.Prerequisites or {},', '))end
            elseif not s.Claimed then
                UI.button(q.Name..' • '..s.Count..'/'..q.Required..(if role=='Guild' then ' • Entregar' else ''),if role=='Guild' then 'Claim' else function() UI.notice('Volte à Guilda para entregar.') end,id)
            end
        end
    elseif role=='Equipment' then
        for _,id in {'Longsword','Katana','Staff','Bow'} do UI.button((if id=='Bow' then 'Alternativa: Arqueiro' else if id=='Katana' then 'Espadachim' elseif id=='Staff' then 'Mago' else 'Guerreiro')..' • '..Catalog.Items[id].Name..' grátis','Choose',id) end
    elseif role=='Inn' then UI.button('Definir esta cidade como retorno','Inn')
    elseif role=='Healer' then UI.button('Receber cura gratuita','Heal')
    elseif role=='Dungeon' then
        UI.button('Atualizar estado do grupo','Hello')
        local p=UI.Party or {}
        local dungeon=DungeonConfig.Dungeons[p.Dungeon or 'MalgorthDepths']
        if dungeon then UI.info(dungeon.Name..' • '..dungeon.Floors..' andares • nível mínimo '..dungeon.MinLevel) end
        if p.Leader then
            UI.info('Grupo '..p.Leader..' • '..(p.State or ''))
            for _,m in p.Members or {} do UI.info(m.Name..(if m.Confirmed then ' ✓ confirmado' else ' • aguardando')) end
            UI.button('Confirmar minha presença','DungeonConfirm')
            UI.button('Iniciar (líder)','DungeonStart')
            UI.button('Sair do grupo','DungeonLeave')
        else
            UI.button('Entrar sozinho','DungeonSolo');UI.button('Criar grupo até quatro','DungeonCreate');UI.button('Explorar as sete salas legadas (solo)','DungeonLegacy')
            local input=Instance.new('TextBox');input.Size=UDim2.new(1,-12,0,36);input.PlaceholderText='Código numérico do líder';input.Text='';input.TextSize=18;input.TextColor3=color.Text;input.BackgroundColor3=color.Panel;input.ClearTextOnFocus=false;input.Parent=UI.List;corner(input)
            UI.button('Entrar com código',function() local code=tonumber(input.Text);if code then UI.send('DungeonJoin',code) end end)
        end
    end
    UI.button('Informações',function() UI.notice(UI.Dialogue.Text) end)
end
function UI.update(data)
    local first=UI.State==nil
    UI.State,UI.Party=data.State,data.Party;UI.ServerTime=data.State.ServerTime;UI.Purchases=data.State.Purchases;UI.TesterAllowed=data.State.TesterAllowed
    local s=data.State
    UI.Hud.Text=string.format('ELDRAVYN • %d Gold • Rank %s • %s\n%s',s.Gold,if s.Rank=='' then '—' else s.Rank,if s.Class=='' then 'Escolha sua classe' else s.Class,if s.Persistent then 'Personagem persistente' else 'TESTE DE SESSÃO • sem salvamento')
    if UI.refreshAdventure then UI.refreshAdventure() end
    if UI.Panel.Visible then
        if UI.Role then UI.render() elseif UI.View=='Inventory' then UI.inventory() elseif UI.View=='Quests' then UI.quests() elseif UI.View=='Identity' then UI.identity() elseif UI.View=='Skills' then UI.skills() elseif UI.View=='Character' then UI.character() elseif UI.View=='Tutorial' then UI.tutorial() end
    end
    if first and not s.StarterChosen and UI.character then UI.character() end
end
function UI.start(remote)
    UI.Remote=remote
    local gui=Instance.new('ScreenGui');gui.Name='MedievalRPG';gui.ResetOnSpawn=false;gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;gui.Parent=Players.LocalPlayer:WaitForChild('PlayerGui')
    local menuButton=UI.button('Menu',UI.menu,nil,gui);menuButton.Size=UDim2.fromOffset(74,32);menuButton.Position=UDim2.new(1,-82,0,8)
    local hud=label(gui,'Carregando perfil...',15);hud.Size=UDim2.new(1,-100,0,48);hud.Position=UDim2.fromOffset(10,4);UI.Hud=hud
    local toast=label(gui,'',17);toast.Size=UDim2.new(0.8,0,0,70);toast.Position=UDim2.fromScale(0.1,0.31);toast.TextXAlignment=Enum.TextXAlignment.Center;toast.Visible=false;toast.ZIndex=15;UI.Toast=toast
    local region=label(gui,'',22);region.Size=UDim2.new(0.7,0,0,28);region.Position=UDim2.new(0.15,0,0,184);region.Visible=not UIS.TouchEnabled;region.TextXAlignment=Enum.TextXAlignment.Center;UI.Region=region
    local panel=Instance.new('Frame');panel.AnchorPoint=Vector2.new(0.5,0.5);panel.BackgroundColor3=color.Bg;panel.Size=UDim2.fromScale(0.85,0.64);panel.Position=UDim2.fromScale(0.5,0.56);panel.Visible=false;panel.ZIndex=10;corner(panel);panel.Parent=gui;UI.Panel=panel
    local max=Instance.new('UISizeConstraint');max.MaxSize=Vector2.new(600,550);max.Parent=panel
    local title=label(panel,'',25);title.Size=UDim2.new(1,-50,0,40);title.Position=UDim2.fromOffset(12,4);UI.Title=title
    local close=Instance.new('TextButton');close.Text='×';close.Size=UDim2.fromOffset(35,35);close.Position=UDim2.new(1,-40,0,4);close.BackgroundTransparency=1;close.TextColor3=color.Gold;close.TextSize=30;close.Parent=panel;close.Activated:Connect(function()panel.Visible=false;UI.Role=nil end)
    local dialogue=label(panel,'',16);dialogue.Size=UDim2.new(1,-24,0,90);dialogue.Position=UDim2.fromOffset(12,45);UI.Dialogue=dialogue
    local list=Instance.new('ScrollingFrame');list.BackgroundTransparency=1;list.BorderSizePixel=0;list.Size=UDim2.new(1,-24,1,-150);list.Position=UDim2.fromOffset(12,140);list.AutomaticCanvasSize=Enum.AutomaticSize.Y;list.CanvasSize=UDim2.new();list.ScrollBarThickness=5;list.Parent=panel;UI.List=list
    local layout=Instance.new('UIListLayout');layout.Padding=UDim.new(0,5);layout.Parent=list
    local resources=label(gui,'',14);resources.Size=UDim2.new(0.62,0,0,36);resources.Position=UDim2.fromOffset(10,50)
    local bars={}
    for index,entry in {{'Vida',Color3.fromRGB(188,73,72)},{'Mana',Color3.fromRGB(82,120,214)},{'Stamina',Color3.fromRGB(99,172,112)},{'XP',color.Gold},{'Postura',Color3.fromRGB(219,157,67)}} do
        local bar=Instance.new('Frame');bar.Size=UDim2.new(0.11,0,0,8);bar.Position=UDim2.new(0.02+(index-1)*0.12,0,0,112);bar.BackgroundColor3=color.Panel;bar.Parent=gui
        local name=label(bar,entry[1],11);name.Size=UDim2.new(1,0,0,14);name.Position=UDim2.fromOffset(0,-15)
        local fill=Instance.new('Frame');fill.Size=UDim2.fromScale(1,1);fill.BackgroundColor3=entry[2];fill.BorderSizePixel=0;fill.Parent=bar;bars[index]=fill
    end
    task.spawn(function()
        while gui.Parent do
            local p=Players.LocalPlayer;local hum=p.Character and p.Character:FindFirstChildOfClass('Humanoid')
            resources.Text=string.format('Nv %d • Vida %d/%d\nMana %d • Stamina %d%s',p:GetAttribute('Level') or 1,hum and hum.Health or 0,hum and hum.MaxHealth or 100,p:GetAttribute('Mana') or 0,p:GetAttribute('Stamina') or 0,if p:GetAttribute('PostureBroken') then ' • Guarda quebrada!' else '')
            local values={{hum and hum.Health or 0,hum and hum.MaxHealth or 100},{p:GetAttribute('Mana') or 0,p:GetAttribute('MaxMana') or 1},{p:GetAttribute('Stamina') or 0,p:GetAttribute('MaxStamina') or 1},{p:GetAttribute('LevelXP') or 0,p:GetAttribute('NextXP') or 1},{p:GetAttribute('Posture') or 0,p:GetAttribute('MaxPosture') or 100}}
            for i,v in values do bars[i].Size=UDim2.fromScale(math.clamp(v[1]/math.max(1,v[2]),0,1),1) end
            for id,entry in UI.SkillButtons do
                if entry.Button.Parent then
                    local remaining=math.max(0,math.ceil((UI.Cooldowns[id] or 0)-os.clock()))
                    entry.Button.Text=entry.Text..(if remaining>0 then ' • '..remaining..'s' else '')
                    entry.Button.Active=remaining==0
                end
            end
            for i,button in UI.HotbarButtons or {} do
                local slots=UI.State and Abilities.Slots[UI.State.Class]
                local id=if i==5 then 'Racial' else slots and slots[i]
                local def=id and Abilities.Skills[id]
                local remaining=id and math.max(0,math.ceil((UI.Cooldowns[id] or 0)-os.clock())) or 0
                button.Text=(if i==5 then 'Racial' elseif def then def.Name else '—')..(if remaining>0 then ' '..remaining..'s' else '')
            end
            if UI.refreshAdventure then UI.refreshAdventure() end
            for _,frame in UI.ActionFrames or {} do frame.Visible=not UI.Panel.Visible end
            task.wait(0.2)
        end
    end)
    local combatButtons=Instance.new('Frame');combatButtons.BackgroundTransparency=1;combatButtons.Size=UDim2.new(1,-16,0,38);combatButtons.Position=UDim2.new(0,8,1,-92);combatButtons.Parent=gui
    local row=Instance.new('UIListLayout');row.FillDirection=Enum.FillDirection.Horizontal;row.Padding=UDim.new(0,4);row.Parent=combatButtons
    for _,entry in {{'Pesado',function()UI.attack('Heavy')end},{'Esquiva',function()UI.send('Control','Dodge')end},{'Bloquear',function()UI.send('Control','BlockOff')end},{'Correr',function()UI.Running=not UI.Running;UI.send('Control',if UI.Running then 'RunOn' else 'RunOff')end},{'Ataque',function()UI.attack('Primary')end}} do
        local b=UI.button(entry[1],entry[2],nil,combatButtons);b.Size=UDim2.new(0.19,0,1,0)
        if entry[1]=='Bloquear' then
            b.MouseButton1Down:Connect(function()UI.send('Control','BlockOn')end)
            b.MouseButton1Up:Connect(function()UI.send('Control','BlockOff')end)
        end
    end
    local buttons=Instance.new('Frame');buttons.BackgroundTransparency=1;buttons.Size=UDim2.new(1,-16,0,40);buttons.Position=UDim2.new(0,8,1,-48);buttons.Parent=gui
    local line=Instance.new('UIListLayout');line.FillDirection=Enum.FillDirection.Horizontal;line.Padding=UDim.new(0,6);line.Parent=buttons
    for _,entry in {{'Missões',UI.quests},{'Inventário',UI.inventory},{'Poção',function()UI.send('Potion')end},{'Pulso (Q)',function() UI.attack('Pulse') end}} do
        local b=UI.button(entry[1],entry[2],nil,buttons);b.Size=UDim2.new(0.23,0,1,0)
    end
    local hotbar=Instance.new('Frame');hotbar.BackgroundTransparency=1;hotbar.Size=UDim2.new(0.65,0,0,38);hotbar.Position=UDim2.new(0.175,0,1,-136);hotbar.Parent=gui
    local hotLayout=Instance.new('UIListLayout');hotLayout.FillDirection=Enum.FillDirection.Horizontal;hotLayout.Padding=UDim.new(0,3);hotLayout.Parent=hotbar
    UI.HotbarButtons={}
    for i=1,5 do
        local b=UI.button('—',function()
            local slots=UI.State and Abilities.Slots[UI.State.Class]
            if i==5 then UI.attack('Racial') elseif slots then UI.attack(slots[i]) end
        end,nil,hotbar);b.Size=UDim2.new(0.19,0,1,0);b.TextSize=13;UI.HotbarButtons[i]=b
    end
    if UIS.TouchEnabled then
        combatButtons.Size=UDim2.new(0.55,0,0,86);combatButtons.Position=UDim2.new(0.44,0,1,-154)
        row:Destroy();local grid=Instance.new('UIGridLayout');grid.CellSize=UDim2.new(0.32,0,0,40);grid.CellPadding=UDim2.fromOffset(3,3);grid.Parent=combatButtons
        buttons.Size=UDim2.new(0.55,0,0,54);buttons.Position=UDim2.new(0.44,0,1,-62)
        for _,b in buttons:GetChildren() do if b:IsA('TextButton') then b.TextSize=12 end end
        hotbar.Size=UDim2.new(0.55,0,0,44);hotbar.Position=UDim2.new(0.44,0,1,-204)
    end
    require(script.Parent.AdventureController).bind(UI)
    UI.ActionFrames={hotbar,combatButtons,buttons}
    local function adapt()
        local camera=workspace.CurrentCamera;local size=camera and camera.ViewportSize
        UI.adapt(size and size.X or 1280,size and size.Y or 720)
    end
    adapt()
    local camera=workspace.CurrentCamera
    if camera then camera:GetPropertyChangedSignal('ViewportSize'):Connect(adapt) end
    remote.OnClientEvent:Connect(function(data)
        if type(data)~='table' then return end
        if data.Type=='State' then UI.update(data)
        elseif data.Type=='Dialogue' then UI.dialogue(data)
        elseif data.Type=='Preview' then
            local p=data.Preview;UI.notice('PRÉVIA SEM GRAVAÇÃO • '..p.Grant..': '..p.Before..' → '..p.After)
        elseif data.Type=='Notice' then UI.notice(data.Text) end
    end)
    UI.send('Hello')
    task.delay(2,function() if not UI.State then UI.send('Hello') end end)
    return UI
end
return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">WorldController</string>
              <string name="Source"><![CDATA[local Players=game:GetService('Players')
local Lighting=game:GetService('Lighting')
local RunService=game:GetService('RunService')
local Tween=game:GetService('TweenService')
local Debris=game:GetService('Debris')
local Config=require(game.ReplicatedStorage.MedievalRPG.Config.WorldConfig)
local Environment=require(game.ReplicatedStorage.MedievalRPG.Core.EnvironmentRules)
local W={}
function W.start(ui,effects)
    local projectiles={};local rain={};local lastVisual=os.clock()
    local palette={Heal=Color3.fromRGB(121,222,170),Fire=Color3.fromRGB(255,121,52),Ice=Color3.fromRGB(118,220,250),Lightning=Color3.fromRGB(243,228,112),Arrow=Color3.fromRGB(194,165,105),Shadow=Color3.fromRGB(163,96,203),Steel=Color3.fromRGB(220,224,234)}
    local poses=setmetatable({}, {__mode='k'})
    local weatherLabel=Instance.new('TextLabel');weatherLabel.Size=UDim2.fromOffset(120,22);weatherLabel.Position=UDim2.new(1,-135,0,206);weatherLabel.BackgroundTransparency=1;weatherLabel.TextColor3=Color3.fromRGB(223,222,201);weatherLabel.TextSize=13;weatherLabel.Parent=ui.Hud.Parent
    local weatherGrade=Instance.new('ColorCorrectionEffect');weatherGrade.Name='LocalWeatherGrade';weatherGrade.Parent=Lighting
    local currentWeather=''
    local current='';local rigs={};local flags={};local updateAt=0;local nextScan=0;local fxWindow=0;local fxCount=0
    local localGrade=Instance.new('ColorCorrectionEffect');localGrade.Name='NoctharLocalGrade';localGrade.Parent=Lighting
    local map=Instance.new('Frame');map.Size=UDim2.fromOffset(130,130);map.Position=UDim2.new(1,-138,0,72);map.BackgroundColor3=Color3.fromRGB(36,62,47);map.BackgroundTransparency=0.15;map.Parent=ui.Hud.Parent
    local title=Instance.new('TextLabel');title.Size=UDim2.new(1,0,0,20);title.Text='N ↑   Continente';title.BackgroundTransparency=1;title.TextColor3=Color3.new(1,1,1);title.TextSize=12;title.Parent=map
    local dot=Instance.new('Frame');dot.Size=UDim2.fromOffset(5,5);dot.AnchorPoint=Vector2.new(0.5,0.5);dot.BackgroundColor3=Color3.new(1,1,1);dot.Parent=map
    for _,city in Config.Cities do
        local label=Instance.new('TextLabel');label.BackgroundTransparency=1;label.Size=UDim2.fromOffset(34,16);label.Text=string.sub(city.Id,1,3);label.TextSize=10;label.TextColor3=Color3.fromRGB(242,210,123);label.Position=UDim2.fromScale(0.5+city.X/Config.WorldSize,0.5+city.Z/Config.WorldSize);label.AnchorPoint=Vector2.new(0.5,0.5);label.Parent=map
    end
    local d=Instance.new('TextLabel');d.Size=UDim2.fromOffset(12,12);d.Text='D';d.BackgroundTransparency=1;d.TextColor3=Color3.fromRGB(241,80,107);d.Position=UDim2.fromScale(0.5,0.5+Config.DungeonEntrance.Z/Config.WorldSize);d.Parent=map
    local boss=Instance.new('TextLabel');boss.Size=UDim2.fromScale(0.6,0.04);boss.Position=UDim2.fromScale(0.2,0.21);boss.BackgroundColor3=Color3.fromRGB(59,26,36);boss.TextColor3=Color3.fromRGB(244,191,181);boss.TextScaled=true;boss.Visible=false;boss.Parent=ui.Hud.Parent
    effects.OnClientEvent:Connect(function(data)
        if data.Kind=='Cast' or data.Kind=='Defense' or data.Kind=='MeleeWarning' then
            local char=Players.LocalPlayer.Character;local r=char and char:FindFirstChild('HumanoidRootPart')
            if not r or (r.Position-data.Position).Magnitude>130 then return end
            if os.clock()-fxWindow>=1 then fxWindow=os.clock();fxCount=0 end
            if data.Kind~='MeleeWarning' then
                fxCount+=1;if fxCount>math.min(Config.MaxCombatFX,Environment.Profiles[ui.Settings.Quality].FX) then return end
            end
            local anchor=Instance.new('Part');anchor.Name='ActionFeedback';anchor.Size=Vector3.new(0.15,0.15,0.15);anchor.Position=data.Position+Vector3.new(0,4,0);anchor.Anchored=true;anchor.Transparency=1;anchor.CanCollide=false;anchor.CanTouch=false;anchor.CanQuery=false;anchor.Parent=workspace
            local billboard=Instance.new('BillboardGui');billboard.Size=UDim2.fromOffset(160,36);billboard.AlwaysOnTop=true;billboard.Parent=anchor
            local text=Instance.new('TextLabel');text.BackgroundTransparency=1;text.Size=UDim2.fromScale(1,1);text.Font=Enum.Font.Garamond;text.TextSize=20;text.TextColor3=palette[data.Style] or Color3.fromRGB(247,204,103);text.Parent=billboard
            text.Text=if data.Kind=='MeleeWarning' then '⚔ APARÁVEL' elseif data.Outcome=='Parry' then 'APARO!' elseif data.Outcome=='Break' then 'GUARDA QUEBRADA' elseif data.Outcome=='Block' then 'BLOQUEIO' elseif data.Outcome=='Dodge' then 'ESQUIVA' else ''
            Debris:AddItem(anchor,data.Seconds or 0.65)
            if data.Kind=='Cast' then
                local actor=Players:GetPlayerByUserId(data.Actor);local model=actor and actor.Character
                if model and not ui.Settings.ReducedMotion then
                    for _,joint in model:GetDescendants() do
                        if joint:IsA('Motor6D') and (joint.Name=='RightShoulder' or joint.Name=='Right Shoulder') then
                            local pose=poses[joint] or {Base=joint.C0,Serial=0};poses[joint]=pose;pose.Serial+=1;local serial=pose.Serial
                            Tween:Create(joint,TweenInfo.new(0.12),{C0=pose.Base*CFrame.Angles(-0.8,0,if data.Mode=='Heavy' then 0.8 else 0.35)}):Play()
                            task.delay(0.18,function()if joint.Parent and pose.Serial==serial then Tween:Create(joint,TweenInfo.new(0.18),{C0=pose.Base}):Play() end end)
                        end
                    end
                end
            end
            return
        end
        if data.Kind=='Burst' then
            local root=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart')
            if not root or (root.Position-data.Position).Magnitude>180 then return end
            if os.clock()-fxWindow>=1 then fxWindow=os.clock();fxCount=0 end
            fxCount+=1;if fxCount>math.min(Config.MaxCombatFX,Environment.Profiles[ui.Settings.Quality].FX) then return end
            local p=Instance.new('Part');p.Name='LocalExplosion';p.Shape=Enum.PartType.Ball;p.Size=Vector3.new(1,1,1);p.Position=data.Position
            p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Material=Enum.Material.Neon;p.Transparency=0.75;p.Color=palette[data.Style] or Color3.fromRGB(178,156,228);p.Parent=workspace
            local size=Vector3.new(data.Radius*2,data.Radius*2,data.Radius*2)
            if ui.Settings.ReducedMotion then p.Size=size;p.Transparency=0.9 else Tween:Create(p,TweenInfo.new(0.4),{Size=size,Transparency=1}):Play()end
            Debris:AddItem(p,0.5);return
        end
        if data.Kind=='ProjectileEnd' then
            local p=projectiles[data.Id];if p then p.Part:Destroy();projectiles[data.Id]=nil end;return
        elseif data.Kind=='Projectile' then
            local r=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart')
            local count=0;for _ in projectiles do count+=1 end
            if not r or (r.Position-data.Origin).Magnitude>180 or count>=math.min(Config.MaxCombatFX,Environment.Profiles[ui.Settings.Quality].FX) then return end
            local p=Instance.new('Part');p.Name='LocalProjectile';p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
            p.Color=palette[data.Style] or Color3.fromRGB(135,150,244);p.Material=Enum.Material.Neon
            p.Size=if data.Style=='Arrow' then Vector3.new(0.15,0.15,3) else Vector3.new(1.2,1.2,1.2)
            if data.Style~='Arrow'then p.Shape=Enum.PartType.Ball end
            p.CFrame=CFrame.lookAt(data.Origin,data.Origin+data.Direction);p.Parent=workspace
            projectiles[data.Id]={Part=p,Origin=data.Origin,Direction=data.Direction,Speed=data.Speed,Range=data.Range,Travel=0}
            return
        elseif data.Kind=='Warning' then
            local r=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart')
            if not r or (r.Position-data.Position).Magnitude>180 then return end
            local disk=Instance.new('Part');disk.Name='DangerTelegraph';disk.Size=Vector3.new(0.15,data.Radius*2,data.Radius*2)
            disk.Shape=Enum.PartType.Cylinder;disk.CFrame=CFrame.new(data.Position-Vector3.new(0,(data.HeightOffset or 3)-0.1,0))*CFrame.Angles(0,0,math.pi/2)
            disk.Color=if data.Friendly then Color3.fromRGB(231,163,67)else Color3.fromRGB(244,78,62);disk.Material=Enum.Material.Neon;disk.Transparency=0.65;disk.Anchored=true;disk.CanCollide=false;disk.CanQuery=false;disk.CanTouch=false;disk.Parent=workspace
            if (data.InnerRadius or 0)>0 then
                local safe=Instance.new('Part');safe.Name='SafeCenter';safe.Shape=Enum.PartType.Cylinder;safe.Size=Vector3.new(0.16,data.InnerRadius*2,data.InnerRadius*2);safe.CFrame=disk.CFrame+Vector3.new(0,0.1,0)
                safe.Color=Color3.fromRGB(83,197,153);safe.Transparency=0.35;safe.Material=Enum.Material.Neon;safe.Anchored=true;safe.CanCollide=false;safe.CanTouch=false;safe.CanQuery=false;safe.Parent=workspace;Debris:AddItem(safe,data.Seconds)
            end
            Debris:AddItem(disk,data.Seconds);if not data.Friendly then ui.notice(data.Name..(if (data.InnerRadius or 0)>0 then ' • centro verde é seguro!'else ' • saia da área vermelha!'))end;return
        end
        if data.Kind=='Cooldown' then
            ui.Cooldowns[data.Id]=os.clock()+(data.Seconds or 0)
            return end
        if data.Kind=='Hit' and typeof(data.A)=='Vector3' and typeof(data.B)=='Vector3' then
            local midpoint=(data.A+data.B)/2
            local char=Players.LocalPlayer.Character;local r=char and char:FindFirstChild('HumanoidRootPart')
            if not r or (r.Position-midpoint).Magnitude>180 then return end
            if os.clock()-fxWindow>=1 then fxWindow=os.clock();fxCount=0 end
            fxCount+=1;if fxCount>math.min(Config.MaxCombatFX,Environment.Profiles[ui.Settings.Quality].FX)then return end
            local audio=Config.Audio.Impact
            if ui.Settings.Sound and type(audio)=='string' and string.match(audio,'^rbxassetid://%d+$') then
                local sound=Instance.new('Sound');sound.SoundId=audio;sound.Volume=0.25;sound.Parent=workspace.CurrentCamera;sound:Play();Debris:AddItem(sound,2)
            end
            local p=Instance.new('Part');p.Name='LocalCombatFX';p.Size=Vector3.new(0.15,0.15,(data.B-data.A).Magnitude);p.CFrame=CFrame.lookAt(midpoint,data.B)
            p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Material=Enum.Material.Neon;p.Color=palette[data.Style] or (if data.Magic then Color3.fromRGB(135,118,253) else Color3.fromRGB(244,211,145));p.Parent=workspace;Debris:AddItem(p,0.15)
            if data.Damage then
                local anchor=Instance.new('Part');anchor.Size=Vector3.new(0.1,0.1,0.1);anchor.Position=data.B;anchor.Transparency=1;anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false;anchor.Parent=workspace
                local billboard=Instance.new('BillboardGui');billboard.Size=UDim2.fromOffset(100,40);billboard.AlwaysOnTop=true;billboard.Parent=anchor
                local number=Instance.new('TextLabel');number.Size=UDim2.fromScale(1,1);number.BackgroundTransparency=1;number.Text=tostring(data.Damage)..(if data.Critical then '!' else '');number.TextSize=if data.Critical then 28 else 24;number.TextColor3=Color3.fromRGB(255,207,103);number.Parent=billboard;Debris:AddItem(anchor,0.7)
            end
        elseif data.Kind=='Chest' then ui.notice('Tesouro recebido! O saque é individual.') end
    end)
    RunService.Heartbeat:Connect(function()
        local now=os.clock();local visualDelta=math.min(0.1,now-lastVisual);lastVisual=now
        for id,p in projectiles do
            p.Travel+=p.Speed*visualDelta
            if not p.Part.Parent or p.Travel>=p.Range then p.Part:Destroy();projectiles[id]=nil
            else local pos=p.Origin+p.Direction*p.Travel;p.Part.CFrame=CFrame.lookAt(pos,pos+p.Direction)end
        end
        if now-updateAt<0.2 then return end;updateAt=now
        local char=Players.LocalPlayer.Character;local root=char and char:FindFirstChild('HumanoidRootPart')
        if not root then return end
        map.Visible=not ui.Compact;weatherLabel.Visible=not ui.Compact
        boss.Size=if ui.Compact then UDim2.new(0.4,-16,0,22) else UDim2.fromScale(0.6,0.04)
        boss.Position=if ui.Compact then UDim2.fromOffset(10,172) else UDim2.new(0.2,0,0,218)
        local weather=Environment.weather(workspace:GetServerTimeNow())
        if weather~=currentWeather then
            currentWeather=weather
            Tween:Create(weatherGrade,TweenInfo.new(4),{TintColor=if weather=='Clear' then Color3.new(1,1,1)else Color3.fromRGB(209,219,235),Brightness=if weather=='Clear'then 0 else -0.03}):Play()
        end
        weatherLabel.Text=if weather=='Rain' then 'Chuva' elseif weather=='Mist' then 'Névoa' else 'Céu aberto'
        local quality=Environment.Profiles[ui.Settings.Quality]
        local bloom=Lighting:FindFirstChild('MedievalBloom');if bloom then bloom.Intensity=quality.Bloom end
        local rainCount=if weather=='Rain' then quality.Rain else 0
        for i=1,24 do
            local p=rain[i]
            if i<=rainCount then
                if not p then
                    p=Instance.new('Part');p.Name='LocalRain';p.Size=Vector3.new(0.06,1.6,0.06);p.Color=Color3.fromRGB(155,184,201);p.Transparency=0.45;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=workspace;rain[i]=p
                end
                local y=22-(now*26+i*3)%24;p.Position=root.Position+Vector3.new(math.sin(i*13)*16,y,math.cos(i*7)*16);p.Transparency=0.45
            elseif p then p.Transparency=1 end
        end
        local region='Terras Livres';local dark=false
        for _,list in {Config.Cities,Config.Forests} do
            for _,r in list do
                if (Vector2.new(root.Position.X,root.Position.Z)-Vector2.new(r.X,r.Z)).Magnitude<r.Radius then region=r.Name;dark=r.Id=='Nocthar' end
            end
        end
        if Players.LocalPlayer:GetAttribute('InDungeon') then region=Players.LocalPlayer:GetAttribute('DungeonName') or 'Abismo • Recepção e salas legadas' end
        if region~=current then
            current=region;ui.Region.Text=region
            Tween:Create(localGrade,TweenInfo.new(2),{TintColor=if dark then Color3.fromRGB(174,176,207) else Color3.new(1,1,1),Brightness=if dark then -0.06 else 0}):Play()
        end
        dot.Visible=not Players.LocalPlayer:GetAttribute('InDungeon')
        title.Text=if Players.LocalPlayer:GetAttribute('InDungeon')then 'Interior separado'else 'N ↑ Continente'
        dot.Position=UDim2.fromScale(math.clamp(0.5+root.Position.X/Config.WorldSize,0,1),math.clamp(0.5+root.Position.Z/Config.WorldSize,0,1))
        -- Cache limitado a modelos carregados pelo streaming; evita varrer Workspace por frame.
        if now>=nextScan then
            nextScan=now+3
            table.clear(rigs);table.clear(flags)
            for _,name in {'GeneratedWorld','GeneratedDungeon'} do
                local world=workspace:FindFirstChild(name)
                if world then
                    local cities=world:FindFirstChild('Cities')
                    if cities then
                        for _,p in cities:GetDescendants() do
                            if p:IsA('BasePart') and p:GetAttribute('Flutter') then table.insert(flags,{Part=p,Base=p.CFrame}) end
                        end
                    end
                    local npcs=world:FindFirstChild('NPCs')
                    if npcs then for _,m in npcs:GetChildren() do if m:IsA('Model') then table.insert(rigs,m) end end end
                    for _,m in world:GetChildren() do if m:IsA('Model') and m:GetAttribute('EnemyKind') then table.insert(rigs,m) end end
                    local expeditions=world:FindFirstChild('Expeditions')
                    if expeditions then for _,tower in expeditions:GetChildren() do for _,floor in tower:GetChildren() do
                        if floor:GetAttribute('Active') then for _,m in floor:GetChildren() do if m:IsA('Model') and m:GetAttribute('EnemyKind') then table.insert(rigs,m) end end end
                    end end end
                end
            end
        end
        for _,entry in flags do
            if not ui.Settings.ReducedMotion and entry.Part.Parent and (entry.Part.Position-root.Position).Magnitude<150 then entry.Part.CFrame=entry.Base*CFrame.Angles(0,math.sin(now*1.5)*0.04,0) end
        end
        boss.Visible=false
        for _,model in rigs do
            local r=model:FindFirstChild('HumanoidRootPart')
            if r and (r.Position-root.Position).Magnitude<120 then
                local torso=model:FindFirstChild('Torso')
                if torso and not ui.Settings.ReducedMotion then
                    for _,j in torso:GetChildren() do
                        if j:IsA('Motor6D') then
                            if j.Name=='Left Shoulder' or j.Name=='Right Shoulder' then j.Transform=CFrame.Angles(if model:GetAttribute('State')=='WINDUP' then -1.4 else math.sin(now*2+r.Position.X)*0.07,0,0)
                            elseif j.Name=='Left Hip' or j.Name=='Right Hip' then
                                local moving=r.AssemblyLinearVelocity.Magnitude>1
                                j.Transform=CFrame.Angles(if moving then math.sin(now*7)*(if j.Name=='Left Hip' then 0.35 else -0.35) else 0,0,0)
                            end
                        end
                    end
                end
                if model:GetAttribute('Boss')==true then boss.Text=model.Name..'  '..math.ceil(model:GetAttribute('Health') or 0)..' / '..(model:GetAttribute('HealthMax') or 1400);boss.Visible=true end
            end
        end
    end)
end
return W
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="63">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players=game:GetService('Players')
local UIS=game:GetService('UserInputService')
-- The custom inventory equips Tools itself; avoid a second overlapping mobile hotbar.
task.spawn(function()
    for _=1,3 do
        local ok=pcall(function()game:GetService('StarterGui'):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack,false);game:GetService('StarterGui'):SetCoreGuiEnabled(Enum.CoreGuiType.Health,false)end)
        if ok then return end
        task.wait(1)
    end
end)
local remoteFolder=game.ReplicatedStorage:WaitForChild('MedievalRPG'):WaitForChild('Remotes')
local remote=remoteFolder:WaitForChild('Action')
local ui=require(script.Parent.Controllers.UIController).start(remote)
require(script.Parent.Controllers.WorldController).start(ui,remoteFolder:WaitForChild('Effects'))
local Abilities=require(game.ReplicatedStorage.MedievalRPG.Config.AbilityConfig)
local mouse=Players.LocalPlayer:GetMouse()
ui.GetAim=function()
    local camera=workspace.CurrentCamera
    if UIS.TouchEnabled and camera then
        local size=camera.ViewportSize
        local ray=camera:ViewportPointToRay(size.X/2,size.Y/2)
        local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={Players.LocalPlayer.Character}
        local hit=workspace:Raycast(ray.Origin,ray.Direction*160,params)
        return hit and hit.Position or ray.Origin+ray.Direction*160
    end
    return mouse.Hit.Position
end
local bound=setmetatable({}, {__mode='k'})
local function bind(tool)
    if not tool:IsA('Tool') or not tool:GetAttribute('ItemId') or bound[tool] then return end
    bound[tool]=true
    tool.Activated:Connect(function()ui.attack('Primary')end)
end
local function character(char)
    char.ChildAdded:Connect(bind)
    for _,v in char:GetChildren() do bind(v) end
end
Players.LocalPlayer.CharacterAdded:Connect(character)
if Players.LocalPlayer.Character then character(Players.LocalPlayer.Character) end
UIS.InputBegan:Connect(function(input,processed)
    if processed then return end
    local slots=ui.State and Abilities.Slots[ui.State.Class]
    for i,key in {Enum.KeyCode.Z,Enum.KeyCode.X,Enum.KeyCode.C,Enum.KeyCode.V} do
        if input.KeyCode==key and slots then ui.attack(slots[i]);return end
    end
    if input.UserInputType==Enum.UserInputType.MouseButton2 then ui.attack('Heavy')
    elseif input.KeyCode==Enum.KeyCode.F then remote:FireServer('Control','BlockOn')
    elseif input.KeyCode==Enum.KeyCode.LeftShift then remote:FireServer('Control','RunOn')
    elseif input.KeyCode==Enum.KeyCode.LeftControl then remote:FireServer('Control','Dodge')
    elseif input.KeyCode==Enum.KeyCode.R then remote:FireServer('Attack',{Mode='Racial'})
    elseif input.KeyCode==Enum.KeyCode.L then ui.identity()
    elseif input.KeyCode==Enum.KeyCode.M then ui.menu()
    elseif input.KeyCode==Enum.KeyCode.K then ui.skills()
    elseif input.KeyCode==Enum.KeyCode.Q then remote:FireServer('Attack',{Mode='Pulse',Target=mouse.Hit.Position})
    elseif input.KeyCode==Enum.KeyCode.J then ui.quests()
    elseif input.KeyCode==Enum.KeyCode.I then ui.inventory() end
end)

UIS.InputEnded:Connect(function(input)
 if input.KeyCode==Enum.KeyCode.F then remote:FireServer('Control','BlockOff') end
 if input.KeyCode==Enum.KeyCode.LeftShift then remote:FireServer('Control','RunOff') end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="64">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
      <int name="StreamingMinRadius">64</int>
      <int name="StreamingTargetRadius">256</int>
    </Properties>
  </Item>
</roblox>