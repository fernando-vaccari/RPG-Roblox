        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">WorldConfig</string>
            <string name="Source"><![CDATA[-- Configuração sem dependências do engine: compartilhada com os testes CLI.
return table.freeze({
    Audio = {Impact='',Cast='',Dodge=''}, -- Somente IDs reais próprios após upload.
    MaxCombatFX = 20,
    EnableStudioTester = false, -- opt-in, somente Studio sem persistência; nunca concede ao perfil real.
